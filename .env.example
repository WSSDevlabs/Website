# Web3Forms access key (https://web3forms.com). Public-safe and domain-validated.
# Required: the contact form and system order requests submit through it.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Cloudflare Web Analytics beacon token (cookieless). Use EITHER this token OR
# Cloudflare's automatic Web Analytics setup in the dashboard, never both,
# or every visit is counted twice. Leave blank locally.
PUBLIC_CF_ANALYTICS_TOKEN=

# Canonical site URL used for SEO and the sitemap
PUBLIC_SITE_URL=https://wssdevlabs.com

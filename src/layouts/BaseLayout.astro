---
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import MobileActionBar from '../components/layout/MobileActionBar.astro';
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
import '@fontsource-variable/outfit/index.css';
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import '../styles/global.css';

type Props = {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
};

const { title, description, path, ogImage, type, noindex, schema } = Astro.props;

/*
 * Cloudflare Web Analytics is cookieless, so it loads without a consent banner and
 * the Cookie Policy says so (audit V11 / 10.2). Use EITHER this token OR Cloudflare's
 * automatic setup in the dashboard, never both, or every visit is counted twice.
 */
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Headlines are the largest thing on most pages, so their font loads first. -->
    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />
    <SEO title={title} description={description} path={path} ogImage={ogImage} type={type} noindex={noindex} />
    {schema && <JsonLd schema={schema} />}
    {
      cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
        />
      )
    }
  </head>
  <body class="bg-paper pb-24 text-ink antialiased md:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-3 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <MobileActionBar />
  </body>
</html>

<script>
  import { setupClickTracking } from '../scripts/track';
  setupClickTracking();
</script>

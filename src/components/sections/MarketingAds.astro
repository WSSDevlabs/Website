---
import Container from '../ui/Container.astro';
import Pill from '../ui/Pill.astro';

// Written for WSS DevLabs in our own words. No rankings, partner badges or results are promised here.
const handled = [
  { label: 'Campaign setup', body: 'Accounts, goals, tracking and the first campaigns, set up properly from day one.', icon: 'M16.862 4.487 18.549 2.8a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125' },
  { label: 'Keyword research', body: 'We find the words your customers really type, and the ones that cost less to win.', icon: 'm21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z' },
  { label: 'Ad writing', body: 'Short, honest ads that say what you offer and why someone should call you.', icon: 'M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z' },
  { label: 'Landing pages', body: 'The page people arrive on is shaped to turn a click into an enquiry.', icon: 'M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v3.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 0 1-1.125-1.125v-3.75ZM14.25 8.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v8.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-8.25ZM3.75 16.125c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-2.25Z' },
  { label: 'Budget and bids', body: 'Your daily spend is watched and adjusted, so money is not wasted on the wrong clicks.', icon: 'M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z' },
  { label: 'Monthly reports', body: 'A plain-language summary: what we spent, what it brought in and what we change next.', icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z' }
];

const adTypes = [
  { name: 'Search ads', best: 'Best for: people ready to buy or enquire', body: 'Text ads that appear above or below Google results when someone searches for what you sell. They catch people at the exact moment of need.' },
  { name: 'Display ads', best: 'Best for: staying in sight', body: 'Picture ads shown on websites and apps. They remind people who have already visited you, and introduce you to people who match your customers.' },
  { name: 'Video ads', best: 'Best for: telling your story', body: 'Short videos on YouTube and across the web. Good when a product needs a little explaining, or when you want to build trust through sight and sound.' },
  { name: 'Shopping ads', best: 'Best for: online shops', body: 'Product listings with a photo and a price, shown directly in Google results. Shoppers see what you sell before they even click.' }
];

const promises = [
  { title: 'You see where the money goes', body: 'Every month you get a clear report: what was spent, how many people clicked and what it led to. No jargon, no hiding behind numbers.' },
  { title: 'We aim at results you can measure', body: 'Campaigns are tuned for enquiries and sales, not just clicks. We keep what works, stop what does not, and tell you why.' },
  { title: 'Built around your business', body: 'A small shop and a large company need different plans. We start from your goals and budget, then choose the ad types to match.' }
];
---

<!-- Google Ads: intro + what we handle -->
<section class="bg-white py-16 md:py-24" data-tight>
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-paper-dim px-3.5 py-1.5 text-xs font-semibold text-ink-dim"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Google Ads</span>
      <h2 class="mt-5 font-display text-[clamp(2rem,1.3rem+3vw,3.4rem)] font-bold leading-[1.05] tracking-[-0.035em] text-ink">Be there when people search for what you sell</h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-dim">
        Google Ads puts your business in front of people at the moment they are looking for it. You pay when someone clicks, so every ringgit has a job to do. We set it up, watch it every week and explain the numbers in plain words.
      </p>
    </div>

    <ul class="ads-grid mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        handled.map((item, i) => (
          <li class="ads-tile group flex gap-4 rounded-[1.5rem] bg-paper-dim p-5 transition-colors duration-300 hover:bg-white hover:shadow-[0_18px_40px_-30px_rgba(0,0,0,0.4)] hover:ring-1 hover:ring-black/5" style={`--i:${i}`}>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white text-ink transition-colors duration-300 group-hover:bg-ink group-hover:text-white">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
            </span>
            <span>
              <span class="block text-sm font-bold text-ink">{item.label}</span>
              <span class="mt-1 block text-sm leading-relaxed text-ink-dim">{item.body}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<!-- Ad types (accordion) + what it is like to work with us -->
<section class="bg-paper-dim py-16 md:py-24" data-tight>
  <Container>
    <div class="grid items-start gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
      <div class="rounded-[2rem] bg-white p-6 sm:p-9" data-ads-acc>
        <h3 class="font-display text-2xl font-bold tracking-tight text-ink">Four ways to show up</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-dim">Google Ads is not one thing. We pick the ones that suit your goal, and often start with just one.</p>
        <ul class="mt-6 space-y-2.5">
          {
            adTypes.map((type, i) => (
              <li class="ads-acc-item rounded-[1.25rem] bg-paper-dim transition-colors duration-300" data-open={i === 0 ? 'true' : 'false'}>
                <button type="button" class="flex w-full items-center justify-between gap-4 p-4 text-left sm:p-5" aria-expanded={i === 0 ? 'true' : 'false'} data-ads-toggle>
                  <span>
                    <span class="block text-base font-semibold tracking-tight text-ink">{type.name}</span>
                    <span class="mt-0.5 block text-xs text-ink-dim">{type.best}</span>
                  </span>
                  <span class="ads-chev flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-ink transition-transform duration-300">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
                  </span>
                </button>
                <div class="ads-body grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out">
                  <div class="overflow-hidden"><p class="px-4 pb-5 text-sm leading-relaxed text-ink-dim sm:px-5">{type.body}</p></div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative overflow-hidden rounded-[2rem] bg-charcoal p-6 text-white sm:p-9">
        <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-accent/30 blur-3xl" aria-hidden="true"></div>
        <h3 class="relative font-display text-2xl font-bold tracking-tight">You stay in control</h3>
        <p class="relative mt-2 text-sm leading-relaxed text-white/60">The worst part of advertising is not knowing what happens to your money. We fix that first.</p>
        <ol class="relative mt-7 space-y-5">
          {
            promises.map((item, i) => (
              <li class="flex gap-4">
                <span class="font-feature text-lg font-semibold text-accent">0{i + 1}</span>
                <span>
                  <span class="block text-base font-bold tracking-tight">{item.title}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-white/60">{item.body}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <Pill href="/contact?topic=Google%20Ads" label="Talk about Google Ads" variant="light" class="relative mt-8" />
      </div>
    </div>
  </Container>
</section>

<style is:global>
  .ads-acc-item[data-open='true'] {
    background: var(--color-tint);
  }
  .ads-acc-item[data-open='true'] .ads-body {
    grid-template-rows: 1fr;
  }
  .ads-acc-item[data-open='true'] .ads-chev {
    transform: rotate(180deg);
    background: var(--color-ink);
    color: #fff;
  }
  .ads-tile {
    animation: ads-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 0.07s);
  }
  @keyframes ads-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ads-tile { animation: none; }
    .ads-body, .ads-chev { transition-duration: 0.01ms; }
  }
</style>

<script>
  function initAdsAcc() {
    document.querySelectorAll<HTMLElement>('[data-ads-acc]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const items = Array.from(root.querySelectorAll<HTMLElement>('.ads-acc-item'));
      items.forEach((item) =>
        item.querySelector('[data-ads-toggle]')?.addEventListener('click', () => {
          const open = item.dataset.open !== 'true';
          items.forEach((other) => {
            other.dataset.open = 'false';
            other.querySelector('[data-ads-toggle]')?.setAttribute('aria-expanded', 'false');
          });
          item.dataset.open = String(open);
          item.querySelector('[data-ads-toggle]')?.setAttribute('aria-expanded', String(open));
        })
      );
    });
  }
  document.addEventListener('astro:page-load', initAdsAcc);
</script>

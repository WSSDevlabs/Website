---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import type { Tone } from '../../lib/tone';

type Props = {
  eyebrow?: string;
  eyebrowTone?: Tone;
  title: string;
  /** A word or phrase within `title` to render in the accent color */
  accentWord?: string;
  accentTone?: 'blue' | 'red' | 'yellow' | 'green';
  subtitle: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  /** Use "page" for inner page hero (compact, patterned band) */
  variant?: 'home' | 'page';
};

const {
  eyebrow,
  eyebrowTone = 'blue',
  title,
  accentWord,
  accentTone = 'blue',
  subtitle,
  primaryCta,
  secondaryCta,
  variant = 'home'
} = Astro.props;

const accentClass = {
  blue: 'text-accent',
  red: 'text-accent-red',
  yellow: 'text-accent-yellow',
  green: 'text-accent-green'
}[accentTone];

const titleHtml =
  accentWord && title.includes(accentWord)
    ? title.replace(accentWord, `<span class="${accentClass}">${accentWord}</span>`)
    : title;
---

{
  variant === 'page' ? (
    <section class="relative overflow-hidden">
      <div class="grid-pattern mask-fade-edges absolute inset-0" aria-hidden="true" />
      <div
        class="absolute -top-32 right-[-10%] h-80 w-[36rem] rounded-full bg-accent/8 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute -bottom-24 left-[-8%] h-64 w-[28rem] rounded-full bg-matte/10 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute right-[8%] top-0 hidden h-full w-px bg-gradient-to-b from-transparent via-line to-transparent sm:block"
        aria-hidden="true"
      />
      <Container class="relative py-12 md:py-16">
        {eyebrow && (
          <span data-hero-item data-hero-delay="0" style="display:block">
            <Eyebrow label={eyebrow} tone={eyebrowTone} />
          </span>
        )}
        <h1
          class="h-section mt-5 max-w-3xl !text-[clamp(2.25rem,1.4rem+3vw,3.4rem)]"
          data-split
          set:html={titleHtml}
        />
        <p data-hero-item data-hero-delay="0.12" class="body-lead mt-5">{subtitle}</p>
        <div data-hero-item data-hero-delay="0.22" class="mt-8 flex flex-wrap gap-4">
          <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>
          {secondaryCta && (
            <Button href={secondaryCta.href} variant="secondary">
              {secondaryCta.label}
            </Button>
          )}
        </div>
      </Container>
      <div class="hairline absolute inset-x-0 bottom-0" aria-hidden="true" />
    </section>
  ) : (
    <section class="relative overflow-hidden" data-noreveal>
      <div class="grid-pattern mask-fade-edges absolute inset-0" aria-hidden="true" />
      <div
        class="absolute -top-40 right-[-12%] h-[28rem] w-[42rem] rounded-full bg-accent/10 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute -bottom-32 left-[-10%] h-96 w-[34rem] rounded-full bg-matte/8 blur-3xl"
        aria-hidden="true"
      />
      <!-- Structural accent: a single sharp diagonal cut, like a concrete beam edge crossing the frame -->
      <div
        class="pointer-events-none absolute -right-24 top-0 hidden h-[140%] w-[2px] rotate-[14deg] bg-gradient-to-b from-transparent via-accent/25 to-transparent lg:block"
        aria-hidden="true"
      />
      <Container class="relative grid gap-14 py-14 md:grid-cols-[1.05fr_0.95fr] md:items-center md:py-20">
        <div>
          {eyebrow && (
            <span data-hero-item data-hero-delay="0" style="display:block">
              <Eyebrow label={eyebrow} tone={eyebrowTone} />
            </span>
          )}
          <h1 class="h-display mt-5" data-split set:html={titleHtml} />
          <p data-hero-item data-hero-delay="0.25" class="body-lead mt-6 max-w-xl">{subtitle}</p>
          <div data-hero-item data-hero-delay="0.38" class="mt-9 flex flex-wrap items-center gap-4">
            <Button href={primaryCta.href} variant="primary" size="lg" data-magnetic>
              {primaryCta.label}
              <svg class="h-4 w-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </Button>
            {secondaryCta && (
              <Button href={secondaryCta.href} variant="secondary" size="lg">
                {secondaryCta.label}
              </Button>
            )}
          </div>
        </div>

        <!-- Free quote mini-form, replacing the hero photo -->
        <div data-hero-item data-hero-delay="0.2" class="hidden md:block">
          <div class="rounded-3xl border border-line bg-paper shadow-float">
            <div class="p-7">
              <p class="mono-label text-accent">Free Quotation</p>
              <h2 class="mt-2 text-xl font-bold text-ink">Get your free quote today</h2>

              <form id="hero-quote-form" class="mt-5 space-y-4" novalidate>
                <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY} />
                <input type="hidden" name="subject" value="Free Quote Request (Homepage)" />
                <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

                <div>
                  <label for="hq-name" class="mb-1.5 block text-xs font-semibold text-ink">Your Name</label>
                  <input id="hq-name" name="name" type="text" required placeholder="Full name"
                    class="w-full rounded-xl border border-line bg-paper-dim px-4 py-2.5 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/25" />
                </div>
                <div>
                  <label for="hq-email" class="mb-1.5 block text-xs font-semibold text-ink">Email</label>
                  <input id="hq-email" name="email" type="email" required placeholder="you@company.com"
                    class="w-full rounded-xl border border-line bg-paper-dim px-4 py-2.5 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/25" />
                </div>
                <div>
                  <label for="hq-message" class="mb-1.5 block text-xs font-semibold text-ink">What are you building?</label>
                  <textarea id="hq-message" name="message" rows="2" placeholder="Tell us briefly"
                    class="w-full resize-none rounded-xl border border-line bg-paper-dim px-4 py-2.5 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/25"></textarea>
                </div>

                <button id="hero-quote-submit" type="submit"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-[0_8px_20px_-8px_rgb(217_45_32/0.5)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-accent-dim">
                  <span id="hero-quote-submit-label">Get My Free Quote</span>
                </button>

                <p id="hero-quote-status" role="status" aria-live="polite" class="text-xs"></p>
              </form>
            </div>
          </div>
        </div>
      </Container>
      <div class="hairline absolute inset-x-0 bottom-0" aria-hidden="true" />
    </section>
  )
}

<script>
  function initHeroQuoteForm() {
    const form = document.getElementById('hero-quote-form') as HTMLFormElement | null;
    const submitButton = document.getElementById('hero-quote-submit') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('hero-quote-submit-label');
    const status = document.getElementById('hero-quote-status');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submitButton || !submitLabel || !status) return;

      const botcheck = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
      if (botcheck?.checked) return;

      submitButton.disabled = true;
      submitLabel.textContent = 'Sending…';
      status.textContent = '';
      status.className = 'text-xs';

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData
        });
        const result = await response.json();

        if (result.success) {
          status.textContent = "Thanks! We'll get back to you within one business day.";
          status.classList.add('text-accent-green');
          form.reset();
        } else {
          throw new Error(result.message ?? 'Submission failed');
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again or email us directly.';
        status.classList.add('text-accent-red');
      } finally {
        submitButton.disabled = false;
        submitLabel.textContent = 'Get My Free Quote';
      }
    });
  }

  initHeroQuoteForm();
  document.addEventListener('astro:page-load', initHeroQuoteForm);
</script>

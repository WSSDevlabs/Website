---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import type { Tone } from '../../lib/tone';

type Props = {
  eyebrow?: string;
  eyebrowTone?: Tone;
  title?: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'home' | 'page';
};

const {
  eyebrow = 'Direct with Builders · Zero SaaS Dependency',
  eyebrowTone = 'red',
  title = 'Empowering Businesses Through Custom Tech Solutions',
  subtitle = 'One engineering team behind everything from fixed-price websites to the custom systems running your business, built to last and fully owned by you.',
  primaryCta = { label: 'Explore Marketplace', href: '/marketplace' },
  secondaryCta = { label: 'Talk with us', href: 'https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I%20would%20like%20to%20discuss%20a%20project' },
  variant = 'home'
} = Astro.props;

const stats = [
  { value: '2000+', label: 'Hours Shipped' },
  { value: '40+', label: 'Buy-Once Systems' },
  { value: '10+', label: 'Custom Project Completion' }
];
---

{
  variant === 'page' ? (
    <section class="relative overflow-hidden">
      <div class="grid-pattern mask-fade-edges absolute inset-0" aria-hidden="true" />
      <div
        class="absolute -top-32 right-[-10%] h-80 w-[36rem] rounded-full bg-accent/8 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute -bottom-24 left-[-8%] h-64 w-[28rem] rounded-full bg-matte/10 blur-3xl"
        aria-hidden="true"
      />
      <Container class="relative py-12 md:py-16">
        {eyebrow && (
          <span data-hero-item data-hero-delay="0" style="display:block">
            <Eyebrow label={eyebrow} tone={eyebrowTone} />
          </span>
        )}
        <h1
          class="h-section mt-5 max-w-3xl !text-[clamp(2.25rem,1.4rem+3vw,3.4rem)]"
          data-split
        >
          {title}
        </h1>
        <p data-hero-item data-hero-delay="0.12" class="body-lead mt-5">{subtitle}</p>
        <div data-hero-item data-hero-delay="0.22" class="mt-8 flex flex-wrap gap-4">
          <a href={primaryCta.href} class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-bold text-white shadow-md transition-all hover:bg-black hover:scale-105">
            {primaryCta.label}
          </a>
          {secondaryCta && (
            <a href={secondaryCta.href} class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-white px-6 py-3 text-sm font-semibold text-ink transition-all hover:bg-paper-dim hover:scale-105">
              {secondaryCta.label}
            </a>
          )}
        </div>
      </Container>
      <div class="hairline absolute inset-x-0 bottom-0" aria-hidden="true" />
    </section>
  ) : (
    <section class="relative overflow-hidden pt-8 pb-14 md:pt-32 md:pb-20" data-noreveal>
      <div
        class="absolute -top-40 right-[-10%] h-[32rem] w-[46rem] rounded-full bg-accent-blue/10 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute top-1/2 left-[-15%] h-96 w-[36rem] rounded-full bg-paper-dim blur-3xl"
        aria-hidden="true"
      />
      <div class="grid-pattern-blue mask-fade-edges absolute inset-0 opacity-15" aria-hidden="true" />

      <Container class="relative">
        {/* Two-Column Hero: Text Left, Visual Right */}
        <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
          {/* Left: Copy & CTAs */}
          <div data-hero-item data-hero-delay="0" class="text-center lg:text-left">
            <h1 class="h-display font-black tracking-tight text-ink">
              Empowering Businesses Through <span class="badge-highlight">Custom Tech Solutions</span>
            </h1>

            <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg lg:mx-0 mx-auto">
              {subtitle}
            </p>
          </div>

          {/* Right: Visual Composition + CTAs */}
          <div data-hero-item data-hero-delay="0.15" class="relative mx-auto w-full max-w-md lg:max-w-none">
            {/* Image placeholder */}
            <div class="relative mx-auto aspect-[4/3] sm:aspect-[16/11] w-full overflow-hidden rounded-3xl border border-line bg-gradient-to-b from-paper-dim via-paper to-white shadow-[0_20px_60px_-15px_rgba(25,25,27,0.12)]">
              <div class="flex h-full items-center justify-center bg-paper-dim">
                <svg class="h-16 w-16 text-ink-dim/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3 16.5V4.5a1.5 1.5 0 0 1 1.5-1.5h15a1.5 1.5 0 0 1 1.5 1.5v15a1.5 1.5 0 0 1-1.5 1.5h-15a1.5 1.5 0 0 1-1.5-1.5Zm10.5-11.25h.008v.008h-.008V5.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap justify-center gap-4">
              <a
                href={primaryCta.href}
                class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white shadow-md transition-all hover:bg-black hover:scale-105"
              >
                {primaryCta.label}
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              {secondaryCta && (
                <a
                  href={secondaryCta.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-white px-6 py-3.5 text-sm font-semibold text-ink transition-all hover:bg-paper-dim hover:scale-105"
                >
                  {secondaryCta.label}
                </a>
              )}
            </div>
          </div>
        </div>

        {/* Floating Stats Bar Pill Container */}
        <div class="mt-12 sm:mt-16 mx-auto max-w-4xl">
          <div class="rounded-3xl border border-line bg-white text-ink p-6 sm:px-10 sm:py-7 shadow-card">
            <div class="mx-auto max-w-xl text-center">
              <h2 class="text-sm font-bold uppercase tracking-wide text-accent">Who we are</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink-dim">
                WSS DevLabs is a Malaysian software studio building fixed-price websites, buy-once business systems, and custom enterprise software for growing companies.
              </p>
            </div>

            <div class="mt-6 grid grid-cols-1 gap-6 border-t border-line pt-6 sm:grid-cols-3 sm:divide-x sm:divide-line text-center">
              {stats.map((s, idx) => (
                <div class:list={['flex flex-col items-center justify-center', idx > 0 && 'sm:pl-6']}>
                  <span class="font-feature text-2xl sm:text-3xl font-black text-ink tracking-tight">{s.value}</span>
                  <span class="mt-1 text-[11px] sm:text-xs text-ink-dim font-medium">{s.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

      </Container>
    </section>
  )
}

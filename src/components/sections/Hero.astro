---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import type { Tone } from '../../lib/tone';

type Props = {
  eyebrow?: string;
  eyebrowTone?: Tone;
  title?: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'home' | 'page';
};

const {
  eyebrow = 'Direct with Builders · Zero SaaS Dependency',
  eyebrowTone = 'red',
  title = 'Empowering Businesses Through Custom Tech Solutions',
  subtitle = 'From RM 180 fixed-price web packages and Buy-Once production systems to bespoke enterprise software.',
  primaryCta = { label: 'Explore Marketplace', href: '/marketplace' },
  secondaryCta = { label: 'WhatsApp an Engineer', href: 'https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I%20would%20like%20to%20discuss%20a%20project' },
  variant = 'home'
} = Astro.props;

const stats = [
  { value: '2000+', label: 'Hours Shipped' },
  { value: '10+', label: 'Years Engineering Experience' },
  { value: '6+', label: 'Buy-Once Systems' },
  { value: 'RM 5M+', label: 'Client Value Generated' }
];
---

{
  variant === 'page' ? (
    <section class="relative overflow-hidden">
      <div class="grid-pattern mask-fade-edges absolute inset-0" aria-hidden="true" />
      <div
        class="absolute -top-32 right-[-10%] h-80 w-[36rem] rounded-full bg-accent/8 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute -bottom-24 left-[-8%] h-64 w-[28rem] rounded-full bg-matte/10 blur-3xl"
        aria-hidden="true"
      />
      <Container class="relative py-12 md:py-16">
        {eyebrow && (
          <span data-hero-item data-hero-delay="0" style="display:block">
            <Eyebrow label={eyebrow} tone={eyebrowTone} />
          </span>
        )}
        <h1
          class="h-section mt-5 max-w-3xl !text-[clamp(2.25rem,1.4rem+3vw,3.4rem)]"
          data-split
        >
          {title}
        </h1>
        <p data-hero-item data-hero-delay="0.12" class="body-lead mt-5">{subtitle}</p>
        <div data-hero-item data-hero-delay="0.22" class="mt-8 flex flex-wrap gap-4">
          <a href={primaryCta.href} class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-bold text-white shadow-md transition-all hover:bg-black hover:scale-105">
            {primaryCta.label}
          </a>
          {secondaryCta && (
            <a href={secondaryCta.href} class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-white px-6 py-3 text-sm font-semibold text-ink transition-all hover:bg-paper-dim hover:scale-105">
              {secondaryCta.label}
            </a>
          )}
        </div>
      </Container>
      <div class="hairline absolute inset-x-0 bottom-0" aria-hidden="true" />
    </section>
  ) : (
    <section class="relative overflow-hidden pt-8 pb-14 md:pt-32 md:pb-20" data-noreveal>
      <div class="grid-pattern mask-fade-edges absolute inset-0 opacity-25" aria-hidden="true" />
      <div
        class="absolute -top-40 right-[-10%] h-[32rem] w-[46rem] rounded-full bg-paper-dim blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute top-1/2 left-[-15%] h-96 w-[36rem] rounded-full bg-paper-dim blur-3xl"
        aria-hidden="true"
      />

      <Container class="relative">
        {/* Top decorative star and heading banner */}
        <div class="mx-auto max-w-4xl text-center">
          {/* Main Heavy Geometric Title */}
          <h1 class="h-display font-black tracking-tight text-ink">
            Empowering Businesses Through <span class="badge-highlight">Custom Tech Solutions</span>
          </h1>
        </div>

        {/* Center Hero Visual Composition with Arched Backing & Floating Cards */}
        <div class="relative mx-auto mt-12 max-w-3xl">
          {/* Arched Frame Container */}
          <div class="relative mx-auto aspect-[4/3] sm:aspect-[16/11] w-full max-w-2xl overflow-hidden rounded-t-[10rem] sm:rounded-t-[16rem] rounded-b-3xl border border-line bg-gradient-to-b from-paper-dim via-paper to-white shadow-[0_20px_60px_-15px_rgba(25,25,27,0.12)]">
            {/* Abstract identity composition (no stock photo) */}
            <div class="grid-pattern mask-fade-edges absolute inset-0 opacity-40" aria-hidden="true"></div>
            <div class="absolute -top-16 right-0 h-72 w-72 rounded-full bg-accent/12 blur-3xl" aria-hidden="true"></div>
            <div class="absolute -bottom-16 left-0 h-72 w-72 rounded-full bg-accent-blue/10 blur-3xl" aria-hidden="true"></div>
            <div class="relative flex h-full flex-col items-center justify-center gap-4 px-8 text-center">
              <span class="flex h-20 w-20 items-center justify-center rounded-3xl bg-white text-ink shadow-float ring-1 ring-line/80">
                <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                </svg>
              </span>
              <p class="font-display text-lg font-bold text-ink">Built Direct, Not Outsourced</p>
              <p class="max-w-xs text-sm text-ink-dim">Every project engineered end-to-end by the same builder you talk to.</p>
            </div>

            {/* Top Left Mini Floating Badge */}
            <div class="absolute top-10 left-6 sm:top-14 sm:left-10 z-20 hidden sm:flex items-center gap-2 rounded-full border border-black/10 bg-white/95 px-4 py-2 text-xs font-bold text-ink shadow-float backdrop-blur-md">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>100% Malaysian Built</span>
            </div>

            {/* Top Right Rating Badge */}
            <div class="absolute top-10 right-6 sm:top-14 sm:right-10 z-20 flex flex-col items-end rounded-2xl border border-black/10 bg-white/95 p-3 sm:px-4 sm:py-3 shadow-float backdrop-blur-md">
              <div class="flex items-center gap-1 text-amber-500">
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              </div>
              <span class="mt-1 font-display text-sm font-extrabold text-ink">10+ Years</span>
              <span class="text-[10px] font-medium text-ink-dim">Engineering Experience</span>
            </div>

            {/* Floating Pill CTA Dock at Bottom of Photo */}
            <div class="absolute bottom-6 inset-x-0 z-20 flex justify-center px-4">
              <div class="flex items-center gap-2 rounded-full border border-black/10 bg-white/95 p-1.5 shadow-2xl backdrop-blur-xl">
                <a
                  href={primaryCta.href}
                  class="rounded-full bg-ink px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-md transition-all hover:bg-black hover:scale-105"
                >
                  {primaryCta.label}
                </a>
                <a
                  href={secondaryCta.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full border border-line bg-paper-dim px-5 py-2.5 text-xs sm:text-sm font-semibold text-ink transition-all hover:bg-paper-deep hover:scale-105"
                >
                  {secondaryCta.label}
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Floating Stats Bar Pill Container */}
        <div class="mt-12 sm:mt-16 mx-auto max-w-4xl">
          <div class="rounded-3xl sm:rounded-full border border-line bg-white text-ink p-6 sm:px-10 sm:py-7 shadow-card">
            <div class="grid grid-cols-2 gap-6 sm:grid-cols-4 sm:divide-x sm:divide-line text-center">
              {stats.map((s, idx) => (
                <div class:list={['flex flex-col items-center justify-center', idx > 0 && 'sm:pl-6']}>
                  <span class="font-feature text-2xl sm:text-3xl font-black text-ink tracking-tight">{s.value}</span>
                  <span class="mt-1 text-[11px] sm:text-xs text-ink-dim font-medium">{s.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

      </Container>
    </section>
  )
}

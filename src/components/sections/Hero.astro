---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import type { Tone } from '../../lib/tone';
import { PRIMARY_CTA } from '../../data/nav';
import { PUBLIC_SYSTEMS } from '../../data/systems';
import { RENT_VS_OWN, SYSTEM_EXTRAS, SYSTEM_TIERS, formatRM, subscriptionTotal } from '../../data/catalog';

type Props = {
  eyebrow?: string;
  eyebrowTone?: Tone;
  title?: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'home' | 'page';
};

const {
  eyebrow = 'Fixed price · Full source code · No monthly rent',
  eyebrowTone = 'red',
  title = 'Software you own. Not rent.',
  subtitle = 'Fixed-price websites and ready-made business systems for Malaysian SMEs. Full source code, no monthly SaaS fees.',
  primaryCta = { label: 'Get a fixed quote', href: PRIMARY_CTA.href },
  secondaryCta = { label: 'See systems', href: '/systems/' },
  variant = 'home'
} = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href);

// Founder-supplied project count; confirm it stays true. Everything else is a fact about the offer.
const stats = [
  { value: String(PUBLIC_SYSTEMS.length), label: 'Ready-made systems' },
  { value: '10+', label: 'Custom projects delivered' },
  { value: 'RM0', label: 'Monthly licence fees' }
];

const standardLicence = SYSTEM_TIERS.standard.price;
const installation = SYSTEM_EXTRAS.installation.price;
const years = RENT_VS_OWN.months / 12;
---

{
  variant === 'page' ? (
    <section class="relative overflow-hidden">
      <div class="grid-pattern mask-fade-edges absolute inset-0" aria-hidden="true" />
      <div
        class="absolute -top-32 right-[-10%] h-80 w-[36rem] rounded-full bg-accent/8 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute -bottom-24 left-[-8%] h-64 w-[28rem] rounded-full bg-matte/10 blur-3xl"
        aria-hidden="true"
      />
      <Container class="relative py-12 md:py-16">
        {eyebrow && (
          <span data-hero-item data-hero-delay="0" style="display:block">
            <Eyebrow label={eyebrow} tone={eyebrowTone} />
          </span>
        )}
        <h1
          class="h-section mt-5 max-w-3xl !text-[clamp(2.25rem,1.4rem+3vw,3.4rem)]"
          data-split
        >
          {title}
        </h1>
        <p data-hero-item data-hero-delay="0.12" class="body-lead mt-5">{subtitle}</p>
        <div data-hero-item data-hero-delay="0.22" class="mt-8 flex flex-wrap gap-4">
          <a href={primaryCta.href} class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-bold text-white shadow-md transition-all hover:bg-black hover:scale-105">
            {primaryCta.label}
          </a>
          {secondaryCta && (
            <a href={secondaryCta.href} class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-white px-6 py-3 text-sm font-semibold text-ink transition-all hover:bg-paper-dim hover:scale-105">
              {secondaryCta.label}
            </a>
          )}
        </div>
      </Container>
      <div class="hairline absolute inset-x-0 bottom-0" aria-hidden="true" />
    </section>
  ) : (
    <section class="relative overflow-hidden pt-8 pb-14 md:pt-32 md:pb-20" data-noreveal>
      <div
        class="absolute -top-40 right-[-10%] h-[32rem] w-[46rem] rounded-full bg-accent-blue/10 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="absolute top-1/2 left-[-15%] h-96 w-[36rem] rounded-full bg-paper-dim blur-3xl"
        aria-hidden="true"
      />
      <div class="grid-pattern-blue mask-fade-edges absolute inset-0 opacity-15" aria-hidden="true" />

      <Container class="relative">
        {/* Two-Column Hero: Text Left, Visual Right */}
        <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
          {/* Left: Copy & CTAs */}
          <div data-hero-item data-hero-delay="0" class="text-center lg:text-left">
            <h1 class="h-display font-black tracking-tight text-ink">
              Software you own. <span class="badge-highlight">Not rent.</span>
            </h1>

            <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg lg:mx-0 mx-auto">
              {subtitle}
            </p>
          </div>

          {/* Right: Visual Composition + CTAs */}
          <div data-hero-item data-hero-delay="0.15" class="relative mx-auto flex w-full max-w-md flex-col lg:max-w-none">
            {/* Rent vs own, worked out on a point-of-sale system. On phones the buttons come first, so one is visible without scrolling. */}
            <div class="relative order-2 mx-auto w-full overflow-hidden rounded-3xl border border-line bg-gradient-to-b from-paper-dim via-paper to-white shadow-[0_20px_60px_-15px_rgba(25,25,27,0.12)] lg:order-1">
              <div class="flex h-full flex-col justify-center gap-4 p-6 sm:p-8">
                <p class="mono-label text-ink-dim">A point-of-sale system over {years} years</p>

                <div class="rounded-2xl border border-line bg-white p-5 shadow-sm">
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm font-semibold text-ink-dim">Renting (subscription)</p>
                    <p class="font-feature text-2xl font-black text-ink">{formatRM(subscriptionTotal)}</p>
                  </div>
                  <p class="mt-1 text-xs text-ink-dim">
                    {formatRM(RENT_VS_OWN.subscriptionMonthly)}/month for {RENT_VS_OWN.months} months, and it stops if you stop paying.
                  </p>
                </div>

                <div class="rounded-2xl border border-accent/30 bg-white p-5 shadow-sm ring-1 ring-accent/10">
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm font-semibold text-ink-dim">Owning (WSS POS)</p>
                    <p class="font-feature text-2xl font-black text-accent">{formatRM(standardLicence + installation)}</p>
                  </div>
                  <p class="mt-1 text-xs text-ink-dim">
                    {formatRM(standardLicence)} licence + {formatRM(installation)} installation, plus your own hosting. It keeps running.
                  </p>
                </div>

                <p class="text-[11px] leading-relaxed text-ink-dim">
                  Subscription figure from a published Malaysian POS entry plan, checked {RENT_VS_OWN.checked}. Subscriptions include
                  hosting and support; owning means you choose your host and can add a Care Plan.{' '}
                  <a href="/systems/#calculator" class="font-semibold text-ink underline hover:text-accent">Try it with your numbers</a>.
                </p>
              </div>
            </div>

            <div class="order-1 mb-8 flex flex-wrap justify-center gap-4 lg:order-2 lg:mb-0 lg:mt-6">
              <a
                href={primaryCta.href}
                data-track="quote_click"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white shadow-md transition-all hover:bg-black hover:scale-105"
              >
                {primaryCta.label}
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              {secondaryCta && (
                <a
                  href={secondaryCta.href}
                  {...(isExternal(secondaryCta.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-white px-6 py-3.5 text-sm font-semibold text-ink transition-all hover:bg-paper-dim hover:scale-105"
                >
                  {secondaryCta.label}
                </a>
              )}
            </div>
          </div>
        </div>

        {/* Floating Stats Bar Pill Container */}
        <div class="mt-12 sm:mt-16 mx-auto max-w-4xl">
          <div class="rounded-3xl border border-line bg-white text-ink p-6 sm:px-10 sm:py-7 shadow-card">
            <div class="mx-auto max-w-xl text-center">
              <h2 class="text-sm font-bold uppercase tracking-wide text-accent">Who we are</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink-dim">
                WSS DevLabs is a founder-led Malaysian software studio. Razali builds fixed-price websites, ready-made business
                systems and custom software for SMEs, then hands over the code so you own it.{' '}
                <a href="/about/" class="font-semibold text-ink underline hover:text-accent">Meet the founder</a>.
              </p>
            </div>

            <div class="mt-6 grid grid-cols-1 gap-6 border-t border-line pt-6 sm:grid-cols-3 sm:divide-x sm:divide-line text-center">
              {stats.map((s, idx) => (
                <div class:list={['flex flex-col items-center justify-center', idx > 0 && 'sm:pl-6']}>
                  <span class="font-feature text-2xl sm:text-3xl font-black text-ink tracking-tight">{s.value}</span>
                  <span class="mt-1 text-[11px] sm:text-xs text-ink-dim font-medium">{s.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

      </Container>
    </section>
  )
}

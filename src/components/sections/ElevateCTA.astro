---
import Container from '../ui/Container.astro';
import { REPLY_PROMISE } from '../../data/catalog';

const steps = [
  { n: '01', title: 'Tell us what you need', detail: 'WhatsApp, email or the form. Two minutes is enough.' },
  { n: '02', title: 'Get a fixed quote', detail: 'A written price, scope and timeline within three business days.' },
  { n: '03', title: 'We build and hand over everything', detail: 'Code, logins and domain are yours once you have paid in full.' }
];
---

<section class="py-16 md:py-24 bg-paper overflow-hidden border-t border-line/60">
  <Container>
    <div class="relative overflow-hidden rounded-[3rem] bg-paper-dim border border-line text-ink p-8 sm:p-14 lg:p-16 shadow-lg">
      <!-- Ambient Subtle Glow in Background -->
      <div class="absolute -top-32 right-1/4 h-80 w-80 rounded-full bg-paper-deep/60 blur-3xl pointer-events-none"></div>

      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <!-- Left: Headline + Input Pill Form -->
        <div class="relative z-10">
          <h2 class="h-section font-black tracking-tight text-ink max-w-xl">
            Tell us what <span class="badge-highlight">you need.</span>
          </h2>

          <p class="mt-4 text-sm sm:text-base leading-relaxed text-ink-dim max-w-lg">
            {REPLY_PROMISE} No obligation, and no sales team in between: you talk to the person who will build it.
          </p>

          <!-- Email / WhatsApp Input Form with Pill Button -->
          <form id="elevate-cta-form" class="mt-8 flex flex-col sm:flex-row items-stretch gap-3 max-w-md" novalidate>
            <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY} />
            <input type="hidden" name="subject" value="Homepage quote request" />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

            <label for="cta-contact-input" class="sr-only">Your email or WhatsApp number</label>
            <input
              id="cta-contact-input"
              name="contact"
              type="text"
              required
              autocomplete="email"
              placeholder="Your email or WhatsApp number"
              class="w-full rounded-full border border-line bg-white px-5 py-3.5 text-sm text-ink placeholder:text-ink-dim/60 focus:border-ink focus:outline-none shadow-sm"
            />

            <button
              id="cta-submit-btn"
              type="submit"
              class="shrink-0 inline-flex items-center justify-center gap-2 rounded-full bg-ink px-7 py-3.5 text-sm font-bold text-white shadow-md transition hover:bg-black hover:scale-105"
            >
              <span id="cta-submit-label">Get a fixed quote</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </button>
          </form>

          <p id="cta-form-status" role="status" aria-live="polite" class="mt-3 text-xs text-ink-dim"></p>
          <p class="mt-2 text-[11px] text-ink-dim">
            We only use your details to reply to you. See our <a href="/privacy/" class="underline hover:text-accent">Privacy Notice</a>.
          </p>
        </div>

        <!-- Right: How it works -->
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative w-full max-w-sm rounded-3xl overflow-hidden border border-line shadow-xl bg-paper-dim">
            <div class="dot-pattern mask-fade-edges absolute inset-0 opacity-60" aria-hidden="true"></div>
            <div class="absolute top-1/3 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>

            <div class="relative p-7 sm:p-8">
              <p class="mono-label text-ink-dim">How it works</p>
              <ol class="mt-5 space-y-5">
                {
                  steps.map((step) => (
                    <li class="flex items-start gap-4">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink font-mono text-xs font-bold text-white">
                        {step.n}
                      </span>
                      <div>
                        <p class="font-bold text-ink">{step.title}</p>
                        <p class="mt-1 text-sm leading-relaxed text-ink-dim">{step.detail}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import { track } from '../../scripts/track';

  function initElevateCTA() {
    const form = document.getElementById('elevate-cta-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('cta-submit-btn') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('cta-submit-label');
    const status = document.getElementById('cta-form-status');
    if (!form || !submitBtn || !submitLabel || !status || form.dataset.bound) return;
    form.dataset.bound = '1';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const botcheck = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
      if (botcheck?.checked) return;

      const contact = form.querySelector<HTMLInputElement>('input[name="contact"]');
      if (!contact?.value.trim()) {
        status.textContent = 'Please add your email or WhatsApp number so we can reply.';
        status.className = 'mt-3 text-xs text-accent-red';
        contact?.focus();
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending...';
      status.textContent = '';
      status.className = 'mt-3 text-xs text-ink-dim';

      try {
        const formData = new FormData(form);
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData
        });
        const result = await res.json();
        if (result.success) {
          status.textContent = "Thank you. We'll reply within one business day.";
          status.classList.add('text-emerald-700');
          track('form_submit', { form: 'homepage' });
          form.reset();
        } else {
          throw new Error(result.message);
        }
      } catch {
        status.textContent = 'That did not send. Please WhatsApp or email us directly instead.';
        status.classList.add('text-accent-red');
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = 'Get a fixed quote';
      }
    });
  }

  initElevateCTA();
  document.addEventListener('astro:page-load', initElevateCTA);
</script>

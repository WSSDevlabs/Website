---
import Container from '../ui/Container.astro';
import { AI_WHATSAPP, LOCAL_SEO_SETUP, WEBSITE_PACKAGES, formatRM } from '../../data/catalog';
import { SITE } from '../../data/site';

/**
 * Website quote builder. Every price is read from the catalogue at build time,
 * so the calculator can never disagree with the package cards.
 */
type Row = {
  id: string;
  name: string;
  solves: string;
  /** Price per package id. Missing means "not offered on that package". */
  prices: Partial<Record<string, number>>;
  /** Shown instead of a price when a package already includes it. */
  includedIn?: string[];
  perPage?: boolean;
  monthly?: number;
};

const rows: Row[] = [
  {
    id: 'extra-page',
    name: 'Extra page',
    solves: 'Room for one more service or landing page.',
    prices: { 'one-page': 219, business: 219 },
    perPage: true
  },
  {
    id: 'copywriting',
    name: 'Copywriting',
    solves: "We write the words for you, the number one cause of website delays.",
    prices: { 'one-page': 149, business: 149, store: 149 },
    perPage: true
  },
  {
    id: 'bilingual',
    name: 'Bahasa Malaysia + English',
    solves: 'Reach customers who prefer Bahasa Malaysia.',
    prices: { business: 749, store: 1119 }
  },
  {
    id: 'payment-gateway',
    name: 'Payment gateway',
    solves: 'Take deposits or bookings online.',
    prices: { business: 369 },
    includedIn: ['store']
  },
  {
    id: 'local-seo',
    name: 'Local SEO Setup',
    solves: 'Show up in Google Maps and "near me" searches. No ranking guarantees: nobody controls Google.',
    prices: { 'one-page': LOCAL_SEO_SETUP.price, business: LOCAL_SEO_SETUP.price, store: LOCAL_SEO_SETUP.price }
  },
  {
    id: 'ai-whatsapp',
    name: 'AI WhatsApp Assistant',
    solves: 'Answers common questions 24/7 and collects leads while you sleep.',
    prices: { 'one-page': AI_WHATSAPP.setup, business: AI_WHATSAPP.setup, store: AI_WHATSAPP.setup },
    monthly: AI_WHATSAPP.monthly
  }
];

const defaultPackage = WEBSITE_PACKAGES.find((p) => p.badge) ?? WEBSITE_PACKAGES[0];
const config = JSON.stringify({
  packages: WEBSITE_PACKAGES.map((p) => ({ id: p.id, name: p.name, price: p.price, timeline: p.timeline })),
  rows: rows.map(({ id, name, prices, includedIn = [], perPage = false, monthly = 0 }) => ({ id, name, prices, includedIn, perPage, monthly })),
  whatsapp: SITE.whatsapp.replace(/\D/g, '')
});
---

<section class="relative overflow-hidden bg-paper-dim/40 py-16 md:py-24 border-y border-line" id="calculator">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        Build your website quote
      </h2>
      <p class="mt-3 text-sm text-ink-dim">
        Pick a package, add what you need, and send the total to us. Every price here is the published price, with no SST added.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="mx-auto mt-12 max-w-4xl rounded-3xl border border-line bg-paper p-6 shadow-xl md:p-10" data-website-calculator data-config={config}>
      <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr]">
        <!-- Left Options -->
        <div class="space-y-6">
          <!-- Step 1: Select Package -->
          <div>
            <label for="website-package-select" class="font-mono text-xs font-bold uppercase tracking-wider text-accent">
              01. Choose your website:
            </label>
            <select
              id="website-package-select"
              data-input="package"
              class="mt-2 w-full rounded-xl border border-line bg-paper-dim px-4 py-3 text-sm font-semibold text-ink transition focus:border-accent focus:outline-none"
            >
              {
                WEBSITE_PACKAGES.map((pkg) => (
                  <option value={pkg.id} selected={pkg.id === defaultPackage.id}>
                    {pkg.name}, {formatRM(pkg.price)}
                  </option>
                ))
              }
            </select>
          </div>

          <!-- Step 2: Add-Ons -->
          <div>
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-ink">
              02. Add what you need:
            </p>
            <div class="mt-3 space-y-2.5">
              {
                rows.map((row) => {
                  const basePrice = Object.values(row.prices)[0] ?? 0;
                  return (
                    <div data-row={row.id} class="flex items-center justify-between gap-3 rounded-xl border border-line bg-paper-dim/40 p-3 text-xs transition hover:bg-paper-dim">
                      <label class="flex flex-1 cursor-pointer items-start gap-2.5">
                        {row.perPage ? (
                          <select
                            data-input={row.id}
                            aria-label={`${row.name}: number of pages`}
                            class="mt-0.5 rounded-lg border border-line bg-white px-1.5 py-1 text-xs font-semibold text-ink"
                          >
                            {Array.from({ length: 11 }, (_, n) => (
                              <option value={n}>{n}</option>
                            ))}
                          </select>
                        ) : (
                          <input type="checkbox" data-input={row.id} class="mt-0.5 rounded border-line text-accent" />
                        )}
                        <span>
                          <span class="block font-medium text-ink">{row.name}</span>
                          <span class="mt-0.5 block text-[11px] leading-relaxed text-ink-dim">{row.solves}</span>
                          <span class="mt-0.5 hidden text-[11px] font-semibold text-accent" data-row-note></span>
                        </span>
                      </label>
                      <span class="shrink-0 text-right font-bold text-ink">
                        <span data-row-price>{row.perPage ? `${formatRM(basePrice)}/page` : `+${formatRM(basePrice)}`}</span>
                        {row.monthly && <span class="block text-[10px] font-medium text-ink-dim">+ {formatRM(row.monthly)}/month</span>}
                      </span>
                    </div>
                  );
                })
              }
            </div>
            <p class="mt-3 text-[11px] text-ink-dim">
              The AI WhatsApp Assistant also has Meta's per-conversation fees, passed through at cost.
            </p>
          </div>
        </div>

        <!-- Right Summary & Quotation -->
        <div class="flex flex-col justify-between rounded-2xl border border-line bg-ink p-6 text-white shadow-xl">
          <div>
            <div class="flex items-center justify-between border-b border-white/10 pb-3 font-mono text-xs text-white/50">
              <span>YOUR ESTIMATE</span>
              <span class="text-emerald-400">● Published prices</span>
            </div>

            <!-- Price Calculations -->
            <div class="mt-4 space-y-2 text-xs" aria-live="polite">
              <div class="flex justify-between text-white/70">
                <span>Website:</span>
                <span class="font-mono text-white" data-output="base">{formatRM(defaultPackage.price)}</span>
              </div>
              <div class="flex justify-between text-white/70">
                <span>Add-ons:</span>
                <span class="font-mono text-white" data-output="addons">{formatRM(0)}</span>
              </div>
              <div class="hidden justify-between text-white/70" data-output="monthly-row">
                <span>Monthly:</span>
                <span class="font-mono text-white" data-output="monthly"></span>
              </div>
            </div>

            <!-- Final Total -->
            <div class="mt-6 border-t border-white/10 pt-4">
              <span class="text-[11px] font-mono uppercase tracking-wider text-white/50">One-time total:</span>
              <div class="mt-1 flex items-baseline gap-2">
                <span class="font-feature text-3xl font-extrabold text-white sm:text-4xl" data-output="total">
                  {formatRM(defaultPackage.price)}
                </span>
                <span class="text-xs text-accent-yellow-vivid font-mono" data-output="timeline">{defaultPackage.timeline}</span>
              </div>
            </div>

            <div class="mt-4 rounded-xl border border-white/10 bg-white/5 p-3 text-[11px] text-white/60">
              <p>✓ Your domain is registered in your name</p>
              <p>✓ You own the design, code and content once paid</p>
              <p>✓ Final price, no SST added</p>
            </div>
          </div>

          <!-- Instant Action -->
          <div class="mt-6 pt-4 border-t border-white/10">
            <a
              data-output="whatsapp"
              data-track="calculator_whatsapp"
              href={`https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 text-xs font-semibold text-white shadow-lg shadow-accent/30 transition hover:bg-accent-dim"
            >
              <span>WhatsApp this quote to us</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
            <p class="mt-2 text-center text-[10px] text-white/50">An estimate from published prices. Your written quote confirms the final scope.</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  type Config = {
    packages: { id: string; name: string; price: number; timeline: string }[];
    rows: { id: string; name: string; prices: Record<string, number>; includedIn: string[]; perPage: boolean; monthly: number }[];
    whatsapp: string;
  };

  const format = (amount: number) => `RM${Math.round(amount).toLocaleString('en-MY')}`;

  function initWebsiteCalculator() {
    const calc = document.querySelector<HTMLElement>('[data-website-calculator]');
    if (!calc || calc.dataset.bound || !calc.dataset.config) return;
    calc.dataset.bound = '1';
    const config = JSON.parse(calc.dataset.config) as Config;

    const input = (id: string) => calc.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-input="${id}"]`);
    const output = (id: string) => calc.querySelector<HTMLElement>(`[data-output="${id}"]`);

    const recalculate = () => {
      const pkgId = input('package')?.value ?? config.packages[0].id;
      const pkg = config.packages.find((p) => p.id === pkgId) ?? config.packages[0];

      let addons = 0;
      let monthly = 0;
      const chosen: string[] = [];

      config.rows.forEach((row) => {
        const el = input(row.id);
        const rowEl = calc.querySelector<HTMLElement>(`[data-row="${row.id}"]`);
        const note = rowEl?.querySelector<HTMLElement>('[data-row-note]');
        const priceEl = rowEl?.querySelector<HTMLElement>('[data-row-price]');
        if (!el || !rowEl) return;

        const price = row.prices[pkg.id];
        const included = row.includedIn.includes(pkg.id);

        if (price === undefined || included) {
          el.disabled = true;
          rowEl.classList.add('opacity-50');
          if (el instanceof HTMLInputElement) el.checked = false;
          else el.value = '0';
          if (note) {
            note.textContent = included ? `Already included in the ${pkg.name}` : `Not offered on the ${pkg.name}`;
            note.classList.remove('hidden');
          }
          return;
        }

        el.disabled = false;
        rowEl.classList.remove('opacity-50');
        note?.classList.add('hidden');
        if (priceEl) priceEl.textContent = row.perPage ? `${format(price)}/page` : `+${format(price)}`;

        const quantity = el instanceof HTMLInputElement ? (el.checked ? 1 : 0) : Number(el.value) || 0;
        if (quantity > 0) {
          addons += price * quantity;
          monthly += row.monthly * quantity;
          chosen.push(row.perPage ? `${row.name} x${quantity}` : row.name);
        }
      });

      const total = pkg.price + addons;
      output('base')!.textContent = format(pkg.price);
      output('addons')!.textContent = format(addons);
      output('total')!.textContent = format(total);
      output('timeline')!.textContent = pkg.timeline;
      const monthlyRow = output('monthly-row');
      monthlyRow?.classList.toggle('hidden', monthly === 0);
      monthlyRow?.classList.toggle('flex', monthly > 0);
      if (monthly > 0) output('monthly')!.textContent = `${format(monthly)}/month`;

      const message = [
        "Hi WSS DevLabs, I built a website quote on your site:",
        `- Package: ${pkg.name} (${format(pkg.price)})`,
        `- Add-ons: ${chosen.length ? chosen.join(', ') : 'None'}`,
        `- One-time total: ${format(total)}${monthly ? ` + ${format(monthly)}/month` : ''}`,
        '',
        'Could you confirm the scope and timeline?'
      ].join('\n');
      (output('whatsapp') as HTMLAnchorElement).href = `https://wa.me/${config.whatsapp}?text=${encodeURIComponent(message)}`;
    };

    calc.addEventListener('change', recalculate);
    recalculate();
  }

  initWebsiteCalculator();
  document.addEventListener('astro:page-load', initWebsiteCalculator);
</script>

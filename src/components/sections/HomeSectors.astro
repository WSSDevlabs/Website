---
import Container from '../ui/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import { SECTORS } from '../../data/sectors';

// Centre card is in colour; the others sit back in metallic grey. Click or hover a card to bring it forward.
const start = Math.floor(SECTORS.length / 2);
---

<section class="relative overflow-hidden bg-charcoal-soft py-20 text-white md:py-28" data-tight data-sector-deck>
  <div class="pointer-events-none absolute inset-0 opacity-60" style="background: radial-gradient(60% 50% at 50% 55%, rgb(255 255 255 / 0.07), transparent 70%);" aria-hidden="true"></div>
  <Container class="relative">
    <SectionHead
      dark
      centered
      title="Technology for the work on the ground"
      ctaLabel="All solutions"
      ctaHref="/solutions"
    />
  </Container>

  <div class="relative mt-14 md:mt-16">
    <div class="deck" role="group" aria-label="Sectors we work in" tabindex="0" data-deck>
      {
        SECTORS.map((sector, i) => (
          <article
            class="deck-card"
            data-deck-card
            data-index={i}
            style={`--o:${i - start}`}
            data-d={Math.abs(i - start)}
            data-active={i === start ? 'true' : 'false'}
          >
            <div class="deck-photo">
              <img src={sector.image} alt="" loading="lazy" width="1200" height="800" draggable="false" />
            </div>
            <h3 class="deck-title">{sector.name}</h3>
            <p class="deck-label">Description</p>
            <p class="deck-body">{sector.summary}</p>
            <ul class="deck-chips">
              {sector.useCases.slice(0, 3).map((useCase) => <li>{useCase.title}</li>)}
            </ul>
            <div class="deck-foot">
              <span>
                <span class="deck-label">Use cases</span>
                <strong>{sector.useCases.length}</strong>
              </span>
              <a href={`/solutions#${sector.slug}`} class="deck-go" aria-label={`Explore ${sector.name}`} tabindex={i === start ? 0 : -1}>
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-6 flex items-center justify-center gap-3">
      <button type="button" data-deck-prev class="deck-arrow" aria-label="Previous sector">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
      </button>
      <p class="min-w-[9rem] text-center text-sm font-semibold text-white/70" data-deck-count aria-live="polite">{start + 1} / {SECTORS.length}</p>
      <button type="button" data-deck-next class="deck-arrow" aria-label="Next sector">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </button>
    </div>
  </div>
</section>

<style is:global>
  .deck {
    --step: 15.5rem;
    position: relative;
    height: 35rem;
    margin-inline: auto;
    perspective: 1400px;
    outline: none;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }
  @media (max-width: 767px) {
    .deck {
      --step: 9.5rem;
      height: 33rem;
    }
  }

  .deck-card {
    position: absolute;
    left: 50%;
    top: 0;
    width: 19rem;
    padding: 0.75rem;
    border-radius: 1.75rem;
    color: #121214;
    cursor: pointer;
    transform-origin: 50% 60%;
    transform: translateX(calc(-50% + var(--o) * var(--step))) rotateY(calc(var(--o) * -9deg)) scale(0.84);
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.5s,
      background 0.5s,
      box-shadow 0.5s;
    z-index: 10;
    /* metallic when not selected */
    background: linear-gradient(160deg, #e4e5e7 0%, #b4b6bb 55%, #d3d4d7 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.7), 0 20px 40px -24px rgb(0 0 0 / 0.7);
    opacity: 0.9;
  }
  .deck-card[data-d='1'] {
    z-index: 15;
  }
  .deck-card[data-d='2'] {
    z-index: 12;
    transform: translateX(calc(-50% + var(--o) * var(--step))) rotateY(calc(var(--o) * -9deg)) scale(0.74);
    opacity: 0.7;
  }
  .deck-card[data-d='3'],
  .deck-card[data-d='4'],
  .deck-card[data-d='5'],
  .deck-card[data-d='6'] {
    transform: translateX(calc(-50% + var(--o) * var(--step))) rotateY(calc(var(--o) * -9deg)) scale(0.64);
    opacity: 0.45;
  }
  .deck-card[data-active='true'] {
    z-index: 20;
    transform: translateX(-50%) scale(1);
    opacity: 1;
    background: #ffffff;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(255 255 255 / 0.6);
    cursor: default;
  }
  /* neighbours on small screens: keep only the nearest ones */
  @media (max-width: 767px) {
    .deck-card[data-d='2'],
    .deck-card[data-d='3'],
    .deck-card[data-d='4'],
    .deck-card[data-d='5'],
    .deck-card[data-d='6'] {
      opacity: 0;
      pointer-events: none;
    }
  }

  .deck-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1.25rem;
    background: #19191b;
  }
  .deck-photo img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15) brightness(0.95);
    transition: filter 0.5s;
  }
  .deck-card[data-active='true'] .deck-photo img,
  .deck-card:hover .deck-photo img {
    filter: none;
  }
  .deck-card:hover:not([data-active='true']) {
    background: linear-gradient(160deg, #f3f3f4 0%, #cfd1d5 55%, #e6e7e9 100%);
  }

  .deck-title {
    margin: 1rem 0.5rem 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .deck-label {
    margin: 0.7rem 0.5rem 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .deck-body {
    margin: 0.25rem 0.5rem 0;
    font-size: 0.78rem;
    line-height: 1.5;
    min-height: 5.6em;
    color: #4a4b4f;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .deck-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.7rem 0.5rem 0;
    padding: 0;
    list-style: none;
  }
  .deck-chips li {
    border-radius: 9999px;
    background: rgb(18 18 20 / 0.07);
    padding: 0.2rem 0.6rem;
    font-size: 0.66rem;
    font-weight: 600;
  }
  .deck-card[data-active='true'] .deck-chips li {
    background: #e6edfb;
    color: #1d3a8a;
  }
  .deck-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin: 0.9rem 0.5rem 0.4rem;
  }
  .deck-foot .deck-label {
    display: block;
    margin: 0;
  }
  .deck-foot strong {
    font-size: 1.1rem;
  }
  .deck-go {
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #121214;
    color: #fff;
    transition: transform 0.3s;
  }
  .deck-go:hover {
    transform: translateX(3px);
  }
  .deck-card:not([data-active='true']) .deck-go {
    pointer-events: none;
    opacity: 0.55;
  }

  .deck-arrow {
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    transition: background 0.2s, transform 0.2s;
  }
  .deck-arrow:hover {
    background: #fff;
    color: #121214;
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-card,
    .deck-photo img {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  function initSectorDeck() {
    document.querySelectorAll<HTMLElement>('[data-sector-deck]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const deck = root.querySelector<HTMLElement>('[data-deck]')!;
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-deck-card]'));
      const count = root.querySelector<HTMLElement>('[data-deck-count]');
      let active = Math.floor(cards.length / 2);

      const render = () => {
        cards.forEach((card, i) => {
          const o = i - active;
          card.style.setProperty('--o', String(o));
          card.dataset.d = String(Math.abs(o));
          card.dataset.active = i === active ? 'true' : 'false';
          card.querySelector<HTMLElement>('.deck-go')?.setAttribute('tabindex', i === active ? '0' : '-1');
        });
        if (count) count.textContent = `${active + 1} / ${cards.length}`;
      };
      const go = (index: number) => {
        active = Math.max(0, Math.min(cards.length - 1, index));
        render();
      };

      cards.forEach((card, i) => {
        card.addEventListener('click', (event) => {
          if (i !== active) {
            event.preventDefault();
            go(i);
          }
        });
      });
      root.querySelector('[data-deck-prev]')?.addEventListener('click', () => go(active - 1));
      root.querySelector('[data-deck-next]')?.addEventListener('click', () => go(active + 1));
      deck.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') go(active - 1);
        if (event.key === 'ArrowRight') go(active + 1);
      });

      // swipe
      let startX = 0;
      let dragging = false;
      deck.addEventListener('pointerdown', (event) => {
        dragging = true;
        startX = event.clientX;
      });
      window.addEventListener('pointerup', (event) => {
        if (!dragging) return;
        dragging = false;
        const dx = event.clientX - startX;
        if (Math.abs(dx) > 50) go(active + (dx < 0 ? 1 : -1));
      });
    });
  }
  document.addEventListener('astro:page-load', initSectorDeck);
</script>

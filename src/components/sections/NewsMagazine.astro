---
import Container from '../ui/Container.astro';
import { getCollection } from 'astro:content';
import { NEWS, type NewsItem } from '../../data/news';

const { featured, side, fresh, popular, more } = NEWS;

const blog = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const fmtDate = (d: Date) => d.toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' });

// one list for the scrolling row: our own blog posts first (newest first), then the news items
const rowItems = [
  ...blog.map((post) => ({
    kind: 'blog' as const,
    title: post.data.title,
    url: `/insights/${post.id}`,
    image: post.data.coverImage,
    tag: post.data.tags[0] ?? 'Insight',
    meta: `Our blog · ${fmtDate(post.data.publishDate)}`
  })),
  ...more.map((item) => ({
    kind: 'news' as const,
    title: item.title,
    url: item.url,
    image: item.image,
    tag: item.tag,
    meta: `${item.source} · ${item.date}`
  }))
];

const label = (item: NewsItem) => `${item.source} · ${item.date}`;
const external = { target: '_blank', rel: 'noopener noreferrer' } as const;
---

<section class="px-3 pb-14 pt-24 md:px-4 md:pb-20 md:pt-36" data-noreveal id="news">
  <Container>
    <h1 class="sr-only">Resources: news, blog, consult process and documentation</h1>

    <div class="grid gap-4 lg:grid-cols-[17rem_minmax(0,1.5fr)_minmax(0,0.85fr)_15rem]">
      <!-- Fresh stories -->
      <aside class="rounded-[1.75rem] bg-paper-dim p-5">
        <h2 class="font-display text-xl font-bold tracking-tight text-ink">Fresh stories</h2>
        <p class="mt-1 text-xs text-ink-dim">AI, tech and industry news from Malaysia</p>
        <ul class="mt-5 space-y-5">
          {
            fresh.map((item) => (
              <li class="border-t border-black/10 pt-4 first:border-0 first:pt-0">
                <p class="text-[0.68rem] font-bold uppercase tracking-wide text-accent">{item.tag}</p>
                <a href={item.url} {...external} class="mt-1 block text-sm font-bold leading-snug text-ink hover:underline">
                  {item.title}
                </a>
                <p class="mt-1.5 text-[0.7rem] text-ink-dim">{label(item)}</p>
              </li>
            ))
          }
        </ul>
      </aside>

      <!-- Featured -->
      <a
        href={featured.url}
        {...external}
        class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-[1.75rem] bg-charcoal p-6 text-white lg:min-h-[34rem] lg:p-8"
      >
        <img src={featured.image} alt="" loading="eager" width="1600" height="1100" class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/35 to-black/10" aria-hidden="true"></div>
        <span class="mb-4 w-fit rounded-md bg-accent px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide">{featured.tag}</span>
        <h3 class="max-w-xl font-display text-[clamp(1.6rem,1.1rem+1.8vw,2.5rem)] font-bold leading-[1.08] tracking-[-0.03em]">{featured.title}</h3>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/75">{featured.summary}</p>
        <p class="mt-4 text-xs font-semibold text-white/60">{label(featured)} · Read at the source ↗</p>
      </a>

      <!-- Two picture cards -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        {
          side.map((item) => (
            <a href={item.url} {...external} class="group flex flex-col rounded-[1.75rem] bg-paper-dim p-3 transition-transform duration-300 hover:-translate-y-1">
              <div class="relative aspect-[16/10] overflow-hidden rounded-[1.25rem] bg-charcoal">
                <img src={item.image} alt="" loading="lazy" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <div class="p-3">
                <p class="text-[0.68rem] font-bold uppercase tracking-wide text-accent">{item.tag}</p>
                <h3 class="mt-1 text-sm font-bold leading-snug text-ink">{item.title}</h3>
                <p class="mt-2 text-[0.7rem] text-ink-dim">{label(item)}</p>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Popular -->
      <aside class="rounded-[1.75rem] bg-tint p-5">
        <h2 class="font-display text-xl font-bold tracking-tight text-ink">Popular</h2>
        <ol class="mt-5 space-y-5">
          {
            popular.map((item, i) => (
              <li class="flex gap-3 border-t border-black/10 pt-4 first:border-0 first:pt-0">
                <span class="font-feature text-xl font-semibold leading-none text-tint-ink">0{i + 1}</span>
                <div>
                  <p class="text-[0.68rem] font-bold uppercase tracking-wide text-ink-dim">{item.tag}</p>
                  <a href={item.url} {...external} class="mt-1 block text-sm font-bold leading-snug text-ink hover:underline">{item.title}</a>
                  <p class="mt-1.5 text-[0.7rem] text-ink-dim">{label(item)}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>

    <!-- Divider line, as in the reference -->
    <div class="my-10 flex items-center gap-4 md:my-12">
      <span class="h-px flex-1 bg-black/10"></span>
      <p class="text-center text-sm font-semibold text-ink">For even more of what is shaping Malaysian business</p>
      <span class="h-px flex-1 bg-black/10"></span>
    </div>

    <!-- Scrolling row: our blog + more headlines. Drifts right to left, pauses on hover, edges blur. -->
    <div class="nm-marquee relative -mx-3 overflow-hidden md:-mx-6" data-nm-marquee>
      <div class="nm-track flex w-max gap-4 px-3 md:px-6">
        {
          [0, 1].flatMap((copy) => rowItems.map((item, i) => ({ item, i, copy }))).map(({ item, i, copy }) => (
            <a
              href={item.url}
              {...(item.kind === 'news' ? external : {})}
              aria-hidden={copy === 1 ? 'true' : undefined}
              tabindex={copy === 1 ? -1 : undefined}
              class="group relative isolate flex h-[22rem] w-[17rem] shrink-0 flex-col justify-end overflow-hidden rounded-[1.75rem] bg-charcoal p-5 text-white sm:w-[19rem]"
            >
              <img src={item.image} alt="" loading="lazy" width="1000" height="1100" class="absolute inset-0 -z-10 h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0" />
              <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/30 to-transparent" aria-hidden="true"></div>
              <span class:list={['mb-2 w-fit rounded-md px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wide backdrop-blur', item.kind === 'blog' ? 'bg-accent' : 'bg-white/15']}>{item.kind === 'blog' ? `Blog · ${item.tag}` : item.tag}</span>
              <h3 class="font-display text-lg font-bold leading-tight tracking-tight">{item.title}</h3>
              <p class="mt-2 text-xs text-white/60">{item.meta}</p>
            </a>
          ))
        }
      </div>
      <div class="nm-edge nm-edge--l" aria-hidden="true"></div>
      <div class="nm-edge nm-edge--r" aria-hidden="true"></div>
    </div>

    <p class="mt-6 text-center text-xs text-ink-dim">
      Headlines link to their original publishers (Berita Harian, Kosmo, The Star, Malay Mail, Bernama). Summaries are ours. Pictures are illustrative.
    </p>
  </Container>
</section>

<style is:global>
  .nm-track {
    animation: nm-scroll var(--nm-speed, 80s) linear infinite;
    will-change: transform;
  }
  .nm-marquee:hover .nm-track {
    animation-play-state: paused;
  }
  @keyframes nm-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  .nm-edge {
    pointer-events: none;
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(3rem, 10vw, 9rem);
    z-index: 5;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: linear-gradient(to right, var(--color-paper), transparent);
    -webkit-mask-image: linear-gradient(to right, #000 25%, transparent);
    mask-image: linear-gradient(to right, #000 25%, transparent);
  }
  .nm-edge--l {
    left: 0;
  }
  .nm-edge--r {
    right: 0;
    transform: scaleX(-1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nm-marquee {
      overflow-x: auto;
    }
    .nm-track {
      animation: none;
    }
    .nm-edge {
      display: none;
    }
  }
</style>

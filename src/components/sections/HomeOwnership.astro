---
import Container from '../ui/Container.astro';
import { SITE } from '../../data/site';
import { FOUNDING_CLIENT } from '../../data/catalog';

const principles = [
  {
    num: '01',
    title: 'You own everything',
    description: 'Code, domain, data and logins, all handed over to you.',
    href: '/systems/'
  },
  {
    num: '02',
    title: 'The price is the price',
    description: 'Published packages and fixed quotes. No hourly billing.',
    href: '/websites/'
  },
  {
    num: '03',
    title: 'You talk to the builder',
    description: 'No account managers. The person you talk to builds your project.',
    href: '/about/'
  }
];

const slotsLeft = Math.max(0, Math.min(SITE.foundingSlotsLeft, FOUNDING_CLIENT.totalSlots));
---

<section class="py-8 md:py-12 border-t border-line/60 bg-paper overflow-hidden">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <!-- Left Column: Heading + Numbered Pill Principles -->
      <div>
        <h2 class="h-section font-black tracking-tight text-ink">
          Own it. <span class="badge-highlight">Don't rent it.</span>
        </h2>

        <p class="mt-4 text-base leading-relaxed text-ink-dim max-w-lg">
          Monthly software bills never stop, and when they do, the system stops with them. We build the other way: you pay
          once, you get the code, and it keeps working for you.
        </p>

        <!-- Numbered pill rows -->
        <div class="mt-8 space-y-3.5">
          {
            principles.map((item) => (
              <a
                href={item.href}
                class="group flex items-center justify-between gap-4 rounded-full border border-line bg-white px-6 py-4 shadow-sm transition-all duration-300 hover:border-ink hover:bg-paper-dim hover:scale-[1.02] hover:shadow-md"
              >
                <div class="flex items-center gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-dim font-mono text-xs font-bold text-ink group-hover:bg-ink group-hover:text-white transition-colors">
                    {item.num}
                  </span>
                  <div>
                    <h3 class="text-sm sm:text-base font-bold text-ink group-hover:text-ink transition-colors">
                      {item.title}
                    </h3>
                    <p class="text-xs text-ink-dim">{item.description}</p>
                  </div>
                </div>

                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-dim text-ink-dim transition-all group-hover:bg-ink group-hover:text-white group-hover:translate-x-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Founding Client Programme panel with the star -->
      <div class="relative">
        <!-- Decorative 8-point star -->
        <div class="absolute -top-6 -right-4 z-20 hidden sm:block" aria-hidden="true">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ink text-white shadow-xl rotate-12">
            <svg class="h-8 w-8 fill-current" viewBox="0 0 24 24">
              <path d="M12 0l2.6 6.8L21.4 4.6l-2.2 7.4 7.4 2.2-6.8 2.6 4.6 6.8-7.4-2.2-2.2 7.4-2.6-6.8-6.8 4.6 2.2-7.4-7.4-2.2 6.8-2.6-4.6-6.8 7.4 2.2z" />
            </svg>
          </span>
        </div>

        <div class="relative overflow-hidden rounded-[2.5rem] border border-line bg-charcoal shadow-2xl sm:aspect-[1/1]">
          <div class="grid-pattern absolute inset-0 opacity-15" aria-hidden="true"></div>
          <div class="absolute -top-16 -left-16 h-64 w-64 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
          <div class="absolute -bottom-16 -right-16 h-64 w-64 rounded-full bg-accent-blue/15 blur-3xl" aria-hidden="true"></div>

          <div class="relative z-10 flex h-full flex-col justify-between gap-8 p-7 sm:p-9">
            <div>
              <p class="mono-label text-white/60">Founding Client Programme</p>
              {
                slotsLeft > 0 ? (
                  <p class="mt-4 font-feature text-4xl font-black tracking-tight text-white sm:text-5xl">
                    {slotsLeft} of {FOUNDING_CLIENT.totalSlots} places left
                  </p>
                ) : (
                  <p class="mt-4 font-feature text-3xl font-black tracking-tight text-white">All founding places are taken</p>
                )
              }
              <p class="mt-4 text-sm leading-relaxed text-white/70">
                Our first {FOUNDING_CLIENT.totalSlots} clients get {FOUNDING_CLIENT.discountPercent}% off a Business or Store
                website, a ready-made system or a custom build. In return: a case study, an honest review, and permission to show
                your project.
              </p>
              <p class="mt-2 text-xs text-white/50">Not available on the One-Page website, Care Plans or hardware.</p>
            </div>

            <!-- Bottom Action Button -->
            <div class="flex flex-wrap items-center justify-end gap-3">
              <a
                href={slotsLeft > 0 ? '/contact/?package=founding' : '/contact/'}
                data-track="founding_click"
                class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-lg transition hover:bg-black hover:scale-105"
              >
                <span>{slotsLeft > 0 ? 'Ask about a founding place' : 'Get a fixed quote'}</span>
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

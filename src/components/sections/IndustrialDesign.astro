---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import { getServiceBySlug } from '../../data/services';
import CadViewer from './CadViewer.astro';

const service = getServiceBySlug('industrial-design');

// Product ideas that show the range of the service. None of these are for sale yet; the photos are stock
// images (Unsplash licence) used for illustration, not pictures of our own prototypes.
const concepts = [
  {
    name: 'Tuah',
    kind: 'Desk companion robot',
    img: 'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&fit=crop&w=1200&h=900&q=80',
    desc: 'A palm-sized robot that sits beside your laptop. It runs focus timers, nudges you to sit up, and lights up when a new order or message lands in your system.',
    tags: ['ESP32', 'Screen face', 'Voice reminders', 'Connects to your dashboard']
  },
  {
    name: 'Sayong',
    kind: 'Heritage table lamp',
    img: 'https://images.unsplash.com/photo-1543198126-a8ad8e47fb22?auto=format&fit=crop&w=1200&h=900&q=80',
    desc: 'A lamp shaped after the labu sayong clay gourd of Perak, with pucuk rebung cut-outs that throw warm light across the room. Teak stand, brass collar, dimmable from the base or your phone.',
    tags: ['Malay heritage', 'Teak + clay', 'Warm 2700K LED', 'App + touch']
  },
  {
    name: 'Tunas',
    kind: 'Smart planter',
    img: 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?auto=format&fit=crop&w=1200&h=900&q=80',
    desc: 'A self-watering pot with a soil sensor and a small screen that tells you, in plain words, when the plant needs water. Built for offices, cafés and hotel lobbies.',
    tags: ['Soil moisture', 'Water reservoir', 'Low-power display', 'Alerts']
  },
  {
    name: 'Ladang',
    kind: 'Solar field sensor node',
    img: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?auto=format&fit=crop&w=1200&h=900&q=80',
    desc: 'A rugged, solar-powered box that sits on a pole in a plantation and reports soil and weather readings over LoRa. No wiring, no daily walk-arounds.',
    tags: ['IP67 enclosure', 'Solar', 'LoRa 8 km', 'Agriculture']
  }
];

const process = [
  { step: 'Sketch', desc: 'Rough ideas on paper and quick renders so you can see the product before money goes into parts.' },
  { step: 'CAD', desc: 'Exact 3D models with real dimensions, ready for printing, CNC or moulding.' },
  { step: 'Prototype', desc: '3D-printed looks-like and works-like models with the electronics fitted inside.' },
  { step: 'Smart parts', desc: 'Firmware, sensors and a companion app or dashboard when the product needs to connect.' },
  { step: 'Production', desc: 'Design for manufacture, supplier hand-off and small-batch runs.' }
];
---

<CadViewer />

<!-- Concept products -->
<Section rule>
  <Container>
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="mono-label text-accent">From the studio</p>
      <h2 class="h-section mt-3">Product ideas we can build with you</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-dim">
        A few of our own product ideas, to show the kind of thing we can take from sketch to working prototype. Have something like this in mind for your brand, your shop or your farm? We would love to build it with you.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        concepts.map((item, i) => (
          <article class="ind-card group flex flex-col overflow-hidden rounded-[2rem] bg-white ring-1 ring-black/5 shadow-[0_24px_60px_-40px_rgba(0,0,0,0.35)]">
            <div class="relative aspect-[4/3] overflow-hidden bg-paper-dim">
              <img
                src={item.img}
                alt={`Illustration photo for ${item.name}, a ${item.kind.toLowerCase()} idea`}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                loading="lazy"
                width="800"
                height="600"
              />
              <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-[0.68rem] font-semibold text-ink backdrop-blur">
                Idea {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-dim">{item.kind}</p>
              <h3 class="mt-1 font-display text-2xl font-semibold tracking-tight text-ink">{item.name}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-dim">{item.desc}</p>
              <div class="mt-5 flex flex-wrap gap-1.5">
                {item.tags.map((tag) => (
                  <span class="rounded-full border border-line bg-paper-dim px-2.5 py-1 text-[11px] font-medium text-ink-dim">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <p class="mt-5 text-center text-xs text-ink-dim">Photos are for illustration only. Each idea is designed from scratch for the client who commissions it.</p>
  </Container>
</Section>

<!-- Process + what you get -->
<Section rule class="bg-paper-dim">
  <Container>
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <h2 class="h-section">From sketch to something you can hold</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-dim">
        Form, electronics and software are designed together, so the circuit board fits the casing and the app matches the buttons.
      </p>
    </div>

    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        process.map((p, i) => (
          <li class="rounded-2xl border border-line bg-white p-5 shadow-sm">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink font-mono text-xs font-bold text-white">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-sm font-bold text-ink">{p.step}</h3>
            <p class="mt-2 text-xs leading-relaxed text-ink-dim">{p.desc}</p>
          </li>
        ))
      }
    </ol>

    {
      service && (
        <div class="mt-10 grid gap-6 rounded-[2rem] bg-white p-7 ring-1 ring-black/5 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="text-sm font-bold text-ink">What you get:</p>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {service.deliverables.map((item) => (
                <li class="flex items-start gap-3 text-sm text-ink-dim">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink text-white">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-6 flex flex-wrap gap-1.5">
              {service.tools.map((tool) => (
                <span class="rounded-full border border-line bg-paper-dim px-2.5 py-1 text-[11px] font-medium text-ink-dim">{tool}</span>
              ))}
            </div>
          </div>
          <a
            href={`/contact?topic=${encodeURIComponent(service.title)}`}
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-white transition-transform hover:scale-105"
          >
            Talk about your product idea
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      )
    }
  </Container>
</Section>

<style>
  .ind-card {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s;
  }
  .ind-card:hover {
    transform: translateY(-6px);
  }
  @media (prefers-reduced-motion: reduce) {
    .ind-card {
      transition: none;
    }
  }
</style>

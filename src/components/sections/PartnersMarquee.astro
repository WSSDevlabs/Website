---
import Container from '../ui/Container.astro';

const placeholders = Array.from({ length: 8 }, (_, i) => i + 1);
---

<section class="border-y border-line bg-paper-dim/40 py-14 md:py-20">
  <Container>
    <div class="mx-auto max-w-xl text-center">
      <h2 class="h-section !text-[clamp(1.7rem,1.3rem+1.6vw,2.5rem)]" data-split>
        Our Strategic <span class="badge-highlight">Partners &amp; Clients</span>
      </h2>
    </div>
  </Container>

  <div class="mask-fade-x mt-12 overflow-hidden">
    <div class="marquee-track flex w-max items-center gap-6">
      {
        [...placeholders, ...placeholders].map((n) => (
          <div class="flex h-20 w-44 shrink-0 items-center justify-center rounded-2xl border border-line bg-white shadow-sm">
            <svg class="h-8 w-8 text-ink-dim/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3 16.5V4.5a1.5 1.5 0 0 1 1.5-1.5h15a1.5 1.5 0 0 1 1.5 1.5v15a1.5 1.5 0 0 1-1.5 1.5h-15a1.5 1.5 0 0 1-1.5-1.5Zm10.5-11.25h.008v.008h-.008V5.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee-scroll 28s linear infinite;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>

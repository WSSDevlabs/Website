---
import Container from '../ui/Container.astro';

const experts = [
  {
    name: 'Razin Hakim',
    role: 'Lead System Architect',
    bio: 'Oversees high-throughput backend architecture, database schemas, cryptographic licensing, and zero-bloat PHP engineering.',
    photo: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&h=200&q=80'
  },
  {
    name: 'Natasya Umairah',
    role: 'Front-End & UI/UX Specialist',
    bio: 'Crafts conversion-focused interfaces, sub-second performance builds, accessible design systems, and responsive micro-moments.',
    photo: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=200&h=200&q=80'
  },
  {
    name: 'Daniel Okoye',
    role: 'Senior AI & Automation Lead',
    bio: 'Designs RAG knowledge retrieval engines, LLM agent workflows, and smart pipeline integrations that automate complex workflows.',
    photo: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&h=200&q=80'
  },
  {
    name: 'Sofia Martinez',
    role: 'Product & Full-Stack Engineer',
    bio: 'Specializes in reactive client dashboards, secure payment gateway integrations, and headless commerce architectures.',
    photo: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=200&h=200&q=80'
  },
  {
    name: 'Marcus Lee',
    role: 'DevOps & Cloud Infrastructure',
    bio: 'Deploys bare-metal VPS, Cloudflare edge optimizations, automated CI/CD pipelines, and bulletproof database backup systems.',
    photo: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=200&h=200&q=80'
  },
  {
    name: 'Tunde Adeyemi',
    role: 'Client Success & Technical Scoping',
    bio: 'Bridges business requirements into concrete technical specifications and ensures transparent milestone deliveries.',
    photo: 'https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?auto=format&fit=crop&w=200&h=200&q=80'
  }
];
---

<section class="py-16 md:py-24 border-t border-line/60 bg-paper overflow-hidden">
  <Container>
    <!-- Section Header with Highlight Badge -->
    <div class="mx-auto max-w-2xl text-center">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="text-ink text-xl">✦</span>
        <span class="mono-label text-ink-dim font-bold">Direct Senior Engineers</span>
      </div>
      <h2 class="h-section font-black tracking-tight text-ink">
        Meet <span class="badge-highlight">Our Experts</span>
      </h2>
      <p class="mt-4 text-base text-ink-dim">
        Work directly with experienced software architects and engineers — no account managers, no layers of bureaucracy.
      </p>
    </div>

    <!-- 6-Card 3x2 Grid (matching screenshot) -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        experts.map((exp) => (
          <div class="group flex flex-col justify-between rounded-3xl border border-line bg-white p-7 shadow-sm transition-all duration-300 hover:border-ink/40 hover:shadow-card-hover hover:-translate-y-1">
            <div>
              <div class="flex items-center gap-4">
                <img
                  src={exp.photo}
                  alt={exp.name}
                  class="h-14 w-14 rounded-full object-cover ring-2 ring-line group-hover:ring-ink transition-all"
                  loading="lazy"
                  width="56"
                  height="56"
                />
                <div>
                  <h3 class="font-bold text-ink text-base group-hover:text-ink transition-colors">
                    {exp.name}
                  </h3>
                  <p class="text-xs font-semibold text-ink-dim">{exp.role}</p>
                </div>
              </div>

              <p class="mt-5 text-xs sm:text-sm leading-relaxed text-ink-dim font-normal">
                {exp.bio}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>

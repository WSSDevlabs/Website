---
import Container from '../ui/Container.astro';
---

<section class="py-16 md:py-24" data-tight>
  <Container>
    <div class="mx-auto max-w-2xl rounded-[2rem] bg-white p-10 text-center ring-1 ring-black/5 sm:p-14">
      <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-paper-dim text-ink">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
      </span>
      <h2 class="mt-6 font-display text-[clamp(1.8rem,1.3rem+2vw,2.8rem)] font-bold leading-tight tracking-[-0.03em] text-ink">Coming soon</h2>
      <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-ink-dim">
        Our grant support guide is being prepared. If you would like help finding and applying for a grant, tell us about your business and we will talk it through with you.
      </p>
      <a href="/contact?topic=Grants" class="mt-7 inline-flex items-center justify-center rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-white transition-transform hover:scale-105">Ask about grants</a>
    </div>
  </Container>
</section>

---
import Container from '../ui/Container.astro';
import Pill from '../ui/Pill.astro';
---

<section class="py-6 md:py-10" data-tight>
  <Container>
    <div class="grid gap-8 rounded-[2.25rem] bg-tint p-8 md:grid-cols-[1.3fr_1fr] md:items-center md:p-12">
      <div>
        <p class="mono-label text-tint-ink">Also available</p>
        <h2 class="mt-4 font-display text-[clamp(1.6rem,1.15rem+1.8vw,2.4rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
          Need a website or marketing too?
        </h2>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-ink-dim">
          We also build websites and apps, and run design and marketing. Fixed prices, live in days.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <Pill href="/express" label="Website packages" />
        <Pill href="/systems" label="Sample systems" variant="light" />
      </div>
    </div>
  </Container>
</section>

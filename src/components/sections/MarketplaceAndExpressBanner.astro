---
import Container from '../ui/Container.astro';
import Pill from '../ui/Pill.astro';
---

<section class="py-6 md:py-10" data-tight>
  <Container>
    <div class="grid gap-8 rounded-[2.25rem] bg-tint p-8 md:grid-cols-[1.3fr_1fr] md:items-center md:p-12">
      <div>
        <h2 class="font-display text-[clamp(1.6rem,1.15rem+1.8vw,2.4rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
          Need a website or marketing too?
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-dim">
          Every business starts the same way: a name, a few customers, and a website people can find. We build that foundation too, with clear prices and a launch measured in days, then help the right customers discover you through design and marketing. Start simple, and grow when you are ready.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <Pill href="/express" label="Website packages" />
        <Pill href="/marketplace" label="Visit our Marketplace" variant="light" />
      </div>
    </div>
  </Container>
</section>

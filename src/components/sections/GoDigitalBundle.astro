---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import { GO_DIGITAL_BUNDLE, bundleSeparateTotal, formatRM } from '../../data/catalog';

const saving = bundleSeparateTotal - GO_DIGITAL_BUNDLE.price;
---

<Section rule id="go-digital-bundle">
  <Container>
    <div class="rounded-3xl border border-line bg-ink p-8 text-white md:p-12">
      <div class="grid items-center gap-8 lg:grid-cols-2">
        <div>
          <p class="mono-label text-white/50">Go Digital Bundle</p>
          <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-white md:text-3xl">
            A website and a system, set up to work together.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-white/70">
            Most businesses buy a website from one vendor, a POS from another and a chatbot from a third. Nothing connects, and
            nobody owns the whole result. This bundle is one coordinated setup from one builder, with a year of care included.
          </p>

          <div class="mt-6 grid grid-cols-2 gap-4">
            <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
              <p class="font-bold text-accent-yellow-vivid">{formatRM(GO_DIGITAL_BUNDLE.price)}</p>
              <p class="mt-1 text-xs text-white/60">Bundle price. Save {formatRM(saving)} against buying each part.</p>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
              <p class="font-bold text-emerald-400">{GO_DIGITAL_BUNDLE.timeline}</p>
              <p class="mt-1 text-xs text-white/60">Payment {GO_DIGITAL_BUNDLE.payment.charAt(0).toLowerCase() + GO_DIGITAL_BUNDLE.payment.slice(1)}</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-white/15 bg-white/5 p-6 backdrop-blur-md">
          <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider">What's in the bundle:</h3>
          <ul class="mt-4 space-y-3 text-xs text-white/80">
            {
              GO_DIGITAL_BUNDLE.items.map((item) => (
                <li class="flex items-start justify-between gap-3">
                  <span class="flex items-start gap-2.5">
                    <span class="text-accent font-bold">✓</span>
                    <span>{item.name}</span>
                  </span>
                  <span class="shrink-0 font-mono text-white/50">{formatRM(item.price)}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-4 flex items-center justify-between border-t border-white/10 pt-3 text-xs">
            <span class="text-white/60">Bought separately</span>
            <span class="font-mono text-white/60 line-through">{formatRM(bundleSeparateTotal)}</span>
          </div>

          <div class="mt-6 pt-4 border-t border-white/10">
            <a
              href="/contact/?package=go-digital"
              data-track="quote_click"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-accent-dim"
            >
              Ask about the Go Digital Bundle
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>

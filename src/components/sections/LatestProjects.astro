---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

const projects = [
  { label: 'Project One', category: 'Web & System Development' },
  { label: 'Project Two', category: 'AI & Automation' },
  { label: 'Project Three', category: 'IoT & Infrastructure' }
];
---

<Section rule>
  <Container>
    <div class="mx-auto max-w-xl text-center">
      <h2 class="h-section" data-split>Our Latest <span class="badge-highlight">Projects</span></h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3" data-stagger>
      {
        projects.map((p) => (
          <div data-stagger-child class="group overflow-hidden rounded-2xl border border-line bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-accent via-accent-blue to-accent-yellow">
              <div class="absolute inset-0 grayscale transition-all duration-500 [transition-timing-function:var(--ease-out-expo)] group-hover:grayscale-0 bg-gradient-to-br from-accent via-accent-blue to-accent-yellow" />
              <div class="absolute inset-0 flex items-center justify-center">
                <svg class="h-10 w-10 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3 16.5V4.5a1.5 1.5 0 0 1 1.5-1.5h15a1.5 1.5 0 0 1 1.5 1.5v15a1.5 1.5 0 0 1-1.5 1.5h-15a1.5 1.5 0 0 1-1.5-1.5Zm10.5-11.25h.008v.008h-.008V5.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
              </div>
              <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-ink-dim backdrop-blur-sm">
                Case Study Coming Soon
              </span>
            </div>
            <div class="p-5">
              <p class="text-xs font-semibold text-accent">{p.category}</p>
              <p class="mt-1 text-base font-bold text-ink">{p.label}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

---
import Container from '../ui/Container.astro';
import Pill from '../ui/Pill.astro';

// Updated 2026-10-18 to match the site as it is now: AI, IoT and systems first, websites and marketing as the side offer,
// pilot-first process, Marketplace coming soon at /store, and the Express page folded into the web development page.
const categories = [
  { id: 'about', label: 'About us' },
  { id: 'solutions', label: 'AI, IoT & systems' },
  { id: 'process', label: 'How we work' },
  { id: 'pricing', label: 'Pricing & payment' },
  { id: 'web', label: 'Websites & marketing' },
  { id: 'ownership', label: 'Data, code & support' }
];

const faqs = [
  { cat: 'about', q: 'What does WSS DevLabs do?', a: 'We are a Malaysian AI, IoT and systems company. We build intelligent solutions for farms, plants, cities and growing businesses, from sensors and cameras to AI, automation and business systems. We also build websites and apps and run design and marketing when clients need them.' },
  { cat: 'about', q: 'Who do you work with?', a: 'Everyone from a single shop with a few cameras to a large plantation or a council. Every project starts with a small pilot sized to your budget, so size is never a barrier.' },
  { cat: 'about', q: 'Where are you based?', a: 'We are based in Kuala Lumpur, Malaysia, and work on site with clients across Malaysia. We also work remotely with clients across Southeast Asia.' },
  { cat: 'about', q: 'Who will I actually be working with?', a: 'You work directly with Razali, the founder, and the people building your project. There are no account managers or middlemen between you and the person doing the work.' },

  { cat: 'solutions', q: 'What AI and automation can you build?', a: 'Detection and monitoring models (for example wildlife and plant disease detection), chatbots grounded in your own content, analytics dashboards, and automations that take repetitive work off your team. We choose the simplest approach that solves your problem.' },
  { cat: 'solutions', q: 'What does your IoT work include?', a: 'Sensors, gateways and cameras, the network that connects them, and the dashboard and alerts on top. We plan systems to keep working when the internet drops, by storing readings on the device and sending them later.' },
  { cat: 'solutions', q: 'Which industries do you serve?', a: 'Agriculture, biomass, smart cities, energy and sustainability, waste-to-energy, digital foundations for businesses, and SME digital shift including staff training. See the Solutions page for each one.' },
  { cat: 'solutions', q: 'Do you supply hardware as well as software?', a: 'Yes. We specify, source and install sensors, gateways and cameras, then build the software, AI models and dashboards on top, so you deal with one team.' },

  { cat: 'process', q: 'How does a project start?', a: 'With a conversation. Send us a short message through the contact form or WhatsApp, and we reply within one business day. We can then talk over Google Meet or visit your site, listen first, and agree on the one problem to solve first.' },
  { cat: 'process', q: 'What is a pilot?', a: 'A small trial on one site, block or line, run for a few weeks, so you judge the result on your own data before you commit. If it earns its keep, we scale it with a fixed scope, timeline and price.' },
  { cat: 'process', q: 'How long does a project take?', a: 'Pilots usually run a few weeks. Websites take 4 to 8 weeks, or 3 to 7 days for our fixed-price packages. Mobile apps, custom systems and larger IoT or AI projects vary, and we give you a timeline in the proposal before you start.' },
  { cat: 'process', q: 'What happens after launch?', a: 'We train your team, hand over clear documentation and stay close for support, updates and retraining. A monthly maintenance retainer covers monitoring, security patches and updates if you want one.' },

  { cat: 'pricing', q: 'How are projects priced?', a: 'Custom work gets a fixed-price proposal after a scoping call or site visit. Website packages have listed prices. Some systems are quoted individually because they depend on your site and data.' },
  { cat: 'pricing', q: 'Can I pay in milestones?', a: 'Yes. Standard terms are 50% on kickoff and 50% on delivery. Larger projects use a milestone schedule written into the proposal.' },
  { cat: 'pricing', q: 'Are there grants that can help?', a: 'Often, yes. For example, the MSME Digital Grant MADANI offers 50% matching up to RM5,000. We can review your eligibility and help with the application. Grant terms change, so we check the latest conditions with you.' },
  { cat: 'pricing', q: 'Is there a monthly fee?', a: 'No hidden monthly fees. You pay for the work you agree, plus any hosting or maintenance retainer you choose. Website packages also list their renewal costs openly.' },

  { cat: 'web', q: 'What website packages do you offer?', a: 'SME packages come in three sizes: 1 page (RM549), 5 pages (RM999) and 10 pages (RM1,399), subject to 8% SST. Corporate packages come in three tiers: RM2,599 for 10 pages, RM3,599 for 15 pages and RM4,599 for 20 pages and more, with extra pages addable anytime during the 1-year contract. Full comparison tables are on the web development page.' },
  { cat: 'web', q: 'Do you build mobile apps and custom systems?', a: 'Yes. We build cross-platform apps and native iOS or Android when performance needs it, plus custom systems that replace spreadsheets and rigid off-the-shelf software.' },
  { cat: 'web', q: 'Do you do digital marketing and SEO?', a: 'Yes, and our Google Ads and SEO packages are coming soon. Until they are published, tell us what you want to achieve and we will talk it through and quote it with you.' },
  { cat: 'web', q: 'What about the Marketplace?', a: 'Our Marketplace website is in process and shows a Coming soon page for now. If you want one of the systems we have built, ask us and we will send a quote.' },

  { cat: 'ownership', q: 'Who owns the data and the code?', a: 'You do. Data stays in your own cloud account or on your own server, and custom code, documentation and credentials are handed over at the end of the project. No lock-in.' },
  { cat: 'ownership', q: 'Can I update the website myself?', a: 'If you need that, we include a content management system or editing flow suited to your team, so you do not have to call us for every small change.' },
  { cat: 'ownership', q: 'What technology do you use?', a: 'It depends on the project. For websites we use modern, fast tools such as Astro and TypeScript. For apps, React Native or Flutter. For systems, IoT and AI, we pick what fits your site and budget, and we explain our choices in plain words.' },
  { cat: 'ownership', q: 'Where do you host websites?', a: 'We deploy to Cloudflare Pages by default because it is fast and global. We can also deploy to Vercel, AWS or your own server if you prefer.' }
];
---

<div data-faq-block>
  <section id="faq" class="scroll-mt-24 bg-paper py-16 md:py-24">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
        <!-- Left: badge, heading and the "still have a question" card -->
        <div class="flex flex-col gap-8 lg:sticky lg:top-28 lg:self-start">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-paper-dim px-3.5 py-1.5 text-xs font-semibold text-ink-dim">
              <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Quick answers
            </span>
            <h2 class="mt-5 font-display text-[clamp(2.4rem,1.4rem+3.8vw,4.6rem)] font-medium leading-[1.02] tracking-[-0.045em] text-ink">
              Frequently asked questions
            </h2>
            <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-dim">
              Stuck on something? Here are the answers to what people ask us most, in one place.
            </p>
          </div>

          <div class="relative overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-tint to-white p-6 ring-1 ring-black/5 sm:p-8">
            <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-accent-blue/10 blur-3xl" aria-hidden="true"></div>
            <h3 class="relative font-display text-xl font-semibold tracking-tight text-ink">Still have a question?</h3>
            <p class="relative mt-2 text-sm leading-relaxed text-ink-dim">
              Can't find the answer? Send us a message and we'll reply within one business day.
            </p>
            <Pill href="/contact" label="Send a message" variant="blue" class="relative mt-6" />
          </div>
        </div>

        <!-- Right: search, category pills, accordion cards -->
        <div>
          <div class="flex items-center gap-2 rounded-full bg-paper-dim p-1.5">
            <svg class="ml-3 h-4 w-4 shrink-0 text-ink-dim/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <input id="faq-search" type="search" placeholder="Search questions..." aria-label="Search questions" class="min-w-0 flex-1 bg-transparent px-1 py-2.5 text-sm text-ink placeholder:text-ink-dim/50 focus:outline-none" />
          </div>

          <div class="mt-4 flex flex-wrap gap-2" role="tablist" aria-label="FAQ categories">
            {
              categories.map((cat, i) => (
                <button
                  type="button"
                  role="tab"
                  data-faq-tab={cat.id}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  class="faq-tab rounded-full bg-paper-dim px-4 py-2 text-xs font-semibold text-ink-dim transition-colors duration-300 hover:text-ink aria-selected:bg-ink aria-selected:text-white sm:text-sm"
                >
                  {cat.label}
                </button>
              ))
            }
          </div>

          <ul class="mt-5 space-y-3" id="faq-list">
            {
              faqs.map((item, i) => (
                <li class="faq-card rounded-[1.5rem] bg-paper-dim transition-colors duration-300" data-faq-item data-cat={item.cat} data-q={item.q.toLowerCase()} data-open="false" hidden={item.cat !== 'about'}>
                  <button type="button" class="flex w-full items-center justify-between gap-4 p-5 text-left sm:p-6" aria-expanded="false" aria-controls={`faq-a-${i}`} data-faq-toggle>
                    <span class="text-base font-semibold leading-snug tracking-tight text-ink">{item.q}</span>
                    <span class="faq-chev flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-ink shadow-sm transition-transform duration-300">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
                    </span>
                  </button>
                  <div class="faq-body grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out" id={`faq-a-${i}`}>
                    <div class="overflow-hidden">
                      <p class="px-5 pb-6 text-sm leading-relaxed text-ink-dim sm:px-6">{item.a}</p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
          <p id="faq-empty" class="mt-6 hidden rounded-[1.5rem] bg-paper-dim p-6 text-sm text-ink-dim">No question matches your search. Try another word, or <a href="/contact" class="font-bold text-ink underline underline-offset-4">ask us directly</a>.</p>
        </div>
      </div>
    </Container>
  </section>
</div>

<style is:global>
  .faq-card[data-open='true'] {
    background: #fff;
    box-shadow: 0 18px 40px -28px rgb(0 0 0 / 0.35), inset 0 0 0 1px rgb(0 0 0 / 0.05);
  }
  .faq-card[data-open='true'] .faq-body {
    grid-template-rows: 1fr;
  }
  .faq-card[data-open='true'] .faq-chev {
    transform: rotate(180deg);
    background: var(--color-ink);
    color: #fff;
  }
  .faq-card:not([hidden]) {
    animation: faq-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--n, 0) * 0.05s);
  }
  @keyframes faq-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-card:not([hidden]) { animation: none; }
    .faq-body, .faq-chev { transition-duration: 0.01ms; }
  }
</style>

<script>
  function initFaq() {
    document.querySelectorAll<HTMLElement>('[data-faq-block]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const tabs = Array.from(root.querySelectorAll<HTMLElement>('[data-faq-tab]'));
      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-faq-item]'));
      const search = root.querySelector<HTMLInputElement>('#faq-search');
      const empty = root.querySelector<HTMLElement>('#faq-empty');
      let category = tabs[0]?.dataset.faqTab ?? '';

      const setOpen = (item: HTMLElement, open: boolean) => {
        item.dataset.open = String(open);
        item.querySelector('[data-faq-toggle]')?.setAttribute('aria-expanded', String(open));
      };

      const render = () => {
        const query = (search?.value ?? '').trim().toLowerCase();
        let shown = 0;
        items.forEach((item) => {
          const text = (item.dataset.q ?? '') + ' ' + (item.textContent ?? '').toLowerCase();
          const match = query ? text.includes(query) : item.dataset.cat === category;
          item.hidden = !match;
          if (match) {
            item.style.setProperty('--n', String(shown));
            shown += 1;
          }
        });
        empty?.classList.toggle('hidden', shown > 0);
        // the first visible card starts open
        const first = items.find((item) => !item.hidden);
        items.forEach((item) => setOpen(item, item === first));
      };

      tabs.forEach((tab) =>
        tab.addEventListener('click', () => {
          category = tab.dataset.faqTab ?? category;
          if (search) search.value = '';
          tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          render();
        })
      );
      search?.addEventListener('input', render);
      items.forEach((item) =>
        item.querySelector('[data-faq-toggle]')?.addEventListener('click', () => {
          const willOpen = item.dataset.open !== 'true';
          items.forEach((other) => setOpen(other, false));
          setOpen(item, willOpen);
        })
      );
      render();
    });
  }
  document.addEventListener('astro:page-load', initFaq);
</script>

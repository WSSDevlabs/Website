---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import {
  CARE_BASIC_MONTHLY,
  CARE_PLANS,
  CARE_PLAN_ROWS,
  CARE_PRO_MONTHLY,
  HOSTING_SITE_YEARLY,
  HOSTING_STORE_YEARLY,
  formatRM
} from '../../data/catalog';

type Props = {
  /** Systems and custom pages talk about systems; the websites page about sites. */
  context?: 'websites' | 'systems';
};

const { context = 'websites' } = Astro.props;

const RECOMMENDED = 'basic';

const annualOf = (id: string) => CARE_PLANS.find((plan) => plan.id === id)?.annual ?? '';

const headline: Record<string, { price: string; note: string }> = {
  hosting: { price: `${formatRM(HOSTING_SITE_YEARLY)}/year`, note: `${formatRM(HOSTING_STORE_YEARLY)}/year for stores` },
  basic: { price: `${formatRM(CARE_BASIC_MONTHLY)}/month`, note: `or ${annualOf('basic')}` },
  pro: { price: `${formatRM(CARE_PRO_MONTHLY)}/month`, note: `or ${annualOf('pro')}` }
};

const isYes = (value: string) => value === 'Yes';
const isNo = (value: string) => value === 'No';
---

<Section rule id="care-plans" class="bg-paper-dim/40">
  <Container>
    <div class="mx-auto max-w-2xl text-center mb-10">
      <h2 class="h-section">Care Plans</h2>
      <p class="mt-4 text-ink-dim">
        {
          context === 'systems'
            ? 'Your system is yours to run. If you would rather we kept it updated, backed up and supported, pick a plan. Cancel monthly plans any time.'
            : "A website isn't finished at launch. Like a car, it needs regular servicing: security updates, backups and small changes. A hacked site usually costs far more to fix than a year of care."
        }
      </p>
    </div>

    <!-- Desktop: comparison table -->
    <div class="hidden overflow-x-auto rounded-3xl border border-line shadow-card md:block">
      <table class="w-full border-collapse bg-white text-sm">
        <thead>
          <tr>
            <th class="w-64 bg-charcoal p-5 text-left align-bottom text-sm font-bold text-white">Care Plans</th>
            {
              CARE_PLANS.map((plan) => {
                const isPopular = plan.id === RECOMMENDED;
                return (
                  <th
                    class:list={[
                      'relative border-l border-line p-5 text-center align-bottom font-bold',
                      isPopular ? 'bg-accent/10 text-accent' : 'bg-paper-dim text-ink'
                    ]}
                  >
                    {isPopular && (
                      <span class="absolute right-2 top-2 rounded-full bg-accent px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-white">
                        Recommended
                      </span>
                    )}
                    {plan.name}
                  </th>
                );
              })
            }
          </tr>
          <tr>
            <td class="bg-charcoal p-4 text-xs text-white/60">Who it's for</td>
            {
              CARE_PLANS.map((plan) => {
                const isPopular = plan.id === RECOMMENDED;
                return (
                  <td class:list={['border-l border-line p-4 text-center', isPopular ? 'bg-accent text-white' : 'bg-paper-dim/60 text-ink']}>
                    <p class="text-xl font-black">{headline[plan.id].price}</p>
                    <p class:list={['mt-0.5 text-[11px]', isPopular ? 'text-white/80' : 'text-ink-dim']}>{headline[plan.id].note}</p>
                    <p class:list={['mt-2 text-[11px] font-medium', isPopular ? 'text-white' : 'text-ink-dim']}>{plan.forWho}</p>
                  </td>
                );
              })
            }
          </tr>
        </thead>
        <tbody>
          {
            CARE_PLAN_ROWS.map(([label, ...values], ri) => (
              <tr class:list={[ri % 2 === 1 && 'bg-paper-dim/40']}>
                <th scope="row" class="bg-charcoal p-4 text-left text-sm font-semibold text-white">{label}</th>
                {values.map((val) => (
                  <td class="border-l border-line p-4 text-center text-sm text-ink-dim">
                    {isYes(val) && (
                      <>
                        <svg class="mx-auto h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <span class="sr-only">Yes</span>
                      </>
                    )}
                    {isNo(val) && (
                      <>
                        <svg class="mx-auto h-4 w-4 text-ink-dim/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                        </svg>
                        <span class="sr-only">No</span>
                      </>
                    )}
                    {!isYes(val) && !isNo(val) && val}
                  </td>
                ))}
              </tr>
            ))
          }
          <tr class="bg-paper">
            <td class="bg-charcoal p-4" />
            {
              CARE_PLANS.map((plan) => (
                <td class="border-l border-line p-4 text-center">
                  <a
                    href={`/contact/?package=care-${plan.id}`}
                    class="inline-flex items-center justify-center rounded-full bg-accent px-5 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-accent-dim"
                  >
                    Ask about {plan.name}
                  </a>
                </td>
              ))
            }
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Mobile: one card per plan, stacked -->
    <div class="space-y-4 md:hidden">
      {
        CARE_PLANS.map((plan, pi) => {
          const isPopular = plan.id === RECOMMENDED;
          return (
            <div class:list={['rounded-3xl border bg-white p-5 shadow-card', isPopular ? 'border-accent ring-2 ring-accent/20' : 'border-line']}>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="font-bold text-ink">{plan.name}</p>
                  <p class="text-xs text-ink-dim">{plan.forWho}</p>
                </div>
                {isPopular && (
                  <span class="shrink-0 rounded-full bg-accent px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-white">Recommended</span>
                )}
              </div>
              <p class="mt-3 text-xl font-black text-ink">{headline[plan.id].price}</p>
              <p class="text-[11px] text-ink-dim">{headline[plan.id].note}</p>
              <dl class="mt-4 space-y-1.5 border-t border-line pt-3 text-xs">
                {CARE_PLAN_ROWS.map(([label, ...values]) => (
                  <div class="flex justify-between gap-3">
                    <dt class="text-ink-dim">{label}</dt>
                    <dd class="text-right font-semibold text-ink">{values[pi]}</dd>
                  </div>
                ))}
              </dl>
              <a
                href={`/contact/?package=care-${plan.id}`}
                class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-accent px-5 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-accent-dim"
              >
                Ask about {plan.name}
              </a>
            </div>
          );
        })
      }
    </div>

    <p class="mt-6 text-center text-xs text-ink-dim">
      "No SaaS fees" means you never pay rent for software you own. A Care Plan is optional service work, priced separately.
      Full details in the <a href="/care-plan-terms/" class="font-semibold text-ink underline hover:text-accent">Care Plan terms</a>.
    </p>
  </Container>
</Section>

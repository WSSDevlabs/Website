---
import { FOUNDER, founderDisplayName } from '../../data/team';

/** The founder's photo once it's added in the CMS; until then, a monogram (never a stock photo). */
type Props = { size?: 'md' | 'lg'; class?: string };
const { size = 'md', class: className = '' } = Astro.props;
const dimension = size === 'lg' ? 'h-40 w-40 sm:h-48 sm:w-48' : 'h-24 w-24';
---

{
  FOUNDER.photo ? (
    <img
      src={FOUNDER.photo}
      alt={`${founderDisplayName}, ${FOUNDER.role} of WSS DevLabs`}
      width="384"
      height="384"
      loading="lazy"
      class:list={['rounded-2xl object-cover', dimension, className]}
    />
  ) : (
    <div
      class:list={['flex items-center justify-center rounded-2xl bg-ink font-display font-bold text-white', dimension, size === 'lg' ? 'text-6xl' : 'text-4xl', className]}
      role="img"
      aria-label={`${founderDisplayName}, ${FOUNDER.role}`}
    >
      {founderDisplayName.charAt(0)}
    </div>
  )
}

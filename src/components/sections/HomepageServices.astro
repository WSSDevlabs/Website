---
import Container from '../ui/Container.astro';

const services = [
  {
    num: '01',
    title: 'Web & Mobile App Development',
    description: 'Custom-built, typed, sub-second web & mobile applications with zero template lock-in.',
    href: '/services/web-development'
  },
  {
    num: '02',
    title: 'The Marketplace (15 Buy-Once PHP Systems)',
    description: 'Self-hosted booking engines, CRMs, clinic queues, and POS you own outright forever.',
    href: '/marketplace'
  },
  {
    num: '03',
    title: 'WSS Express Fixed-Price Packages',
    description: 'Rapid 3–7 day turnarounds with transparent pricing from RM 180 to RM 4,500.',
    href: '/express'
  },
  {
    num: '04',
    title: 'AI Systems & Bespoke Architecture',
    description: 'LLM agents, RAG document pipelines, custom ERPs, and automated workflow integrations.',
    href: '/services/artificial-intelligence-automation#ai-development'
  },
  {
    num: '05',
    title: 'IoT Solutions',
    description: 'Connected devices, sensor networks, and real-time monitoring systems built to integrate with your existing stack.',
    href: '/services/iot-solutions-infrastructure'
  }
];
---

<section class="py-16 md:py-24 border-t border-line/60 bg-paper-dim/30 overflow-hidden">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <!-- Left Column: Heading + Numbered Pill Services List -->
      <div>
        <h2 class="h-section font-black tracking-tight text-ink">
          Our <span class="badge-highlight">Services</span>
        </h2>

        <p class="mt-4 text-base leading-relaxed text-ink-dim max-w-lg">
          We bridge the gap between ideas and impact by crafting systems that are strategic, scalable, typed, and engineered for long-term business performance.
        </p>

        <!-- Numbered pill rows -->
        <div class="mt-8 space-y-3.5">
          {
            services.map((svc) => (
              <a
                href={svc.href}
                class="group flex items-center justify-between rounded-full border border-line bg-white px-6 py-4 shadow-sm transition-all duration-300 hover:border-ink hover:bg-paper-dim hover:scale-[1.02] hover:shadow-md"
              >
                <div class="flex items-center gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-dim font-mono text-xs font-bold text-ink group-hover:bg-ink group-hover:text-white transition-colors">
                    {svc.num}
                  </span>
                  <div>
                    <h3 class="text-sm sm:text-base font-bold text-ink group-hover:text-ink transition-colors">
                      {svc.title}
                    </h3>
                  </div>
                </div>

                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-dim text-ink-dim transition-all group-hover:bg-ink group-hover:text-white group-hover:translate-x-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Visual Collage Card with circular/pill actions and star -->
      <div class="relative">
        <!-- Decorative 8-point star -->
        <div class="absolute -top-6 -right-4 z-20 hidden sm:block">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ink text-white shadow-xl rotate-12">
            <svg class="h-8 w-8 fill-current" viewBox="0 0 24 24">
              <path d="M12 0l2.6 6.8L21.4 4.6l-2.2 7.4 7.4 2.2-6.8 2.6 4.6 6.8-7.4-2.2-2.2 7.4-2.6-6.8-6.8 4.6 2.2-7.4-7.4-2.2 6.8-2.6-4.6-6.8 7.4 2.2z" />
            </svg>
          </span>
        </div>

        <!-- Abstract Identity Panel (no stock photo) -->
        <div class="relative overflow-hidden rounded-[2.5rem] border border-line bg-charcoal shadow-2xl aspect-[4/3] sm:aspect-[1/1]">
          <div class="grid-pattern absolute inset-0 opacity-15" aria-hidden="true"></div>
          <div class="absolute -top-16 -left-16 h-64 w-64 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
          <div class="absolute -bottom-16 -right-16 h-64 w-64 rounded-full bg-accent-blue/15 blur-3xl" aria-hidden="true"></div>

          <!-- Bottom Action Buttons -->
          <div class="absolute bottom-6 inset-x-6 flex flex-wrap items-center justify-between gap-3 z-10">
            <a
              href="/about"
              class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white/95 px-5 py-2.5 text-xs sm:text-sm font-bold text-ink shadow-lg backdrop-blur-md transition hover:bg-white hover:scale-105"
            >
              <span>Meet the Founder</span>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>

            <a
              href="/work"
              class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-lg transition hover:bg-black hover:scale-105"
            >
              <span>See Our Work</span>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

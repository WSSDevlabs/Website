---
import Pill from '../ui/Pill.astro';
---

<section
  class="relative isolate flex min-h-[100dvh] flex-col justify-end overflow-hidden bg-charcoal text-white"
  data-noreveal
  data-hero-holo
  data-bg="/images/hero/hero-bg.jpg"
  data-depth="/images/hero/hero-depth.png"
>
  <!-- Plain photo: the fallback, and what shows while the 3D layer loads -->
  <img
    src="/images/hero/hero-bg.jpg"
    alt=""
    width="2200"
    height="1228"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[47%_center] md:object-center"
  />
  <!-- Pseudo-3D hologram layer: fades in over the photo once it is ready -->
  <canvas data-hero-canvas class="absolute inset-0 -z-20 h-full w-full opacity-0 transition-opacity duration-700" aria-hidden="true"></canvas>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/55 via-black/40 to-black/70" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-7xl px-6 md:px-10">
    <div class="grid items-end gap-8 pb-6 md:grid-cols-[1.1fr_0.9fr] md:gap-12 md:pb-10">
      <h1
        data-hero-item
        data-hero-delay="0.05"
        class="max-w-xl font-display text-[clamp(1.9rem,1.1rem+2.9vw,3.6rem)] font-medium leading-[1.08] tracking-[-0.03em] text-white"
      >
        Artificial Intelligence and technology solutions for real problems
      </h1>

      <div data-hero-item data-hero-delay="0.15" class="md:ml-auto md:max-w-xs">
        <p class="text-sm leading-relaxed text-white/75">
          Tell us what is not working. We will listen first, then build the AI and technology that actually helps.
        </p>
        <Pill href="/contact" label="Consult with us" variant="light" class="mt-5" />
      </div>
    </div>

    <p
      data-holo-wordmark
      class="pointer-events-none -mx-1 select-none whitespace-nowrap pb-2 font-display text-[clamp(3.2rem,15.6vw,17rem)] font-bold leading-[0.82] tracking-[-0.05em] text-white will-change-transform md:pb-4"
      aria-hidden="true"
      data-hero-item
      data-hero-delay="0.25"
    >
      WSS DevLabs
    </p>
  </div>
</section>

<span data-red-cursor-page hidden></span>

<script>
  import '../../scripts/heroHolo';
  import '../../scripts/redCursor';
</script>

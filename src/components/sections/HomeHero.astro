---
import VideoMedia from '../media/VideoMedia.astro';
import Pill from '../ui/Pill.astro';
import { CLIPS } from '../../data/media';
---

<section class="relative isolate flex min-h-[100dvh] flex-col justify-end bg-charcoal text-white" data-noreveal>
  <div class="absolute inset-0 -z-10">
    <VideoMedia clip={CLIPS.windFarm} eager class="h-full w-full" />
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/20 to-black/35" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-7xl px-6 pb-12 pt-48 md:px-10 md:pb-16">
    <div class="max-w-5xl" data-hero-item data-hero-delay="0.1">
      <h1 class="font-display text-[clamp(2.2rem,1.1rem+4vw,4.4rem)] font-bold uppercase leading-[0.98] tracking-[-0.035em] text-white">
        Artificial Intelligence and technology solutions for real problems
      </h1>
      <div class="mt-8 flex flex-wrap gap-3">
        <Pill href="/solutions" label="Explore solutions" variant="light" />
        <Pill href="/contact" label="Talk with us" variant="ghost" />
      </div>
    </div>
  </div>
</section>

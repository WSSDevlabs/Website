---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
---

<section class="relative overflow-hidden bg-paper-dim/40 py-16 md:py-24 border-y border-line" id="calculator">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <Eyebrow label="Interactive Estimation Tool" tone="yellow" />
      <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        Malaysian SME Project &amp; Grant Savings Calculator
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-dim sm:text-base">
        Calculate your exact project investment, check 2026 PMKS Madani Grant 50% subsidy deductions, and generate an instant quotation in seconds.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="mx-auto mt-12 max-w-4xl rounded-3xl border border-line bg-paper p-6 shadow-xl md:p-10">
      <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr]">
        <!-- Left Options -->
        <div class="space-y-6">
          <!-- Step 1: Select Project Base -->
          <div>
            <label for="project-tier-select" class="font-mono text-xs font-bold uppercase tracking-wider text-accent">
              01. Choose Solution Type:
            </label>
            <select
              id="project-tier-select"
              class="mt-2 w-full rounded-xl border border-line bg-paper-dim px-4 py-3 text-sm font-semibold text-ink transition focus:border-accent focus:outline-none"
            >
              <option value="180" data-name="WSS Express Landing (RM180/yr)" data-days="3-5 Days">
                WSS Express Landing Page — RM 180 / year
              </option>
              <option value="1500" data-name="WSS Express Starter (RM1,500)" data-days="3-7 Days" selected>
                WSS Express Starter (3 Custom Pages) — RM 1,500
              </option>
              <option value="4500" data-name="WSS Express Business (RM4,500)" data-days="7-14 Days">
                WSS Express Business (Full E-Commerce) — RM 4,500
              </option>
              <option value="749" data-name="Buy-Once Marketplace PHP System (RM749)" data-days="1-2 Days">
                Buy-Once Marketplace System (Full Source Code) — RM 749
              </option>
              <option value="8500" data-name="Bespoke Enterprise ERP / System (RM8,500)" data-days="14-21 Days">
                Bespoke Enterprise Engineering (Custom ERP/CRM) — RM 8,500
              </option>
            </select>
          </div>

          <!-- Step 2: Grant Matching Toggle -->
          <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-4">
            <div class="flex items-center justify-between">
              <div>
                <span class="font-bold text-xs text-emerald-800">Apply PMKS Madani Grant 2026?</span>
                <p class="text-[11px] text-emerald-900/70">50% government matching subsidy (up to RM 5,000 savings)</p>
              </div>
              <label class="relative inline-flex cursor-pointer items-center">
                <input type="checkbox" id="grant-toggle" class="peer sr-only" checked />
                <div class="peer h-6 w-11 rounded-full bg-line peer-checked:bg-emerald-600 peer-checked:after:translate-x-full peer-focus:outline-none after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all"></div>
              </label>
            </div>
          </div>

          <!-- Step 3: Optional Add-Ons -->
          <div>
            <p class="font-mono text-xs font-bold uppercase tracking-wider text-ink">
              02. Optional Architectural Add-Ons:
            </p>
            <div class="mt-3 space-y-2.5">
              <label class="flex cursor-pointer items-center justify-between rounded-xl border border-line bg-paper-dim/40 p-3 text-xs transition hover:bg-paper-dim">
                <div class="flex items-center gap-2.5">
                  <input type="checkbox" data-addon-price="500" data-addon-name="Malaysian Payment Gateways (ToyyibPay/Stripe)" class="addon-checkbox rounded border-line text-accent" />
                  <span class="font-medium text-ink">ToyyibPay / SenangPay / Stripe Gateway Integration</span>
                </div>
                <span class="font-bold text-ink">+RM 500</span>
              </label>

              <label class="flex cursor-pointer items-center justify-between rounded-xl border border-line bg-paper-dim/40 p-3 text-xs transition hover:bg-paper-dim">
                <div class="flex items-center gap-2.5">
                  <input type="checkbox" data-addon-price="1200" data-addon-name="24/7 AI Lead Qualification WhatsApp Bot" class="addon-checkbox rounded border-line text-accent" />
                  <span class="font-medium text-ink">24/7 AI Lead Qualification WhatsApp Bot</span>
                </div>
                <span class="font-bold text-ink">+RM 1,200</span>
              </label>

              <label class="flex cursor-pointer items-center justify-between rounded-xl border border-line bg-paper-dim/40 p-3 text-xs transition hover:bg-paper-dim">
                <div class="flex items-center gap-2.5">
                  <input type="checkbox" data-addon-price="3500" data-addon-name="Native iOS & Android Mobile App Extension" class="addon-checkbox rounded border-line text-accent" />
                  <span class="font-medium text-ink">Native iOS &amp; Android App Extension</span>
                </div>
                <span class="font-bold text-ink">+RM 3,500</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Right Summary & Quotation -->
        <div class="flex flex-col justify-between rounded-2xl border border-line bg-ink p-6 text-white shadow-xl">
          <div>
            <div class="flex items-center justify-between border-b border-white/10 pb-3 font-mono text-xs text-white/50">
              <span>ESTIMATED INVESTMENT</span>
              <span class="text-emerald-400">● Live Quote</span>
            </div>

            <!-- Price Calculations -->
            <div class="mt-4 space-y-2 text-xs">
              <div class="flex justify-between text-white/70">
                <span>Base Package:</span>
                <span class="font-mono text-white" id="calc-base-display">RM 1,500</span>
              </div>
              <div class="flex justify-between text-white/70">
                <span>Add-Ons:</span>
                <span class="font-mono text-white" id="calc-addons-display">RM 0</span>
              </div>
              <div class="flex justify-between text-emerald-400 font-semibold" id="calc-grant-row">
                <span>Madani Grant Subsidy (50%):</span>
                <span class="font-mono" id="calc-grant-display">-RM 750</span>
              </div>
            </div>

            <!-- Final Net Total -->
            <div class="mt-6 border-t border-white/10 pt-4">
              <span class="text-[11px] font-mono uppercase tracking-wider text-white/50">Net SME Investment:</span>
              <div class="mt-1 flex items-baseline gap-2">
                <span class="font-feature text-3xl font-extrabold text-white sm:text-4xl" id="calc-total-display">
                  RM 750
                </span>
                <span class="text-xs text-accent-yellow-vivid font-mono" id="calc-days-display">3-7 Days</span>
              </div>
            </div>

            <div class="mt-4 rounded-xl border border-white/10 bg-white/5 p-3 text-[11px] text-white/60">
              <p>✓ Includes full source code ownership</p>
              <p>✓ Direct WhatsApp with Razin &amp; Natasya</p>
              <p>✓ 90+ Mobile Lighthouse speed guaranteed</p>
            </div>
          </div>

          <!-- Instant Action -->
          <div class="mt-6 pt-4 border-t border-white/10">
            <a
              id="calc-whatsapp-btn"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 text-xs font-semibold text-white shadow-lg shadow-accent/30 transition hover:bg-accent-dim"
            >
              <span>WhatsApp This Quote to Builder</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  function initSMECalculator() {
    const select = document.getElementById('project-tier-select') as HTMLSelectElement | null;
    const grantToggle = document.getElementById('grant-toggle') as HTMLInputElement | null;
    const addonCheckboxes = document.querySelectorAll<HTMLInputElement>('.addon-checkbox');
    const baseDisplay = document.getElementById('calc-base-display');
    const addonsDisplay = document.getElementById('calc-addons-display');
    const grantDisplay = document.getElementById('calc-grant-display');
    const grantRow = document.getElementById('calc-grant-row');
    const totalDisplay = document.getElementById('calc-total-display');
    const daysDisplay = document.getElementById('calc-days-display');
    const whatsappBtn = document.getElementById('calc-whatsapp-btn') as HTMLAnchorElement | null;

    if (!select || !grantToggle || !totalDisplay || !whatsappBtn) return;

    function recalculate() {
      const basePrice = parseInt(select?.value || '1500', 10);
      const selectedOption = select?.options[select.selectedIndex];
      const packageName = selectedOption?.dataset.name || 'WSS Express Starter';
      const daysEstimate = selectedOption?.dataset.days || '3-7 Days';

      let addonsTotal = 0;
      const selectedAddons: string[] = [];

      addonCheckboxes.forEach((cb) => {
        if (cb.checked) {
          const price = parseInt(cb.dataset.addonPrice || '0', 10);
          const name = cb.dataset.addonName || '';
          addonsTotal += price;
          selectedAddons.push(name);
        }
      });

      const subtotal = basePrice + addonsTotal;
      const grantActive = grantToggle?.checked && basePrice >= 1000;
      let grantDiscount = 0;

      if (grantActive) {
        // 50% matching grant up to RM 5,000 max
        grantDiscount = Math.min(Math.round(subtotal * 0.5), 5000);
      }

      const netTotal = subtotal - grantDiscount;

      if (baseDisplay) baseDisplay.textContent = `RM ${basePrice.toLocaleString()}`;
      if (addonsDisplay) addonsDisplay.textContent = `RM ${addonsTotal.toLocaleString()}`;
      if (grantDisplay) grantDisplay.textContent = `-RM ${grantDiscount.toLocaleString()}`;
      if (grantRow) grantRow.style.display = grantActive ? 'flex' : 'none';
      if (totalDisplay) totalDisplay.textContent = `RM ${netTotal.toLocaleString()}`;
      if (daysDisplay) daysDisplay.textContent = daysEstimate;

      // Construct prefilled WhatsApp Message
      const message = `Hi WSS DevLabs! I calculated a project quote on your website:
- Base: ${packageName}
- Add-ons: ${selectedAddons.length > 0 ? selectedAddons.join(', ') : 'None'}
- Grant Applied: ${grantActive ? 'Yes (50% Madani Subsidy)' : 'No'}
- Estimated Net Investment: RM ${netTotal.toLocaleString()}

Please confirm availability for this sprint.`;

      if (whatsappBtn) {
        whatsappBtn.href = `https://wa.me/601127205895?text=${encodeURIComponent(message)}`;
      }
    }

    select.addEventListener('change', recalculate);
    grantToggle.addEventListener('change', recalculate);
    addonCheckboxes.forEach((cb) => cb.addEventListener('change', recalculate));

    recalculate();
  }

  initSMECalculator();
  document.addEventListener('astro:page-load', initSMECalculator);
</script>

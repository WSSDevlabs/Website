---
import Container from '../ui/Container.astro';

// Home only. Desktop: pinned horizontal pan (scrollScenes → initHorizontalPan).
// Phones and reduced motion: native swipe row with scroll-snap.
// One real-world problem per sector, in the client's own words, linking to the fix.

const PROBLEMS = [
  { quote: 'Elephants reached the crop again last night.', sector: 'Agriculture', href: '/solutions#agriculture', tone: 'dark' },
  { quote: 'Boiler output dropped and nobody can say why.', sector: 'Biomass', href: '/solutions#biomass', tone: 'light' },
  { quote: 'Residents posted the flood before we saw it.', sector: 'Smart City', href: '/solutions#smart-city', tone: 'accent' },
  { quote: 'One electricity bill a month, and no idea where it goes.', sector: 'Energy & Sustainability', href: '/solutions#energy-sustainability', tone: 'light' },
  { quote: 'The digester soured over the weekend.', sector: 'Waste-to-Energy', href: '/solutions#waste-to-energy', tone: 'dark' },
  { quote: 'Our website still says 2019.', sector: 'Websites, Apps & IoT', href: '/solutions#digital-foundations', tone: 'light' },
  { quote: 'Three systems, and staff still re-type every order.', sector: 'SME Digital Shift', href: '/solutions#sme-digital-shift', tone: 'accent' }
] as const;

const TONES = {
  dark: 'bg-charcoal text-white border-white/10',
  light: 'bg-white text-ink border-line',
  accent: 'bg-accent text-white border-accent'
};
---

<section data-hpan data-noreveal class="relative overflow-hidden border-t border-line/60 bg-paper py-16 md:py-0" aria-labelledby="problems-title">
  <div class="md:flex md:h-[100dvh] md:min-h-[600px] md:flex-col md:justify-center">
    <Container class="mb-8 md:mb-12">
      <div class="max-w-2xl">
        <h2 id="problems-title" class="h-section font-black tracking-tight text-ink">
          Problems we get <span class="badge-highlight">called for</span>
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">What owners and operators tell us on the first call, and where each one gets solved.</p>
      </div>
    </Container>

    <div data-hpan-viewport class="snap-x snap-mandatory overflow-x-auto">
      <ol data-hpan-track class="flex w-max gap-5 px-6 md:gap-7 md:px-10 xl:px-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))]">
        {
          PROBLEMS.map((problem, i) => (
            <li class="shrink-0 snap-start">
              <a
                href={problem.href}
                class:list={[
                  'group relative flex h-[22rem] w-[80vw] flex-col justify-between overflow-hidden rounded-[2.25rem] border p-8 shadow-[0_30px_70px_-35px_rgba(25,25,27,0.45)] transition-transform duration-500 hover:-translate-y-1.5 sm:w-[420px] md:h-[26rem] md:p-10',
                  TONES[problem.tone]
                ]}
              >
                {problem.tone === 'dark' && <div class="grid-pattern pointer-events-none absolute inset-0 opacity-[0.07] invert" aria-hidden="true" />}
                <span class="relative font-feature text-sm font-semibold opacity-60">{String(i + 1).padStart(2, '0')}</span>
                <p class="relative font-display text-[1.85rem] font-bold leading-[1.1] tracking-tight md:text-[2.2rem]">
                  “{problem.quote}”
                </p>
                <span class="relative inline-flex items-center gap-2 text-sm font-bold">
                  {problem.sector}
                  <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
        <li class="shrink-0 snap-start">
          <a
            href="/resources"
            class="group flex h-[22rem] w-[80vw] flex-col justify-center rounded-[2.25rem] border border-dashed border-ink/25 p-8 text-ink transition-colors hover:border-ink hover:bg-white sm:w-[360px] md:h-[26rem] md:p-10"
          >
            <p class="font-display text-2xl font-bold tracking-tight">See the fixes running</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-dim">Detection, digital twins and monitoring demos in WSS Labs.</p>
            <span class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm font-bold text-white transition-transform group-hover:scale-105">
              Open Labs
            </span>
          </a>
        </li>
      </ol>
    </div>

    <Container class="mt-10 hidden md:block">
      <div class="h-px bg-line" aria-hidden="true">
        <div data-hpan-progress class="h-full w-full bg-ink"></div>
      </div>
    </Container>
  </div>
</section>

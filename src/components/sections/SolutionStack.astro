---
import Container from '../ui/Container.astro';
import { SECTORS, STACK_LAYERS } from '../../data/sectors';

const LAYER_ICONS: Record<string, string> = {
  sense:
    'M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z',
  connect:
    'M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244',
  understand:
    'M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z',
  act: 'm3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z'
};

type Props = {
  /** Show one sector only (sector pages) instead of the sector tabs. */
  only?: string;
};

const { only } = Astro.props;
const sectors = only ? SECTORS.filter((s) => s.slug === only) : SECTORS;
---

<section class="bg-paper py-16 md:py-24" data-stack-root>
  <Container>
    <div class="relative overflow-hidden rounded-[2.5rem] bg-charcoal px-6 py-14 text-white shadow-2xl sm:px-12 lg:px-16 lg:py-20">
      <div class="grid-pattern pointer-events-none absolute inset-0 opacity-[0.07] invert" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-24 -top-24 h-80 w-80 rounded-full bg-accent/25 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 -right-24 h-80 w-80 rounded-full bg-accent-blue/25 blur-3xl" aria-hidden="true"></div>
      <div
        data-scene="network"
        class="pointer-events-none absolute -right-[8%] -top-[12%] hidden h-[75%] w-[60%] md:block"
        aria-hidden="true"
      ></div>

      <div class="relative">
        <p class="mono-label text-white/55" data-scramble>How a solution comes together</p>
        <h2 class="h-section mt-4 max-w-2xl !text-white">
          Sense. Connect. Understand. <span class="badge-highlight">Act.</span>
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-white/65">
          {
            only
              ? 'What we put in each of the four layers for this sector.'
              : 'Every project we build follows the same four layers. Pick a sector to see what sits in each one.'
          }
        </p>

        {
          !only && (
            <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="Choose a sector">
              {sectors.map((sector, i) => (
                <button
                  type="button"
                  role="tab"
                  data-stack-tab={sector.slug}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  class:list={[
                    'rounded-full border px-4 py-2 text-xs font-bold transition-all sm:text-sm',
                    i === 0
                      ? 'border-white bg-white text-ink'
                      : 'border-white/20 bg-white/5 text-white/75 hover:border-white/50 hover:text-white'
                  ]}
                >
                  {sector.name}
                </button>
              ))}
            </div>
          )
        }

        <div class="relative mt-10">
          <div class="absolute left-[1.375rem] right-[1.375rem] top-[1.375rem] hidden h-px bg-white/10 lg:block" aria-hidden="true">
            <div data-draw-line class="h-full w-full bg-gradient-to-r from-accent via-white/70 to-accent-blue"></div>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
              STACK_LAYERS.map((layer) => (
                <div class="tilt-card relative rounded-3xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm">
                  <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white text-ink ring-4 ring-charcoal">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d={LAYER_ICONS[layer.key]} />
                    </svg>
                  </span>
                  <h3 class="mt-5 text-lg font-bold tracking-tight">{layer.label}</h3>
                  <p class="mt-1 text-sm text-white/55">{layer.verb}</p>
                  {sectors.map((sector, k) => (
                    <ul data-stack-panel={sector.slug} hidden={k !== 0} class="mt-5 space-y-2.5 text-sm text-white/85">
                      {sector.stack[layer.key].map((item) => (
                        <li class="flex gap-2.5">
                          <span class="mt-[0.55rem] h-0.5 w-3 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import { gsap } from 'gsap';

  function initStackTabs() {
    document.querySelectorAll<HTMLElement>('[data-stack-root]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stack-tab]'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      tabs.forEach((tab) =>
        tab.addEventListener('click', () => {
          const slug = tab.dataset.stackTab;
          tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute('aria-selected', String(on));
            t.classList.toggle('bg-white', on);
            t.classList.toggle('text-ink', on);
            t.classList.toggle('border-white', on);
            t.classList.toggle('bg-white/5', !on);
            t.classList.toggle('text-white/75', !on);
            t.classList.toggle('border-white/20', !on);
          });
          const shown: HTMLElement[] = [];
          root.querySelectorAll<HTMLElement>('[data-stack-panel]').forEach((panel) => {
            const on = panel.dataset.stackPanel === slug;
            panel.toggleAttribute('hidden', !on);
            if (on) shown.push(...Array.from(panel.children) as HTMLElement[]);
          });
          if (!reduce) {
            gsap.fromTo(shown, { autoAlpha: 0, x: -10 }, { autoAlpha: 1, x: 0, duration: 0.45, stagger: 0.035, ease: 'power3.out' });
          }
        })
      );
    });
  }

  document.addEventListener('astro:page-load', initStackTabs);
</script>

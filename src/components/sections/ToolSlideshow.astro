---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import type { ToolSlide } from '../../data/toolShowcase';

interface Props {
  slides: ToolSlide[];
  title?: string;
  intro?: string;
}
const {
  slides,
  title = 'Real tools, real hardware',
  intro = 'A look at the software and hardware this kind of work runs on. Most of it is open-source, so you are never locked in, and we always pick what fits your site and budget.'
} = Astro.props;
---

<Section rule>
  <Container>
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="mono-label text-accent">In practice</p>
      <h2 class="h-section mt-3">{title}</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-dim">{intro}</p>
    </div>

    <div class="tool-show" data-tool-show>
      <!-- main stage: a scroll-snap track, so touch swipe works without any library -->
      <div class="relative overflow-hidden rounded-[2rem] bg-charcoal shadow-[0_30px_70px_-40px_rgba(0,0,0,0.6)]">
        <div class="tool-track flex snap-x snap-mandatory overflow-x-auto" data-track tabindex="0" aria-label={`${title} slideshow`} role="region">
          {
            slides.map((slide, i) => (
              <figure class="tool-slide relative aspect-[4/3] w-full shrink-0 snap-center sm:aspect-[16/9]" data-slide aria-label={`${i + 1} of ${slides.length}: ${slide.name}`}>
                {slide.fit === 'contain' && (
                  <img src={slide.img} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-40 blur-2xl" loading="lazy" />
                )}
                <img
                  src={slide.img}
                  alt={`${slide.name}: ${slide.caption}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class:list={['absolute inset-0 h-full w-full', slide.fit === 'contain' ? 'object-contain p-4 pb-24 sm:p-8 sm:pb-28' : 'object-cover']}
                />
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/55 to-transparent px-5 pb-5 pt-14 text-white sm:px-8 sm:pb-7">
                  <p class="font-display text-lg font-semibold tracking-tight sm:text-xl">{slide.name}</p>
                  <p class="mt-1 max-w-2xl text-xs leading-relaxed text-white/75 sm:text-sm">{slide.caption}</p>
                  <a href={slide.source} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-[10px] text-white/50 underline-offset-2 hover:text-white/80 hover:underline">
                    Image: {slide.credit} · {slide.license}
                  </a>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <button type="button" data-prev aria-label="Previous slide" class="tool-arrow left-3 sm:left-5">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
        </button>
        <button type="button" data-next aria-label="Next slide" class="tool-arrow right-3 sm:right-5">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
        </button>
        <div class="absolute right-4 top-4 rounded-full bg-black/45 px-3 py-1 font-mono text-[11px] text-white/85 backdrop-blur sm:right-6 sm:top-5" aria-hidden="true">
          <span data-count>1</span> / {slides.length}
        </div>
        <div class="absolute inset-x-0 top-0 h-1 bg-white/10" aria-hidden="true"><div class="tool-progress h-full bg-accent" data-progress></div></div>
      </div>

      <!-- thumbnails -->
      <div class="mt-4 flex gap-3 overflow-x-auto pb-2" role="tablist" aria-label="Choose a slide">
        {
          slides.map((slide, i) => (
            <button
              type="button"
              role="tab"
              data-thumb={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`Show ${slide.name}`}
              class="tool-thumb group relative h-16 w-28 shrink-0 overflow-hidden rounded-xl bg-charcoal ring-2 ring-transparent transition sm:h-20 sm:w-36"
            >
              <img src={slide.img} alt="" loading="lazy" class="h-full w-full object-cover opacity-60 transition group-hover:opacity-90" />
              <span class="absolute inset-x-0 bottom-0 truncate bg-black/55 px-2 py-0.5 text-left text-[10px] font-semibold text-white">{slide.name}</span>
            </button>
          ))
        }
      </div>
    </div>
  </Container>
</Section>

<style is:global>
  .tool-track { scrollbar-width: none; scroll-behavior: smooth; }
  .tool-track::-webkit-scrollbar { display: none; }
  .tool-arrow {
    position: absolute;
    top: 42%;
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.9);
    color: #121214;
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.5);
    transition: transform 0.3s, background 0.3s;
  }
  .tool-arrow:hover { transform: scale(1.08); background: #fff; }
  .tool-thumb[aria-selected='true'] { --tw-ring-color: var(--color-accent); }
  .tool-thumb[aria-selected='true'] img { opacity: 1; }
  .tool-progress { width: 0; }
  .tool-show.is-playing .tool-progress { animation: tool-progress var(--tool-delay, 5s) linear forwards; }
  @keyframes tool-progress { from { width: 0; } to { width: 100%; } }
  @media (prefers-reduced-motion: reduce) {
    .tool-track { scroll-behavior: auto; }
    .tool-show.is-playing .tool-progress { animation: none; }
  }
</style>

<script>
  // Autoplay every 5 s; pauses on hover, focus, touch, or when off screen. Arrows, thumbnails, swipe and arrow keys all work.
  function initToolShows() {
    document.querySelectorAll<HTMLElement>('[data-tool-show]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const track = root.querySelector<HTMLElement>('[data-track]')!;
      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
      const thumbs = Array.from(root.querySelectorAll<HTMLElement>('[data-thumb]'));
      const count = root.querySelector<HTMLElement>('[data-count]');
      const progress = root.querySelector<HTMLElement>('[data-progress]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const DELAY = 5000;
      let index = 0;
      let timer = 0;
      let hovered = false;
      let visible = false;

      const mark = (i: number) => {
        index = i;
        thumbs.forEach((t, n) => t.setAttribute('aria-selected', String(n === i)));
        if (count) count.textContent = String(i + 1);
        thumbs[i]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      };
      const go = (i: number) => {
        const next = (i + slides.length) % slides.length;
        track.scrollTo({ left: slides[next].offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
        mark(next);
        restart();
      };
      const restart = () => {
        window.clearTimeout(timer);
        root.classList.remove('is-playing');
        if (reduced || hovered || !visible) return;
        void progress?.offsetWidth; // restart the progress bar animation
        root.classList.add('is-playing');
        timer = window.setTimeout(() => {
          if (!document.body.contains(root)) return;
          go(index + 1);
        }, DELAY);
      };

      // keep the counter right when the visitor swipes
      let scrollTick = 0;
      track.addEventListener('scroll', () => {
        window.clearTimeout(scrollTick);
        scrollTick = window.setTimeout(() => {
          const i = Math.round(track.scrollLeft / track.clientWidth);
          if (i !== index) { mark(i); restart(); }
        }, 120);
      });

      root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
      root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
      thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
      });
      root.addEventListener('mouseenter', () => { hovered = true; restart(); });
      root.addEventListener('mouseleave', () => { hovered = false; restart(); });
      root.addEventListener('focusin', () => { hovered = true; restart(); });
      root.addEventListener('focusout', () => { hovered = false; restart(); });
      root.addEventListener('touchstart', () => { hovered = true; restart(); }, { passive: true });

      new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; restart(); }, { threshold: 0.35 }).observe(root);
      root.style.setProperty('--tool-delay', `${DELAY}ms`);
    });
  }
  document.addEventListener('astro:page-load', initToolShows);
</script>

---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
---

<Section rule>
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="h-section" data-split>Whatever it is, we probably build it</h2>
    </div>

    <!-- Image placeholder: swap for a real laptop/desktop/mobile product shot once available -->
    <div class="mt-12 flex aspect-[16/9] flex-col items-center justify-center gap-4 rounded-3xl border-2 border-dashed border-line bg-paper-dim p-10 text-center sm:aspect-[21/9]">
      <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-paper text-muted shadow-card">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75 8.69 9.31a2.25 2.25 0 0 1 3.182 0l5.658 5.658m-1.5-1.5 1.318-1.318a2.25 2.25 0 0 1 3.182 0l2.85 2.85M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Zm10.5-13.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
        </svg>
      </span>
      <p class="font-semibold text-ink">Image placeholder</p>
      <p class="max-w-md text-sm leading-relaxed text-ink-dim">
        Gambar laptop, komputer, mobile app yang ada real design
      </p>
    </div>
  </Container>
</Section>

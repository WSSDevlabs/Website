---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';

/**
 * Case studies (audit 3.18 template): only published ones with written permission on file.
 * Renders nothing until the first real one exists. A /work/ page comes only after 6+.
 */
type Props = {
  offer?: 'websites' | 'systems' | 'custom';
  limit?: number;
  title?: string;
};

const { offer, limit = 1, title = 'Recent work' } = Astro.props;

const studies = (
  await getCollection('caseStudies', ({ data }) => !data.draft && data.permissionOnFile && (!offer || data.offer === offer))
)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, limit);
---

{
  studies.length > 0 && (
    <section class="py-16 md:py-24">
      <Container>
        <h2 class="h-section">{title}</h2>
        <div class="mt-10 space-y-10">
          {studies.map(({ data }) => (
            <article class="card grid gap-8 p-6 md:grid-cols-2 md:p-10">
              <div>
                <p class="text-sm font-semibold text-ink-dim">
                  {data.client}, {data.industry}
                </p>
                <p class="price mt-3 text-3xl">{data.result}</p>
                <h3 class="h-sub mt-6">The problem</h3>
                <p class="mt-2 text-ink-dim">{data.problem}</p>
                <h3 class="h-sub mt-6">What we built</h3>
                <p class="mt-2 text-ink-dim">{data.built}</p>
                {data.quote && (
                  <blockquote class="mt-6 border-l-2 border-accent pl-4 text-ink">
                    <p>&ldquo;{data.quote.text}&rdquo;</p>
                    <footer class="mt-2 text-sm text-ink-dim">
                      {data.quote.name}, {data.quote.role}
                    </footer>
                  </blockquote>
                )}
              </div>
              {data.screenshots.length > 0 && (
                <div class="grid gap-4">
                  {data.screenshots.map((shot) => (
                    <Image src={shot.src} alt={shot.alt} class="w-full rounded-xl border border-line" widths={[480, 960]} sizes="(min-width: 768px) 50vw, 100vw" />
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </Container>
    </section>
  )
}

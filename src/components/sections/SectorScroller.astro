---
import Container from '../ui/Container.astro';
import VideoMedia from '../media/VideoMedia.astro';
import { SECTORS } from '../../data/sectors';
import { CLIPS } from '../../data/media';

// Desktop (lg+): pinned; scrolling steps through the sectors.
// Tablet, phone and reduced motion: the same markup works as tabs.
// Behaviour lives in scripts/scrollScenes.ts → initSectorScroller.
---

<section data-sector-scroller data-noreveal class="relative border-t border-line/60 bg-paper" aria-labelledby="sectors-title">
  <div data-ss-pin class="relative py-16 md:py-20 lg:flex lg:h-[100dvh] lg:flex-col lg:justify-center lg:pb-6 lg:pt-32">
    <div class="grid-pattern mask-fade-edges pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="sectors-title" class="h-section font-black tracking-tight text-ink">
          Where we apply <span class="badge-highlight">technology</span>
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-ink-dim">
          Seven sectors, one method: measure what happens, connect it, let AI and analytics make sense of it, then act on it.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-8 lg:mt-8 lg:grid-cols-[0.8fr_1.3fr_1fr] lg:items-center lg:gap-12">
        <!-- Sector list -->
        <div class="relative -mx-6 min-w-0 px-6 lg:mx-0 lg:px-0">
          <div class="absolute bottom-0 left-0 top-0 hidden w-px bg-line lg:block" aria-hidden="true">
            <div data-ss-progress class="h-full w-full bg-accent"></div>
          </div>
          <div class="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none] lg:block lg:overflow-visible lg:pb-0" role="tablist" aria-label="Sectors">
            {
              SECTORS.map((sector, i) => (
                <button
                  type="button"
                  role="tab"
                  data-ss-item
                  aria-selected={i === 0 ? 'true' : 'false'}
                  class:list={[
                    'flex shrink-0 items-center gap-3 rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-ink-dim transition-colors hover:text-ink',
                    'lg:w-full lg:rounded-none lg:border-0 lg:bg-transparent lg:py-2.5 lg:pl-6 lg:pr-0 lg:text-left lg:text-lg',
                    i === 0 && 'is-active'
                  ]}
                >
                  <span class="ss-dot hidden h-2 w-2 shrink-0 rounded-full bg-accent lg:block" aria-hidden="true" />
                  {sector.name}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Media -->
        <div class="relative aspect-[4/3] overflow-hidden rounded-[2rem] border border-line bg-charcoal shadow-[0_30px_70px_-30px_rgba(25,25,27,0.45)] lg:aspect-[5/6] lg:max-h-[54vh] lg:w-full">
          {
            SECTORS.map((sector, i) => (
              <div data-ss-media class:list={['absolute inset-0', i === 0 && 'is-active']}>
                <VideoMedia clip={CLIPS[sector.teaserClip]} manual class="h-full w-full" />
              </div>
            ))
          }
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/50 to-transparent" aria-hidden="true"></div>
        </div>

        <!-- Panels -->
        <div class="min-h-[18rem]">
          {
            SECTORS.map((sector, i) => (
              <div data-ss-panel role="tabpanel" hidden={i !== 0} class:list={[i === 0 && 'is-active']}>
                <h3 data-ss-line class="h-sub text-ink">
                  {sector.titleLead} {sector.titleHighlight}
                </h3>
                <p data-ss-line class="mt-3 text-sm leading-relaxed text-ink-dim sm:text-base">
                  {sector.summary}
                </p>
                <ul class="mt-5 space-y-2.5">
                  {sector.useCases.slice(0, 4).map((useCase, k) => (
                    <li data-ss-line class="flex items-baseline gap-3 text-sm text-ink">
                      <span class="font-mono text-[0.7rem] text-ink-dim">/0{k + 1}</span>
                      {useCase.title}
                    </li>
                  ))}
                </ul>
                <a
                  data-ss-line
                  href={`/solutions#${sector.slug}`}
                  class="mt-7 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm font-bold text-white shadow-md transition-all hover:scale-105 hover:bg-black"
                >
                  Explore {sector.name}
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </div>
</section>

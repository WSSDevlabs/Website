---
import Container from '../ui/Container.astro';
import { TESTIMONIALS } from '../../data/testimonials';

/** Real client reviews only. Renders nothing until one is published with permission (audit H9, R1). */
type Props = { id?: string; title?: string };
const { id = 'reviews', title = 'What clients say' } = Astro.props;
const reviews = TESTIMONIALS.slice(0, 3);
---

{
  reviews.length > 0 && (
    <section id={id} class="py-16 md:py-24">
      <Container>
        <h2 class="h-section">{title}</h2>
        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {reviews.map((review) => (
            <li class="card flex flex-col p-6">
              <blockquote class="text-lg text-ink">&ldquo;{review.quote}&rdquo;</blockquote>
              <p class="mt-auto pt-5 text-sm text-ink-dim">
                <span class="font-semibold text-ink">{review.name}</span>, {review.role}
                {review.company && <>, {review.company}</>}
                {review.source && <span class="block">Review on {review.source}</span>}
              </p>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )
}

---
import Container from '../ui/Container.astro';
import { TESTIMONIALS, type Testimonial } from '../../data/testimonials';

type Props = {
  testimonials?: Testimonial[];
};

const { testimonials = TESTIMONIALS } = Astro.props;
---

{
  testimonials.length > 0 && (
    <section class="py-16 md:py-24 bg-paper text-ink border-t border-line/60 overflow-hidden">
      <Container>
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="h-section font-black tracking-tight text-ink">
            What Clients Say <span class="badge-highlight">About Us</span>
          </h2>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 max-w-5xl mx-auto">
          {
            testimonials.map((t) => (
              <div class="flex flex-col justify-between rounded-3xl border border-line bg-white p-8 shadow-card transition-all duration-300 hover:border-ink/40 hover:shadow-card-hover">
                <div>
                  <h3 class="font-bold text-ink text-base">{t.author}</h3>
                  <p class="text-xs text-ink-dim">
                    {t.role}
                    {t.company && (
                      <>
                        {' '}· <span class="text-ink font-semibold">{t.company}</span>
                      </>
                    )}
                  </p>
                </div>

                <p class="mt-6 text-sm sm:text-base leading-relaxed text-ink/90 font-normal italic">
                  "{t.quote}"
                </p>

                {t.rating && (
                  <div class="mt-6 flex items-center gap-1 text-amber-500">
                    {Array.from({ length: t.rating }).map(() => (
                      <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </Container>
    </section>
  )
}

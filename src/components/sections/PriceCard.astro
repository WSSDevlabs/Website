---
import Icon from '../ui/Icon.astro';
import Disclosure from '../ui/Disclosure.astro';
import { formatRM, type WebsitePackage } from '../../data/catalog';

/** Package card per audit 12.6: name, price on line 2, who it's for, 5 benefits, timeline, one button, full spec collapsed. */
type Props = { pkg: WebsitePackage };
const { pkg } = Astro.props;
const featured = Boolean(pkg.badge);
const quoteHref = `/contact/?need=website&package=${pkg.id}`;
---

<article
  class:list={['card relative flex flex-col p-6 sm:p-7', featured && 'border-2 border-accent shadow-[var(--shadow-lift)]']}
  id={pkg.id}
>
  {
    featured && (
      <p class="absolute -top-3.5 left-6 rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
        {pkg.badge}
      </p>
    )
  }
  <h3 class="h-sub">{pkg.name}</h3>
  <p class="price mt-2 text-4xl">
    {formatRM(pkg.price)}<span class="ml-1 text-base font-medium text-ink-dim">one-time</span>
  </p>
  <p class="mt-2 text-ink-dim">{pkg.whoFor}</p>

  <ul class="mt-6 space-y-3">
    {
      pkg.highlights.map((item) => (
        <li class="flex gap-3">
          <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent" />
          <span class="text-ink">{item}</span>
        </li>
      ))
    }
  </ul>

  <p class="mt-6 font-semibold text-ink">{pkg.timeline}</p>
  <p class="mt-1 text-sm text-muted">{pkg.renewal}</p>

  <a href={quoteHref} class:list={['btn mt-6 w-full', featured ? 'btn-primary' : 'btn-secondary']} data-track="quote_click">
    Get a fixed quote
  </a>

  <Disclosure summary="See everything included" class="mt-4 border-t border-line pt-2" summaryClass="py-2 text-sm font-semibold text-ink">
    <dl class="space-y-4 text-sm">
      <div>
        <dt class="font-semibold text-ink">Who it's for</dt>
        <dd class="mt-1 text-ink-dim">{pkg.spec.who}</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">The problem it solves</dt>
        <dd class="mt-1 text-ink-dim">{pkg.spec.problem}</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">Included</dt>
        <dd class="mt-1">
          <ul class="list-disc space-y-1 pl-5 text-ink-dim">
            {pkg.spec.included.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">Not included</dt>
        <dd class="mt-1">
          <ul class="list-disc space-y-1 pl-5 text-ink-dim">
            {pkg.spec.notIncluded.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">Price and payment</dt>
        <dd class="mt-1 text-ink-dim">{pkg.spec.payment}</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">Timeline</dt>
        <dd class="mt-1 text-ink-dim">{pkg.spec.timeline}</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">Revisions</dt>
        <dd class="mt-1 text-ink-dim">{pkg.spec.revisions}</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">What you provide</dt>
        <dd class="mt-1 text-ink-dim">{pkg.spec.youProvide}</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">Handover and approval</dt>
        <dd class="mt-1 text-ink-dim">{pkg.spec.handover}</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink">Warranty</dt>
        <dd class="mt-1 text-ink-dim">{pkg.spec.warranty}</dd>
      </div>
    </dl>
  </Disclosure>
</article>

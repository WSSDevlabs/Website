---
import Container from '../ui/Container.astro';
import Pill from '../ui/Pill.astro';

// Four WSS DevLabs courses, written for us. Formats and lengths are agreed with each client, so no fixed prices or promised results appear here.
const courses = [
  {
    id: 'ai-at-work',
    tag: 'AI',
    title: 'AI tools at work',
    short: 'Use AI assistants for quotes, emails and reports, safely and well.',
    tone: 'tint',
    intro:
      'Most people have tried an AI assistant once and then gone back to the old way. This course turns a curiosity into a daily habit, and keeps your business data safe while you do it.',
    learn: [
      'Writing clear requests that get useful answers the first time',
      'Drafting quotes, emails, replies and reports in minutes',
      'Summarising long documents and meeting notes',
      'Checking AI answers before you rely on them',
      'What business or customer data must never be pasted in'
    ],
    who: 'Owners, admin staff, sales and support teams. No technical background needed.',
    sections: [
      { h: 'Why it matters', p: 'The people who use AI well save hours every week on writing and summarising. The people who use it carelessly risk leaking private information or sending out wrong answers. A short, practical session prevents the second and unlocks the first.' },
      { h: 'How it works', p: 'We use your real tasks, such as a quote you need to send or a report you dread writing. You leave with prompts you can reuse, and a simple one-page rulebook for your team.' }
    ]
  },
  {
    id: 'digital-marketing',
    tag: 'Marketing',
    title: 'Digital marketing for owners',
    short: 'Get found online: Google Business Profile, social posting and paid ads.',
    tone: 'paper',
    intro:
      'You do not need to become a marketer. You need a clear plan for the few things that actually bring customers, and the confidence to run them yourself.',
    learn: [
      'Setting up and keeping a Google Business Profile that gets calls',
      'Choosing a posting rhythm you can keep up',
      'Writing posts and ads that sound like you',
      'How paid ads work, and how to avoid wasting budget',
      'Reading simple numbers to see what is working'
    ],
    who: 'Business owners and anyone who looks after marketing alongside another job.',
    sections: [
      { h: 'Why it matters', p: 'Customers now check Google and social pages before they call. A tidy, active presence builds trust before you say a word, and costs far less than it used to.' },
      { h: 'How it works', p: 'We build your plan live, on your own accounts. You practise each step during the session, so you finish with real posts scheduled and a checklist to follow.' }
    ]
  },
  {
    id: 'linkedin',
    tag: 'Social media',
    title: 'LinkedIn for business',
    short: 'Turn a company page and a personal profile into a steady source of enquiries.',
    tone: 'tint',
    intro:
      'LinkedIn is where buyers, partners and future staff check you out. This course shows you how to look credible, be easy to find and start the right conversations.',
    learn: [
      'A profile and company page that explain what you do in seconds',
      'What to post, and what to leave out',
      'Finding and approaching the right people politely',
      'Collecting recommendations that build trust',
      'Keeping it up with a few minutes a week'
    ],
    who: 'Owners, sales and business development teams, and consultants selling to other businesses.',
    sections: [
      { h: 'Why it matters', p: 'Many business decisions are made between professionals who already know of each other. A clear, active profile puts you on the list, and recommendations from past clients carry more weight than any advert.' },
      { h: 'How it works', p: 'We rewrite your profile together, plan a month of simple posts and practise a few real messages. You leave with templates you can reuse.' }
    ]
  },
  {
    id: 'automation',
    tag: 'Automation',
    title: 'Automate your daily work',
    short: 'Connect your apps so repetitive steps run on their own.',
    tone: 'paper',
    intro:
      'If you copy the same details from one place to another every day, a computer can do it for you. This course shows how to spot those tasks and set up simple automations.',
    learn: [
      'Finding the tasks that are worth automating',
      'Connecting forms, spreadsheets, email and chat apps',
      'Building a simple flow from trigger to result',
      'Adding checks so mistakes are caught early',
      'When to call us for something bigger'
    ],
    who: 'Owners and team leads who want to save time without hiring a developer.',
    sections: [
      { h: 'Why it matters', p: 'Repetitive work is where time and small errors hide. Removing even one weekly task gives your team back hours, and the habit of spotting such tasks keeps paying off.' },
      { h: 'How it works', p: 'We pick one real task from your business and automate it during the session. You see exactly how it is built, so you can build the next one yourself.' }
    ]
  }
];
---

<section class="bg-white py-16 md:py-24" data-tight id="courses" data-courses>
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-paper-dim px-3.5 py-1.5 text-xs font-semibold text-ink-dim"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Training and courses</span>
      <h2 class="mt-5 font-display text-[clamp(2rem,1.3rem+3vw,3.4rem)] font-bold leading-[1.05] tracking-[-0.035em] text-ink">Learn it once, use it every day</h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-dim">
        Technology only pays off when your people feel confident using it. We run small, hands-on courses for your team, at your office or online, in English or Bahasa Malaysia. Pick a course to see what is inside.
      </p>
    </div>

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        courses.map((course, i) => (
          <li>
            <button
              type="button"
              data-course-open={course.id}
              class:list={['course-card group flex h-full w-full flex-col rounded-[1.75rem] p-6 text-left', course.tone === 'tint' ? 'bg-tint' : 'bg-paper-dim']}
              style={`--i:${i}`}
            >
              <span class="w-fit rounded-full bg-white/70 px-3 py-1 text-[0.68rem] font-bold uppercase tracking-wide text-ink-dim">{course.tag}</span>
              <span class="mt-8 block font-display text-xl font-semibold leading-tight tracking-tight text-ink">{course.title}</span>
              <span class="mt-3 block flex-1 text-sm leading-relaxed text-ink-dim">{course.short}</span>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-ink">
                See what is inside
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-white transition-transform duration-300 group-hover:translate-x-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-center text-sm text-ink-dim">Need something else? We tailor each course to your team and your tools.</p>
  </Container>

  {
    courses.map((course) => (
      <dialog id={`course-${course.id}`} class="course-dialog m-auto w-[min(48rem,94vw)] rounded-[2rem] border-0 bg-white p-0 text-ink shadow-2xl backdrop:bg-black/50">
        <div class="max-h-[88vh] overflow-y-auto p-7 sm:p-10">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-wide text-accent">{course.tag} course</p>
              <h3 class="mt-2 font-display text-[clamp(1.6rem,1.2rem+1.6vw,2.3rem)] font-bold leading-tight tracking-[-0.03em]">{course.title}</h3>
            </div>
            <form method="dialog">
              <button aria-label="Close" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line transition hover:bg-paper-dim">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              </button>
            </form>
          </div>

          <p class="mt-5 text-base leading-relaxed text-ink-dim">{course.intro}</p>

          <div class="mt-7 rounded-[1.5rem] bg-paper-dim p-6">
            <p class="text-sm font-bold text-ink">What you will learn</p>
            <ul class="mt-4 space-y-3">
              {
                course.learn.map((item) => (
                  <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-dim">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink text-white">
                      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                    </span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            {
              course.sections.map((section) => (
                <div>
                  <h4 class="font-display text-lg font-bold tracking-tight text-ink">{section.h}</h4>
                  <p class="mt-2 text-sm leading-relaxed text-ink-dim">{section.p}</p>
                </div>
              ))
            }
          </div>

          <p class="mt-6 rounded-[1.25rem] bg-tint p-4 text-sm leading-relaxed text-ink"><strong>Who it is for:</strong> {course.who}</p>

          <div class="mt-7 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-ink-dim">Format, length and price are agreed with you after a short chat.</p>
            <Pill href={`/contact?topic=${encodeURIComponent(course.title)}`} label="Ask about this course" variant="blue" />
          </div>
        </div>
      </dialog>
    ))
  }
</section>

<style is:global>
  .course-card {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s;
    animation: course-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 0.09s);
  }
  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 50px -34px rgb(0 0 0 / 0.4);
  }
  @keyframes course-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .course-dialog[open] {
    animation: course-pop 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes course-pop {
    from { opacity: 0; transform: translateY(18px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .course-card, .course-dialog[open] { animation: none; transition: none; }
  }
</style>

<script>
  function initCourses() {
    document.querySelectorAll<HTMLElement>('[data-courses]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      root.querySelectorAll<HTMLElement>('[data-course-open]').forEach((btn) =>
        btn.addEventListener('click', () => {
          (root.querySelector(`#course-${btn.dataset.courseOpen}`) as HTMLDialogElement | null)?.showModal();
        })
      );
      root.querySelectorAll<HTMLDialogElement>('.course-dialog').forEach((dialog) =>
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        })
      );
    });
  }
  document.addEventListener('astro:page-load', initCourses);
</script>

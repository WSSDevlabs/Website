---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';

type TocItem = { id: string; label: string };
type Accent = 'blue' | 'red' | 'yellow' | 'green';

type Props = {
  title: string;
  description: string;
  path: string;
  /** kept so the legal pages can still pass them; the page header no longer shows an icon or intro */
  icon?: string;
  accent?: Accent;
  lastUpdated: Date;
  intro?: string;
  toc: TocItem[];
};

const { title, description, path, lastUpdated, toc } = Astro.props;


const formattedDate = lastUpdated.toLocaleDateString('en-MY', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description} path={path}>
  <!-- Title block stays fixed in place while the policy text scrolls up over it -->
  <section class="sticky top-0 z-0 flex min-h-[46vh] items-end bg-slate pb-24 pt-36 text-white md:min-h-[52vh] md:pb-28 md:pt-44" data-tight>
    <Container class="relative">
      <h1 class="font-display text-4xl font-black tracking-tight text-white sm:text-6xl">{title}</h1>
      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-white/60">
        Last updated: {formattedDate}
      </p>
    </Container>
  </section>

  <section class="relative z-10 -mt-10 rounded-t-[2.75rem] bg-paper" data-tight>
    <Container>
      <div class="grid gap-12 pb-14 pt-12 md:pb-20 md:pt-14 lg:grid-cols-[260px_1fr]">
        <aside class="hidden lg:block">
          <div class="sticky top-28">
            <p class="text-xs font-bold uppercase tracking-widest text-ink-dim">On this page</p>
            <nav class="mt-4 space-y-1 border-l border-line">
              {
                toc.map((item) => (
                  <a
                    href={`#${item.id}`}
                    class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-ink-dim transition-colors hover:border-accent hover:text-ink"
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </div>
        </aside>

        <div class="min-w-0 space-y-5">
          <slot />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

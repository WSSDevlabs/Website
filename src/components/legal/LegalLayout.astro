---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';

type TocItem = { id: string; label: string };
type Accent = 'blue' | 'red' | 'yellow' | 'green';

type Props = {
  title: string;
  description: string;
  path: string;
  icon: string;
  accent?: Accent;
  lastUpdated: Date;
  intro: string;
  toc: TocItem[];
};

const { title, description, path, icon, accent = 'blue', lastUpdated, intro, toc } = Astro.props;

const accentMap: Record<Accent, { bg: string; text: string; ring: string }> = {
  blue: { bg: 'bg-accent-blue/15', text: 'text-accent-blue', ring: 'ring-accent-blue/25' },
  red: { bg: 'bg-accent-red/15', text: 'text-accent-red', ring: 'ring-accent-red/25' },
  yellow: { bg: 'bg-accent-yellow-vivid/15', text: 'text-accent-yellow', ring: 'ring-accent-yellow-vivid/25' },
  green: { bg: 'bg-accent-green/15', text: 'text-accent-green', ring: 'ring-accent-green/25' }
};
const a = accentMap[accent];

const formattedDate = lastUpdated.toLocaleDateString('en-MY', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description} path={path}>
  <section class="relative overflow-hidden bg-charcoal pt-28 pb-16 text-white md:pt-36 md:pb-20">
    <div class="grain-overlay opacity-20" aria-hidden="true"></div>
    <Container class="relative">
      <div class:list={['inline-flex h-14 w-14 items-center justify-center rounded-2xl ring-1', a.bg, a.ring]}>
        <svg class:list={['h-7 w-7', a.text]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d={icon}></path>
        </svg>
      </div>
      <h1 class="mt-6 font-display text-4xl font-black tracking-tight text-white sm:text-5xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/65">{intro}</p>
      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-white/60">
        Last updated: {formattedDate}
      </p>
    </Container>
  </section>

  <section class="bg-paper">
    <Container>
      <div class="grid gap-12 py-14 md:py-20 lg:grid-cols-[260px_1fr]">
        <aside class="hidden lg:block">
          <div class="sticky top-28">
            <p class="text-xs font-bold uppercase tracking-widest text-ink-dim">On this page</p>
            <nav class="mt-4 space-y-1 border-l border-line">
              {
                toc.map((item) => (
                  <a
                    href={`#${item.id}`}
                    class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-ink-dim transition-colors hover:border-accent hover:text-ink"
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </div>
        </aside>

        <div class="min-w-0 space-y-5">
          <slot />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

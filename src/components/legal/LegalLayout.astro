---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';

type TocItem = { id: string; label: string };

type Props = {
  title: string;
  description: string;
  path: string;
  lastUpdated: Date;
  intro: string;
  toc: TocItem[];
};

const { title, description, path, lastUpdated, intro, toc } = Astro.props;
const formattedDate = lastUpdated.toLocaleDateString('en-MY', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} path={path}>
  <section class="border-b border-line">
    <Container class="py-12 md:py-16">
      <h1 class="h-display max-w-3xl">{title}</h1>
      <p class="lead mt-5">{intro}</p>
      <p class="mt-5 text-sm text-ink-dim">Last updated: {formattedDate}</p>
    </Container>
  </section>

  <Container>
    <div class="grid gap-12 py-12 md:py-16 lg:grid-cols-[240px_1fr]">
      <aside class="hidden lg:block">
        <nav class="sticky top-24" aria-label="On this page">
          <p class="text-sm font-semibold text-ink">On this page</p>
          <ul class="mt-3 border-l border-line">
            {
              toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-ink-dim hover:border-accent hover:text-ink">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
      <div class="legal-body min-w-0 max-w-3xl">
        <slot />
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
  .legal-body :global(h2) {
    margin-top: 2.75rem;
    scroll-margin-top: 6rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-body :global(h3) {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 650;
    color: var(--color-ink);
  }

  .legal-body :global(p),
  .legal-body :global(li) {
    color: var(--color-ink-dim);
    line-height: 1.7;
  }

  .legal-body :global(p) {
    margin-top: 0.85rem;
  }

  .legal-body :global(ul),
  .legal-body :global(ol) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
  }

  .legal-body :global(ul) {
    list-style: disc;
  }

  .legal-body :global(ol) {
    list-style: decimal;
  }

  .legal-body :global(li + li) {
    margin-top: 0.4rem;
  }

  .legal-body :global(strong) {
    color: var(--color-ink);
  }

  .legal-body :global(a) {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 3px;
  }

  .legal-body :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .legal-body :global(table) {
    margin-top: 1rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .legal-body :global(th),
  .legal-body :global(td) {
    border-top: 1px solid var(--color-line);
    padding: 0.6rem 0.75rem 0.6rem 0;
    text-align: left;
    vertical-align: top;
    color: var(--color-ink-dim);
  }

  .legal-body :global(th) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>

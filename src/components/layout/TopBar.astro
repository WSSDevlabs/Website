---
import { SITE } from '../../data/site';

const phoneHref = `tel:${SITE.phone.replace(/[^+\d]/g, '')}`;
---

<div class="fixed inset-x-0 top-0 z-50 hidden h-9 items-center border-b border-white/10 bg-charcoal px-6 text-white md:flex lg:px-10">
  <div class="flex w-full items-center justify-between text-xs">
    <div class="flex items-center gap-5">
      <a
        href="#"
        data-email-user={SITE.email.split('@')[0]}
        data-email-domain={SITE.email.split('@')[1]}
        data-email-text="1"
        class="flex items-center gap-1.5 text-white/70 transition-colors hover:text-white"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
      </a>
      <a href={phoneHref} class="flex items-center gap-1.5 text-white/70 transition-colors hover:text-white">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
        </svg>
        <span>{SITE.phone}</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2.5">
        {
          SITE.social.linkedin && (
            <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-white/70 transition-colors hover:text-white">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          )
        }
        {
          SITE.social.tiktok && (
            <a href={SITE.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="text-white/70 transition-colors hover:text-white">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M16.6 5.82c-.9-.9-1.4-2.1-1.4-3.4h-3.1v13.4c0 1.5-1.2 2.7-2.7 2.7s-2.7-1.2-2.7-2.7 1.2-2.7 2.7-2.7c.3 0 .5 0 .8.1V9.9c-.3 0-.5-.1-.8-.1-3.2 0-5.8 2.6-5.8 5.8S6.2 21.4 9.4 21.4s5.8-2.6 5.8-5.8V8.4c1.2.9 2.7 1.4 4.3 1.4V6.7c-.9 0-1.8-.3-2.5-.9-.2-.1-.3-.1-.4 0z" />
              </svg>
            </a>
          )
        }
      </div>

      <div class="flex items-center gap-1 border-l border-white/15 pl-4 font-mono text-[11px] font-bold uppercase tracking-wide">
        <button type="button" class="rounded px-1.5 py-0.5 text-white" aria-current="true">EN</button>
        <span class="text-white/20">/</span>
        <button type="button" class="rounded px-1.5 py-0.5 text-white/50 transition-colors hover:text-white">BM</button>
      </div>
    </div>
  </div>
</div>

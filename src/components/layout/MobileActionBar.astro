---
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { PRIMARY_CTA } from '../../data/nav';
import { DEFAULT_WHATSAPP_MESSAGE, whatsappHref } from '../../data/site';

/** Sticky bottom bar on phones: both actions always in thumb reach (audit 10.3). */
---

<div
  class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-paper px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:hidden"
>
  <div class="grid grid-cols-[1fr_auto] gap-3">
    <a href={PRIMARY_CTA.href} class="btn btn-primary w-full" data-track="quote_click">{PRIMARY_CTA.label}</a>
    <a
      href={whatsappHref(DEFAULT_WHATSAPP_MESSAGE)}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-whatsapp"
      data-track="whatsapp_click"
    >
      <WhatsAppIcon class="h-5 w-5" />
      WhatsApp
    </a>
  </div>
</div>

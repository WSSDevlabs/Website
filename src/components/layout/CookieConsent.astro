---
type Props = {
  cfAnalyticsToken?: string;
};

const { cfAnalyticsToken } = Astro.props;
---

<div
  id="cookie-consent"
  class="fixed inset-x-3 bottom-3 z-50 hidden max-w-md rounded-2xl border border-line bg-paper p-4 shadow-lg pb-[max(1rem,env(safe-area-inset-bottom))] md:inset-x-auto md:bottom-6 md:left-6 md:p-5"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
  data-cf-token={cfAnalyticsToken || ''}
>
  <p class="text-xs leading-relaxed text-ink-dim md:text-sm">
    We use privacy-friendly analytics. No tracking cookies. It only runs if you click Allow.{' '}
    <a href="/cookies" class="underline hover:text-accent">Cookie Policy</a>
  </p>
  <div class="mt-3 grid grid-cols-2 gap-2 md:flex md:gap-3">
    <button
      id="cookie-accept"
      type="button"
      class="rounded-full bg-ink px-4 py-2.5 text-sm font-medium text-paper hover:bg-accent"
    >
      Allow
    </button>
    <button
      id="cookie-dismiss"
      type="button"
      class="rounded-full border border-line px-4 py-2.5 text-sm font-medium text-ink-dim hover:text-ink"
    >
      Reject
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'wss-cookie-consent';

  function loadAnalytics() {
    if ((window as unknown as { __wssAnalyticsLoaded?: boolean }).__wssAnalyticsLoaded) return;
    const banner = document.getElementById('cookie-consent');
    const token = banner?.dataset.cfToken;
    if (!token) return;
    (window as unknown as { __wssAnalyticsLoaded?: boolean }).__wssAnalyticsLoaded = true;
    const script = document.createElement('script');
    script.type = 'text/partytown';
    script.src = 'https://static.cloudflareinsights.com/beacon.min.js';
    script.setAttribute('data-cf-beacon', JSON.stringify({ token }));
    document.head.appendChild(script);
  }

  function initCookieConsent() {
    const banner = document.getElementById('cookie-consent');
    const accept = document.getElementById('cookie-accept');
    const dismiss = document.getElementById('cookie-dismiss');
    const consent = localStorage.getItem(STORAGE_KEY);

    if (consent === 'accepted') {
      loadAnalytics();
    } else if (!consent) {
      banner?.classList.remove('hidden');
    }

    const close = (value: string) => {
      localStorage.setItem(STORAGE_KEY, value);
      banner?.classList.add('hidden');
    };

    accept?.addEventListener('click', () => {
      close('accepted');
      loadAnalytics();
      window.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
    });

    dismiss?.addEventListener('click', () => close('dismissed'));
  }

  initCookieConsent();
  document.addEventListener('astro:page-load', initCookieConsent);
</script>

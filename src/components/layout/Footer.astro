---
import Container from '../ui/Container.astro';
import { FOOTER_LEGAL_LINKS, FOOTER_COMPANY_LINKS, FOOTER_SOLUTIONS_LINKS } from '../../data/nav';
import { SITE } from '../../data/site';

const year = new Date().getFullYear();
---

<!-- Arched Closing Footer (Clean Light Off-White Theme) -->
<footer class="relative overflow-hidden bg-paper-dim text-ink border-t border-line rounded-t-[3.5rem] sm:rounded-t-[5rem] mt-12">
  <div class="grain-overlay opacity-20" aria-hidden="true"></div>

  <Container class="relative pt-16 pb-12">
    <!-- Top Row: Brand on left + Mission statement on right -->
    <div class="flex flex-col gap-6 pb-12 border-b border-line sm:flex-row sm:items-center sm:justify-between">
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <span class="flex items-center gap-1" aria-hidden="true">
            <span class="h-8 w-3 rounded-[3px] bg-accent-red"></span>
            <span class="h-8 w-3 rounded-[3px] bg-accent"></span>
          </span>
          <span class="font-display text-2xl sm:text-3xl font-black tracking-tight text-ink">{SITE.name}</span>
        </a>
        <p class="mt-2 text-xs font-mono text-ink-dim uppercase tracking-widest">Productized &amp; Bespoke Software Studio</p>
      </div>

      <div class="max-w-md">
        <p class="text-sm leading-relaxed text-ink-dim font-normal">
          We partner with ambitious startups, SMEs, and enterprises to build high-performance systems, 15 Buy-Once marketplace tools, and AI solutions that scale.
        </p>
      </div>
    </div>

    <!-- 4-Column Navigation Layout -->
    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4 border-b border-line">
      <!-- Col 1: Services -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-ink">Services</h4>
        <ul class="mt-5 space-y-2.5 text-xs sm:text-sm text-ink-dim">
          {
            FOOTER_SOLUTIONS_LINKS.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-ink hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 2: Company -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-ink">Company</h4>
        <ul class="mt-5 space-y-2.5 text-xs sm:text-sm text-ink-dim">
          {
            FOOTER_COMPANY_LINKS.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-ink hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Let's Connect -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-ink">Let's Connect</h4>
        <p class="mt-5 text-xs sm:text-sm text-ink-dim">Direct scoping with Senior Engineers:</p>
        <a
          href="https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I'd%20like%20to%20discuss%20a%20project."
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-xs font-bold text-white shadow-md transition hover:bg-black hover:scale-105"
        >
          <span>WhatsApp an Engineer</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <p class="mt-3 text-xs text-ink-dim">{SITE.email}</p>
      </div>

      <!-- Col 4: Location & Socials -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-ink">Location</h4>
        <p class="mt-5 text-xs sm:text-sm text-ink-dim">Cyberjaya &amp; Kuala Lumpur, Malaysia</p>
        <p class="mt-1 text-xs text-ink-dim/80">Serving clients nationwide &amp; globally</p>

        <div class="mt-5 flex items-center gap-2.5">
          {
            SITE.social.linkedin && (
              <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
                 class="flex h-9 w-9 items-center justify-center rounded-full border border-line bg-white text-ink-dim transition hover:border-ink hover:bg-ink hover:text-white">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
            )
          }
          {
            SITE.social.github && (
              <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
                 class="flex h-9 w-9 items-center justify-center rounded-full border border-line bg-white text-ink-dim transition hover:border-ink hover:bg-ink hover:text-white">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                </svg>
              </a>
            )
          }
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="flex flex-col gap-4 pt-8 text-xs text-ink-dim md:flex-row md:items-center md:justify-between">
      <p>
        &copy; {year} {SITE.legalName || SITE.name}. All rights reserved. Designed with precision.
      </p>
      <nav aria-label="Legal" class="flex gap-6">
        {
          FOOTER_LEGAL_LINKS.map((link) => (
            <a href={link.href} class="transition-colors hover:text-ink hover:underline">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </Container>
</footer>


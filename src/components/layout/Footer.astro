---
import Container from '../ui/Container.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { FOOTER_COMPANY, FOOTER_LEGAL, FOOTER_OFFERS } from '../../data/nav';
import { SITE, SOCIAL_LINKS, businessName, phoneHref, whatsappHref, DEFAULT_WHATSAPP_MESSAGE } from '../../data/site';

const year = new Date().getFullYear();
const linkClass = 'inline-flex min-h-11 items-center text-ink-dim transition-colors hover:text-ink';
---

<footer class="border-t border-line bg-paper-dim">
  <Container class="py-14">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <a href="/" class="inline-flex min-h-11 items-center" aria-label={`${SITE.name} home`}>
          <img src="/images/brand/logo-160.png" srcset="/images/brand/logo-160.png 1x, /images/brand/logo-320.png 2x" alt={SITE.name} width="160" height="33" class="h-7 w-auto" loading="lazy" />
        </a>
        <p class="mt-3 max-w-xs text-ink-dim">Fixed-price websites and business systems for Malaysian SMEs. You own the code.</p>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-8 md:col-span-4">
        <div>
          <h2 class="text-sm font-semibold text-ink">What we do</h2>
          <ul class="mt-2">
            {FOOTER_OFFERS.map((link) => <li><a href={link.href} class={linkClass}>{link.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-ink">Company</h2>
          <ul class="mt-2">
            {FOOTER_COMPANY.map((link) => <li><a href={link.href} class={linkClass}>{link.label}</a></li>)}
          </ul>
        </div>
      </nav>

      <div class="md:col-span-4">
        <h2 class="text-sm font-semibold text-ink">Talk to the builder</h2>
        <a
          href={whatsappHref(DEFAULT_WHATSAPP_MESSAGE)}
          class="btn btn-whatsapp mt-4"
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp_click"
        >
          <WhatsAppIcon class="h-5 w-5" />
          WhatsApp us
        </a>
        <ul class="mt-3">
          <li><a href={`mailto:${SITE.email}`} class={linkClass}>{SITE.email}</a></li>
          <li><a href={phoneHref} class={linkClass}>{SITE.phone}</a></li>
          <li class="text-ink-dim">{SITE.hours}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 grid gap-6 border-t border-line pt-8 text-sm md:grid-cols-12">
      <div class="text-ink-dim md:col-span-6">
        <p class="font-semibold text-ink">{businessName}</p>
        {SITE.ssmNumber && <p>Registration no. {SITE.ssmNumber}</p>}
        {SITE.sstNumber && <p>SST no. {SITE.sstNumber}</p>}
        <p>{SITE.registeredAddress || SITE.baseLocation}</p>
        <p class="mt-2">&copy; {year} {businessName}. All rights reserved.</p>
      </div>
      <div class="md:col-span-6">
        <ul class="flex flex-wrap gap-x-5">
          {FOOTER_LEGAL.map((link) => <li><a href={link.href} class={linkClass}>{link.label}</a></li>)}
        </ul>
        {
          SOCIAL_LINKS.length > 0 && (
            <ul class="mt-2 flex flex-wrap gap-x-5" aria-label="Social media">
              {SOCIAL_LINKS.map(([label, href]) => (
                <li>
                  <a href={href} class={linkClass} target="_blank" rel="noopener noreferrer">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </Container>
</footer>

---
import Container from '../ui/Container.astro';
import Email from '../ui/Email.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import { FOOTER_LEGAL_LINKS, FOOTER_COMPANY_LINKS, FOOTER_OFFER_LINKS } from '../../data/nav';
import { SITE, SOCIAL_LINKS, businessName, phoneHref, whatsappHref, DEFAULT_WHATSAPP_MESSAGE } from '../../data/site';
import { REPLY_PROMISE } from '../../data/catalog';

const year = new Date().getFullYear();
const identity = [
  SITE.ssmNumber && `SSM ${SITE.ssmNumber}`,
  SITE.registeredAddress
].filter(Boolean);
---

<!-- Arched Closing Footer (Matte Charcoal Theme, matching the logo) -->
<footer class="relative overflow-hidden bg-charcoal text-white border-t border-white/10 rounded-t-[3.5rem] sm:rounded-t-[5rem] mt-12">
  <div class="grain-overlay opacity-20" aria-hidden="true"></div>

  <Container class="relative pt-16 pb-12">
    <!-- Top Row: Brand on left + Mission statement on right -->
    <div class="flex flex-col gap-6 pb-12 border-b border-white/10 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <a href="/" class="inline-flex items-center rounded-2xl bg-white px-4 py-2.5">
          <img src="/images/brand/logo.png" alt={SITE.name} class="h-8 sm:h-9 w-auto object-contain" width="180" height="48" />
        </a>
      </div>

      <div class="max-w-md">
        <p class="text-sm leading-relaxed text-white/60 font-normal">
          Fixed-price websites and business systems for Malaysian SMEs. You own the code.
        </p>
      </div>
    </div>

    <!-- 4-Column Navigation Layout -->
    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4 border-b border-white/10">
      <!-- Col 1: Offers -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">What we do</h4>
        <ul class="mt-5 space-y-2.5 text-xs sm:text-sm text-white/60">
          {
            FOOTER_OFFER_LINKS.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-white hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 2: Company -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Company</h4>
        <ul class="mt-5 space-y-2.5 text-xs sm:text-sm text-white/60">
          {
            FOOTER_COMPANY_LINKS.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-white hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Let's Connect -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Let's Connect</h4>
        <p class="mt-5 text-xs sm:text-sm text-white/60">Talk to the builder:</p>
        <a
          href={whatsappHref(DEFAULT_WHATSAPP_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 rounded-full bg-accent-blue px-5 py-2.5 text-xs font-bold text-white shadow-md transition hover:opacity-90 hover:scale-105"
        >
          <span>WhatsApp us</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <Email class="mt-3 block text-xs text-white/60 transition-colors hover:text-white hover:underline" />
        <a href={phoneHref} class="mt-1.5 block text-xs text-white/60 transition-colors hover:text-white hover:underline">{SITE.phone}</a>
        <p class="mt-3 text-xs text-white/50">{REPLY_PROMISE}</p>
      </div>

      <!-- Col 4: Location & Socials -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Location</h4>
        <p class="mt-5 text-xs sm:text-sm text-white/60">{SITE.baseLocation}</p>
        <p class="mt-1 text-xs text-white/50">{SITE.meetings}</p>
        <p class="mt-1 text-xs text-white/50">{SITE.hours}</p>

        <div class="mt-5 flex items-center gap-2.5">
          {
            SOCIAL_LINKS.map(([label, href]) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/70 transition hover:border-white hover:bg-white hover:text-ink"
              >
                <SocialIcon name={label} class="h-4 w-4" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="flex flex-col gap-4 pt-8 text-xs text-white/50 md:flex-row md:items-center md:justify-between">
      <div>
        <p>&copy; {year} {businessName}. All rights reserved.</p>
        {identity.length > 0 && <p class="mt-1">{identity.join(' · ')}</p>}
      </div>
      <nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2">
        {
          FOOTER_LEGAL_LINKS.map((link) => (
            <a href={link.href} class="transition-colors hover:text-white hover:underline">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </Container>
</footer>

---
import Container from '../ui/Container.astro';
import { FOOTER_LEGAL_LINKS, FOOTER_COMPANY_LINKS, FOOTER_SOLUTIONS_LINKS } from '../../data/nav';
import { SITE } from '../../data/site';

const year = new Date().getFullYear();
---

<!-- Arched Closing Footer (Matte Charcoal Theme, matching the logo) -->
<footer class="relative overflow-hidden bg-charcoal text-white border-t border-white/10 rounded-t-[3.5rem] sm:rounded-t-[5rem] mt-12">
  <div class="grain-overlay opacity-20" aria-hidden="true"></div>

  <Container class="relative pt-16 pb-12">
    <!-- Top Row: Brand on left + Mission statement on right -->
    <div class="flex flex-col gap-6 pb-12 border-b border-white/10 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <a href="/" class="inline-flex items-center rounded-2xl bg-white px-4 py-2.5">
          <img src="/images/brand/logo.png" alt={SITE.name} class="h-8 sm:h-9 w-auto object-contain" width="180" height="48" />
        </a>
        <p class="mt-2 text-xs font-mono text-white/50 uppercase tracking-widest">Productized &amp; Bespoke Software Studio</p>
      </div>

      <div class="max-w-md">
        <p class="text-sm leading-relaxed text-white/60 font-normal">
          We partner with ambitious startups, SMEs, and enterprises to build high-performance systems, 15 Buy-Once marketplace tools, and AI solutions that scale.
        </p>
      </div>
    </div>

    <!-- 4-Column Navigation Layout -->
    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4 border-b border-white/10">
      <!-- Col 1: Services -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Services</h4>
        <ul class="mt-5 space-y-2.5 text-xs sm:text-sm text-white/60">
          {
            FOOTER_SOLUTIONS_LINKS.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-white hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 2: Company -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Company</h4>
        <ul class="mt-5 space-y-2.5 text-xs sm:text-sm text-white/60">
          {
            FOOTER_COMPANY_LINKS.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-white hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Let's Connect -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Let's Connect</h4>
        <p class="mt-5 text-xs sm:text-sm text-white/60">Direct scoping with Senior Engineers:</p>
        <a
          href="https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I'd%20like%20to%20discuss%20a%20project."
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 rounded-full bg-accent-blue px-5 py-2.5 text-xs font-bold text-white shadow-md transition hover:opacity-90 hover:scale-105"
        >
          <span>WhatsApp an Engineer</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <p class="mt-3 text-xs text-white/60">{SITE.email}</p>
      </div>

      <!-- Col 4: Location & Socials -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Location</h4>
        <p class="mt-5 text-xs sm:text-sm text-white/60">Cyberjaya &amp; Kuala Lumpur, Malaysia</p>
        <p class="mt-1 text-xs text-white/40">Serving clients nationwide &amp; globally</p>

        <div class="mt-5 flex items-center gap-2.5">
          {
            SITE.social.linkedin && (
              <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
                 class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/70 transition hover:border-white hover:bg-white hover:text-ink">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
            )
          }
          {
            SITE.social.tiktok && (
              <a href={SITE.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok"
                 class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/70 transition hover:border-white hover:bg-white hover:text-ink">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M16.6 5.82c-.9-.9-1.4-2.1-1.4-3.4h-3.1v13.4c0 1.5-1.2 2.7-2.7 2.7s-2.7-1.2-2.7-2.7 1.2-2.7 2.7-2.7c.3 0 .5 0 .8.1V9.9c-.3 0-.5-.1-.8-.1-3.2 0-5.8 2.6-5.8 5.8S6.2 21.4 9.4 21.4s5.8-2.6 5.8-5.8V8.4c1.2.9 2.7 1.4 4.3 1.4V6.7c-.9 0-1.8-.3-2.5-.9-.2-.1-.3-.1-.4 0z" />
                </svg>
              </a>
            )
          }
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="flex flex-col gap-4 pt-8 text-xs text-white/50 md:flex-row md:items-center md:justify-between">
      <p>
        &copy; {year} {SITE.legalName || SITE.name}. All rights reserved. Designed with precision.
      </p>
      <nav aria-label="Legal" class="flex gap-6">
        {
          FOOTER_LEGAL_LINKS.map((link) => (
            <a href={link.href} class="transition-colors hover:text-white hover:underline">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </Container>
</footer>


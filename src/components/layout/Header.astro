---
import Container from '../ui/Container.astro';
import { NAV_GROUPS, NAV_LINKS, PRIMARY_CTA } from '../../data/nav';
import { SITE } from '../../data/site';
import { SERVICE_CATEGORIES } from '../../data/serviceCategories';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const isHome = currentPath === '/';
---

<!-- Topbar: dark ink frame, mirrored by the footer -->
<div class="relative bg-ink">
  <Container class="flex h-9 items-center justify-between gap-4">
    <!-- Left: contact info & status indicator -->
    <div class="flex items-center gap-5 text-[11px] text-white/55">
      <a href="/status" class="flex items-center gap-1.5 transition-colors hover:text-emerald-400">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-mono text-white/80">Status: Operational (Live SLA)</span>
      </a>
      {SITE.phone && (
        <a href={`tel:${SITE.phone}`} class="hidden items-center gap-1.5 transition-colors hover:text-white sm:flex">
          <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          {SITE.phone}
        </a>
      )}
      {SITE.email && (
        <a href={`mailto:${SITE.email}`} class="hidden items-center gap-1.5 transition-colors hover:text-white lg:flex">
          <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
          {SITE.email}
        </a>
      )}
    </div>

    <!-- Right: direct builder hook & social -->
    <div class="flex items-center gap-3">
      <a
        href="https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I'd%20like%20to%20speak%20with%20an%20engineer."
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-[11px] font-mono text-accent-yellow-vivid hover:underline sm:inline-block"
      >
        Direct with Builder WhatsApp →
      </a>
      <div class="flex items-center gap-1.5">
        {SITE.social.linkedin && (
          <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
             class="flex h-6 w-6 items-center justify-center rounded-full border border-white/15 text-white/55 transition-all hover:border-accent hover:bg-accent hover:text-white">
            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        )}
        {SITE.social.github && (
          <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
             class="flex h-6 w-6 items-center justify-center rounded-full border border-white/15 text-white/55 transition-all hover:border-accent hover:bg-accent hover:text-white">
            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </Container>
  <!-- Brand signature line -->
  <div
    class="h-[2px] w-full opacity-90"
    style="background: linear-gradient(90deg, var(--color-accent-red), var(--color-accent) 38%, var(--color-accent-yellow) 72%, var(--color-accent-green));"
    aria-hidden="true"
  >
  </div>
</div>

<header class="sticky top-3 z-50 px-3 sm:px-4">
  <div
    class:list={[
      'mx-auto flex h-14 max-w-5xl items-center justify-between rounded-full border border-line/80 pl-5 pr-2 shadow-[0_8px_32px_-12px_rgb(12_18_32/0.18)] backdrop-blur-xl',
      isHome ? 'bg-transparent' : 'bg-paper/85'
    ]}
  >
    <a href="/" class="flex items-center gap-2.5">
      <span class="flex items-center gap-[3px]" aria-hidden="true">
        <span class="h-5 w-2.5 rounded-[3px] bg-accent-red"></span>
        <span class="h-5 w-2.5 rounded-[3px] bg-accent"></span>
      </span>
      <span class="text-base font-bold tracking-tight text-ink">{SITE.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-0.5 md:flex">
      {
        NAV_GROUPS.map((group) => {
          const groupActive = group.links.some((link) => isActive(link.href));
          const isSolutions = group.label === 'Solutions';
          return (
            <div class="nav-dropdown group/nav relative">
              <button
                type="button"
                class:list={[
                  'flex cursor-pointer items-center gap-1 rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors duration-200 ease-out',
                  groupActive ? 'bg-accent/10 text-accent' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
                ]}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {group.label}
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover/nav:rotate-180 group-focus-within/nav:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </button>

              {/* Invisible bridge */}
              <div class="absolute left-0 top-full h-2 w-full" aria-hidden="true" />

              <div
                class:list={[
                  'invisible absolute left-0 top-full z-10 mt-2 origin-top-left scale-95 rounded-2xl border border-line/80 bg-paper/98 opacity-0 shadow-[0_20px_56px_-16px_rgb(12_18_32/0.3)] backdrop-blur-xl transition-all duration-200 [transition-timing-function:var(--ease-out-expo)] group-hover/nav:visible group-hover/nav:scale-100 group-hover/nav:opacity-100 group-focus-within/nav:visible group-focus-within/nav:scale-100 group-focus-within/nav:opacity-100',
                  isSolutions ? 'w-[440px] p-4' : 'min-w-[220px] p-2'
                ]}
              >
                {isSolutions ? (
                  <Fragment>
                    <p class="mono-label px-2 pb-2 text-ink-dim/70">Productized &amp; Enterprise</p>
                    <div class="grid grid-cols-2 gap-2 pb-3">
                      <a
                        href="/express"
                        class="rounded-xl border border-accent/20 bg-accent/5 p-2.5 transition hover:bg-accent/10"
                      >
                        <div class="flex items-center justify-between">
                          <span class="text-xs font-bold text-accent">WSS Express</span>
                          <span class="rounded bg-accent px-1.5 py-0.2 text-[9px] font-bold text-white">3-7 Days</span>
                        </div>
                        <p class="mt-0.5 text-[11px] text-ink-dim">Fixed-price packages from RM180/yr</p>
                      </a>
                      <a
                        href="/marketplace"
                        class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-2.5 transition hover:bg-emerald-500/10"
                      >
                        <div class="flex items-center justify-between">
                          <span class="text-xs font-bold text-emerald-800">Marketplace</span>
                          <span class="rounded bg-emerald-600 px-1.5 py-0.2 text-[9px] font-bold text-white">Buy-Once</span>
                        </div>
                        <p class="mt-0.5 text-[11px] text-ink-dim">15 Production PHP systems</p>
                      </a>
                    </div>

                    <p class="mono-label px-2 pb-1 border-t border-line pt-2 text-ink-dim/70">Custom Capabilities</p>
                    <div class="grid grid-cols-1 gap-1">
                      <a
                        href="/services/bespoke"
                        class="flex items-center justify-between rounded-xl px-2 py-1.5 text-xs font-semibold text-ink-dim hover:bg-paper-dim hover:text-ink"
                      >
                        <span>Bespoke Enterprise Engineering (RM 4.5k – RM 15k)</span>
                        <span class="text-[10px] text-accent font-bold">Grant-Matched</span>
                      </a>
                      {SERVICE_CATEGORIES.slice(0, 3).map((category) => (
                        <a
                          href={`/services/${category.slug}`}
                          class="flex items-center gap-2 rounded-xl px-2 py-1 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink"
                        >
                          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                          <span>{category.title}</span>
                        </a>
                      ))}
                    </div>
                  </Fragment>
                ) : (
                  group.links.map((link) => (
                    <a
                      href={link.href}
                      class:list={[
                        'flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium transition-colors',
                        isActive(link.href) ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
                      ]}
                      aria-current={isActive(link.href) ? 'page' : undefined}
                    >
                      <span>{link.label}</span>
                      {link.badge && (
                        <span class="rounded-md bg-paper-deep/80 px-1.5 py-0.5 font-mono text-[9px] text-ink-dim">
                          {link.badge}
                        </span>
                      )}
                    </a>
                  ))
                )}
              </div>
            </div>
          );
        })
      }
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-3 py-1.5 text-xs font-medium transition-colors duration-200 ease-out',
              isActive(link.href)
                ? 'bg-accent/10 text-accent font-semibold'
                : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <a
        href={PRIMARY_CTA.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-4 py-2 text-xs font-semibold text-white shadow-md shadow-accent/20 transition-all hover:bg-accent-dim hover:shadow-lg"
      >
        <span>{PRIMARY_CTA.label}</span>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-full md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <svg
        id="nav-icon-open"
        class="h-6 w-6 text-ink"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"
        ></path>
      </svg>
      <svg
        id="nav-icon-close"
        class="hidden h-6 w-6 text-ink"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="mx-auto mt-2 hidden max-w-5xl rounded-3xl border border-line/80 bg-paper/95 shadow-[0_16px_48px_-16px_rgb(12_18_32/0.25)] backdrop-blur-xl md:hidden"
  >
    <div class="flex flex-col gap-1 p-4">
      <div class="rounded-2xl bg-accent/5 border border-accent/20 p-3 mb-2">
        <p class="text-xs font-bold text-accent">Productized Solutions:</p>
        <div class="mt-2 grid grid-cols-2 gap-2">
          <a href="/express" class="rounded-xl bg-paper p-2 text-center text-xs font-bold text-ink">
            WSS Express (RM180+)
          </a>
          <a href="/marketplace" class="rounded-xl bg-paper p-2 text-center text-xs font-bold text-ink">
            Marketplace (15 Systems)
          </a>
        </div>
      </div>

      {
        NAV_GROUPS.map((group, i) => (
          <div class:list={[i > 0 && 'mt-2 border-t border-line pt-2']}>
            <p class="mono-label px-3 pb-1 text-ink-dim/70">{group.label}</p>
            {group.links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'block rounded-xl px-3 py-2 text-sm font-medium',
                  isActive(link.href) ? 'bg-accent/10 text-accent font-bold' : 'text-ink'
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
      <div class="mt-2 border-t border-line pt-2">
        <a
          href="/status"
          class="flex items-center justify-between rounded-xl px-3 py-2 text-sm font-medium text-emerald-700 bg-emerald-500/10"
        >
          <span>Live Studio Status</span>
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        </a>
      </div>
      <a
        href={PRIMARY_CTA.href}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 flex items-center justify-center gap-2 rounded-xl bg-accent py-3 text-center text-sm font-semibold text-white shadow-md"
      >
        <span>{PRIMARY_CTA.label}</span>
      </a>
    </div>
  </nav>
</header>

<script>
  function initNavToggle() {
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-nav');
    const iconOpen = document.getElementById('nav-icon-open');
    const iconClose = document.getElementById('nav-icon-close');
    if (!toggle || toggle.dataset.bound) return;
    toggle.dataset.bound = '1';

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu?.classList.toggle('hidden', isOpen);
      iconOpen?.classList.toggle('hidden', !isOpen);
      iconClose?.classList.toggle('hidden', isOpen);
    });
  }

  initNavToggle();
  document.addEventListener('astro:page-load', initNavToggle);
</script>

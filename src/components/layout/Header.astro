---
import { SITE } from '../../data/site';
import { PRIMARY_CTA } from '../../data/nav';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

type NavVisualCard = {
  title: string;
  desc: string;
  href: string;
  image: string;
};

type NavSubLink = {
  label: string;
  href: string;
  desc: string;
  badge?: string;
};

type NavGroup = {
  label: string;
  subtitle: string;
  categoryTitle: string;
  href: string;
  badge: string | null;
  active: boolean;
  icon: string;
  links: NavSubLink[];
  cards: NavVisualCard[];
};

const masterDirectory = {
  categoryTitle: 'DIRECTORIES',
  links: [
    { label: 'All Services Catalog', href: '/services', desc: 'Web, AI, Mobile & Enterprise' },
    { label: 'WSS Express Web', href: '/express', desc: 'Fixed-price RM 180–RM 4,500', badge: '3–7d' },
    { label: 'The Marketplace', href: '/marketplace', desc: '15 Buy-once PHP systems', badge: '15 Systems' },
    { label: 'Bespoke Enterprise', href: '/services/bespoke', desc: 'Custom enterprise software', badge: 'Grant' },
    { label: 'Projects & Work', href: '/work', desc: 'Delivered client results' },
    { label: 'About Senior Builders', href: '/about', desc: 'Razin Hakim & Natasya Umairah' },
    { label: 'Live Build Status', href: '/status', desc: '99.9% operational SLA', badge: 'Live' },
    { label: 'Direct FAQ', href: '/faq', desc: 'Pricing & engineering answers' }
  ],
  cards: [
    {
      title: 'Productized Software',
      desc: 'Fixed-price engineering shipped in 3–7 days with zero recurring lock-in.',
      href: '/services',
      image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=600&h=380&q=80'
    },
    {
      title: 'Direct Senior Architects',
      desc: 'Work directly with lead architects — zero middlemen or account managers.',
      href: '/about',
      image: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&h=380&q=80'
    }
  ]
};

const navGroups: NavGroup[] = [
  {
    label: 'Home',
    subtitle: 'Overview & Fast Entry',
    categoryTitle: 'EXPLORE',
    href: '/',
    badge: null,
    active: currentPath === '/',
    icon: 'home',
    links: [
      { label: 'Overview & Studio', href: '/', desc: 'Fast entry to all core offerings' },
      { label: 'Browse All Services', href: '/services', desc: 'Web, AI, Mobile & Enterprise' },
      { label: 'Pricing Calculator', href: '/pricing', desc: 'Transparent investment ranges' },
      { label: 'Engineering Process', href: '/process', desc: 'Our engineering roadmap' },
      { label: 'Direct Scoping', href: 'https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I%20would%20like%20to%20discuss%20a%20project', desc: 'Instant WhatsApp with builders' }
    ],
    cards: [
      {
        title: 'Bespoke Digital Platforms',
        desc: 'High-contrast design systems built for Malaysian SMEs and fast-growing brands.',
        href: '/express',
        image: 'https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=600&h=380&q=80'
      },
      {
        title: 'High-Speed SEO Engine',
        desc: 'Sub-second page speeds and AI-first SEO architecture that drive search rankings.',
        href: '/insights',
        image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=600&h=380&q=80'
      }
    ]
  },
  {
    label: 'Services & Details',
    subtitle: 'Web, AI, Mobile & Enterprise',
    categoryTitle: 'CAPABILITIES',
    href: '/services',
    badge: 'Catalog',
    active: isActive('/services') || isActive('/pricing'),
    icon: 'services',
    links: [
      { label: 'WSS Express Web', href: '/express', badge: '3–7d', desc: 'Fixed-price RM 180–RM 4,500' },
      { label: 'The Marketplace', href: '/marketplace', badge: '15 Systems', desc: '15 Buy-once PHP systems' },
      { label: 'Bespoke Enterprise', href: '/services/bespoke', badge: 'Grant', desc: 'Custom enterprise software' },
      { label: 'AI Agents & LLM', href: '/services/ai-development', desc: 'Smart workflow automation' },
      { label: 'Mobile & Web Apps', href: '/services/web-development', desc: 'Full custom digital portals' },
      { label: 'Pricing & Packages', href: '/pricing', desc: 'Transparent investment ranges' }
    ],
    cards: [
      {
        title: 'WSS Express Web',
        desc: 'Turnkey landing pages and company platforms delivered in 3 to 7 business days.',
        href: '/express',
        image: 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=600&h=380&q=80'
      },
      {
        title: 'The PHP Marketplace',
        desc: '15 production-ready turnkey web systems. Buy once, host anywhere, own the code.',
        href: '/marketplace',
        image: 'https://images.unsplash.com/photo-1556742049-0a67c5574f73?auto=format&fit=crop&w=600&h=380&q=80'
      }
    ]
  },
  {
    label: 'About & Studio',
    subtitle: 'Razin Hakim & Natasya Umairah',
    categoryTitle: 'STUDIO & TRUST',
    href: '/about',
    badge: 'Direct',
    active: isActive('/about') || isActive('/work') || isActive('/process'),
    icon: 'user',
    links: [
      { label: 'About Senior Builders', href: '/about', desc: 'Direct with lead engineers' },
      { label: 'Projects & Case Studies', href: '/work', desc: 'Production results & metrics' },
      { label: 'How We Build (Process)', href: '/process', desc: 'Our engineering workflow' },
      { label: 'Live Build Status', href: '/status', desc: 'Operational metrics & SLA', badge: 'Live' },
      { label: 'Direct FAQ', href: '/faq', desc: 'Answers to common questions' },
      { label: 'Contact Us', href: '/contact', desc: 'Get in touch directly' }
    ],
    cards: [
      {
        title: 'Direct Senior Architects',
        desc: '10+ years combined shipping complex web apps, ERP systems, and cloud infrastructure.',
        href: '/about',
        image: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=600&h=380&q=80'
      },
      {
        title: 'Verified Production Results',
        desc: 'Over RM 5M+ gross value transacted across 15+ custom software platforms.',
        href: '/work',
        image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=600&h=380&q=80'
      }
    ]
  },
  {
    label: 'Solutions & Express',
    subtitle: 'Fixed-Price RM180 - RM4,500',
    categoryTitle: 'PACKAGES',
    href: '/express',
    badge: '3–7d',
    active: isActive('/express'),
    icon: 'code',
    links: [
      { label: 'WSS Express Overview', href: '/express', badge: '3–7d', desc: 'Fast turnaround web design' },
      { label: 'Starter Tier (RM 180)', href: '/express#packages', desc: 'One-page landing essentials' },
      { label: 'Business Tier (RM 1,200)', href: '/express#packages', desc: 'Multi-page high-speed site' },
      { label: 'Enterprise Tier (RM 4,500)', href: '/express#packages', desc: 'Full custom digital platform' },
      { label: 'Compare All Features →', href: '/express#compare', desc: 'Detailed SLA breakdown' }
    ],
    cards: [
      {
        title: 'Rapid Web Launch',
        desc: 'Production-ready website deployed with DNS, SSL, and mobile optimization in 3–7 days.',
        href: '/express',
        image: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=600&h=380&q=80'
      },
      {
        title: 'Built for Conversions',
        desc: 'High-converting layout with WhatsApp direct integration and instant lead capture.',
        href: '/express',
        image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=600&h=380&q=80'
      }
    ]
  },
  {
    label: 'The Marketplace',
    subtitle: '15 Buy-Once PHP Systems',
    categoryTitle: 'SYSTEMS',
    href: '/marketplace',
    badge: '15 Systems',
    active: isActive('/marketplace'),
    icon: 'store',
    links: [
      { label: 'Clinic Queue & EMR', href: '/marketplace/clinic-queue-emr', desc: 'Patient management & queue' },
      { label: 'Service Booking Engine', href: '/marketplace/service-booking-engine', desc: 'Automated appointments & sync' },
      { label: 'Multi-Vendor Marketplace', href: '/marketplace/multi-vendor-marketplace', desc: 'E-commerce multivendor engine' },
      { label: 'HR & Payroll Portal', href: '/marketplace/hr-payroll-portal', desc: 'Self-hosted staff & payroll' },
      { label: 'Browse All 15 Systems →', href: '/marketplace', badge: 'PHP 8.2', desc: 'Full unencrypted source code' }
    ],
    cards: [
      {
        title: 'Clinic Queue & EMR',
        desc: 'Live TV queue display, patient records, prescription tracking, and WhatsApp alerts.',
        href: '/marketplace/clinic-queue-emr',
        image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=600&h=380&q=80'
      },
      {
        title: 'Service Booking Engine',
        desc: 'Automated calendar slot reservations, deposit payments, and Google Calendar sync.',
        href: '/marketplace/service-booking-engine',
        image: 'https://images.unsplash.com/photo-1556742044-3c52d6e88c62?auto=format&fit=crop&w=600&h=380&q=80'
      }
    ]
  },
  {
    label: 'Live Build Status',
    subtitle: 'Operational & Direct SLA',
    categoryTitle: 'RELIABILITY',
    href: '/status',
    badge: 'Live',
    active: isActive('/status'),
    icon: 'status',
    links: [
      { label: 'Production API Status', href: '/status', badge: '99.9%', desc: 'Real-time uptime monitoring' },
      { label: 'Server Edge Health', href: '/status', desc: 'Cloudflare global edge status' },
      { label: 'Direct Builder SLA', href: '/status', desc: 'Sub-hour response guarantee' },
      { label: 'Ed25519 Cryptographic', href: '/status', desc: 'Active key verification' }
    ],
    cards: [
      {
        title: '99.9% Production SLA',
        desc: 'All systems running with sub-second response times across Cloudflare edge nodes.',
        href: '/status',
        image: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=600&h=380&q=80'
      },
      {
        title: 'Direct Builder Access',
        desc: 'Sub-hour response SLA directly from senior architects Razin and Natasya.',
        href: '/status',
        image: 'https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=600&h=380&q=80'
      }
    ]
  },
  {
    label: 'Insights & FAQ',
    subtitle: 'AI-First SEO & Answers',
    categoryTitle: 'KNOWLEDGE',
    href: '/insights',
    badge: null,
    active: isActive('/insights') || isActive('/faq'),
    icon: 'document',
    links: [
      { label: 'Insights & AI-SEO', href: '/insights', desc: 'Technical & growth guides' },
      { label: 'E-Invoicing 2026 Guide', href: '/insights/do-you-need-einvoicing-yet', desc: 'LHDN compliance guide' },
      { label: 'Page Speed & SEO', href: '/insights/why-page-speed-still-matters-for-seo', desc: 'Sub-second Lighthouse scores' },
      { label: 'MSME MADANI Grant', href: '/insights/msme-digital-grant-madani-explained', desc: 'Gov grant requirements' },
      { label: 'Direct Pricing FAQ', href: '/faq', desc: 'Transparent SME pricing Q&A' }
    ],
    cards: [
      {
        title: 'Engineering Blueprints',
        desc: 'In-depth technical guides and business growth strategies for Malaysian founders.',
        href: '/insights',
        image: 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=600&h=380&q=80'
      },
      {
        title: 'Transparent SME FAQ',
        desc: 'Zero-jargon answers covering pricing, timelines, source code rights, and support.',
        href: '/faq',
        image: 'https://images.unsplash.com/photo-1450133064473-71024230f91b?auto=format&fit=crop&w=600&h=380&q=80'
      }
    ]
  }
];
---

<!-- Mobile Top Bar (< md screens) -->
<header class="fixed left-0 top-0 z-40 flex h-14 w-full items-center justify-between border-b border-line bg-paper/90 px-4 backdrop-blur-md md:hidden">
  <a href="/" class="flex items-center gap-2">
    <span class="flex items-center gap-[3px]" aria-hidden="true">
      <span class="h-5 w-2 rounded-[2px] bg-accent-red"></span>
      <span class="h-5 w-2 rounded-[2px] bg-accent"></span>
    </span>
    <span class="text-sm font-bold tracking-tight text-ink">{SITE.name}</span>
  </a>

  <div class="flex items-center gap-2">
    <a
      href="/services"
      class="rounded-lg border border-line bg-paper px-3 py-1 text-xs font-semibold text-ink"
    >
      Services
    </a>
    <a
      href={PRIMARY_CTA.href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-white shadow-sm transition hover:bg-emerald-700"
      aria-label="WhatsApp an Engineer"
    >
      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.072-.5-1.761-.733-2.887-2.526-2.975-2.644-.088-.117-.708-.942-.708-1.798s.446-1.277.607-1.452c.16-.175.349-.219.465-.219.117 0 .233 0 .335.006.107.005.25.04.388.373.145.349.495 1.209.539 1.297.044.088.073.19.015.305-.058.117-.087.19-.175.292-.087.102-.184.228-.263.307-.087.087-.179.182-.077.357.102.175.454.748.974 1.211.669.595 1.233.78 1.408.868.175.087.277.073.379-.044.102-.117.437-.51.554-.685.117-.175.233-.146.393-.087.16.058 1.018.48 1.193.568.175.087.291.131.335.204.044.073.044.423-.1 1.028z"/>
      </svg>
    </a>
  </div>
</header>

<!-- Desktop / Tablet Floating Left Icon Navigation Rail with White/Grey Split Popups -->
<aside
  id="desktop-icon-rail"
  aria-label="Quick Navigation Rail"
  class="fixed left-4 lg:left-7 top-1/2 -translate-y-1/2 z-50 hidden md:flex flex-col items-center justify-between rounded-[2.6rem] border border-line/80 bg-paper/90 py-5 px-3 shadow-[0_20px_50px_-12px_rgba(25,25,27,0.22)] backdrop-blur-2xl ring-1 ring-black/5"
>
  <!-- Top: Company Logo Button with Master White/Grey Popover -->
  <div class="relative group flex items-center justify-center pb-3 border-b border-line/70">
    <a
      href="/"
      id="rail-logo-btn"
      class="flex h-13 w-13 items-center justify-center rounded-2xl transition-all duration-200 hover:bg-paper-dim hover:scale-105 active:scale-95"
      aria-label={`${SITE.name} Master Menu`}
    >
      <!-- Company Logo Placeholder / Mark -->
      <span class="flex items-center justify-center gap-1" aria-hidden="true">
        <span class="h-6 w-2.5 rounded-[3px] bg-accent-red"></span>
        <span class="h-6 w-2.5 rounded-[3px] bg-accent"></span>
      </span>
    </a>

    <!-- Top Master White/Grey Mega Popover (Left Links + Right Image Cards) -->
    <div
      class="pointer-events-none absolute left-full ml-1 top-0 z-50 hidden md:flex items-start opacity-0 -translate-x-3 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-x-0"
    >
      <div class="pl-3">
        <div class="w-[42rem] lg:w-[46rem] rounded-[2.2rem] border border-black/10 bg-white p-6 text-left shadow-[0_25px_70px_-15px_rgba(0,0,0,0.18)] text-ink">
          <div class="flex items-stretch gap-6">
            <!-- Left Column: Menu Links -->
            <div class="w-48 shrink-0 pr-5 border-r border-gray-100">
              <p class="font-mono text-[10px] font-bold uppercase tracking-widest text-ink-dim/60 mb-2.5">
                {masterDirectory.categoryTitle}
              </p>
              <div class="space-y-1">
                {masterDirectory.links.map((sub, idx) => (
                  <a
                    href={sub.href}
                    class:list={[
                      'block rounded-xl px-3 py-2 text-xs transition-colors',
                      idx === 0
                        ? 'bg-[#f0efe9] font-bold text-ink'
                        : 'font-medium text-ink-dim hover:text-ink hover:bg-[#f4f3f0] hover:font-semibold'
                    ]}
                  >
                    <div class="flex items-center justify-between">
                      <span>{sub.label}</span>
                      {sub.badge && (
                        <span class="rounded bg-accent/10 px-1.5 py-0.2 font-mono text-[9px] font-bold text-accent">
                          {sub.badge}
                        </span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </div>

            <!-- Right Area: Visual Image Cards -->
            <div class="flex-1 grid grid-cols-2 gap-4.5">
              {masterDirectory.cards.map((card) => (
                <a href={card.href} class="group/card block text-left">
                  <div class="overflow-hidden rounded-2xl aspect-[16/10] bg-[#f4f3f0] border border-black/5 mb-3">
                    <img
                      src={card.image}
                      alt={card.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-105"
                      loading="lazy"
                    />
                  </div>
                  <h4 class="text-xs font-bold text-ink group-hover/card:text-accent transition-colors">
                    {card.title}
                  </h4>
                  <p class="text-[11px] text-ink-dim/80 mt-1 leading-snug">
                    {card.desc}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Center: Primary Icon Navigation Stack with White/Grey Popups -->
  <nav class="my-3 flex flex-col items-center gap-2.5" aria-label="Quick Links">
    {
      navGroups.map((item) => (
        <div class="relative group flex items-center justify-center">
          <a
            href={item.href}
            class:list={[
              'relative flex h-13 w-13 items-center justify-center rounded-2xl transition-all duration-200 hover:scale-105 active:scale-95',
              item.active
                ? 'bg-paper-dim text-ink shadow-sm ring-1 ring-line/80 font-bold'
                : 'text-ink/75 hover:bg-paper-dim/80 hover:text-ink'
            ]}
            aria-label={item.label}
          >
            <!-- Render specific icon based on type -->
            {item.icon === 'home' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            )}

            {item.icon === 'services' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
              </svg>
            )}

            {item.icon === 'user' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
            )}

            {item.icon === 'code' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
              </svg>
            )}

            {item.icon === 'store' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.614A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72m-13.5 8.651h.01" />
              </svg>
            )}

            {item.icon === 'status' && (
              <div class="relative flex items-center justify-center">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
                <span class="absolute -top-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              </div>
            )}

            {item.icon === 'document' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
              </svg>
            )}
          </a>

          <!-- Rich Interactive Hover Popover (White/Grey Theme, Left Links + Right Cards) -->
          <div
            class="pointer-events-none absolute left-full ml-1 top-1/2 -translate-y-1/2 z-50 hidden md:flex items-center opacity-0 -translate-x-3 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-x-0"
          >
            <div class="pl-3">
              <div class="w-[40rem] lg:w-[44rem] rounded-[2.2rem] border border-black/10 bg-white p-6 text-left shadow-[0_25px_70px_-15px_rgba(0,0,0,0.18)] text-ink">
                <div class="flex items-stretch gap-6">
                  <!-- Left Column: Menu Links -->
                  <div class="w-48 shrink-0 pr-5 border-r border-gray-100">
                    <p class="font-mono text-[10px] font-bold uppercase tracking-widest text-ink-dim/60 mb-2.5">
                      {item.categoryTitle}
                    </p>
                    <div class="space-y-1">
                      {item.links.map((sub, idx) => (
                        <a
                          href={sub.href}
                          class:list={[
                            'block rounded-xl px-3 py-2 text-xs transition-colors',
                            idx === 0
                              ? 'bg-[#f0efe9] font-bold text-ink'
                              : 'font-medium text-ink-dim hover:text-ink hover:bg-[#f4f3f0] hover:font-semibold'
                          ]}
                        >
                          <div class="flex items-center justify-between">
                            <span>{sub.label}</span>
                            {sub.badge && (
                              <span class="rounded bg-accent/10 px-1.5 py-0.2 font-mono text-[9px] font-bold text-accent">
                                {sub.badge}
                              </span>
                            )}
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>

                  <!-- Right Area: Visual Image Cards -->
                  <div class="flex-1 grid grid-cols-2 gap-4.5">
                    {item.cards.map((card) => (
                      <a href={card.href} class="group/card block text-left">
                        <div class="overflow-hidden rounded-2xl aspect-[16/10] bg-[#f4f3f0] border border-black/5 mb-3">
                          <img
                            src={card.image}
                            alt={card.title}
                            class="w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-105"
                            loading="lazy"
                          />
                        </div>
                        <h4 class="text-xs font-bold text-ink group-hover/card:text-accent transition-colors">
                          {card.title}
                        </h4>
                        <p class="text-[11px] text-ink-dim/80 mt-1 leading-snug">
                          {card.desc}
                        </p>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </nav>
</aside>



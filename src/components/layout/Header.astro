---
import { SITE } from '../../data/site';
import { PRIMARY_CTA } from '../../data/nav';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const navIcons = [
  {
    label: 'Home',
    subtitle: 'Overview & Fast Entry',
    href: '/',
    badge: null,
    active: currentPath === '/',
    icon: 'home'
  },
  {
    label: 'About & Builders',
    subtitle: 'Razin Hakim & Natasya Umairah',
    href: '/about',
    badge: 'Direct',
    active: isActive('/about'),
    icon: 'user'
  },
  {
    label: 'Solutions & Express',
    subtitle: 'Fixed-Price RM180 - RM4,500',
    href: '/express',
    badge: '3–7d',
    active: isActive('/express') || isActive('/services'),
    icon: 'code'
  },
  {
    label: 'The Marketplace',
    subtitle: '15 Buy-Once PHP Systems',
    href: '/marketplace',
    badge: '15 Systems',
    active: isActive('/marketplace'),
    icon: 'store'
  },
  {
    label: 'Live Build Status',
    subtitle: 'Operational & Direct SLA',
    href: '/status',
    badge: 'Live',
    active: isActive('/status'),
    icon: 'status'
  },
  {
    label: 'Insights & FAQ',
    subtitle: 'AI-First SEO & Answers',
    href: '/insights',
    badge: null,
    active: isActive('/insights') || isActive('/faq'),
    icon: 'document'
  }
];
---

<!-- Mobile Top Bar (< md screens) -->
<header class="fixed left-0 top-0 z-40 flex h-14 w-full items-center justify-between border-b border-line bg-paper/90 px-4 backdrop-blur-md md:hidden">
  <a href="/" class="flex items-center gap-2">
    <span class="flex items-center gap-[3px]" aria-hidden="true">
      <span class="h-5 w-2 rounded-[2px] bg-accent-red"></span>
      <span class="h-5 w-2 rounded-[2px] bg-accent"></span>
    </span>
    <span class="text-sm font-bold tracking-tight text-ink">{SITE.name}</span>
  </a>

  <div class="flex items-center gap-2">
    <a
      href={PRIMARY_CTA.href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-white shadow-sm transition hover:bg-emerald-700"
      aria-label="WhatsApp an Engineer"
    >
      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.072-.5-1.761-.733-2.887-2.526-2.975-2.644-.088-.117-.708-.942-.708-1.798s.446-1.277.607-1.452c.16-.175.349-.219.465-.219.117 0 .233 0 .335.006.107.005.25.04.388.373.145.349.495 1.209.539 1.297.044.088.073.19.015.305-.058.117-.087.19-.175.292-.087.102-.184.228-.263.307-.087.087-.179.182-.077.357.102.175.454.748.974 1.211.669.595 1.233.78 1.408.868.175.087.277.073.379-.044.102-.117.437-.51.554-.685.117-.175.233-.146.393-.087.16.058 1.018.48 1.193.568.175.087.291.131.335.204.044.073.044.423-.1 1.028z"/>
      </svg>
    </a>

    <button
      id="mobile-drawer-toggle"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-xl border border-line bg-paper text-ink transition hover:bg-paper-dim"
      aria-label="Toggle Full Menu"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
  </div>
</header>

<!-- Desktop / Tablet Floating Left Icon Navigation Rail -->
<aside
  id="desktop-icon-rail"
  aria-label="Quick Navigation Rail"
  class="fixed left-4 lg:left-6 top-1/2 -translate-y-1/2 z-50 hidden md:flex flex-col items-center justify-between rounded-[2.2rem] border border-line/75 bg-paper/85 py-3.5 px-2 shadow-[0_16px_45px_-12px_rgba(25,25,27,0.18)] backdrop-blur-xl ring-1 ring-black/5"
>
  <!-- Top: Menu / Full Drawer Button -->
  <div class="relative group flex items-center justify-center pb-2 border-b border-line/60">
    <button
      id="drawer-open-btn"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-xl text-ink transition-all duration-200 hover:bg-paper-dim hover:scale-105 active:scale-95"
      aria-label="Open Full Navigation Menu"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>

    <!-- Hover Tooltip -->
    <div
      role="tooltip"
      class="pointer-events-none absolute left-full ml-3.5 top-1/2 -translate-y-1/2 z-50 hidden md:flex items-center opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-1"
    >
      <div class="rounded-xl border border-line bg-ink px-3.5 py-2 text-left shadow-xl">
        <span class="block text-xs font-bold text-white">Full Menu</span>
        <span class="block font-mono text-[10px] text-white/60">Click to explore all pages</span>
      </div>
    </div>
  </div>

  <!-- Center: Primary Icon Navigation Stack -->
  <nav class="my-2.5 flex flex-col items-center gap-1.5" aria-label="Quick Links">
    {
      navIcons.map((item) => (
        <div class="relative group flex items-center justify-center">
          <a
            href={item.href}
            class:list={[
              'relative flex h-10 w-10 items-center justify-center rounded-xl transition-all duration-200 hover:scale-105 active:scale-95',
              item.active
                ? 'bg-paper-dim/95 text-ink shadow-sm ring-1 ring-line/80 font-bold'
                : 'text-ink/75 hover:bg-paper-dim/80 hover:text-ink'
            ]}
            aria-label={item.label}
          >
            <!-- Render specific icon based on type -->
            {item.icon === 'home' && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            )}

            {item.icon === 'user' && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
            )}

            {item.icon === 'code' && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
              </svg>
            )}

            {item.icon === 'store' && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.614A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72m-13.5 8.651h.01" />
              </svg>
            )}

            {item.icon === 'status' && (
              <div class="relative flex items-center justify-center">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
                <span class="absolute -top-0.5 -right-0.5 h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              </div>
            )}

            {item.icon === 'document' && (
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
              </svg>
            )}
          </a>

          <!-- Hover Details Popover / Tooltip -->
          <div
            role="tooltip"
            class="pointer-events-none absolute left-full ml-3.5 top-1/2 -translate-y-1/2 z-50 hidden md:flex items-center opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-1"
          >
            <div class="min-w-[180px] rounded-2xl border border-line bg-ink p-3 text-left shadow-2xl backdrop-blur-xl">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-bold text-white">{item.label}</span>
                {item.badge && (
                  <span class="rounded bg-accent px-1.5 py-0.2 font-mono text-[9px] font-bold text-white">
                    {item.badge}
                  </span>
                )}
              </div>
              <span class="mt-0.5 block font-mono text-[10px] text-white/60">
                {item.subtitle}
              </span>
            </div>
          </div>
        </div>
      ))
    }
  </nav>

  <!-- Bottom: WhatsApp Action Icon -->
  <div class="relative group flex items-center justify-center pt-2 border-t border-line/60">
    <a
      href={PRIMARY_CTA.href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600/10 text-emerald-600 transition-all duration-200 hover:bg-emerald-600 hover:text-white hover:scale-105 active:scale-95 shadow-sm"
      aria-label="WhatsApp an Engineer"
    >
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.072-.5-1.761-.733-2.887-2.526-2.975-2.644-.088-.117-.708-.942-.708-1.798s.446-1.277.607-1.452c.16-.175.349-.219.465-.219.117 0 .233 0 .335.006.107.005.25.04.388.373.145.349.495 1.209.539 1.297.044.088.073.19.015.305-.058.117-.087.19-.175.292-.087.102-.184.228-.263.307-.087.087-.179.182-.077.357.102.175.454.748.974 1.211.669.595 1.233.78 1.408.868.175.087.277.073.379-.044.102-.117.437-.51.554-.685.117-.175.233-.146.393-.087.16.058 1.018.48 1.193.568.175.087.291.131.335.204.044.073.044.423-.1 1.028z"/>
      </svg>
    </a>

    <!-- Tooltip -->
    <div
      role="tooltip"
      class="pointer-events-none absolute left-full ml-3.5 top-1/2 -translate-y-1/2 z-50 hidden md:flex items-center opacity-0 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-1"
    >
      <div class="min-w-[190px] rounded-2xl border border-line bg-emerald-950 p-3 text-left shadow-2xl text-white">
        <div class="flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-bold">WhatsApp an Engineer</span>
        </div>
        <span class="mt-0.5 block font-mono text-[10px] text-emerald-200/70">
          Instant chat with Razin &amp; Natasya
        </span>
      </div>
    </div>
  </div>
</aside>

<!-- Full Flyout Navigation Drawer (Opens when clicking Hamburger icon) -->
<div
  id="full-nav-backdrop"
  class="fixed inset-0 z-55 hidden bg-ink/60 backdrop-blur-md transition-opacity duration-300"
  aria-hidden="true"
></div>

<div
  id="full-nav-drawer"
  class="fixed left-0 top-0 z-60 flex h-screen w-80 max-w-[85vw] -translate-x-full flex-col justify-between border-r border-line bg-paper/98 p-6 shadow-2xl backdrop-blur-2xl transition-transform duration-300 ease-in-out"
>
  <div>
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-line pb-4">
      <a href="/" class="flex items-center gap-2.5">
        <span class="flex items-center gap-[3px]" aria-hidden="true">
          <span class="h-6 w-2.5 rounded-[3px] bg-accent-red"></span>
          <span class="h-6 w-2.5 rounded-[3px] bg-accent"></span>
        </span>
        <div>
          <span class="block text-base font-bold tracking-tight text-ink">{SITE.name}</span>
          <span class="block font-mono text-[9px] uppercase tracking-wider text-ink-dim/80">Productized Engineering</span>
        </div>
      </a>

      <button
        id="drawer-close-btn"
        type="button"
        class="flex h-8 w-8 items-center justify-center rounded-lg text-ink-dim hover:bg-paper-dim hover:text-ink"
        aria-label="Close Drawer"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Status link -->
    <div class="mt-4">
      <a
        href="/status"
        class="flex items-center justify-between rounded-xl border border-emerald-500/30 bg-emerald-500/5 px-3 py-1.5 text-[11px] font-mono text-emerald-800 transition hover:bg-emerald-500/10"
      >
        <span class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Status: Operational</span>
        </span>
        <span class="text-[9px] font-bold uppercase text-emerald-700">Live SLA</span>
      </a>
    </div>

    <!-- Full Navigation Links Tree -->
    <nav class="mt-6 space-y-4 overflow-y-auto max-h-[calc(100vh-320px)] pr-1">
      <div>
        <p class="mono-label px-2 pb-1 text-[10px] uppercase text-ink-dim/70 font-bold">Solutions</p>
        <div class="space-y-0.5">
          <a href="/express" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold text-ink hover:bg-paper-dim">
            <span>WSS Express</span>
            <span class="rounded bg-accent/10 px-1.5 py-0.2 font-mono text-[9px] font-bold text-accent">3–7d</span>
          </a>
          <a href="/marketplace" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold text-ink hover:bg-paper-dim">
            <span>The Marketplace</span>
            <span class="rounded bg-emerald-700/10 px-1.5 py-0.2 font-mono text-[9px] font-bold text-emerald-800">15 Systems</span>
          </a>
          <a href="/services/bespoke" class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold text-ink hover:bg-paper-dim">
            <span>Bespoke Enterprise</span>
            <span class="rounded bg-amber-500/10 px-1.5 py-0.2 font-mono text-[9px] font-bold text-amber-800">Grant</span>
          </a>
          <a href="/services" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            All Services Catalog
          </a>
          <a href="/pricing" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            Pricing &amp; Packages
          </a>
        </div>
      </div>

      <div>
        <p class="mono-label px-2 pb-1 text-[10px] uppercase text-ink-dim/70 font-bold">Studio &amp; Trust</p>
        <div class="space-y-0.5">
          <a href="/status" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            Live Build Status
          </a>
          <a href="/work" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            Projects &amp; Case Studies
          </a>
          <a href="/process" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            How We Build (Process)
          </a>
          <a href="/about" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            About &amp; Builders
          </a>
          <a href="/insights" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            Insights &amp; AI-SEO
          </a>
          <a href="/faq" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            Direct FAQ
          </a>
          <a href="/contact" class="block rounded-xl px-3 py-2 text-xs font-medium text-ink-dim hover:bg-paper-dim hover:text-ink">
            Contact
          </a>
        </div>
      </div>
    </nav>
  </div>

  <!-- Bottom: Direct Action -->
  <div class="border-t border-line pt-4">
    <a
      href={PRIMARY_CTA.href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-xs font-semibold text-white shadow-md shadow-accent/20 transition hover:bg-accent-dim"
    >
      <span>{PRIMARY_CTA.label}</span>
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</div>

<script>
  function initDrawerHandlers() {
    const openBtn = document.getElementById('drawer-open-btn');
    const mobileToggle = document.getElementById('mobile-drawer-toggle');
    const closeBtn = document.getElementById('drawer-close-btn');
    const drawer = document.getElementById('full-nav-drawer');
    const backdrop = document.getElementById('full-nav-backdrop');

    if (!drawer || !backdrop) return;

    function open() {
      drawer?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      drawer?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', open);
    mobileToggle?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    backdrop.addEventListener('click', close);

    const drawerLinks = drawer.querySelectorAll('a');
    drawerLinks.forEach((l) => l.addEventListener('click', close));
  }

  initDrawerHandlers();
  document.addEventListener('astro:page-load', initDrawerHandlers);
</script>

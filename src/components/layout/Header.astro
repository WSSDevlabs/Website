---
import { PRIMARY_CTA } from '../../data/nav';
import { SITE } from '../../data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!-- Mobile Top Bar (Visible only on < md screens) -->
<header class="fixed left-0 top-0 z-40 flex h-14 w-full items-center justify-between border-b border-line bg-paper/90 px-4 backdrop-blur-md md:hidden">
  <a href="/" class="flex items-center gap-2.5">
    <span class="flex items-center gap-[3px]" aria-hidden="true">
      <span class="h-5 w-2 rounded-[2px] bg-accent-red"></span>
      <span class="h-5 w-2 rounded-[2px] bg-accent"></span>
    </span>
    <span class="text-base font-bold tracking-tight text-ink">{SITE.name}</span>
  </a>

  <div class="flex items-center gap-2">
    <a
      href={PRIMARY_CTA.href}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full bg-accent px-3 py-1 text-xs font-semibold text-white shadow-sm"
      aria-label="WhatsApp an Engineer"
    >
      WhatsApp
    </a>

    <button
      id="sidebar-toggle-btn"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-xl border border-line bg-paper text-ink transition hover:bg-paper-dim"
      aria-label="Open Navigation Menu"
      aria-expanded="false"
      aria-controls="left-sidebar-nav"
    >
      <svg id="sidebar-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="sidebar-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Backdrop Overlay -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-45 hidden bg-ink/50 backdrop-blur-sm transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<!-- Left Side Navigation Bar (Docked on Desktop, Slide-over on Mobile) -->
<aside
  id="left-sidebar-nav"
  aria-label="Sidebar Navigation"
  class:list={[
    'fixed left-0 top-0 z-50 flex h-screen w-64 lg:w-72 flex-col justify-between border-r border-line bg-paper/98 p-5 backdrop-blur-xl shadow-[4px_0_24px_-12px_rgb(25_25_27/0.08)] transition-transform duration-300 ease-in-out md:translate-x-0',
    '-translate-x-full' // Hidden off-screen on mobile until toggled
  ]}
>
  <!-- Top: Brand & Status -->
  <div>
    <!-- Logo & Close on mobile -->
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <span class="flex items-center gap-[3px]" aria-hidden="true">
          <span class="h-6 w-2.5 rounded-[3px] bg-accent-red"></span>
          <span class="h-6 w-2.5 rounded-[3px] bg-accent"></span>
        </span>
        <div>
          <span class="block text-lg font-bold tracking-tight text-ink">{SITE.name}</span>
          <span class="block font-mono text-[9px] uppercase tracking-wider text-ink-dim/80">Productized Engineering</span>
        </div>
      </a>

      <button
        id="sidebar-close-btn"
        type="button"
        class="flex h-8 w-8 items-center justify-center rounded-lg text-ink-dim hover:bg-paper-dim hover:text-ink md:hidden"
        aria-label="Close Sidebar"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Live Status Pill -->
    <div class="mt-4">
      <a
        href="/status"
        class="flex items-center justify-between rounded-xl border border-emerald-500/30 bg-emerald-500/5 px-3 py-1.5 text-[11px] font-mono text-emerald-800 transition hover:bg-emerald-500/10"
      >
        <span class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Status: Operational</span>
        </span>
        <span class="text-[9px] font-bold uppercase text-emerald-700">Live SLA</span>
      </a>
    </div>

    <!-- Navigation Groups -->
    <nav class="mt-6 space-y-5 overflow-y-auto max-h-[calc(100vh-340px)] pr-1">
      <!-- Section 1: Solutions -->
      <div>
        <p class="mono-label px-2 pb-1.5 text-[10px] uppercase text-ink-dim/70">Solutions</p>
        <div class="space-y-0.5">
          <a
            href="/express"
            class:list={[
              'flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold transition-colors',
              isActive('/express') ? 'bg-accent text-white shadow-sm' : 'text-ink hover:bg-paper-dim'
            ]}
          >
            <span>WSS Express</span>
            <span class:list={['rounded px-1.5 py-0.2 text-[9px] font-bold font-mono', isActive('/express') ? 'bg-white/20 text-white' : 'bg-accent/10 text-accent']}>
              3–7d
            </span>
          </a>

          <a
            href="/marketplace"
            class:list={[
              'flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold transition-colors',
              isActive('/marketplace') ? 'bg-accent text-white shadow-sm' : 'text-ink hover:bg-paper-dim'
            ]}
          >
            <span>The Marketplace</span>
            <span class:list={['rounded px-1.5 py-0.2 text-[9px] font-bold font-mono', isActive('/marketplace') ? 'bg-white/20 text-white' : 'bg-emerald-700/10 text-emerald-800']}>
              15 Systems
            </span>
          </a>

          <a
            href="/services/bespoke"
            class:list={[
              'flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold transition-colors',
              isActive('/services/bespoke') ? 'bg-accent text-white shadow-sm' : 'text-ink hover:bg-paper-dim'
            ]}
          >
            <span>Bespoke Enterprise</span>
            <span class:list={['rounded px-1.5 py-0.2 text-[9px] font-bold font-mono', isActive('/services/bespoke') ? 'bg-white/20 text-white' : 'bg-amber-500/10 text-amber-800']}>
              Grant
            </span>
          </a>

          <a
            href="/services"
            class:list={[
              'block rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/services') && !isActive('/services/bespoke') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            All Services Catalog
          </a>

          <a
            href="/pricing"
            class:list={[
              'block rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/pricing') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            Pricing &amp; Packages
          </a>
        </div>
      </div>

      <!-- Section 2: Studio & Trust -->
      <div>
        <p class="mono-label px-2 pb-1.5 text-[10px] uppercase text-ink-dim/70">Studio &amp; Trust</p>
        <div class="space-y-0.5">
          <a
            href="/status"
            class:list={[
              'flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/status') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            <span>Live Build Status</span>
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          </a>

          <a
            href="/work"
            class:list={[
              'block rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/work') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            Projects &amp; Case Studies
          </a>

          <a
            href="/process"
            class:list={[
              'block rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/process') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            How We Build (Process)
          </a>

          <a
            href="/about"
            class:list={[
              'block rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/about') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            About &amp; Builders
          </a>

          <a
            href="/insights"
            class:list={[
              'block rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/insights') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            Insights &amp; AI-SEO
          </a>

          <a
            href="/faq"
            class:list={[
              'block rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/faq') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            Direct FAQ
          </a>

          <a
            href="/contact"
            class:list={[
              'block rounded-xl px-3 py-2 text-xs font-medium transition-colors',
              isActive('/contact') ? 'bg-accent/10 text-accent font-semibold' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
            ]}
          >
            Contact
          </a>
        </div>
      </div>
    </nav>
  </div>

  <!-- Bottom: Direct Builder Action & Contact CTA -->
  <div class="border-t border-line pt-4">
    <!-- Direct Builder Avatars -->
    <div class="mb-3 flex items-center justify-between rounded-xl bg-paper-dim/60 p-2.5">
      <div class="flex items-center gap-2">
        <div class="flex -space-x-2 overflow-hidden">
          <img
            class="inline-block h-6 w-6 rounded-full ring-2 ring-paper"
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=60&h=60&q=80"
            alt="Razin Hakim"
          />
          <img
            class="inline-block h-6 w-6 rounded-full ring-2 ring-paper"
            src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=60&h=60&q=80"
            alt="Natasya Umairah"
          />
        </div>
        <div class="leading-none">
          <span class="block text-[11px] font-bold text-ink">Razin &amp; Natasya</span>
          <span class="block text-[9px] text-accent">Direct with Builders</span>
        </div>
      </div>
      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
    </div>

    <!-- Primary CTA -->
    <a
      href={PRIMARY_CTA.href}
      target="_blank"
      rel="noopener noreferrer"
      class="flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-xs font-semibold text-white shadow-md shadow-accent/20 transition-all hover:bg-accent-dim hover:shadow-lg"
    >
      <span>{PRIMARY_CTA.label}</span>
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </a>

    <!-- Footer SSM / copyright note -->
    <div class="mt-3 text-center text-[10px] text-ink-dim/60">
      <span>&copy; {new Date().getFullYear()} {SITE.name} · Malaysia</span>
    </div>
  </div>
</aside>

<script>
  function initSidebarDrawer() {
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const closeBtn = document.getElementById('sidebar-close-btn');
    const sidebar = document.getElementById('left-sidebar-nav');
    const backdrop = document.getElementById('sidebar-backdrop');
    const iconOpen = document.getElementById('sidebar-icon-open');
    const iconClose = document.getElementById('sidebar-icon-close');

    if (!toggleBtn || !sidebar || !backdrop || toggleBtn.dataset.bound) return;
    toggleBtn.dataset.bound = '1';

    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', () => {
      const isClosed = sidebar.classList.contains('-translate-x-full');
      if (isClosed) {
        openSidebar();
      } else {
        closeSidebar();
      }
    });

    closeBtn?.addEventListener('click', closeSidebar);
    backdrop.addEventListener('click', closeSidebar);

    // Close on navigation link click (mobile)
    const links = sidebar.querySelectorAll('a');
    links.forEach((l) => l.addEventListener('click', () => {
      if (window.innerWidth < 768) {
        closeSidebar();
      }
    }));
  }

  initSidebarDrawer();
  document.addEventListener('astro:page-load', initSidebarDrawer);
</script>

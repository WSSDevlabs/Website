---
import { SERVICE_CATEGORIES } from '../../data/serviceCategories';

type Props = {
  path: string;
};

const { path } = Astro.props;
const show = path !== '/' && path !== '/contact';
---

{
  show && (
    <div
      id="services-popup"
      class="fixed left-4 top-24 z-40 w-[min(90vw,21rem)] origin-top-left -translate-x-6 opacity-0 transition-all duration-500 [transition-timing-function:var(--ease-out-expo)] md:left-6 md:top-28"
    >
      <div class="max-h-[75vh] overflow-y-auto rounded-3xl border border-line bg-white p-4 shadow-float sm:p-5">
        <div class="flex items-center justify-between gap-3 px-1 pb-3">
          <div>
            <p class="mono-label text-accent">Explore</p>
            <h2 class="mt-0.5 text-base font-bold tracking-tight text-ink">Services you may like</h2>
          </div>
          <button
            type="button"
            id="services-popup-close"
            aria-label="Close"
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line text-ink-dim transition-colors hover:bg-paper-dim hover:text-ink"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="space-y-2">
          {
            SERVICE_CATEGORIES.map((cat, i) => (
              <a
                href={`/services/${cat.slug}`}
                class="group flex items-center gap-3 rounded-full border border-line bg-paper-dim/40 py-2 pl-2 pr-3 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-white hover:shadow-card"
              >
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-dim font-mono text-xs font-bold text-ink-dim">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="flex-1 text-sm font-bold leading-tight text-ink">{cat.title}</span>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-dim text-ink transition-colors duration-200 group-hover:bg-accent group-hover:text-white">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  )
}

<script>
  function initServicesPopup() {
    const popup = document.getElementById('services-popup');
    if (!popup) return;

    if (sessionStorage.getItem('wss-services-popup-dismissed')) {
      popup.remove();
      return;
    }

    const closeBtn = document.getElementById('services-popup-close');
    const dismiss = () => {
      popup.classList.add('opacity-0', '-translate-x-6');
      sessionStorage.setItem('wss-services-popup-dismissed', '1');
      window.setTimeout(() => popup.remove(), 500);
    };

    closeBtn?.addEventListener('click', dismiss);

    window.setTimeout(() => {
      popup.classList.remove('opacity-0', '-translate-x-6');
    }, 1400);
  }

  initServicesPopup();
</script>

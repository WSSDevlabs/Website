---
type Props = {
  items?: string[];
  class?: string;
};

const {
  items = [
    'Creativity',
    'Excellence',
    'Reliability',
    'High Performance',
    'Scalability',
    'Zero SaaS Tax',
    'Direct SLA',
    'Clean Architecture'
  ],
  class: className = ''
} = Astro.props;

// Duplicate so the seamless loop works
const doubled = [...items, ...items, ...items];
---

<div class:list={['marquee-pausable relative overflow-hidden py-6 bg-paper-dim border-y border-line/80 text-ink', className]} aria-hidden="true">
  <div class="mask-fade-x">
    <div class="animate-marquee flex w-max whitespace-nowrap items-center">
      {
        doubled.map((item) => (
          <span class="mx-8 flex items-center gap-8 font-display text-xl sm:text-2xl font-black uppercase tracking-wider text-ink">
            <span>{item}</span>
            <span class="text-accent text-xl">✦</span>
          </span>
        ))
      }
    </div>
  </div>
</div>


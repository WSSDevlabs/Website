---
type Props = {
  href: string;
  variant?: 'primary' | 'secondary' | 'whatsapp';
  size?: 'md' | 'lg';
  /** Conversion event name sent to Cloudflare Zaraz when clicked (audit T12). */
  track?: string;
  external?: boolean;
  class?: string;
};

const { href, variant = 'primary', size = 'md', track, external = false, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, size === 'lg' && 'btn-lg', className]}
  data-track={track}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>

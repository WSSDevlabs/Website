---
import Disclosure from './Disclosure.astro';

type Props = {
  items: { q: string; a: string }[];
  class?: string;
};

const { items, class: className = '' } = Astro.props;
---

<div class:list={['divide-y divide-line border-y border-line', className]}>
  {
    items.map((item) => (
      <Disclosure summary={item.q} class="py-2" summaryClass="py-2 text-left text-base font-semibold text-ink sm:text-lg">
        <p class="max-w-3xl text-ink-dim">{item.a}</p>
      </Disclosure>
    ))
  }
</div>

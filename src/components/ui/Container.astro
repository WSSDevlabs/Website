---
type Props = {
  class?: string;
  /** Narrow width for reading pages (legal text, articles). */
  narrow?: boolean;
};

const { class: className = '', narrow = false } = Astro.props;
---

<div class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', narrow ? 'max-w-3xl' : 'max-w-6xl', className]}>
  <slot />
</div>

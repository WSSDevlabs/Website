---
import Icon from './Icon.astro';

type Props = { items: { name: string; href?: string }[] };
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-ink-dim">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && <Icon name="chevron-right" class="h-4 w-4 text-muted" />}
          {item.href ? (
            <a href={item.href} class="inline-flex min-h-11 items-center hover:text-ink">
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class="text-ink">
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

---
type Props = {
  href: string;
  label: string;
  variant?: 'dark' | 'light' | 'ghost' | 'red';
  class?: string;
  external?: boolean;
};

const { href, label, variant = 'dark', class: className = '', external = false } = Astro.props;
const variantClass =
  variant === 'light' ? 'btn-arrow--light' : variant === 'ghost' ? 'btn-arrow--ghost' : variant === 'red' ? 'btn-arrow--red' : '';
---

<a
  href={href}
  class:list={['btn-arrow', variantClass, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span>{label}</span>
  <span class="btn-arrow__dot">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
    </svg>
  </span>
</a>

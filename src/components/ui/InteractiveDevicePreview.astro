---
/**
 * Desktop / mobile preview frame. It only ever shows real material: screenshots or a real
 * demo passed in through the slot. It never shows a made-up address or live status.
 */
type Props = {
  title?: string;
  /** Text for the address bar. Use a real URL only when a real demo exists. */
  addressLabel?: string;
  /** Small chip on the right of the address bar. */
  chip?: string;
  class?: string;
};

const {
  title = 'System preview',
  addressLabel = 'Walkthrough on request',
  chip = 'Sample data',
  class: className = ''
} = Astro.props;

const previewId = `preview-${Math.random().toString(36).substring(2, 9)}`;
---

<div class:list={['rounded-3xl border border-line bg-ink p-4 text-white shadow-2xl sm:p-6', className]} id={previewId}>
  <!-- Top Bar: Device Mode Switcher & title -->
  <div class="flex flex-col gap-4 border-b border-white/10 pb-4 sm:flex-row sm:items-center sm:justify-between">
    <!-- Left: Window Controls & Title -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
        <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
        <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
      </div>
      <span class="font-mono text-xs text-white/60 font-semibold">{title}</span>
    </div>

    <!-- Center/Right: Viewport Toggle Tabs -->
    <div class="flex items-center rounded-full border border-white/15 bg-white/5 p-1 text-xs">
      <button
        type="button"
        data-device-target="desktop"
        class="device-btn active-device flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 font-semibold text-white transition-all duration-200"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3" />
        </svg>
        <span>Desktop</span>
      </button>

      <button
        type="button"
        data-device-target="mobile"
        class="device-btn flex items-center gap-1.5 rounded-full px-3 py-1 font-semibold text-white/60 transition-all duration-200 hover:text-white"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
        </svg>
        <span>Mobile (375px)</span>
      </button>
    </div>
  </div>

  <!-- Address Bar -->
  <div class="mt-3 flex items-center justify-between rounded-xl bg-white/5 px-3 py-1.5 text-[11px] font-mono text-white/50">
    <span class="text-white/80">{addressLabel}</span>
    <span class="rounded bg-white/10 px-1.5 py-0.5 text-[9px] text-accent-yellow-vivid">{chip}</span>
  </div>

  <!-- Viewport Stage -->
  <div class="viewport-stage mt-4 flex items-center justify-center overflow-hidden rounded-2xl bg-paper p-4 transition-all duration-300 min-h-[380px]">
    <!-- Desktop Mode Viewport -->
    <div class="viewport-container w-full transition-all duration-300 ease-out">
      <div class="preview-content rounded-xl border border-line bg-paper p-6 text-ink">
        <slot>
          <p class="text-sm font-semibold text-ink">{title}</p>
          <p class="mt-2 text-xs text-ink-dim">Screenshots appear here once they're published.</p>
        </slot>
      </div>
    </div>
  </div>
</div>

<script>
  function initDevicePreviews() {
    document.querySelectorAll<HTMLButtonElement>('.device-btn:not([data-bound])').forEach((btn) => {
      btn.dataset.bound = '1';
      btn.addEventListener('click', (e) => {
        const targetBtn = e.currentTarget as HTMLButtonElement;
        const parentStage = targetBtn.closest('.rounded-3xl');
        if (!parentStage) return;

        const targetMode = targetBtn.dataset.deviceTarget;
        const container = parentStage.querySelector('.viewport-container') as HTMLElement;
        const allBtns = parentStage.querySelectorAll('.device-btn');

        allBtns.forEach((b) => {
          b.classList.remove('active-device', 'bg-accent', 'text-white');
          b.classList.add('text-white/60');
        });

        targetBtn.classList.add('active-device', 'bg-accent', 'text-white');
        targetBtn.classList.remove('text-white/60');

        if (targetMode === 'mobile') {
          container.style.maxWidth = '375px';
          container.classList.add('shadow-2xl', 'ring-8', 'ring-ink', 'rounded-[2rem]');
        } else {
          container.style.maxWidth = '100%';
          container.classList.remove('shadow-2xl', 'ring-8', 'ring-ink', 'rounded-[2rem]');
        }
      });
    });
  }

  initDevicePreviews();
  document.addEventListener('astro:page-load', initDevicePreviews);
</script>

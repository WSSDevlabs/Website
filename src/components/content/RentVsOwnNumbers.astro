---
import {
  CARE_BASIC_MONTHLY,
  LICENCE_TERMS,
  RENT_VS_OWN,
  SYSTEM_EXTRAS,
  SYSTEM_TIERS,
  formatRM,
  subscriptionTotal
} from '../../data/catalog';

/** The worked 3-year example for articles, read live from the catalogue. Stacked cards, so nothing scrolls sideways on a phone. */
const months = RENT_VS_OWN.months;
const licence = SYSTEM_TIERS.standard.price;
const install = SYSTEM_EXTRAS.installation.price;
const hosting = RENT_VS_OWN.hostingEstimateMonthly * months;
const care = CARE_BASIC_MONTHLY * months;
const ownBare = licence + install + hosting;
const ownWithCare = ownBare + care;

const options = [
  {
    name: 'Renting',
    rows: [
      ['Software', `${formatRM(RENT_VS_OWN.subscriptionMonthly)} x ${months} months`],
      ['Hosting', 'Included'],
      ['Support, updates, backups', 'Included']
    ],
    total: subscriptionTotal
  },
  {
    name: 'Owning, no Care Plan',
    rows: [
      ['Software', `${formatRM(licence)} licence + ${formatRM(install)} installation`],
      ['Hosting (estimate)', `${formatRM(RENT_VS_OWN.hostingEstimateMonthly)} x ${months} months`],
      ['Support, updates, backups', `${LICENCE_TERMS.supportDays} days support, ${LICENCE_TERMS.updateMonths} months of updates`]
    ],
    total: ownBare
  },
  {
    name: 'Owning, with Care Basic',
    rows: [
      ['Software', `${formatRM(licence)} licence + ${formatRM(install)} installation`],
      ['Hosting (estimate)', `${formatRM(RENT_VS_OWN.hostingEstimateMonthly)} x ${months} months`],
      ['Support, updates, backups', `${formatRM(CARE_BASIC_MONTHLY)} x ${months} months`]
    ],
    total: ownWithCare
  }
];
---

<div class="not-prose my-8 grid gap-4 md:grid-cols-3">
  {
    options.map((option) => (
      <div class="rounded-2xl border border-line bg-white p-5 shadow-sm">
        <p class="font-display text-lg font-bold text-ink">{option.name}</p>
        <dl class="mt-3 space-y-2 text-sm">
          {option.rows.map(([label, value]) => (
            <div>
              <dt class="text-ink-dim">{label}</dt>
              <dd class="font-medium text-ink">{value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 border-t border-line pt-3 text-sm text-ink-dim">
          {months / 12}-year total
          <span class="block font-feature text-2xl font-black text-ink">{formatRM(option.total)}</span>
        </p>
      </div>
    ))
  }
</div>

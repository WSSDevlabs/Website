---
import { HOSTING_SITE_YEARLY, HOSTING_STORE_YEARLY, WEBSITE_PACKAGES, formatRM } from '../../data/catalog';

/** Our website prices for use inside articles, read live from the catalogue so they can never drift. */
const scope: Record<string, string> = {
  'one-page': 'One page, up to 5 sections',
  business: 'Up to 6 pages, edit it yourself (CMS)',
  store: 'Up to 10 pages, 50 products loaded, online payments'
};
---

<table>
  <thead>
    <tr>
      <th>Package</th>
      <th>Price (one-time)</th>
      <th>What it is</th>
      <th>Live in</th>
    </tr>
  </thead>
  <tbody>
    {
      WEBSITE_PACKAGES.map((pkg) => (
        <tr>
          <td>{pkg.name}</td>
          <td>{formatRM(pkg.price)}</td>
          <td>{scope[pkg.id]}</td>
          <td>{pkg.timeline.replace('Live in ', '')}</td>
        </tr>
      ))
    }
  </tbody>
</table>
<p>
  From year 2, hosting and domain are {formatRM(HOSTING_SITE_YEARLY)} a year for websites and {formatRM(HOSTING_STORE_YEARLY)} a
  year for stores, or included in any Care Plan. No SST is added.
</p>

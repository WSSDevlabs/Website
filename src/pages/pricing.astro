---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import QuoteForm from '../components/sections/QuoteForm.astro';
import FAQ from '../components/sections/FAQ.astro';
import PricingCard from '../components/sections/PricingCard.astro';
import { PRICING_TIERS } from '../data/pricing';
import { PRICING_FAQ } from '../data/faq';
---

<BaseLayout
  title="Pricing: WSS DevLabs"
  description="Five packages, matched to where your business actually is: Launch, Expand, Grow, Scale, and Custom. Transparent, fixed-price proposals."
  path="/pricing"
>

  <!-- Five packages, by business stage -->
  <Section rule class="pt-28 md:pt-36">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-accent">Pricing</p>
        <h2 class="mt-2 text-3xl font-bold text-ink">Five packages, matched to where you are</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          Every package bundles the services that actually make sense at your stage, from a first-ever
          website to a full corporate system rebuild. Some qualify for the government's MSME Digital
          Grant MADANI.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 md:items-start" data-stagger>
        {PRICING_TIERS.map((tier) => <PricingCard tier={tier} />)}
      </div>

      <p class="mt-8 text-center text-sm text-ink-dim">
        Project doesn't fit neatly into one package?{' '}
        <a href="/contact" class="font-semibold text-accent hover:underline">Tell us what you need</a>{' '}
        and we'll scope the right mix.
      </p>
    </Container>
  </Section>

  <FAQ title="Freely ask us for more information" items={PRICING_FAQ} />

  <QuoteForm />

</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import RentVsOwnCalculator from '../../components/sections/RentVsOwnCalculator.astro';
import CarePlans from '../../components/sections/CarePlans.astro';
import FAQ from '../../components/sections/FAQ.astro';
import CTABand from '../../components/sections/CTABand.astro';
import { BUYER_GROUPS, PUBLIC_SYSTEMS, systemPrice, type BuyerGroup, type SystemProduct } from '../../data/systems';
import { PUBLISHED_ECOSYSTEMS } from '../../data/ecosystems';
import {
  CARE_BASIC_MONTHLY,
  LICENCE_TERMS,
  RENT_VS_OWN,
  SYSTEM_EXTRAS,
  SYSTEM_TIERS,
  formatRM,
  subscriptionTotal
} from '../../data/catalog';
import { SYSTEMS_FAQ } from '../../data/faqs';
import { whatsappHref } from '../../data/site';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();

const GROUP_META: Record<BuyerGroup | 'all', { icon: string; description: string }> = {
  retail: {
    icon: 'M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 1.9-4.652 2.257-7.126a1.125 1.125 0 0 0-1.13-1.243H4.117L3.85 4.402A1.125 1.125 0 0 0 2.762 3.6H2.25m6 15.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm11.25 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z',
    description: 'Point of sale and self-service kiosks for shops, cafés and restaurants.'
  },
  offices: {
    icon: 'M2.25 21h19.5M4.5 21V9.75l7.5-6 7.5 6V21M9.75 21v-6h4.5v6',
    description: 'Attendance, staff portal, helpdesk, assets, vehicles and forms for growing teams.'
  },
  security: {
    icon: 'M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
    description: 'Visitors, guard patrols, parcels and incidents for guarded premises.'
  },
  events: {
    icon: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5',
    description: 'Room and event space booking, kiosks and digital forms for venues and organisers.'
  },
  all: {
    icon: 'M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z',
    description: 'Every ready-made system, A to Z.'
  }
};

type Group = { name: string; icon: string; description: string; systems: SystemProduct[] };

const groups: Group[] = [
  ...(Object.keys(BUYER_GROUPS) as BuyerGroup[]).map((key) => ({
    name: BUYER_GROUPS[key],
    icon: GROUP_META[key].icon,
    description: GROUP_META[key].description,
    systems: PUBLIC_SYSTEMS.filter((s) => s.groups?.includes(key))
  })),
  {
    name: 'All systems',
    icon: GROUP_META.all.icon,
    description: GROUP_META.all.description,
    systems: [...PUBLIC_SYSTEMS].sort((a, b) => a.name.localeCompare(b.name))
  }
];

const tiers = (Object.keys(SYSTEM_TIERS) as (keyof typeof SYSTEM_TIERS)[]).map((key) => ({ key, ...SYSTEM_TIERS[key] }));

const extras = [SYSTEM_EXTRAS.installation, SYSTEM_EXTRAS.branding, SYSTEM_EXTRAS.training, SYSTEM_EXTRAS.dataImport];

const licence = SYSTEM_TIERS.standard.price;
const install = SYSTEM_EXTRAS.installation.price;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      name: 'Ready-made business systems',
      itemListElement: PUBLIC_SYSTEMS.map((system, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(`/systems/${system.slug}/`, siteUrl).toString(),
        name: system.name
      }))
    },
    faqSchema(SYSTEMS_FAQ),
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Systems', path: '/systems/' }
    ])
  ]
};
---

<BaseLayout
  title="Ready-Made Business Systems You Pay for Once"
  description={`${PUBLIC_SYSTEMS.length} ready-made business systems for Malaysian SMEs: POS, visitor management, attendance, helpdesk and more. From ${formatRM(SYSTEM_TIERS.basic.price)} one-time, with full source code and no monthly fees.`}
  path="/systems/"
  schema={schema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-10 pb-20 md:pt-40 md:pb-28">
    <div class="grid-pattern mask-fade-edges absolute inset-0 opacity-25" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 top-1/4 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-40 top-0 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>

    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl md:text-6xl">
          Ready-made business systems. <span class="badge-highlight">Pay once.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg">
          Own the code, keep your data on your own server, and never pay monthly rent. Book a 15-minute screen-share to see any
          system working before you buy.
        </p>
      </div>
    </Container>
  </section>

  <!-- Complete solutions (ecosystems) -->
  {
    PUBLISHED_ECOSYSTEMS.length > 0 && (
      <Section rule>
        <Container>
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-2xl font-bold text-ink md:text-3xl">Complete solutions</h2>
            <p class="mt-2 text-sm text-ink-dim">Several systems connected into one dashboard, for one kind of business.</p>
          </div>

          <div class="mt-10 grid gap-5 md:grid-cols-2">
            {PUBLISHED_ECOSYSTEMS.map((eco) => (
              <a
                href={`/systems/${eco.slug}/`}
                class="group relative flex flex-col rounded-2xl border border-line bg-paper p-6 shadow-sm transition-all duration-300 hover:border-accent hover:shadow-lg"
              >
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <h3 class="text-lg font-bold text-ink">{eco.name}</h3>
                  <span class="rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-bold text-emerald-700">{eco.status}</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-ink-dim">{eco.pitch}</p>
                <p class="mt-4 text-sm font-semibold text-ink">
                  From {formatRM(eco.packages[0].price)} <span class="font-normal text-ink-dim">+ hardware, quoted separately</span>
                </p>
                <p class="mt-4 flex items-center gap-1.5 text-xs font-semibold text-accent">
                  See how it works
                  <svg class="h-3 w-3 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </p>
              </a>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- Category Browser: hover/tap a group to reveal its systems -->
  <Section rule class="bg-paper-dim/30" id="browse">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold text-ink md:text-3xl">
          Browse {PUBLIC_SYSTEMS.length} systems by who you are
        </h2>
        <p class="mt-2 text-sm text-ink-dim">Tap or hover a group to see its systems and prices.</p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          groups.map((group) => (
            <div
              tabindex="0"
              class="category-card group relative flex flex-col rounded-2xl border border-line bg-paper p-6 shadow-sm transition-all duration-300 hover:border-accent hover:shadow-lg focus:border-accent focus:shadow-lg focus:outline-none focus-within:border-accent"
            >
              <div class="flex items-start justify-between gap-3">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/8 text-accent">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={group.icon} />
                  </svg>
                </span>
                <span class="rounded-full bg-paper-dim px-2.5 py-1 text-[11px] font-bold text-ink-dim">
                  {group.systems.length} System{group.systems.length === 1 ? '' : 's'}
                </span>
              </div>

              <h3 class="mt-4 text-base font-bold text-ink">{group.name}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-ink-dim">{group.description}</p>

              <p class="category-hint mt-4 flex items-center gap-1.5 text-[11px] font-semibold text-accent transition-opacity duration-200 group-hover:opacity-0 group-focus:opacity-0 group-focus-within:opacity-0">
                Tap or hover to see systems
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </p>

              {/* Reveal panel: collapsed by default, expands on hover/focus */}
              <div class="category-reveal grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 [transition-timing-function:var(--ease-out-expo)] group-hover:grid-rows-[1fr] group-focus:grid-rows-[1fr] group-focus-within:grid-rows-[1fr]">
                <div class="overflow-hidden">
                  <div class="mt-4 max-h-64 space-y-1 overflow-y-auto border-t border-line pt-3" data-lenis-prevent>
                    {group.systems.map((system) => {
                      const price = systemPrice(system);
                      return (
                        <a
                          href={`/systems/${system.slug}/`}
                          class="block rounded-lg px-2 py-1.5 text-xs transition-colors hover:bg-paper-dim"
                        >
                          <span class="flex items-center justify-between gap-2">
                            <span class="truncate font-semibold text-ink">{system.name}</span>
                            {price && <span class="shrink-0 font-mono text-[11px] font-bold text-accent">{formatRM(price)}</span>}
                          </span>
                          <span class="mt-0.5 block text-[11px] leading-snug text-ink-dim">{system.benefit}</span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- How systems are priced -->
      <div class="mt-12 grid gap-4 sm:grid-cols-3">
        {
          tiers.map((tier) => (
            <div class="rounded-2xl border border-line bg-paper p-5 shadow-sm">
              <div class="flex items-baseline justify-between gap-3">
                <p class="text-sm font-bold text-ink">{tier.name}</p>
                <p class="font-feature text-lg font-black text-ink">{formatRM(tier.price)}</p>
              </div>
              <p class="mt-2 text-xs leading-relaxed text-ink-dim">{tier.qualifies}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-center text-xs text-ink-dim">
        One-time prices, final, with no SST added. More systems are available on request: tell us what you need.
      </p>
    </Container>
  </Section>

  <!-- Rent vs own: the main reason to buy -->
  <RentVsOwnCalculator
    id="calculator"
    title="Rent vs own: the 3-year cost"
    intro="Example: a point-of-sale system for one outlet. Then try it with what you pay today."
    monthlyLabel="What you pay for software now, per month (RM)"
    monthlyHint="The starting figure is a published Malaysian POS entry plan. Add up every subscription you want to replace."
    defaultMonthly={RENT_VS_OWN.subscriptionMonthly}
    ownLabel="one Standard system + installation"
    ownOneTime={licence + install}
    hosting
    careMonthly={CARE_BASIC_MONTHLY}
    careLabel="Care Basic"
  >
    <div class="mx-auto mt-10 grid max-w-4xl gap-5 sm:grid-cols-2">
      <div class="rounded-2xl border border-line bg-white p-6 shadow-sm">
        <p class="text-sm font-bold text-ink">Subscription POS</p>
        <p class="text-xs text-ink-dim">Entry plan, {formatRM(RENT_VS_OWN.subscriptionMonthly)}/month</p>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-ink-dim">Year 1</dt><dd class="font-semibold text-ink">{formatRM(RENT_VS_OWN.subscriptionMonthly * 12)}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-ink-dim">3-year total</dt><dd class="font-feature text-lg font-black text-ink">{formatRM(subscriptionTotal)}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-ink-dim">Stop paying?</dt><dd class="font-semibold text-ink">You lose access</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-ink-dim">Your data</dt><dd class="font-semibold text-ink">On their servers</dd></div>
        </dl>
      </div>
      <div class="rounded-2xl border border-accent/30 bg-white p-6 shadow-sm ring-1 ring-accent/10">
        <p class="text-sm font-bold text-ink">WSS Point of Sale (Standard)</p>
        <p class="text-xs text-ink-dim">{formatRM(licence)} licence + {formatRM(install)} installation</p>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-ink-dim">Year 1</dt><dd class="font-semibold text-ink">{formatRM(licence + install)} + your hosting</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-ink-dim">3-year total</dt><dd class="font-feature text-lg font-black text-accent">{formatRM(licence + install)} + hosting</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-ink-dim">Stop paying?</dt><dd class="font-semibold text-ink">It keeps running</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-ink-dim">Your data</dt><dd class="font-semibold text-ink">On your server</dd></div>
        </dl>
      </div>
    </div>
    <p class="mx-auto mt-4 max-w-3xl text-center text-[11px] leading-relaxed text-ink-dim">
      To be fair to subscriptions: they include hosting, updates and support. Owning means you pay your host directly, get{' '}
      {LICENCE_TERMS.updateMonths} months of updates, and can add a Care Plan for ongoing support. Subscription figure from a
      published Malaysian POS entry plan, checked {RENT_VS_OWN.checked}; prices change, so check current rates.
    </p>
  </RentVsOwnCalculator>

  <!-- What you get with every system -->
  <Section rule>
    <Container>
      <div class="rounded-3xl border border-line bg-ink p-8 text-white md:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <h2 class="font-display text-2xl font-bold tracking-tight text-white md:text-3xl">
              Yours to run. Forever.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-white/70">
              When you rent software, you never own it: stop paying and it switches off. Every system here comes with a{' '}
              <strong>perpetual licence and the full source code</strong>: use it, change it and host it forever, with no monthly
              fee. You can't resell it to others. The <a href="/licence/" class="underline hover:text-white">Licence Agreement</a> has the details.
            </p>

            <div class="mt-6 grid grid-cols-2 gap-4">
              <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
                <p class="font-bold text-accent-yellow-vivid">No kill switch</p>
                <p class="mt-1 text-xs text-white/60">Works offline and never phones home. We can't switch your system off.</p>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
                <p class="font-bold text-emerald-400">Zero commission</p>
                <p class="mt-1 text-xs text-white/60">Where a system takes payments, the money goes straight to your own merchant account.</p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/15 bg-white/5 p-6 backdrop-blur-md">
            <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider">What you get with every system:</h3>
            <ul class="mt-4 space-y-3 text-xs text-white/80">
              <li class="flex items-start gap-2.5">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Full source code</strong>, plus the database setup file.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Step-by-step install guide</strong> for cPanel hosting or a VPS.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-accent font-bold">✓</span>
                <span><strong>{LICENCE_TERMS.supportDays} days of WhatsApp support</strong> from the builder, with bug fixes.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-accent font-bold">✓</span>
                <span><strong>{LICENCE_TERMS.updateMonths} months of updates</strong>, delivered as releases with notes.</span>
              </li>
            </ul>

            <div class="mt-6 pt-4 border-t border-white/10">
              <a
                href={whatsappHref("Hi WSS DevLabs, I have a question about your ready-made systems.")}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-accent-dim"
              >
                Questions? WhatsApp us
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Optional extras -->
      <div class="mt-10">
        <h3 class="text-center text-lg font-bold text-ink">Optional extras</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            extras.map((extra) => (
              <div class="rounded-2xl border border-line bg-paper p-5 shadow-sm">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="text-sm font-bold text-ink">{extra.name}</p>
                  <p class="shrink-0 font-feature text-base font-black text-ink">
                    {'from' in extra && extra.from ? 'from ' : ''}{formatRM(extra.price)}
                  </p>
                </div>
                <p class="mt-2 text-xs leading-relaxed text-ink-dim">{extra.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <!-- Care Plans -->
  <CarePlans context="systems" />

  <!-- FAQ -->
  <FAQ title="Questions about buying a system" items={SYSTEMS_FAQ} />

  <CTABand
    title="Need it changed, or something that isn't here?"
    subtitle="Light changes are priced on each system page. For anything bigger, a custom build starts with a fixed-price Discovery Sprint."
    ctaLabel="See custom builds"
    ctaHref="/custom/"
  />
</BaseLayout>

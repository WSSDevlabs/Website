---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import FaqList from '../../components/ui/FaqList.astro';
import Icon from '../../components/ui/Icon.astro';
import SystemCard from '../../components/sections/SystemCard.astro';
import RentVsOwnCalculator from '../../components/sections/RentVsOwnCalculator.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import {
  CARE_BASIC_MONTHLY,
  FOUNDING_CLIENT,
  LICENCE_TERMS,
  RENT_VS_OWN,
  SYSTEM_EXTRAS,
  SYSTEM_TIERS,
  formatRM,
  subscriptionTotal
} from '../../data/catalog';
import { PUBLISHED_ECOSYSTEMS } from '../../data/ecosystems';
import { SYSTEMS_FAQ } from '../../data/faqs';
import { SITE } from '../../data/site';
import { BUYER_GROUPS, PUBLIC_SYSTEMS, type BuyerGroup } from '../../data/systems';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();
const slotsLeft = Math.max(0, Math.min(FOUNDING_CLIENT.totalSlots, SITE.foundingSlotsLeft));
const posOwn = SYSTEM_TIERS.standard.price + SYSTEM_EXTRAS.installation.price;
const years = RENT_VS_OWN.months / 12;

const catalogueSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ready-made business systems',
  itemListElement: PUBLIC_SYSTEMS.map((system, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/systems/${system.slug}/`, siteUrl).toString(),
    name: system.name
  }))
};

const groupOrder = Object.keys(BUYER_GROUPS) as BuyerGroup[];
const included = [
  { icon: 'code', title: 'Full source code', body: 'Use it, change it and host it forever. No kill switch.' },
  { icon: 'book', title: 'Step-by-step install guide', body: 'Or add installation and we set it up for you.' },
  { icon: 'chat', title: `${LICENCE_TERMS.supportDays} days of builder support`, body: 'WhatsApp support and bug fixes from the person who built it.' },
  { icon: 'refresh', title: `${LICENCE_TERMS.updateMonths} months of updates`, body: 'Security patches and improvements, with release notes.' }
] as const;
---

<BaseLayout
  title="Ready-Made Business Systems You Own"
  description={`Pay once for a business system with full source code. POS, visitor management, attendance, helpdesk and more, from ${formatRM(SYSTEM_TIERS.basic.price)}. No monthly fee.`}
  path="/systems/"
  schema={[
    catalogueSchema,
    faqSchema(SYSTEMS_FAQ),
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Systems', path: '/systems/' }
    ])
  ]}
>
  <!-- 1. Hero -->
  <section class="border-b border-line">
    <Container class="py-14 md:py-20">
      <h1 class="h-display max-w-4xl">Ready-made business systems. Pay once, use forever.</h1>
      <p class="lead mt-5">Full source code, 12 months of updates, no monthly fee. Watch any system working on a screen-share first.</p>
    </Container>
  </section>

  <!-- 2. Rent vs own: the main reason to buy (audit 12.7) -->
  <section class="py-16 md:py-20" id="rent-vs-own">
    <Container class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="h-section">Rent or own: the {years}-year cost</h2>
        <p class="lead mt-4">Example: a point-of-sale system.</p>
        <div class="mt-6 overflow-hidden rounded-2xl border border-line">
          <table class="w-full border-collapse text-left">
            <caption class="sr-only">Renting versus owning a point-of-sale system over {years} years</caption>
            <thead class="bg-paper-dim">
              <tr>
                <th scope="col" class="p-4"><span class="sr-only">Item</span></th>
                <th scope="col" class="p-4 font-semibold text-ink">Subscription POS</th>
                <th scope="col" class="p-4 font-semibold text-ink">WSS POS</th>
              </tr>
            </thead>
            <tbody class="text-ink-dim">
              <tr class="border-t border-line">
                <th scope="row" class="p-4 font-medium text-ink">Year 1</th>
                <td class="p-4">{formatRM(RENT_VS_OWN.subscriptionMonthly * 12)}</td>
                <td class="p-4">{formatRM(SYSTEM_TIERS.standard.price)} licence + {formatRM(SYSTEM_EXTRAS.installation.price)} install + your hosting</td>
              </tr>
              <tr class="border-t border-line">
                <th scope="row" class="p-4 font-medium text-ink">{years}-year total</th>
                <td class="p-4 font-semibold text-ink">{formatRM(subscriptionTotal)}</td>
                <td class="p-4 font-semibold text-ink">{formatRM(posOwn)} + hosting</td>
              </tr>
              <tr class="border-t border-line">
                <th scope="row" class="p-4 font-medium text-ink">Stop paying?</th>
                <td class="p-4">You lose access</td>
                <td class="p-4">It keeps running</td>
              </tr>
              <tr class="border-t border-line">
                <th scope="row" class="p-4 font-medium text-ink">Your data</th>
                <td class="p-4">On their servers</td>
                <td class="p-4">On your server</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm text-muted">
          Subscription figure: a published Malaysian POS entry plan of {formatRM(RENT_VS_OWN.subscriptionMonthly)} a month, checked{' '}
          {RENT_VS_OWN.checked}. Prices change, so check current rates.
        </p>
        <p class="mt-4 text-ink-dim">
          Being fair: subscriptions include hosting, updates and support. When you own, you pay your host directly, and you can add
          a Care Plan if you want us to handle backups, updates and support. Try both with your own numbers.
        </p>
      </div>
      <div id="calculator">
        <h3 class="h-sub mb-4">Your numbers</h3>
        <RentVsOwnCalculator
          id="systems-calc"
          monthlyLabel="What you pay now for this kind of software, per month (RM)"
          monthlyHint="Add up every subscription the system would replace."
          defaultMonthly={RENT_VS_OWN.subscriptionMonthly}
          ownLabel="Standard system + installation"
          ownOneTime={posOwn}
          hosting
          careMonthly={CARE_BASIC_MONTHLY}
          careLabel="Care Basic"
        />
      </div>
    </Container>
  </section>

  <!-- 3. Complete solutions: ecosystems (audit 13.7) -->
  <section class="bg-paper-dim py-16 md:py-20" id="complete-solutions">
    <Container>
      <h2 class="h-section">Complete solutions</h2>
      <p class="lead mt-3">Several systems connected into one, with one login and one dashboard, for one kind of business.</p>
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {
          PUBLISHED_ECOSYSTEMS.map((eco) => (
            <li class="card flex flex-col p-6 sm:p-8">
              <p class="self-start rounded-full bg-accent-soft px-3 py-1 text-sm font-semibold text-accent-dim">{eco.status}</p>
              <h3 class="mt-4 font-display text-2xl font-bold text-ink">{eco.name}</h3>
              <p class="mt-2 flex-1 text-ink-dim">{eco.pitch}</p>
              <p class="price mt-5 text-2xl">
                From {formatRM(eco.packages[0].price)}
                <span class="ml-1 text-sm font-medium text-ink-dim">+ hardware</span>
              </p>
              <a href={`/systems/${eco.slug}/`} class="link mt-4 inline-flex min-h-11 items-center gap-2 self-start">
                See how it works <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- 4. The catalogue, filtered by who you are (max 5 chips, audit 3.18) -->
  <section class="py-16 md:py-20" id="catalogue">
    <Container>
      <h2 class="h-section">Every system, with its price</h2>
      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter systems by type of business" data-filter-chips hidden>
        <button type="button" class="filter-chip" aria-pressed="true" data-filter="all">All</button>
        {
          groupOrder.map((group) => (
            <button type="button" class="filter-chip" aria-pressed="false" data-filter={group}>
              {BUYER_GROUPS[group]}
            </button>
          ))
        }
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-system-grid>
        {PUBLIC_SYSTEMS.map((system) => <SystemCard system={system} />)}
      </ul>
      <p class="mt-8 text-ink-dim">
        More systems are available on request, including a contractor sales pipeline, a virtual service counter and school bus
        tracking. <a href="/contact/?need=system" class="link">Tell us what you need</a>.
      </p>
    </Container>
  </section>

  <!-- 5. What every system includes -->
  <section class="bg-paper-dim py-16 md:py-20">
    <Container>
      <h2 class="h-section">Pay once. No monthly fee.</h2>
      <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          included.map((item) => (
            <li>
              <Icon name={item.icon} class="h-8 w-8 text-accent" />
              <h3 class="h-sub mt-4">{item.title}</h3>
              <p class="mt-2 text-ink-dim">{item.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-ink-dim">
        Every system is sold under a <a href="/licence/" class="link">perpetual licence with full source code</a>: use it, change it
        and host it forever. No resale. Installation, branding, training and data import are optional, with prices on each system's
        page.
        {
          slotsLeft > 0 && (
            <>
              {' '}Founding clients get {FOUNDING_CLIENT.discountPercent}% off ({slotsLeft} of {FOUNDING_CLIENT.totalSlots} places left,{' '}
              <a href="/#founding-clients" class="link">how it works</a>).
            </>
          )
        }
        {' '}Need a website too? See the <a href="/websites/#bundle" class="link">Go Digital Bundle</a>.
      </p>
    </Container>
  </section>

  <!-- 6. FAQ -->
  <section class="py-16 md:py-20" id="faq">
    <Container narrow>
      <h2 class="h-section">Questions</h2>
      <FaqList items={SYSTEMS_FAQ} class="mt-8" />
    </Container>
  </section>

  <FinalCTA
    title="Need it changed to fit you?"
    body="Small changes are priced on every system page. If nothing ready-made fits, we build it for you."
    ctaLabel="See Custom builds"
    ctaHref="/custom/"
    track="custom_click"
  />
</BaseLayout>

<style>
  .filter-chip {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid var(--color-line-strong);
    background-color: #ffffff;
    padding: 0.5rem 1.1rem;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
  }

  .filter-chip[aria-pressed='true'] {
    border-color: var(--color-ink);
    background-color: var(--color-ink);
    color: #ffffff;
  }
</style>

<script>
  // Progressive enhancement: the full list shows without JavaScript; chips appear once this runs.
  const chips = document.querySelector<HTMLElement>('[data-filter-chips]');
  const grid = document.querySelector<HTMLElement>('[data-system-grid]');
  if (chips && grid) {
    chips.hidden = false;
    chips.addEventListener('click', (event) => {
      const chip = (event.target as Element).closest<HTMLButtonElement>('[data-filter]');
      if (!chip) return;
      const filter = chip.dataset.filter ?? 'all';
      chips.querySelectorAll('[data-filter]').forEach((el) => el.setAttribute('aria-pressed', String(el === chip)));
      grid.querySelectorAll<HTMLElement>('[data-groups]').forEach((card) => {
        const groups = (card.dataset.groups ?? '').split(' ');
        card.hidden = filter !== 'all' && !groups.includes(filter);
      });
    });
  }
</script>

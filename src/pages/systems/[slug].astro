---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import InteractiveDevicePreview from '../../components/ui/InteractiveDevicePreview.astro';
import {
  BUYER_GROUPS,
  COMMON_SYSTEM_FAQ,
  DEFAULT_LANGUAGE_ANSWER,
  PUBLIC_SYSTEMS,
  systemPrice,
  type QA,
  type SystemProduct
} from '../../data/systems';
import { LICENCE_TERMS, SYSTEM_EXTRAS, SYSTEM_TIERS, formatRM } from '../../data/catalog';
import { whatsappHref } from '../../data/site';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return PUBLIC_SYSTEMS.map((system) => ({
    params: { slug: system.slug },
    props: { system }
  }));
}

type Props = {
  system: SystemProduct;
};

const { system } = Astro.props;
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();

const price = systemPrice(system) ?? 0;
const tier = system.tier ? SYSTEM_TIERS[system.tier] : null;
const primaryGroup = system.groups?.[0];
const groupLabel = primaryGroup ? BUYER_GROUPS[primaryGroup] : 'Systems';
const features = system.features ?? [];
const rightForYou = system.rightForYou ?? [];
const stack = system.stack ?? [];
const media = system.media ?? [];

// "Retail shops, ..." reads as "Built for retail shops, ..."; acronyms such as "SMEs" keep their case.
const forWho = system.forWho ?? '';
const forWhoSentence = /^[A-Z][a-z]/.test(forWho) ? forWho.charAt(0).toLowerCase() + forWho.slice(1) : forWho;

const buyMessage = `Hi WSS DevLabs, I'd like to buy ${system.name} (${formatRM(price)}). Please send the invoice.`;
const walkthroughMessage = `Hi WSS DevLabs, can I book a 15-minute screen-share walkthrough of ${system.name}?`;

const extras = [SYSTEM_EXTRAS.installation, SYSTEM_EXTRAS.branding, SYSTEM_EXTRAS.training, SYSTEM_EXTRAS.dataImport];

const specificFaq: QA[] = [
  ...(system.payments ? [{ q: 'Does it take online payments?', a: system.payments }] : []),
  ...(system.hardware ? [{ q: 'What hardware do I need?', a: system.hardware }] : []),
  { q: 'Does it support Bahasa Malaysia?', a: system.language ?? DEFAULT_LANGUAGE_ANSWER },
  ...(system.extraFaq ?? [])
];
const faq = [...COMMON_SYSTEM_FAQ, ...specificFaq];

const related = PUBLIC_SYSTEMS.filter(
  (other) => other.slug !== system.slug && other.groups?.some((g) => system.groups?.includes(g))
).slice(0, 3);

const specs: [string, string][] = [
  ['Server', 'PHP 8.2 or newer with a MySQL database: cPanel shared hosting or a small VPS'],
  ['Built with', stack.join(', ')],
  ['Licence check', 'Works offline. It never contacts us, and there is no remote kill switch'],
  ['Users', 'No per-user fees: one business, one live installation, plus a test copy'],
  ...(system.version ? ([['Version', system.version]] as [string, string][]) : []),
  ...(system.lastUpdated ? ([['Last updated', system.lastUpdated]] as [string, string][]) : [])
];

const softwareSchema = {
  '@type': 'SoftwareApplication',
  name: system.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web (PHP 8.2+ and MySQL)',
  description: system.benefit,
  offers: {
    '@type': 'Offer',
    price: String(price),
    priceCurrency: 'MYR',
    description: 'Perpetual licence with full source code. No monthly fee.'
  }
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    softwareSchema,
    faqSchema(faq),
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Systems', path: '/systems/' },
      { name: system.name, path: `/systems/${system.slug}/` }
    ])
  ]
};
---

<BaseLayout
  title={`${system.name}: Pay Once, Own the Code`}
  description={`${system.benefit} ${formatRM(price)} one-time, with full source code, ${LICENCE_TERMS.supportDays} days of support and ${LICENCE_TERMS.updateMonths} months of updates. No monthly fees.`}
  path={`/systems/${system.slug}/`}
  schema={schema}
>
  <!-- System Hero -->
  <section class="relative overflow-hidden bg-ink pt-10 pb-20 text-white md:pt-40 md:pb-28">
    <div class="grain-overlay" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 top-0 h-96 w-96 rounded-full bg-accent/20 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-accent-blue/20 blur-3xl"
      aria-hidden="true"
    ></div>

    <Container class="relative">
      <div class="mx-auto max-w-4xl">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs font-mono text-white/60">
          <a href="/systems/" class="transition hover:text-white">Systems</a>
          <span aria-hidden="true">›</span>
          <a href="/systems/#browse" class="transition hover:text-white">{groupLabel}</a>
          <span aria-hidden="true">›</span>
          <span class="text-white/80" aria-current="page">{system.name}</span>
        </nav>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="rounded-full border border-white/20 bg-white/5 px-3 py-1 text-xs font-semibold text-accent-yellow-vivid">
            {groupLabel}
          </span>
          <span class="rounded-full bg-emerald-500/20 border border-emerald-500/30 px-3 py-1 text-xs font-semibold text-emerald-300">
            Pay once, no monthly fee
          </span>
        </div>

        <div class="mt-6 grid items-start gap-8 lg:grid-cols-[1.5fr_1fr]">
          <div>
            <h1 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
              {system.name}
            </h1>
            <p class="mt-3 text-lg font-medium text-accent-yellow sm:text-xl">
              {system.benefit}
            </p>
            <p class="mt-5 text-sm leading-relaxed text-white/75 sm:text-base">
              Built for {forWhoSentence} Pay once, get the full source code, and run it on your own hosting with no monthly fee.
            </p>

            {
              stack.length > 0 && (
                <div class="mt-6 flex flex-wrap gap-2">
                  {stack.map((tech) => (
                    <span class="rounded-lg border border-white/15 bg-white/5 px-2.5 py-1 text-xs font-mono text-white/80">
                      {tech}
                    </span>
                  ))}
                </div>
              )
            }
          </div>

          <!-- Perpetual Licence Card -->
          <div class="rounded-2xl border border-accent/40 bg-white/5 p-6 backdrop-blur-xl shadow-2xl">
            <p class="text-xs font-mono uppercase tracking-wider text-white/60">Perpetual licence{tier ? ` · ${tier.name}` : ''}</p>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="font-feature text-4xl font-black text-white">{formatRM(price)}</span>
              <span class="text-xs text-emerald-400 font-semibold">One-time payment</span>
            </div>
            <p class="mt-2 text-xs text-white/60">
              No monthly fee. Install it on your own hosting, or add installation for {formatRM(SYSTEM_EXTRAS.installation.price)}.
            </p>

            <div class="mt-6 space-y-3">
              <a
                href={whatsappHref(buyMessage)}
                target="_blank"
                rel="noopener noreferrer"
                data-track="buy_click"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/30 transition hover:bg-accent-dim"
              >
                <span>Buy now</span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>

              <a
                href={whatsappHref(walkthroughMessage)}
                target="_blank"
                rel="noopener noreferrer"
                data-track="walkthrough_click"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-white/10"
              >
                Book a 15-minute walkthrough
              </a>
            </div>

            <div class="mt-4 border-t border-white/10 pt-4 text-[11px] text-white/50 space-y-1">
              <p>✓ Full source code and install guide</p>
              <p>✓ {LICENCE_TERMS.supportDays} days of WhatsApp support from the builder</p>
              <p>✓ {LICENCE_TERMS.updateMonths} months of updates</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Is this right for you? -->
  <Section rule>
    <Container>
      <div class="mx-auto max-w-4xl">
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink md:text-3xl">
          Is {system.name} right for you?
        </h2>
        <p class="mt-3 text-sm text-ink-dim">
          If you answer yes to any of these, it's worth a closer look.
        </p>

        <!-- Questions Grid -->
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {rightForYou.map((question) => (
            <div class="flex items-start gap-3 rounded-2xl border border-line bg-paper-dim/60 p-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-bold text-white" aria-hidden="true">
                ?
              </span>
              <p class="text-xs font-medium leading-relaxed text-ink">
                {question}
              </p>
            </div>
          ))}
        </div>

        <!-- What you need + your licence -->
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-line bg-paper p-5">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-accent">
              What you need to run it
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-ink-dim">
              A web hosting account that runs PHP 8.2 or newer with a MySQL database, such as cPanel shared hosting or a small
              VPS. You pay your host directly. Not sure? Add installation and we set it all up.
            </p>
          </div>
          <div class="rounded-2xl border border-line bg-paper p-5">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-accent-yellow">
              Your licence
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-ink-dim">
              A perpetual licence with the full source code: use it, change it and host it forever. It works offline and has no
              remote kill switch. You can't resell it. See the <a href="/licence/" class="font-semibold text-ink underline hover:text-accent">Licence Agreement</a>.
            </p>
          </div>
        </div>

        <!-- Preview: real screenshots once published, otherwise a walkthrough offer -->
        <div class="mt-10">
          <InteractiveDevicePreview
            title={`${system.name}: preview`}
            addressLabel={media.length || system.videoUrl ? 'Recorded with sample data' : 'Walkthrough on request'}
            chip="Sample data"
          >
            {
              media.length || system.videoUrl ? (
                <div class="space-y-4">
                  {system.videoUrl && (
                    <video controls preload="none" src={system.videoUrl} class="w-full rounded-lg border border-line">
                      <a href={system.videoUrl}>Watch the {system.name} walkthrough</a>
                    </video>
                  )}
                  {media.length > 0 && (
                    <div class="grid gap-4 sm:grid-cols-2">
                      {media.map((shot) => (
                        <img src={shot.src} alt={shot.alt} loading="lazy" class="w-full rounded-lg border border-line" />
                      ))}
                    </div>
                  )}
                </div>
              ) : (
                <>
                  <div class="flex items-center justify-between border-b border-line pb-4">
                    <div class="flex items-center gap-2">
                      <span class="h-4 w-2 rounded-sm bg-accent"></span>
                      <span class="font-bold text-sm">{system.name}</span>
                    </div>
                    <span class="rounded-full bg-paper-dim px-2.5 py-0.5 text-[10px] font-semibold text-ink-dim">
                      Shown on a screen-share
                    </span>
                  </div>

                  <div class="mt-4 grid gap-4 sm:grid-cols-3">
                    <div class="rounded-xl border border-line bg-paper-dim p-3">
                      <p class="text-[10px] font-mono text-ink-dim uppercase">Licence</p>
                      <p class="mt-1 font-bold text-sm text-ink">Perpetual</p>
                    </div>
                    <div class="rounded-xl border border-line bg-paper-dim p-3">
                      <p class="text-[10px] font-mono text-ink-dim uppercase">Updates</p>
                      <p class="mt-1 font-bold text-sm text-accent">{LICENCE_TERMS.updateMonths} months</p>
                    </div>
                    <div class="rounded-xl border border-line bg-paper-dim p-3">
                      <p class="text-[10px] font-mono text-ink-dim uppercase">Support</p>
                      <p class="mt-1 font-bold text-sm text-emerald-700">{LICENCE_TERMS.supportDays} days, direct</p>
                    </div>
                  </div>

                  <div class="mt-4 rounded-xl border border-line/60 bg-paper-deep/30 p-4">
                    <p class="text-xs font-semibold text-ink">See it working before you buy</p>
                    <p class="mt-1 text-xs text-ink-dim">
                      Real screenshots of this system will appear here. Until then, book a 15-minute screen-share and we'll walk
                      you through {system.name} with sample data and answer your questions.
                    </p>
                    <a
                      href={whatsappHref(walkthroughMessage)}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-track="walkthrough_click"
                      class="mt-3 inline-flex items-center gap-2 rounded-full bg-ink px-4 py-2 text-xs font-bold text-white transition hover:bg-black"
                    >
                      Book a walkthrough
                    </a>
                  </div>
                </>
              )
            }
          </InteractiveDevicePreview>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Features Grid -->
  <Section rule class="bg-paper-dim/40">
    <Container>
      <div class="mx-auto max-w-4xl">
        <h2 class="mt-2 text-2xl font-bold text-ink md:text-3xl">
          What it does for you
        </h2>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((feature, idx) => (
            <div class="rounded-2xl border border-line bg-paper p-5 shadow-sm">
              <span class="font-feature text-xs font-bold text-accent">0{idx + 1}</span>
              <h3 class="mt-2 text-sm font-bold text-ink">{feature}</h3>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <!-- Everything included + optional extras -->
  <Section rule>
    <Container>
      <div class="mx-auto max-w-4xl">
        <div class="rounded-3xl border border-line bg-ink p-8 text-white md:p-10">
          <div class="grid items-center gap-8 lg:grid-cols-[1.2fr_1fr]">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 font-mono text-xs text-emerald-300">
                What you receive
              </div>
              <h2 class="mt-3 font-display text-2xl font-bold text-white md:text-3xl">
                Everything included in your order
              </h2>
              <p class="mt-3 text-xs leading-relaxed text-white/70">
                A perpetual licence to install, use and change the system for your own business. You can't resell it or offer
                it to other businesses as a service.
              </p>

              <ul class="mt-5 space-y-2.5 text-xs text-white/80">
                <li class="flex items-center gap-2"><span class="text-accent font-bold">✓</span><span>Full source code and the database setup file</span></li>
                <li class="flex items-center gap-2"><span class="text-accent font-bold">✓</span><span>Step-by-step install guide and admin setup instructions</span></li>
                <li class="flex items-center gap-2"><span class="text-accent font-bold">✓</span><span>{LICENCE_TERMS.supportDays} days of WhatsApp support and bug fixes from the builder</span></li>
                <li class="flex items-center gap-2"><span class="text-accent font-bold">✓</span><span>{LICENCE_TERMS.updateMonths} months of updates, with release notes</span></li>
                <li class="flex items-center gap-2"><span class="text-accent font-bold">✓</span><span>A {LICENCE_TERMS.refundDays}-day refund if it can't be installed by following the guide and we can't fix it</span></li>
              </ul>
            </div>

            <div class="rounded-2xl border border-white/15 bg-white/5 p-6 text-center">
              <p class="text-xs font-mono uppercase tracking-wider text-white/60">Ready to buy?</p>
              <p class="mt-2 font-feature text-3xl font-black text-white">{formatRM(price)}</p>
              <p class="mt-1 text-[11px] text-white/60">One-time payment · No SST added</p>

              <a
                href={whatsappHref(buyMessage)}
                target="_blank"
                rel="noopener noreferrer"
                data-track="buy_click"
                class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-xs font-semibold text-white shadow-md hover:bg-accent-dim"
              >
                Buy now
              </a>
              <p class="mt-3 text-[11px] text-white/50">We send the invoice; your download link follows once payment clears.</p>
            </div>
          </div>
        </div>

        <!-- Optional extras -->
        <h3 class="mt-10 text-lg font-bold text-ink">Optional extras</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            extras.map((extra) => (
              <div class="rounded-2xl border border-line bg-paper p-5 shadow-sm">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="text-sm font-bold text-ink">{extra.name}</p>
                  <p class="shrink-0 font-feature text-base font-black text-ink">
                    {'from' in extra && extra.from ? 'from ' : ''}{formatRM(extra.price)}
                  </p>
                </div>
                <p class="mt-2 text-xs leading-relaxed text-ink-dim">{extra.detail}</p>
              </div>
            ))
          }
        </div>

        <!-- Tech specs, collapsed for the IT person -->
        <details class="card group mt-6 p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
            Tech specs (for your IT person)
            <svg class="h-4 w-4 shrink-0 text-ink-dim transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-[10rem_1fr]">
            {
              specs.map(([label, value]) => (
                <>
                  <dt class="font-mono text-xs font-bold uppercase tracking-wider text-ink-dim">{label}</dt>
                  <dd class="text-ink">{value}</dd>
                </>
              ))
            }
          </dl>
        </details>
      </div>
    </Container>
  </Section>

  <!-- System FAQ -->
  <Section rule class="bg-paper-dim/30">
    <Container>
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center text-2xl font-bold text-ink">
          Questions about {system.name}
        </h2>
        <div class="mt-8 space-y-4">
          {faq.map((item) => (
            <details class="group rounded-2xl border border-line bg-paper p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
                <h3 class="text-sm font-bold text-ink">{item.q}</h3>
                <svg class="h-4 w-4 shrink-0 text-ink-dim transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </summary>
              <p class="mt-2 text-xs leading-relaxed text-ink-dim">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <!-- Related systems -->
  {
    related.length > 0 && (
      <Section rule>
        <Container>
          <div class="mx-auto max-w-4xl">
            <h2 class="text-2xl font-bold text-ink">Related systems</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
              {related.map((other) => {
                const otherPrice = systemPrice(other);
                return (
                  <a
                    href={`/systems/${other.slug}/`}
                    class="group rounded-2xl border border-line bg-paper p-5 shadow-sm transition-all duration-300 hover:border-accent hover:shadow-lg"
                  >
                    <p class="text-sm font-bold text-ink">{other.name}</p>
                    {otherPrice && <p class="mt-1 font-mono text-xs font-bold text-accent">{formatRM(otherPrice)}</p>}
                    <p class="mt-2 text-xs leading-relaxed text-ink-dim">{other.benefit}</p>
                  </a>
                );
              })}
            </div>
          </div>
        </Container>
      </Section>
    )
  }
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import InteractiveDevicePreview from '../../components/ui/InteractiveDevicePreview.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import { TESTIMONIALS } from '../../data/testimonials';

const FLAGSHIP_BUILDS = [
  {
    id: 'janitor-hub',
    title: 'JanitorHub Facility Management System',
    client: 'Industrial & Commercial Cleaners (KL & Selangor)',
    category: 'Custom Operations Web & Mobile',
    badge: '3,200+ Shifts/Month',
    tone: 'blue',
    summary: 'A complete multi-branch operations and shift dispatching portal for Malaysian commercial cleaners, replacing 5 fragmented SaaS subscriptions.',
    results: [
      'Zero monthly SaaS recurring fees (saved RM 1,400/mo)',
      'Sub-80ms page load speeds across mobile 4G networks',
      'Automated PDF invoice generation and WhatsApp shift alerts'
    ],
    techStack: ['PHP 8.2', 'MySQL', 'Tailwind CSS', 'Alpine.js', 'WhatsApp API'],
    slug: 'wss-staffportal',
    demoUrl: 'https://demo.wssdevlabs.com/systems/janitor-hub'
  },
  {
    id: 'medcare-clinic',
    title: 'MedCare Multi-Specialist Clinic & Live Queue',
    client: 'Private Healthcare Network (Johor Bahru)',
    category: 'Healthcare & Live Queue',
    badge: 'Live TV Queue Engine',
    tone: 'red',
    summary: 'Online specialist appointment booking system paired with an ultra-low latency waiting room TV queue display and PDPA-compliant intake forms.',
    results: [
      '68% reduction in patient waiting room congestion',
      'ToyyibPay FPX automated deposit payments',
      'PDPA digital intake signature capture on mobile'
    ],
    techStack: ['PHP 8.2', 'WebSockets', 'MySQL', 'ToyyibPay', 'GSAP'],
    slug: 'wss-medcare',
    demoUrl: 'https://demo.wssdevlabs.com/systems/wss-medcare'
  },
  {
    id: 'car-advisor',
    title: 'CarAdvisor Certified Auto Marketplace',
    client: 'Pre-Owned Dealership Group (Penang & KL)',
    category: 'Digital Marketplace',
    badge: 'RM 4.2M Inventory Managed',
    tone: 'yellow',
    summary: 'High-converting auto inventory catalog featuring embedded bank loan mortgage calculators, 360 inspection reports, and instant WhatsApp test-drive booking.',
    results: [
      '4.8x increase in qualified buyer test-drive leads',
      'Sub-second search filtering across 400+ vehicle specs',
      'Direct WhatsApp salesperson routing per car'
    ],
    techStack: ['Astro', 'TypeScript', 'Tailwind CSS', 'PHP Backend', 'MySQL'],
    slug: 'wss-directory',
    demoUrl: 'https://demo.wssdevlabs.com/systems/car-advisor'
  },
  {
    id: 'ticket-flow',
    title: 'TicketFlow Festival & Event Gate Engine',
    client: 'Live Entertainment & Conference Organizers',
    category: 'High-Throughput Ticketing',
    badge: '12,000+ Tickets Scanned',
    tone: 'green',
    summary: 'Encrypted QR code ticketing system with zero per-ticket commission fees and an ultra-fast browser camera gate scanner for gate crew.',
    results: [
      'Zero per-ticket ticketing platform fees saved RM 18,500',
      '0.4-second QR code scan and gate validation speed',
      '100% offline-resilient local cache fallback'
    ],
    techStack: ['PHP 8.2', 'HTML5 BarcodeDetector', 'MySQL', 'SenangPay', 'Ed25519'],
    slug: 'wss-ticketflow',
    demoUrl: 'https://demo.wssdevlabs.com/systems/wss-ticketflow'
  },
  {
    id: 'eventspace-nexus',
    title: 'Nexus EventSpace & Multi-Hall Booking',
    client: 'Commercial Venue Hub (Bangsar South)',
    category: 'Hospitality & Rental',
    badge: '100% Conflict Free',
    tone: 'blue',
    summary: 'Real-time multi-hall calendar reservation portal with automated deposit schedules, hourly/daily tier logic, and automated invoice PDF emailing.',
    results: [
      'Zero double-booking conflicts across 6 meeting suites',
      'Integrated DuitNow QR & Stripe payment processing',
      'Automated email confirmations with calendar .ics attachments'
    ],
    techStack: ['PHP 8.2', 'MySQL', 'Tailwind CSS', 'Stripe', 'DOMPDF'],
    slug: 'wss-eventspace',
    demoUrl: 'https://demo.wssdevlabs.com/systems/wss-eventspace'
  },
  {
    id: 'buildright-crm',
    title: 'BuildRight Contractor Project CRM',
    client: 'Renovation & Engineering Contractors',
    category: 'Bespoke ERP & CRM',
    badge: '50% PMKS Madani Subsidized',
    tone: 'red',
    summary: 'Custom Kanban project tracking and quotation capture portal built specifically for Malaysian renovation and construction project workflows.',
    results: [
      'Subsidized 50% under 2026 PMKS Madani Digital Grant',
      'Replaced messy WhatsApp chat quotes with formal PDF generator',
      'Milestone payment tracking with automated payment reminders'
    ],
    techStack: ['PHP 8.2', 'MySQL', 'SortableJS', 'Tailwind CSS', 'FPX Gateway'],
    slug: 'wss-buildright',
    demoUrl: 'https://demo.wssdevlabs.com/systems/wss-buildright'
  }
];

const PROCESS_STEPS = [
  {
    step: '01',
    title: 'Architecture & Scope Lock',
    description: 'We map your exact requirements, database schemas, and payment integrations. Fixed quote, zero hidden surprises.',
    time: 'Day 1'
  },
  {
    step: '02',
    title: 'Staging Prototype Build',
    description: 'Direct sprint execution led by Natasya (UI/UX) & Razin (Backend). You test real live URLs as we build.',
    time: 'Days 2–5'
  },
  {
    step: '03',
    title: 'Malaysian Payments & Security',
    description: 'ToyyibPay/SenangPay integration, Ed25519 licensing setup, PDPA form protection, and load testing.',
    time: 'Days 5–6'
  },
  {
    step: '04',
    title: 'Go-Live Handover & Calm',
    description: 'Full unencrypted source code, SQL database scripts, server deployment, and direct WhatsApp engineer support.',
    time: 'Day 7+'
  }
];
---

<BaseLayout
  title="Projects & Client Builds: WSS DevLabs"
  description="Explore production builds and real outcomes across web apps, mobile systems, Buy-Once PHP platforms, and custom ERPs for Malaysian businesses."
  path="/work"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-ink py-16 text-white md:py-24">
    <div class="grain-overlay" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 top-1/4 h-96 w-96 rounded-full bg-accent-red/20 blur-3xl"
      aria-hidden="true"
    ></div>

    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1 text-xs font-mono uppercase tracking-wider text-accent-yellow-vivid">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Direct Builder Execution · High-Converting UI
        </div>
        <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          Systems That Drive Tangible Revenue.
        </h1>
        <p class="mt-4 text-base leading-relaxed text-white/70 sm:text-lg">
          No generic templates. No monthly SaaS rent. Explore real engineering deployments built for Malaysian SMEs and regional enterprises.
        </p>
      </div>
    </Container>
  </section>

  <!-- Interactive Live Viewport Demonstration -->
  <Section rule class="bg-paper-dim/30">
    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <Eyebrow label="Interactive Live Gallery" tone="red" />
        <h2 class="mt-2 text-3xl font-extrabold text-ink sm:text-4xl">
          Test Live Viewport Responsiveness
        </h2>
        <p class="mt-3 text-sm text-ink-dim">
          Toggle between <strong>Desktop</strong> and <strong>Mobile (375px)</strong> viewports below to test the physical responsiveness of our systems before you reach out.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-4xl">
        <InteractiveDevicePreview
          title="WSS Flagship Operations Hub (Live Responsive Preview)"
          urlPath="https://demo.wssdevlabs.com/systems/featured-hub"
          systemSlug="featured-hub"
        >
          <div class="space-y-4">
            <div class="flex flex-wrap items-center justify-between border-b border-line pb-3">
              <div class="flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-bold text-sm text-ink">Commercial Operations Hub v4.2</span>
              </div>
              <span class="rounded bg-accent/10 px-2 py-0.5 font-mono text-[10px] font-bold text-accent">
                99.9% Uptime SLA
              </span>
            </div>

            <div class="grid gap-3 sm:grid-cols-3">
              <div class="rounded-xl border border-line bg-paper-dim p-3 text-center">
                <p class="text-[10px] font-mono text-ink-dim uppercase">Monthly Dispatches</p>
                <p class="mt-1 font-feature text-lg font-bold text-ink">3,240</p>
              </div>
              <div class="rounded-xl border border-line bg-paper-dim p-3 text-center">
                <p class="text-[10px] font-mono text-ink-dim uppercase">Payment Gateways</p>
                <p class="mt-1 font-bold text-xs text-accent">ToyyibPay + Stripe</p>
              </div>
              <div class="rounded-xl border border-line bg-paper-dim p-3 text-center">
                <p class="text-[10px] font-mono text-ink-dim uppercase">Lighthouse Speed</p>
                <p class="mt-1 font-bold text-xs text-emerald-700">98 / 100 Mobile</p>
              </div>
            </div>

            <div class="rounded-xl border border-line/70 bg-paper-deep/20 p-3 text-xs text-ink-dim">
              <p class="font-semibold text-ink">✓ Tested across iOS Safari, Android Chrome, and Desktop Viewports.</p>
              <p class="mt-1 text-[11px]">Instant client-side rendering with sub-50ms Time To First Byte (TTFB).</p>
            </div>
          </div>
        </InteractiveDevicePreview>
      </div>
    </Container>
  </Section>

  <!-- Featured Case Studies & Builds Grid -->
  <Section rule>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="Production Showcases" tone="blue" />
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-ink md:text-4xl">
          Featured Engineering Deployments
        </h2>
        <p class="mt-3 text-sm text-ink-dim">
          Every system is delivered with complete source code ownership and direct builder support.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {
          FLAGSHIP_BUILDS.map((build, idx) => (
            <div class="flex flex-col justify-between rounded-3xl border border-line bg-paper p-6 shadow-sm transition-all hover:border-accent hover:shadow-xl sm:p-8">
              <div>
                <!-- Top Meta & Category -->
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-bold text-accent">0{idx + 1}</span>
                  <span class="rounded-full border border-line bg-paper-dim px-3 py-1 font-mono text-[10px] font-semibold text-ink-dim">
                    {build.badge}
                  </span>
                </div>

                <h3 class="mt-4 text-xl font-bold tracking-tight text-ink">
                  {build.title}
                </h3>
                <p class="mt-1 text-xs font-semibold text-accent">
                  {build.client} · {build.category}
                </p>

                <p class="mt-3 text-sm leading-relaxed text-ink-dim">
                  {build.summary}
                </p>

                <!-- Key Outcomes List -->
                <div class="mt-5 space-y-2 border-t border-line/60 pt-4">
                  <p class="font-mono text-[11px] uppercase tracking-wider text-ink font-bold">Key Engineering Outcomes:</p>
                  {build.results.map((res) => (
                    <div class="flex items-start gap-2 text-xs text-ink-dim">
                      <span class="text-accent font-bold">✓</span>
                      <span>{res}</span>
                    </div>
                  ))}
                </div>

                <!-- Tech Stack Tags -->
                <div class="mt-5 flex flex-wrap gap-1.5">
                  {build.techStack.map((tech) => (
                    <span class="rounded-md border border-line/80 bg-paper-dim/80 px-2 py-0.5 font-mono text-[10px] text-ink-dim">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Link -->
              <div class="mt-6 flex items-center justify-between border-t border-line pt-4">
                <a
                  href={`/marketplace/${build.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-accent hover:underline"
                >
                  <span>Inspect System Architecture</span>
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>

                <a
                  href={`https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I'd%20like%20to%20discuss%20a%20build%20similar%20to%20${encodeURIComponent(build.title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-xl border border-line bg-paper-dim px-3 py-1.5 text-[11px] font-semibold text-ink transition hover:border-accent hover:bg-accent hover:text-white"
                >
                  WhatsApp Builder
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Numbered 4-Phase Delivery Framework -->
  <Section rule class="bg-paper-dim/40">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="Sprint Architecture" tone="yellow" />
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-ink md:text-4xl">
          The 4-Phase Sprint Methodology
        </h2>
        <p class="mt-3 text-sm text-ink-dim">
          How we deliver high-velocity, high-performing systems without enterprise bloat or scope creep.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          PROCESS_STEPS.map((step) => (
            <div class="flex flex-col justify-between rounded-2xl border border-line bg-paper p-6 shadow-sm">
              <div>
                <div class="flex items-center justify-between border-b border-line pb-3">
                  <span class="font-mono text-2xl font-black text-accent">{step.step}</span>
                  <span class="rounded bg-paper-dim px-2 py-0.5 font-mono text-[10px] font-semibold text-ink-dim">
                    {step.time}
                  </span>
                </div>
                <h3 class="mt-4 font-bold text-sm text-ink">{step.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-ink-dim">{step.description}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-line/60 text-[10px] font-mono text-accent">
                ● Direct Builder SLA
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Testimonials Section -->
  <Section rule>
    <Container>
      <div class="text-center">
        <Eyebrow label="Verified Reviews" tone="green" class="justify-center" />
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-ink md:text-4xl">
          What Malaysian Founders &amp; Business Leads Say
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-ink-dim">
          Direct feedback from Malaysian business owners who switched from monthly SaaS subscriptions to our productized builds.
        </p>
      </div>

      <div class="mt-10">
        <Testimonials testimonials={TESTIMONIALS} />
      </div>
    </Container>
  </Section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Pill from '../../components/ui/Pill.astro';
import CTABand from '../../components/sections/CTABand.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' });
const [featured, ...rest] = posts;

const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
---

<BaseLayout
  title="Insights: WSS DevLabs"
  description="Practical, sourced notes on Malaysian policy, AI, IoT and technology for business."
  path="/insights"
>
  <!-- Featured post: rounded image hero -->
  {
    featured && (
      <section class="px-3 pb-6 pt-24 md:px-4 md:pt-36" data-noreveal>
        <a
          href={`/insights/${featured.id}`}
          class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-[2.25rem] bg-charcoal p-8 text-white md:min-h-[34rem] md:rounded-[2.75rem] md:p-14"
        >
          <img src={featured.data.coverImage} alt="" loading="eager" width="1600" height="900" class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/30 to-black/10" aria-hidden="true"></div>
          <p class="mono-label text-white/70">Featured post</p>
          <h1 class="mt-4 max-w-3xl font-display text-[clamp(2rem,1.2rem+3.4vw,4rem)] font-bold leading-[1.04] tracking-[-0.035em]">
            {featured.data.title}
          </h1>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/75 md:text-base">{featured.data.description}</p>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <span class="btn-arrow btn-arrow--light">
              <span>Read more</span>
              <span class="btn-arrow__dot">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </span>
            </span>
            <span class="text-xs text-white/60">{fmt(featured.data.publishDate)}</span>
          </div>
        </a>
      </section>
    )
  }

  <!-- Latest posts + sidebar -->
  <section class="py-14 md:py-20" data-tight>
    <Container>
      <div class="grid gap-6 lg:grid-cols-[1fr_20rem]">
        <div class="rounded-[2rem] bg-paper-dim p-5 md:p-7">
          <h2 class="font-display text-xl font-bold tracking-tight text-ink">Latest posts</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {
              rest.map((post) => (
                <a href={`/insights/${post.id}`} class="group flex flex-col rounded-[1.5rem] bg-white p-3 transition-transform duration-300 hover:-translate-y-1">
                  <div class="relative aspect-[4/3] overflow-hidden rounded-[1.1rem] bg-charcoal">
                    <img src={post.data.coverImage} alt="" loading="lazy" width="600" height="450" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    <span class="absolute left-2.5 top-2.5 rounded-full bg-white/90 px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-wide text-ink">
                      {post.data.tags[0] ?? 'Insight'}
                    </span>
                  </div>
                  <div class="flex flex-1 flex-col p-3">
                    <h3 class="text-sm font-bold leading-snug tracking-tight text-ink">{post.data.title}</h3>
                    <p class="mt-auto pt-4 text-xs text-ink-dim">{fmt(post.data.publishDate)}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <aside class="grid content-start gap-6">
          <div class="rounded-[2rem] bg-paper-dim p-6">
            <h2 class="font-display text-lg font-bold tracking-tight text-ink">Popular posts</h2>
            <ul class="mt-5 space-y-4">
              {
                posts.slice(0, 4).map((post) => (
                  <li>
                    <a href={`/insights/${post.id}`} class="group flex items-center gap-3">
                      <img src={post.data.coverImage} alt="" loading="lazy" width="120" height="120" class="h-14 w-14 shrink-0 rounded-xl object-cover" />
                      <span>
                        <span class="block text-sm font-semibold leading-snug text-ink group-hover:underline">{post.data.title}</span>
                        <span class="mt-0.5 block text-xs text-ink-dim">{fmt(post.data.publishDate)}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-[2rem] bg-tint p-6">
            <h2 class="font-display text-lg font-bold tracking-tight text-ink">Topics</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => <li class="rounded-full bg-white px-3.5 py-1.5 text-xs font-semibold text-ink">{tag}</li>)}
            </ul>
          </div>

          <div class="rounded-[2rem] bg-charcoal-soft p-6 text-white">
            <h2 class="font-display text-lg font-bold tracking-tight">Have a problem on site?</h2>
            <p class="mt-2 text-sm leading-relaxed text-white/60">Tell us what goes wrong. We reply within one business day.</p>
            <Pill href="/contact" label="Consult with us" variant="light" class="mt-5" />
          </div>
        </aside>
      </div>
    </Container>
  </section>

  <CTABand
    title="Want these ideas applied to your site?"
    subtitle="Every project starts with a site visit and a small pilot."
    ctaLabel="Consult with us"
  />
</BaseLayout>

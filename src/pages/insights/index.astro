---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import { TEAM } from '../../data/team';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const authorName = (slug: string) => {
  const member = TEAM.find((m) => m.slug === slug);
  return member ? member.fullName || member.name : 'WSS DevLabs';
};

const formatDate = (date: Date) => date.toLocaleDateString('en-MY', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Insights for Malaysian SMEs"
  description="Plain-language guides for Malaysian small businesses: what websites and systems really cost, owning versus renting software, e-invoicing, Google Business Profile and more."
  path="/insights/"
>
  <section class="border-b border-line">
    <Container class="py-14 md:py-20">
      <h1 class="h-display max-w-3xl">Insights</h1>
      <p class="lead mt-5">Plain-language guides for Malaysian SME owners. No jargon, and we show our sources.</p>
    </Container>
  </section>

  <section class="py-14 md:py-16">
    <Container>
      <ul class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <li>
              <a href={`/insights/${post.id}/`} class="group block">
                <img
                  src={post.data.coverImage}
                  alt={post.data.coverAlt}
                  width="600"
                  height="350"
                  loading="lazy"
                  class="aspect-[12/7] w-full rounded-2xl border border-line object-cover"
                />
                <p class="mt-4 text-sm text-ink-dim">
                  {post.data.tags[0] && <span class="font-semibold text-ink">{post.data.tags[0]}</span>}
                  {post.data.tags[0] && ', '}
                  <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                </p>
                <h2 class="mt-2 font-display text-xl font-bold leading-snug text-ink group-hover:underline group-hover:decoration-accent group-hover:underline-offset-4">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-ink-dim">{post.data.description}</p>
                <p class="mt-3 text-sm text-ink-dim">By {authorName(post.data.author)}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</BaseLayout>

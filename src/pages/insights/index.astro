---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const estimateReadMinutes = (text: string) => Math.max(3, Math.round(text.split(/\s+/).length / 15));

const feedItems = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return {
      id: post.id,
      title: post.data.title,
      excerpt: post.data.description,
      category: post.data.tags[0] ?? 'Insight',
      dateLabel: post.data.publishDate.toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' }),
      readMinutes: estimateReadMinutes(post.data.description),
      image: post.data.coverImage,
      sourceUrl: post.data.sourceUrl,
      sourceLabel: post.data.sourceLabel,
      Content
    };
  })
);

const [featured, ...rest] = feedItems;
const latest = rest.slice(0, 4);
const more = rest.slice(4, 7);
---

<BaseLayout
  title="Insights: WSS DevLabs"
  description="Practical, sourced notes on web development, SEO, and running a small business in Malaysia."
  path="/insights"
>
  {featured && (
    <section class="border-b border-line">
      <Container class="pt-28 pb-10 md:pt-36 md:pb-14">
        <div class="grid gap-6 lg:grid-cols-3">
          <!-- Featured -->
          <button
            type="button"
            data-open-insight={featured.id}
            class="group relative block w-full overflow-hidden rounded-3xl text-left lg:col-span-2"
          >
            <div class="relative aspect-[4/3] sm:aspect-[16/10]">
              <img
                src={featured.image}
                alt={featured.title}
                loading="eager"
                width="900"
                height="560"
                class="h-full w-full object-cover transition-transform duration-700 [transition-timing-function:var(--ease-out-expo)] group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent" aria-hidden="true"></div>
              <span class="absolute left-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-paper/95 px-3 py-1.5 text-xs font-semibold text-ink">
                <span class="h-1.5 w-1.5 rounded-full bg-accent-red" aria-hidden="true"></span>
                {featured.category}
              </span>
              <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
                <h1 class="h-sub text-white">{featured.title}</h1>
                <p class="mt-2 text-xs text-white/60">{featured.dateLabel} &middot; {featured.readMinutes} min read</p>
              </div>
            </div>
          </button>

          <!-- Latest post list -->
          {latest.length > 0 && (
            <div>
              <h2 class="text-sm font-bold uppercase tracking-wide text-ink">Latest post</h2>
              <div class="mt-5 space-y-5">
                {
                  latest.map((item) => (
                    <button type="button" data-open-insight={item.id} class="group flex w-full items-start gap-3 text-left">
                      <div class="h-16 w-16 shrink-0 overflow-hidden rounded-xl">
                        <img src={item.image} alt={item.title} loading="lazy" width="100" height="100" class="h-full w-full object-cover" />
                      </div>
                      <div class="min-w-0">
                        <p class="line-clamp-2 text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-accent">{item.title}</p>
                        <p class="mt-1.5 text-xs text-ink-dim">{item.dateLabel} &middot; {item.readMinutes} min read</p>
                      </div>
                    </button>
                  ))
                }
              </div>
            </div>
          )}
        </div>
      </Container>
    </section>
  )}

  <!-- More from WSS DevLabs: carousel -->
  {
    more.length > 0 && (
      <section class="border-b border-line bg-paper-dim">
        <Container class="py-10 md:py-14">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold uppercase tracking-wide text-ink">More from WSS DevLabs</h2>
            <div class="flex gap-2">
              <button
                type="button"
                aria-label="Previous"
                data-more-prev
                class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-paper text-ink transition-colors hover:bg-ink hover:text-white"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
              </button>
              <button
                type="button"
                aria-label="Next"
                data-more-next
                class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-paper text-ink transition-colors hover:bg-ink hover:text-white"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
              </button>
            </div>
          </div>

          <div class="mt-8 mask-fade-x -mx-6 px-6 md:-mx-10 md:px-10">
            <div class="flex gap-5 overflow-x-auto pb-2 snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-more-track>
              {
                more.map((item) => (
                  <button type="button" data-open-insight={item.id} class="tilt-card card group w-[280px] shrink-0 snap-start overflow-hidden !rounded-3xl p-0 text-left sm:w-[320px]">
                    <div class="relative h-44 overflow-hidden">
                      <img src={item.image} alt={item.title} loading="lazy" width="640" height="400" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                      <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-paper/95 px-2.5 py-1 text-[11px] font-semibold text-ink">
                        <span class="h-1.5 w-1.5 rounded-full bg-accent-red" aria-hidden="true"></span>
                        {item.category}
                      </span>
                    </div>
                    <div class="flex flex-col p-5">
                      <p class="text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-accent">{item.title}</p>
                      <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-ink-dim">{item.excerpt}</p>
                      <p class="mt-3 text-xs text-ink-dim">{item.dateLabel} &middot; {item.readMinutes} min read</p>
                    </div>
                  </button>
                ))
              }
            </div>
          </div>
        </Container>
      </section>
    )
  }

  <!-- Hidden per-post content, cloned into the modal on open -->
  {feedItems.map((item) => (
    <template data-insight-template={item.id} data-source-url={item.sourceUrl} data-source-label={item.sourceLabel}>
      <p class="mono-label text-ink-dim">{item.category} &middot; {item.dateLabel} &middot; {item.readMinutes} min read</p>
      <h2 class="mt-2 text-2xl font-bold leading-snug text-ink">{item.title}</h2>
      <div class="prose prose-neutral mt-5 max-w-none text-sm leading-relaxed">
        <item.Content />
      </div>
    </template>
  ))}

  <!-- Modal -->
  <div id="insight-modal" class="fixed inset-0 z-[100] hidden items-start justify-center overflow-y-auto bg-ink/60 p-4 py-10 backdrop-blur-sm md:items-center" role="dialog" aria-modal="true" aria-labelledby="insight-modal-title">
    <div class="relative w-full max-w-2xl rounded-3xl bg-paper p-6 shadow-2xl md:p-10">
      <button type="button" id="insight-modal-close" aria-label="Close" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-dim transition-colors hover:bg-paper-dim hover:text-ink">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
      <div id="insight-modal-body"></div>
      <div class="mt-8 border-t border-line pt-6">
        <p class="text-xs text-ink-dim">Written after reading and studying the source below. Want the original?</p>
        <a id="insight-modal-source" href="#" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-2 rounded-full border border-line bg-paper-dim px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent">
          <span id="insight-modal-source-label">Visit the source</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initInsightModal() {
    const modal = document.getElementById('insight-modal');
    const body = document.getElementById('insight-modal-body');
    const closeBtn = document.getElementById('insight-modal-close');
    const sourceLink = document.getElementById('insight-modal-source') as HTMLAnchorElement | null;
    const sourceLabel = document.getElementById('insight-modal-source-label');
    if (!modal || !body || !closeBtn || !sourceLink || !sourceLabel || modal.dataset.bound) return;
    modal.dataset.bound = '1';

    const openers = document.querySelectorAll<HTMLElement>('[data-open-insight]');
    openers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.openInsight;
        const template = document.querySelector<HTMLTemplateElement>(`template[data-insight-template="${CSS.escape(id ?? '')}"]`);
        if (!template) return;
        body.innerHTML = '';
        body.appendChild(template.content.cloneNode(true));
        sourceLink.href = template.dataset.sourceUrl ?? '#';
        sourceLabel.textContent = template.dataset.sourceLabel ?? 'Visit the source';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    });

    const close = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    closeBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
    });
  }

  initInsightModal();
  document.addEventListener('astro:page-load', initInsightModal);

  function initMoreCarousel() {
    const track = document.querySelector<HTMLElement>('[data-more-track]');
    if (!track || track.dataset.bound) return;
    track.dataset.bound = '1';

    const prev = document.querySelector<HTMLButtonElement>('[data-more-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-more-next]');
    const step = () => (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? 300;

    prev?.addEventListener('click', () => track.scrollBy({ left: -(step() + 20), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step() + 20, behavior: 'smooth' }));
  }

  initMoreCarousel();
  document.addEventListener('astro:page-load', initMoreCarousel);
</script>

---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import FounderCard from '../../components/sections/FounderCard.astro';
import { CUSTOM, SYSTEM_TIERS, WEBSITE_PACKAGES, formatRM } from '../../data/catalog';
import { TEAM } from '../../data/team';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id).slice(0, 3) }
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const author = TEAM.find((m) => m.slug === data.author) ?? TEAM[0];
const authorName = author.fullName || author.name;
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 200));
const formatDate = (date: Date) => date.toLocaleDateString('en-MY', { year: 'numeric', month: 'long', day: 'numeric' });

/* Topic-specific closing call to action, linked to what we sell (audit N5, N7) */
const ctas = {
  websites: {
    title: 'Need a website?',
    body: `Fixed-price packages from ${formatRM(WEBSITE_PACKAGES[0].price)}, with everything included listed on the page. You own the code and the domain.`,
    label: 'See website prices',
    href: '/websites/'
  },
  systems: {
    title: 'Stop renting your business software.',
    body: `Ready-made systems from ${formatRM(SYSTEM_TIERS.basic.price)}, paid once, with full source code and 12 months of updates.`,
    label: 'See systems and prices',
    href: '/systems/'
  },
  custom: {
    title: 'Need something built for you?',
    body: `Start with a Discovery Sprint (${formatRM(CUSTOM.discovery.price)}, credited to the build) and get a fixed price you can trust.`,
    label: 'See how custom builds work',
    href: '/custom/'
  }
} as const;
const cta = ctas[data.cta];
---

<ArticleLayout
  title={data.title}
  description={data.description}
  path={`/insights/${post.id}/`}
  authorName={authorName}
  authorUrl="/about/"
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  coverImage={data.coverImage}
>
  <article>
    <Container narrow class="pt-8 md:pt-12">
      <Breadcrumbs items={[{ name: 'Insights', href: '/insights/' }, { name: data.title }]} />
      <h1 class="h-section mt-6">{data.title}</h1>
      <p class="lead mt-4">{data.description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-dim">
        <span>By <a href="/about/" class="link">{authorName}</a>, {author.role}</span>
        <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
        {data.updatedDate && <span>Updated {formatDate(data.updatedDate)}</span>}
        <span>{minutes} min read</span>
      </div>
      <img
        src={data.coverImage}
        alt={data.coverAlt}
        width="1200"
        height="700"
        class="mt-8 aspect-[12/7] w-full rounded-2xl border border-line object-cover"
      />

      <div
        class="prose prose-neutral prose-lg mt-10 max-w-none prose-headings:font-display prose-headings:text-ink prose-a:text-ink prose-a:decoration-accent prose-a:underline-offset-4 prose-strong:text-ink prose-table:text-base"
      >
        <Content />
      </div>

      {
        data.sourceUrl && (
          <p class="mt-10 rounded-2xl border border-line bg-white p-5 text-ink-dim">
            Main source:{' '}
            <a href={data.sourceUrl} class="link" target="_blank" rel="noopener noreferrer">
              {data.sourceLabel ?? data.sourceUrl}
            </a>
          </p>
        )
      }

      <div class="mt-10 flex items-center gap-5 border-t border-line pt-8">
        <FounderCard />
        <div>
          <p class="font-semibold text-ink">{authorName}, {author.role} of WSS DevLabs</p>
          <p class="mt-1 text-ink-dim">{author.bio}</p>
        </div>
      </div>

      <div class="mt-10 rounded-2xl bg-ink p-6 text-white sm:p-8">
        <p class="font-display text-2xl font-bold">{cta.title}</p>
        <p class="mt-2 text-white/85">{cta.body}</p>
        <a href={cta.href} class="btn btn-primary mt-5">{cta.label}</a>
      </div>
    </Container>
  </article>

  {
    related.length > 0 && (
      <section class="mt-16 border-t border-line bg-paper-dim py-14">
        <Container>
          <h2 class="h-section">More insights</h2>
          <ul class="mt-8 grid gap-8 md:grid-cols-3">
            {related.map((item) => (
              <li>
                <a href={`/insights/${item.id}/`} class="group block">
                  <h3 class="font-display text-lg font-bold leading-snug text-ink group-hover:underline group-hover:decoration-accent group-hover:underline-offset-4">
                    {item.data.title}
                  </h3>
                  <p class="mt-2 text-ink-dim">{item.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }
</ArticleLayout>

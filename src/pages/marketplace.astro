---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Pill from '../components/ui/Pill.astro';
---

<BaseLayout
  title="Marketplace: Coming Soon | WSS DevLabs"
  description="The WSS DevLabs Marketplace is coming soon: systems, hardware and more, in one place."
  path="/marketplace"
>
  <section class="flex min-h-[80dvh] items-center pb-16 pt-32 md:pt-44" data-noreveal>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-paper-dim text-ink">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
          </svg>
        </span>
        <h1 class="mt-8 font-display text-[clamp(2.6rem,1.4rem+4.6vw,5rem)] font-bold leading-[1] tracking-[-0.04em] text-ink">Coming soon</h1>
        <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-ink-dim">
          Our Marketplace is on its way. Check back soon.
        </p>
        <div class="mt-9 flex justify-center">
          <Pill href="/contact?topic=Marketplace" label="Tell us what you are looking for" />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import { REPLY_PROMISE, SYSTEM_EXTRAS, WEBSITE_PACKAGES, GO_DIGITAL_BUNDLE, LICENCE_TERMS, formatRM } from '../data/catalog';
import { PUBLISHED_ECOSYSTEMS } from '../data/ecosystems';
import { DEFAULT_WHATSAPP_MESSAGE, SITE, phoneHref, whatsappHref } from '../data/site';
import { PUBLIC_SYSTEMS, systemPrice } from '../data/systems';
import { organizationSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';

/* Everything the page needs to pre-fill the form from a link like /contact/?need=website&package=business */
const lookup = {
  packages: Object.fromEntries([
    ...WEBSITE_PACKAGES.map((p) => [p.id, `${p.name} (${formatRM(p.price)})`]),
    ['go-digital-bundle', `Go Digital Bundle (${formatRM(GO_DIGITAL_BUNDLE.price)})`]
  ]),
  items: Object.fromEntries([
    ...PUBLIC_SYSTEMS.map((s) => [s.slug, s.name]),
    ...PUBLISHED_ECOSYSTEMS.map((e) => [e.slug, e.name])
  ]),
  orders: Object.fromEntries(PUBLIC_SYSTEMS.map((s) => [s.slug, { name: s.name, price: systemPrice(s) ?? 0 }]))
};

const orderExtras = [
  { id: 'installation', label: `${SYSTEM_EXTRAS.installation.name} (${formatRM(SYSTEM_EXTRAS.installation.price)})`, price: SYSTEM_EXTRAS.installation.price },
  { id: 'training', label: `${SYSTEM_EXTRAS.training.name} (${formatRM(SYSTEM_EXTRAS.training.price)})`, price: SYSTEM_EXTRAS.training.price },
  { id: 'branding', label: `${SYSTEM_EXTRAS.branding.name} (from ${formatRM(SYSTEM_EXTRAS.branding.price)}, quoted first)`, price: 0 },
  { id: 'data-import', label: `${SYSTEM_EXTRAS.dataImport.name} (from ${formatRM(SYSTEM_EXTRAS.dataImport.price)}, quoted first)`, price: 0 }
];
---

<BaseLayout
  title="Contact WSS DevLabs"
  description={`Tell us what you need. ${REPLY_PROMISE} WhatsApp, email or a short form.`}
  path="/contact/"
  schema={organizationSchema(siteUrl)}
>
  <section class="py-12 md:py-16">
    <Container class="grid gap-12 lg:grid-cols-[1fr_360px]">
      <div>
        <h1 class="h-display" data-heading>Tell us what you need.</h1>
        <p class="lead mt-4" data-lead>{REPLY_PROMISE}</p>

        <!-- Order summary: shown when arriving from a system's "Buy now" (audit 14.2 C) -->
        <div class="card mt-10 hidden p-6" data-order-panel data-lookup={JSON.stringify(lookup)}>
          <h2 class="h-sub">Your order</h2>
          <div class="mt-4 flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-4">
            <p class="font-semibold text-ink"><span data-order-name></span> licence</p>
            <p class="price text-xl" data-order-price></p>
          </div>
          <ul class="mt-4 space-y-1 text-sm text-ink-dim">
            <li>Perpetual licence with full source code, for {LICENCE_TERMS.installations}</li>
            <li>{LICENCE_TERMS.supportDays} days of WhatsApp support and bug fixes, {LICENCE_TERMS.updateMonths} months of updates</li>
            <li>Delivered by download link, with your licence and install guide, once payment clears</li>
          </ul>
          <fieldset class="mt-5">
            <legend class="font-semibold text-ink">Optional extras</legend>
            {
              orderExtras.map((extra) => (
                <label class="mt-2 flex min-h-11 items-center gap-3">
                  <input type="checkbox" class="h-5 w-5 shrink-0 accent-[var(--color-accent)]" data-extra={extra.id} data-extra-price={extra.price} data-extra-label={extra.label} />
                  <span class="text-ink">{extra.label}</span>
                </label>
              ))
            }
          </fieldset>
          <div class="mt-5 flex items-baseline justify-between border-t border-line pt-4">
            <p class="font-semibold text-ink">Total for fixed-price items</p>
            <p class="price text-2xl" data-order-total></p>
          </div>
          <p class="mt-1 text-sm text-ink-dim">Final price, no SST added. Hosting and hardware are paid separately.</p>
        </div>

        <form
          class="mt-10 space-y-6"
          action="https://api.web3forms.com/submit"
          method="POST"
          data-contact-form
          novalidate
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="subject" value="New enquiry from wssdevlabs.com" data-field="subject" />
          <input type="hidden" name="from_name" value="wssdevlabs.com" />
          <input type="hidden" name="context" value="" data-field="context" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div>
            <label for="name" class="field-label">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required class="field-input" />
          </div>

          <div>
            <label for="contact" class="field-label" data-contact-label>WhatsApp number or email</label>
            <input
              id="contact"
              name="contact"
              type="text"
              autocomplete="email"
              required
              class="field-input"
              aria-describedby="contact-help"
            />
            <p id="contact-help" class="field-help" data-contact-help>Whichever you prefer us to reply on.</p>
          </div>

          <div>
            <label for="need" class="field-label">What do you need?</label>
            <select id="need" name="need" required class="field-input">
              <option value="" disabled selected>Choose one</option>
              <option value="Website">A website</option>
              <option value="System">A system to run my business</option>
              <option value="Custom">Something built just for us</option>
              <option value="Other">Something else</option>
            </select>
          </div>

          <div>
            <label for="message" class="field-label">Short message <span class="font-normal text-ink-dim">(optional)</span></label>
            <textarea id="message" name="message" rows="4" class="field-input"></textarea>
          </div>

          <label class="hidden min-h-11 items-start gap-3" data-terms-row>
            <input type="checkbox" name="accepted_terms" value="Yes" class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-accent)]" data-terms />
            <span class="text-ink">
              I agree to the <a href="/licence/" class="link" target="_blank">Licence Agreement</a> and the{' '}
              <a href="/refunds/" class="link" target="_blank">Refund Policy</a>.
            </span>
          </label>

          <label class="flex min-h-11 items-start gap-3">
            <input type="checkbox" name="marketing_opt_in" value="Yes" class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-accent)]" />
            <span class="text-ink-dim">Send me occasional tips and offers. You can stop them at any time. (Optional)</span>
          </label>

          <p class="text-sm text-ink-dim">
            We use these details only to reply to you and prepare your quote. By sending this form you agree to that. See our{' '}
            <a href="/privacy/" class="link">Privacy Notice</a> (English and Bahasa Malaysia).
          </p>

          <div>
            <button type="submit" class="btn btn-primary btn-lg w-full sm:w-auto" data-submit>
              <span data-submit-label>Get a fixed quote</span>
            </button>
            <p class="mt-3 text-sm" role="status" aria-live="polite" data-status></p>
          </div>
        </form>

        <!-- Confirmation: what happens next (audit 3.18, 10.1 visibility of system status) -->
        <div class="card mt-10 hidden p-6 sm:p-8" data-thanks tabindex="-1">
          <h2 class="h-section" data-thanks-title>Thanks. We've got it.</h2>
          <ol class="mt-6 space-y-4" data-steps-enquiry>
            <li class="flex gap-4"><span class="price text-ink-dim">01</span><span class="text-ink">We reply within one business day.</span></li>
            <li class="flex gap-4"><span class="price text-ink-dim">02</span><span class="text-ink">A 15-minute call to understand what you need.</span></li>
            <li class="flex gap-4"><span class="price text-ink-dim">03</span><span class="text-ink">You get a fixed quote within three business days.</span></li>
          </ol>
          <ol class="mt-6 hidden space-y-4" data-steps-order>
            <li class="flex gap-4"><span class="price text-ink-dim">01</span><span class="text-ink">We email your invoice with payment details within one business day.</span></li>
            <li class="flex gap-4"><span class="price text-ink-dim">02</span><span class="text-ink">You pay by bank transfer or FPX.</span></li>
            <li class="flex gap-4"><span class="price text-ink-dim">03</span><span class="text-ink">Your download link, licence and install guide arrive by email once payment clears. If you added installation, we finish it within 3 working days.</span></li>
          </ol>
          <p class="mt-6 text-ink-dim">
            In a hurry? <a href={whatsappHref(DEFAULT_WHATSAPP_MESSAGE)} class="link" target="_blank" rel="noopener noreferrer">WhatsApp us</a>.
          </p>
        </div>
      </div>

      <!-- Side panel -->
      <aside class="space-y-6 lg:pt-4" aria-label="Other ways to reach us">
        <div class="card p-6">
          <h2 class="h-sub">Talk to the builder</h2>
          <a
            href={whatsappHref(DEFAULT_WHATSAPP_MESSAGE)}
            class="btn btn-whatsapp mt-4 w-full"
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp_click"
          >
            <WhatsAppIcon class="h-5 w-5" />
            WhatsApp us
          </a>
          <ul class="mt-5 space-y-1">
            <li>
              <a href={`mailto:${SITE.email}`} class="flex min-h-11 items-center gap-3 text-ink hover:text-accent-dim">
                <Icon name="mail" class="h-5 w-5 text-ink-dim" />
                {SITE.email}
              </a>
            </li>
            <li>
              <a href={phoneHref} class="flex min-h-11 items-center gap-3 text-ink hover:text-accent-dim">
                <Icon name="phone" class="h-5 w-5 text-ink-dim" />
                {SITE.phone}
              </a>
            </li>
            <li class="flex min-h-11 items-center gap-3 text-ink">
              <Icon name="map-pin" class="h-5 w-5 shrink-0 text-ink-dim" />
              <span>{SITE.registeredAddress || SITE.baseLocation}. {SITE.meetings}.</span>
            </li>
            <li class="flex min-h-11 items-center gap-3 text-ink">
              <Icon name="clock" class="h-5 w-5 text-ink-dim" />
              {SITE.hours}
            </li>
          </ul>
        </div>
        <div class="rounded-2xl bg-paper-dim p-6">
          <h2 class="h-sub">What happens next</h2>
          <ol class="mt-4 space-y-3 text-ink-dim">
            <li>1. We reply within one business day.</li>
            <li>2. A 15-minute call to understand what you need.</li>
            <li>3. A fixed quote within three business days.</li>
          </ol>
        </div>
      </aside>
    </Container>
  </section>
</BaseLayout>

<script>
  import { track } from '../scripts/track';

  type Lookup = {
    packages: Record<string, string>;
    items: Record<string, string>;
    orders: Record<string, { name: string; price: number }>;
  };

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const orderPanel = document.querySelector<HTMLElement>('[data-order-panel]');
  const params = new URLSearchParams(window.location.search);
  const lookup: Lookup = JSON.parse(orderPanel?.dataset.lookup ?? '{"packages":{},"items":{},"orders":{}}');
  const format = (amount: number) => `RM${amount.toLocaleString('en-MY')}`;

  const needSelect = form?.querySelector<HTMLSelectElement>('#need');
  const message = form?.querySelector<HTMLTextAreaElement>('#message');
  const contact = form?.querySelector<HTMLInputElement>('#contact');
  const subject = form?.querySelector<HTMLInputElement>('[data-field="subject"]');
  const context = form?.querySelector<HTMLInputElement>('[data-field="context"]');
  const termsRow = form?.querySelector<HTMLElement>('[data-terms-row]');
  const terms = form?.querySelector<HTMLInputElement>('[data-terms]');

  const order = params.get('order');
  const orderItem = order ? lookup.orders[order] : undefined;

  /* Pre-fill from the link the visitor clicked */
  const need = params.get('need');
  const needMap: Record<string, string> = { website: 'Website', system: 'System', custom: 'Custom' };
  if (needSelect && need && needMap[need]) needSelect.value = needMap[need];

  const packageId = params.get('package');
  const item = params.get('item');
  const topic = params.get('topic');
  if (message && !orderItem) {
    if (packageId && lookup.packages[packageId]) {
      message.value = `I'm interested in the ${lookup.packages[packageId]}.`;
    } else if (item && lookup.items[item]) {
      const name = lookup.items[item];
      message.value =
        topic === 'demo'
          ? `I'd like a 15-minute screen-share of ${name}.`
          : topic === 'site-visit'
            ? `I'd like to book a site visit for ${name}.`
            : `I'm interested in ${name}.`;
    }
  }
  if (context) context.value = [need, packageId, item, topic].filter(Boolean).join(' / ');

  /* Order mode */
  const updateTotal = () => {
    if (!orderPanel || !orderItem) return;
    let total = orderItem.price;
    orderPanel.querySelectorAll<HTMLInputElement>('[data-extra]').forEach((box) => {
      if (box.checked) total += Number(box.dataset.extraPrice ?? 0);
    });
    orderPanel.querySelector('[data-order-total]')!.textContent = format(total);
    return total;
  };

  if (orderPanel && orderItem && form) {
    orderPanel.classList.remove('hidden');
    orderPanel.querySelector('[data-order-name]')!.textContent = orderItem.name;
    orderPanel.querySelector('[data-order-price]')!.textContent = format(orderItem.price);
    orderPanel.addEventListener('change', updateTotal);
    updateTotal();

    document.querySelector('[data-heading]')!.textContent = 'Request your order.';
    document.querySelector('[data-lead]')!.textContent = 'We email your invoice within one business day. Your download link follows as soon as payment clears.';
    if (needSelect) needSelect.value = 'System';
    if (subject) subject.value = `Order request: ${orderItem.name}`;
    if (contact) {
      contact.type = 'email';
      document.querySelector('[data-contact-label]')!.textContent = 'Email for your invoice and licence';
      document.querySelector('[data-contact-help]')!.textContent = 'We send the invoice, then your download link and licence, to this address.';
    }
    termsRow?.classList.replace('hidden', 'flex');
    if (terms) terms.required = true;
    form.querySelector('[data-submit-label]')!.textContent = 'Request invoice';
  }

  /* Submit with inline validation and a clear result */
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');

  const fail = (text: string, field?: HTMLElement | null) => {
    if (status) {
      status.textContent = text;
      status.className = 'mt-3 text-sm font-semibold text-accent-dim';
    }
    field?.focus();
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submit || !contact) return;
    if ((form.querySelector('[name="botcheck"]') as HTMLInputElement).checked) return;

    const name = form.querySelector<HTMLInputElement>('#name');
    const value = contact.value.trim();
    const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
    const isPhone = /^\+?[\d\s-]{8,16}$/.test(value);

    if (!name?.value.trim()) return fail('Please add your name.', name);
    if (orderItem && !isEmail) return fail('Please add a valid email address for your invoice and licence.', contact);
    if (!orderItem && !isEmail && !isPhone) return fail('Please add a WhatsApp number or an email address so we can reply.', contact);
    if (!needSelect?.value) return fail('Please choose what you need.', needSelect);
    if (orderItem && !terms?.checked) return fail('Please confirm you agree to the Licence Agreement and Refund Policy.', terms);

    const data = new FormData(form);
    if (isEmail) data.set('email', value);
    else data.set('whatsapp', value);

    if (orderItem && orderPanel) {
      const extras = Array.from(orderPanel.querySelectorAll<HTMLInputElement>('[data-extra]:checked')).map((box) => box.dataset.extraLabel);
      data.set('order', `${orderItem.name} licence (${format(orderItem.price)})`);
      data.set('order_extras', extras.length ? extras.join('; ') : 'None');
      data.set('order_total_fixed_items', format(updateTotal() ?? orderItem.price));
    }

    submit.disabled = true;
    if (status) {
      status.textContent = 'Sending...';
      status.className = 'mt-3 text-sm text-ink-dim';
    }

    try {
      const response = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
      const result = (await response.json()) as { success?: boolean; message?: string };
      if (!result.success) throw new Error(result.message ?? 'Submission failed');

      track(orderItem ? 'order_request' : 'form_submit', { need: needSelect?.value ?? '' });
      form.classList.add('hidden');
      orderPanel?.classList.add('hidden');
      const thanks = document.querySelector<HTMLElement>('[data-thanks]');
      if (thanks) {
        thanks.classList.remove('hidden');
        if (orderItem) {
          thanks.querySelector('[data-thanks-title]')!.textContent = 'Thanks. Your order request is in.';
          thanks.querySelector('[data-steps-enquiry]')?.classList.add('hidden');
          thanks.querySelector('[data-steps-order]')?.classList.remove('hidden');
        }
        thanks.focus();
      }
    } catch (error) {
      console.error('Contact form submission failed', error);
      fail("Sorry, that didn't send. Please try again, or WhatsApp or email us directly.");
    } finally {
      submit.disabled = false;
    }
  });
</script>

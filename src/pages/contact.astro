---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Email from '../components/ui/Email.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import { SITE, SOCIAL_LINKS, phoneHref, whatsappHref, DEFAULT_WHATSAPP_MESSAGE } from '../data/site';
import { CUSTOM, GO_DIGITAL_BUNDLE, REPLY_PROMISE, WEBSITE_PACKAGES, formatRM } from '../data/catalog';
import { PUBLIC_SYSTEMS, systemPrice } from '../data/systems';
import { PUBLISHED_ECOSYSTEMS } from '../data/ecosystems';
import { breadcrumbSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';

const NEEDS = [
  { value: 'website', label: 'A website' },
  { value: 'system', label: 'A ready-made system' },
  { value: 'custom', label: 'Custom software' },
  { value: 'care', label: 'A Care Plan' },
  { value: 'other', label: 'Something else' }
];

/* Prefill for "Get a quote" links: /contact/?package=<id> picks the need and drafts the first line. */
const prefill: Record<string, { need: string; message: string }> = {
  website: { need: 'website', message: "I'd like a quote for a website." },
  custom: { need: 'custom', message: "I'd like a quote for a custom build." },
  discovery: { need: 'custom', message: `I'd like to book a Discovery Sprint (${formatRM(CUSTOM.discovery.price)}).` },
  founding: { need: 'other', message: "I'd like to ask about a Founding Client place." },
  'go-digital': { need: 'website', message: `I'm interested in the Go Digital Bundle (${formatRM(GO_DIGITAL_BUNDLE.price)}).` },
  'care-hosting': { need: 'care', message: "I'm interested in the Hosting Only plan." },
  'care-basic': { need: 'care', message: "I'm interested in the Care Basic plan." },
  'care-pro': { need: 'care', message: "I'm interested in the Care Pro plan." }
};
WEBSITE_PACKAGES.forEach((pkg) => {
  prefill[pkg.id] = { need: 'website', message: `I'm interested in the ${pkg.name} (${formatRM(pkg.price)}).` };
});
PUBLIC_SYSTEMS.forEach((system) => {
  const price = systemPrice(system);
  prefill[system.slug] = { need: 'system', message: `I'm interested in ${system.name}${price ? ` (${formatRM(price)})` : ''}.` };
});
PUBLISHED_ECOSYSTEMS.forEach((eco) => {
  prefill[eco.slug] = { need: 'system', message: `I'd like to book a site visit for ${eco.name}.` };
});

const nextSteps = [
  'We reply within one business day.',
  'A 15-minute call to understand what you need.',
  'A fixed quote, in writing, within three business days.'
];

const schema = breadcrumbSchema(siteUrl, [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' }
]);
---

<BaseLayout
  title="Contact: Get a Fixed Quote"
  description="Tell WSS DevLabs what you need. We reply within one business day, with a fixed quote within three. WhatsApp, email or the form."
  path="/contact/"
  schema={schema}
>

  <!-- Contact intro + form -->
  <section class="border-b border-line">
    <Container class="pt-10 pb-12 md:pt-36 md:pb-16">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Left: heading + info -->
        <div>
          <p class="mono-label text-ink-dim">Get in touch</p>
          <h1 class="h-display mt-3 !text-[clamp(2rem,1.3rem+2.6vw,3.2rem)]" data-split>
            Tell us what <span class="badge-highlight">you need</span>
          </h1>
          <p class="mt-5 max-w-md leading-relaxed text-ink-dim">
            {REPLY_PROMISE} You'll talk to the person who builds it, not a sales team.
          </p>

          <div class="mt-10 grid gap-8 sm:grid-cols-2">
            <div>
              <p class="mono-label text-ink-dim">Phone and WhatsApp</p>
              <p class="mt-2 text-sm font-semibold text-ink"><a href={phoneHref} class="hover:text-accent">{SITE.phone}</a></p>
              <a
                href={whatsappHref(DEFAULT_WHATSAPP_MESSAGE)}
                target="_blank"
                rel="noopener noreferrer"
                class="link-underline mt-1 text-xs font-semibold text-accent"
              >
                Chat on WhatsApp
              </a>
            </div>
            <div>
              <p class="mono-label text-ink-dim">Based in</p>
              <p class="mt-2 text-sm font-semibold text-ink">{SITE.baseLocation}</p>
              <p class="mt-1 text-xs text-ink-dim">{SITE.meetings}</p>
            </div>
            <div>
              <p class="mono-label text-ink-dim">Email</p>
              <p class="mt-2 text-sm font-semibold text-ink"><Email class="hover:text-accent" /></p>
            </div>
            <div>
              <p class="mono-label text-ink-dim">Social Network</p>
              <div class="mt-2 flex items-center gap-2">
                {SOCIAL_LINKS.map(([label, href]) => (
                  <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-dim transition-all hover:border-accent hover:bg-accent hover:text-white">
                    <SocialIcon name={label} class="h-3.5 w-3.5" />
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Right: quick-contact form -->
        <div class="rounded-3xl border border-line bg-white p-8 md:p-10 shadow-card">
          <p class="mono-label text-accent font-bold tracking-widest uppercase">FIXED QUOTE</p>
          <h2 class="text-xl font-bold text-ink mt-1">Get In Touch</h2>
          <p class="mt-1.5 text-sm text-ink-dim">Four quick fields. We'll come back with a fixed quote.</p>

          <form
            id="contact-form"
            class="mt-6 space-y-4"
            novalidate
            data-has-key={accessKey ? '1' : undefined}
            data-prefill={JSON.stringify(prefill)}
          >
            <input type="hidden" name="access_key" value={accessKey} />
            <input type="hidden" name="subject" value="Website enquiry" />
            <input type="hidden" name="package" id="c-package" value="" />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="c-name" class="mb-1.5 block text-xs font-semibold text-ink">Your Name <span class="text-accent-red">*</span></label>
                <input id="c-name" name="name" type="text" placeholder="Full name" required autocomplete="name" class="w-full rounded-xl border border-line bg-paper-dim/60 px-4 py-3 text-sm text-ink placeholder:text-ink-dim/50 focus:border-ink focus:bg-white focus:outline-none" />
              </div>
              <div>
                <label for="c-contact" class="mb-1.5 block text-xs font-semibold text-ink">WhatsApp or email <span class="text-accent-red">*</span></label>
                <input id="c-contact" name="contact" type="text" placeholder="012-345 6789 or you@company.com" required autocomplete="email" class="w-full rounded-xl border border-line bg-paper-dim/60 px-4 py-3 text-sm text-ink placeholder:text-ink-dim/50 focus:border-ink focus:bg-white focus:outline-none" />
              </div>
            </div>

            <div>
              <label for="c-need" class="mb-1.5 block text-xs font-semibold text-ink">What do you need? <span class="text-accent-red">*</span></label>
              <select id="c-need" name="need" required class="w-full rounded-xl border border-line bg-paper-dim/60 px-4 py-3 text-sm text-ink focus:border-ink focus:bg-white focus:outline-none appearance-none cursor-pointer">
                <option value="">Choose one</option>
                {NEEDS.map((need) => <option value={need.label} data-need={need.value}>{need.label}</option>)}
              </select>
            </div>

            <div>
              <label for="c-message" class="mb-1.5 block text-xs font-semibold text-ink">Short message <span class="font-normal text-ink-dim">(optional)</span></label>
              <textarea id="c-message" name="message" rows="3" placeholder="A line or two about your business and what you'd like..." class="w-full resize-none rounded-xl border border-line bg-paper-dim/60 px-4 py-3 text-sm text-ink placeholder:text-ink-dim/50 focus:border-ink focus:bg-white focus:outline-none" />
            </div>

            <label class="flex items-start gap-2.5 text-xs text-ink-dim">
              <input type="checkbox" name="marketing_opt_in" value="yes" class="mt-0.5 rounded border-line text-accent" />
              <span>Send me occasional tips and offers. Optional, and you can stop any time.</span>
            </label>

            <p class="text-[11px] leading-relaxed text-ink-dim">
              We use your details only to reply to this enquiry and prepare your quote. See our{' '}
              <a href="/privacy/" class="underline hover:text-accent">Privacy Notice</a>.
            </p>

            <p id="c-error" role="alert" class="hidden rounded-xl border border-accent-red/20 bg-accent-red/5 px-4 py-3 text-sm font-semibold text-accent-red"></p>

            <div id="c-success" class="hidden rounded-xl bg-emerald-500/10 border border-emerald-500/20 px-4 py-4 text-sm text-emerald-900" role="status">
              <p class="font-bold">Thank you, it's on its way. Here's what happens next:</p>
              <ol class="mt-2 space-y-1">
                {nextSteps.map((step, i) => <li>{i + 1}. {step}</li>)}
              </ol>
            </div>

            <button type="submit" id="c-submit" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-7 py-3.5 text-sm font-bold text-white shadow-md shadow-accent/25 transition-all hover:bg-accent-dim hover:scale-[1.01] active:scale-95">
              <span id="c-submit-label">Get a fixed quote</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </button>
          </form>
        </div>
      </div>
    </Container>
  </section>

  <!-- Map + location -->
  <div class="border-b border-line">
    <Container class="py-6">
      <div class="grid gap-5 lg:grid-cols-[1fr_320px]">
        <div class="perspective-wrap relative overflow-hidden rounded-[0.75rem] border border-line" data-reveal="tilt3d">
          <div
            id="contact-map"
            role="img"
            aria-label={`Map of ${SITE.baseLocation}, where WSS DevLabs is based`}
            class="h-[320px] w-full bg-paper-dim md:h-[440px]"
          />
        </div>

        <!-- Dedicated location card, always visible (not floated over the map) -->
        <div class="tilt-card card flex flex-col gap-4 p-6">
          <div class="relative flex h-32 w-full items-center justify-center overflow-hidden rounded-xl border border-line bg-paper-dim">
            <div class="dot-pattern mask-fade-edges absolute inset-0 opacity-60" aria-hidden="true"></div>
            <svg class="relative h-9 w-9 text-ink-dim/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
          </div>
          <div>
            <p class="mono-label text-ink-dim">Where we are</p>
            <p class="mt-2 font-semibold text-ink">{SITE.name}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-dim">{SITE.registeredAddress || SITE.baseLocation}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-dim">{SITE.meetings}.</p>
            <p class="mono-label mt-3 !text-[0.62rem] text-accent">{SITE.hours}</p>
          </div>
          <a
            href={whatsappHref("Hi WSS DevLabs, I'd like to arrange a meeting.")}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-accent"
          >
            Arrange a meeting on WhatsApp
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </Container>
  </div>

</BaseLayout>

<script>
  import { track } from '../scripts/track';

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('c-success');
    const error = document.getElementById('c-error');
    const submit = document.getElementById('c-submit') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('c-submit-label');
    if (!form || !success || !error || !submit || !submitLabel || form.dataset.bound) return;
    form.dataset.bound = '1';

    const need = form.querySelector<HTMLSelectElement>('#c-need');
    const message = form.querySelector<HTMLTextAreaElement>('#c-message');
    const packageField = form.querySelector<HTMLInputElement>('#c-package');

    // Prefill from ?package=… so "Get a quote" buttons arrive with the right choice.
    const packageId = new URLSearchParams(window.location.search).get('package');
    const prefill = JSON.parse(form.dataset.prefill ?? '{}') as Record<string, { need: string; message: string }>;
    const match = packageId ? prefill[packageId] : undefined;
    if (match && need && message && packageField) {
      const option = Array.from(need.options).find((o) => o.dataset.need === match.need);
      if (option) need.value = option.value;
      if (!message.value) message.value = `${match.message} `;
      packageField.value = packageId ?? '';
    }

    const showError = (text: string) => {
      error.textContent = text;
      error.classList.remove('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.classList.add('hidden');
      const botcheck = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
      if (botcheck?.checked) return;

      const name = (form.querySelector<HTMLInputElement>('#c-name')?.value ?? '').trim();
      const contact = (form.querySelector<HTMLInputElement>('#c-contact')?.value ?? '').trim();
      if (!name || !contact || !need?.value) {
        showError('Please add your name, a WhatsApp number or email, and what you need.');
        return;
      }

      // No form key configured: open the visitor's email app instead, as before.
      if (!form.dataset.hasKey) {
        const subject = encodeURIComponent(`Enquiry from ${name}: ${need.value}`);
        const body = encodeURIComponent(`Name: ${name}\nWhatsApp or email: ${contact}\nNeed: ${need.value}\n\n${message?.value ?? ''}`);
        window.location.href = `mailto:info@wssdevlabs.com?subject=${subject}&body=${body}`;
        success.classList.remove('hidden');
        return;
      }

      submit.disabled = true;
      submitLabel.textContent = 'Sending...';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form)
        });
        const result = await res.json();
        if (!result.success) throw new Error(result.message);
        success.classList.remove('hidden');
        track('form_submit', { form: 'contact', need: need.value });
        form.reset();
      } catch {
        showError('That did not send. Please WhatsApp or email us directly instead, and sorry for the trouble.');
      } finally {
        submit.disabled = false;
        submitLabel.textContent = 'Get a fixed quote';
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<script>
  import 'leaflet/dist/leaflet.css';
  import L from 'leaflet';

  const OFFICE: [number, number] = [3.149, 101.695];
  let map: L.Map | null = null;

  function initContactMap() {
    const el = document.getElementById('contact-map');
    if (!el || map) return;

    map = L.map(el, {
      center: OFFICE,
      zoom: 11,
      scrollWheelZoom: false,
      zoomControl: false
    });

    // CARTO's free tiles now require an API key, so we use OpenStreetMap's tiles,
    // muted with a CSS filter (.wss-muted-tiles below) to keep the light map look.
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      className: 'wss-muted-tiles',
      maxZoom: 19
    }).addTo(map);

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    const pin = L.divIcon({
      className: '',
      html:
        '<span style="display:block;height:14px;width:14px;border-radius:9999px;background:var(--color-accent);border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,.35)"></span>',
      iconSize: [14, 14],
      iconAnchor: [7, 7]
    });

    L.marker(OFFICE, { icon: pin }).addTo(map);
  }

  function teardownContactMap() {
    map?.remove();
    map = null;
  }

  initContactMap();
  document.addEventListener('astro:page-load', initContactMap);
  document.addEventListener('astro:before-swap', teardownContactMap);
</script>

<style is:global>
  .wss-muted-tiles {
    filter: grayscale(1) contrast(0.88) brightness(1.06);
  }
</style>

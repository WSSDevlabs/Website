---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import { EXPRESS_PACKAGES, EXPRESS_FAQ } from '../data/express';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: EXPRESS_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};
---

<BaseLayout
  title="WSS Express: Fixed-Price Web Design Packages (3–7 Day Ship)"
  description="Eliminating Malaysian SME quote friction with transparent, fixed-price websites starting from RM 180/year. 3–7 day delivery, zero SaaS lock-in, mobile-first, and Answer Engine optimized."
  path="/express"
  schema={faqSchema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-ink py-20 text-white md:py-28">
    <div class="grain-overlay" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 -top-40 h-96 w-96 rounded-full bg-accent/20 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-accent-blue/15 blur-3xl"
      aria-hidden="true"
    ></div>

    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1 text-xs font-mono uppercase tracking-wider text-accent-yellow-vivid">
          <span class="h-2 w-2 animate-pulse rounded-full bg-accent-yellow-vivid"></span>
          Fixed-Price · Zero SaaS Lock-in · Ships in 3–7 Days
        </div>
        <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl">
          Fast, High-Speed Websites <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-accent via-red-400 to-accent-yellow-vivid bg-clip-text text-transparent">
            Without the Agency Fluff.
          </span>
        </h1>
        <p class="mt-6 text-base leading-relaxed text-white/70 sm:text-lg">
          Malaysian SMEs waste weeks waiting for "custom quotes" only to be locked into recurring SaaS fees.
          <strong>WSS Express</strong> delivers transparent, high-performance web systems shipped in days, directly engineered by senior builders.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <Button
            href="https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I'd%20like%20to%20order%20a%20WSS%20Express%20package."
            variant="primary"
            class="shadow-lg shadow-accent/30"
          >
            WhatsApp an Engineer Now
          </Button>
          <a
            href="#packages"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
          >
            Compare 3 Packages
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </a>
        </div>

        <!-- Trust Signals Bar -->
        <div class="mt-12 grid grid-cols-2 gap-4 border-t border-white/10 pt-8 sm:grid-cols-4">
          <div>
            <p class="font-feature text-2xl font-bold text-white">3–7 Days</p>
            <p class="mt-0.5 text-xs text-white/50">Average Ship Time</p>
          </div>
          <div>
            <p class="font-feature text-2xl font-bold text-accent-yellow-vivid">RM 0</p>
            <p class="mt-0.5 text-xs text-white/50">Hidden Monthly SaaS Fees</p>
          </div>
          <div>
            <p class="font-feature text-2xl font-bold text-accent">90+ Score</p>
            <p class="mt-0.5 text-xs text-white/50">Mobile Lighthouse Guaranteed</p>
          </div>
          <div>
            <p class="font-feature text-2xl font-bold text-emerald-400">100%</p>
            <p class="mt-0.5 text-xs text-white/50">Direct with Senior Engineers</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Packages Grid -->
  <Section id="packages" rule>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="Standardized Pricing" tone="red" />
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">
          Pick Your Tier. Ship Next Week.
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          No hidden discovery fees. No endless sales calls. Every package is typed, clean, and delivered directly to production.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-3 lg:items-stretch">
        {
          EXPRESS_PACKAGES.map((pkg) => (
            <div
              class:list={[
                'relative flex flex-col justify-between rounded-2xl border p-7 transition-all duration-300',
                pkg.highlight
                  ? 'border-accent bg-paper shadow-2xl ring-2 ring-accent/20 lg:-translate-y-2'
                  : 'border-line bg-paper-dim/40 hover:border-line-hover hover:bg-paper'
              ]}
            >
              {pkg.badge && (
                <div class="absolute -top-3.5 right-6 rounded-full bg-accent px-3 py-0.5 text-xs font-semibold text-white shadow-sm">
                  {pkg.badge}
                </div>
              )}

              <div>
                <h3 class="text-xl font-bold text-ink">{pkg.name}</h3>
                <p class="mt-1 text-xs font-medium text-accent">{pkg.strategicCopy}</p>
                <p class="mt-3 text-xs leading-relaxed text-ink-dim">{pkg.overview}</p>

                <div class="my-6 border-y border-line/60 py-4">
                  <div class="flex items-baseline gap-1">
                    <span class="font-feature text-4xl font-extrabold text-ink">{pkg.price}</span>
                    {pkg.period && <span class="text-xs text-ink-dim">{pkg.period}</span>}
                  </div>
                  <div class="mt-2 flex items-center gap-2 text-xs text-ink-dim">
                    <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                    <span>Turnaround: <strong>{pkg.turnaround}</strong></span>
                  </div>
                </div>

                <!-- Features list -->
                <p class="text-xs font-bold uppercase tracking-wider text-ink">What's Included:</p>
                <ul class="mt-3 space-y-2.5 text-xs text-ink-dim">
                  {pkg.features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>

                <!-- Specs Box -->
                <div class="mt-6 rounded-xl border border-line/70 bg-paper-deep/40 p-3 text-[11px] text-ink-dim">
                  <p class="font-semibold text-ink">Architecture Details:</p>
                  <p class="mt-1">· <strong>Scope:</strong> {pkg.specs.pages}</p>
                  <p>· <strong>Hosting:</strong> {pkg.specs.domainHosting}</p>
                  <p>· <strong>Revisions:</strong> {pkg.specs.revisions}</p>
                  <p>· <strong>Support:</strong> {pkg.specs.support}</p>
                </div>
              </div>

              <div class="mt-8 pt-4">
                <a
                  href={`https://wa.me/601127205895?text=${encodeURIComponent(pkg.whatsappMessage)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'inline-flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition-all duration-200',
                    pkg.highlight
                      ? 'bg-accent text-white shadow-md hover:bg-accent-dim'
                      : 'border border-ink bg-ink text-white hover:bg-ink/85'
                  ]}
                >
                  <span>{pkg.ctaText}</span>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Answer Engine Optimization (AI-SEO) Breakdown -->
  <Section class="bg-paper-dim/60">
    <Container>
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <Eyebrow label="AI-First Search Visibility" tone="yellow" />
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">
            Engineered for Answer Engines, Not Just Legacy Search.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-dim">
            Modern customers ask <strong>ChatGPT, Perplexity, and Gemini</strong> for local recommendations instead of scrolling 10 blue Google links.
            Every WSS Express build ships with structured JSON-LD data and semantic metadata so AI assistants cite your business directly.
          </p>

          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3 rounded-xl border border-line bg-paper p-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 font-bold text-accent">✓</span>
              <div>
                <h3 class="text-sm font-semibold text-ink">Structured FAQ & Service Schemas</h3>
                <p class="mt-0.5 text-xs text-ink-dim">Direct question-and-answer pairs encoded directly into page head data for rapid LLM indexing.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 rounded-xl border border-line bg-paper p-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 font-bold text-accent">✓</span>
              <div>
                <h3 class="text-sm font-semibold text-ink">Local Geo-Relevance Anchors</h3>
                <p class="mt-0.5 text-xs text-ink-dim">Precise ICBM coordinates, SSM identifiers, and Malaysian service territory tagging.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-ink p-6 text-white shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-3 font-mono text-xs text-white/50">
            <span>schema-validator.jsonld</span>
            <span class="text-emerald-400">● Validated Schema</span>
          </div>
          <pre class="mt-4 overflow-x-auto font-mono text-xs leading-relaxed text-white/80">
<code>{`{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Your Malaysian Business",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Kuala Lumpur",
    "addressCountry": "MY"
  },
  "makesOffer": {
    "@type": "Offer",
    "priceCurrency": "MYR",
    "price": "180"
  },
  "answerEngineOptimized": true
}`}</code></pre>
        </div>
      </div>
    </Container>
  </Section>

  <!-- The Direct Builder USP -->
  <Section rule>
    <Container>
      <div class="rounded-3xl border border-line bg-paper p-8 shadow-sm md:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
          <div>
            <Eyebrow label="Direct Builder Access" tone="red" />
            <h2 class="mt-2 text-2xl font-bold text-ink md:text-3xl">
              You Talk Directly to Razin & Natasya. No Middlemen.
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-dim">
              Traditional agencies put junior account managers between you and the person writing the code, causing delays and miscommunication.
              At WSS Dev Labs, <strong>Razin Hakim</strong> leads the backend and performance architecture, while <strong>Natasya Umairah</strong> crafts the UI and micro-moments.
            </p>

            <div class="mt-6 flex flex-wrap gap-4">
              <a
                href="https://wa.me/601127205895?text=Hi%20Razin%20%26%20Natasya%2C%20I'd%20like%20to%20discuss%20an%20Express%20build."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-accent-dim"
              >
                WhatsApp the Builders Directly
              </a>
              <a
                href="/status"
                class="inline-flex items-center gap-2 rounded-full border border-line bg-paper-dim px-5 py-2.5 text-sm font-semibold text-ink hover:bg-paper-deep"
              >
                View Live Build Status
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-2xl border border-line bg-paper-dim p-4 text-center">
              <img
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&h=300&q=80"
                alt="Razin Hakim"
                class="mx-auto h-16 w-16 rounded-full object-cover shadow-sm"
              />
              <h3 class="mt-3 text-sm font-bold text-ink">Razin Hakim</h3>
              <p class="text-[11px] text-accent">Full-Stack & Backend</p>
            </div>
            <div class="rounded-2xl border border-line bg-paper-dim p-4 text-center">
              <img
                src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=300&h=300&q=80"
                alt="Natasya Umairah"
                class="mx-auto h-16 w-16 rounded-full object-cover shadow-sm"
              />
              <h3 class="mt-3 text-sm font-bold text-ink">Natasya Umairah</h3>
              <p class="text-[11px] text-accent">Front-End & UI/UX</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Conversion FAQ -->
  <Section rule class="bg-paper-dim/40">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="Direct & Scannable Answers" tone="blue" />
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink">
          Frequently Asked Questions
        </h2>
      </div>

      <div class="mx-auto mt-10 max-w-3xl space-y-4">
        {
          EXPRESS_FAQ.map((faq) => (
            <details class="group rounded-2xl border border-line bg-paper p-5 transition hover:border-line-hover open:border-accent open:bg-paper">
              <summary class="flex cursor-pointer items-center justify-between text-base font-semibold text-ink">
                <span>{faq.q}</span>
                <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-paper-dim text-ink transition-transform duration-200 group-open:rotate-180">
                  ↓
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink-dim">{faq.a}</p>
            </details>
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <p class="text-sm text-ink-dim">
          Have a custom question or ready to begin?
          <a
            href="https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I%20have%20a%20question%20about%20WSS%20Express."
            class="font-semibold text-accent hover:underline"
          >
            Chat with us on WhatsApp
          </a>
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SMEProjectCalculator from '../components/sections/SMEProjectCalculator.astro';
import { EXPRESS_PACKAGES, EXPRESS_FAQ } from '../data/express';
import { LIVE_SYSTEM_METRICS, STANDARD_BUILD_PIPELINE } from '../data/status';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: EXPRESS_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};
---

<BaseLayout
  title="WSS Express: Fixed-Price Web Design Packages & Live Build Status"
  description="Eliminating Malaysian SME quote friction with transparent, fixed-price websites. 3–7 day delivery, zero SaaS lock-in, direct builder access, and live sprint/deployment status."
  path="/express"
  schema={faqSchema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-10 pb-20 md:pt-40 md:pb-28">
    <div class="grid-pattern mask-fade-edges absolute inset-0 opacity-25" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 -top-40 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>

    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl md:text-6xl">
          Fast, High-Speed Websites <br class="hidden sm:inline" />
          <span class="badge-highlight">Without the Agency Fluff.</span>
        </h1>
        <p class="mt-6 text-base leading-relaxed text-ink-dim sm:text-lg">
          Malaysian SMEs waste weeks waiting for "custom quotes" only to be locked into recurring SaaS fees.
          <strong>WSS Express</strong> delivers transparent, high-performance web systems shipped in days, directly engineered by senior builders.
        </p>

        <!-- Trust Signals Bar -->
        <div class="mt-12 rounded-3xl sm:rounded-full border border-line bg-white p-6 sm:px-10 sm:py-7 shadow-card">
          <div class="grid grid-cols-2 gap-6 sm:grid-cols-4 sm:divide-x sm:divide-line text-center">
            <div class="flex flex-col items-center justify-center">
              <p class="font-feature text-2xl font-black text-ink">3–7 Days</p>
              <p class="mt-1 text-xs text-ink-dim">Average Ship Time</p>
            </div>
            <div class="flex flex-col items-center justify-center sm:pl-6">
              <p class="font-feature text-2xl font-black text-ink">RM 0</p>
              <p class="mt-1 text-xs text-ink-dim">Hidden Monthly SaaS Fees</p>
            </div>
            <div class="flex flex-col items-center justify-center sm:pl-6">
              <p class="font-feature text-2xl font-black text-accent">90+ Score</p>
              <p class="mt-1 text-xs text-ink-dim">Mobile Lighthouse Guaranteed</p>
            </div>
            <div class="flex flex-col items-center justify-center sm:pl-6">
              <p class="font-feature text-2xl font-black text-emerald-600">100%</p>
              <p class="mt-1 text-xs text-ink-dim">Direct with Senior Engineers</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Packages Grid -->
  <Section id="packages" rule>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="Standardized Pricing" tone="red" />
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">
          Pick Your Tier. Ship Next Week.
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          No hidden discovery fees. No endless sales calls. Every package is typed, clean, and delivered directly to production.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-3 lg:items-stretch">
        {
          EXPRESS_PACKAGES.map((pkg) => (
            <div
              id={pkg.id}
              class:list={[
                'relative flex flex-col justify-between rounded-2xl border p-7 transition-all duration-300',
                pkg.highlight
                  ? 'border-accent bg-paper shadow-2xl ring-2 ring-accent/20 lg:-translate-y-2'
                  : 'border-line bg-paper-dim/40 hover:border-line-hover hover:bg-paper'
              ]}
            >
              {pkg.badge && (
                <div class="absolute -top-3.5 right-6 rounded-full bg-accent px-3 py-0.5 text-xs font-semibold text-white shadow-sm">
                  {pkg.badge}
                </div>
              )}

              <div>
                <h3 class="text-xl font-bold text-ink">{pkg.name}</h3>
                <p class="mt-1 text-xs font-medium text-accent">{pkg.strategicCopy}</p>
                <p class="mt-3 text-xs leading-relaxed text-ink-dim">{pkg.overview}</p>

                <div class="my-6 border-y border-line/60 py-4">
                  <div class="mt-2 flex items-center gap-2 text-xs text-ink-dim">
                    <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                    <span>Turnaround: <strong>{pkg.turnaround}</strong></span>
                  </div>
                </div>

                <!-- Features list -->
                <p class="text-xs font-bold uppercase tracking-wider text-ink">What's Included:</p>
                <ul class="mt-3 space-y-2.5 text-xs text-ink-dim">
                  {pkg.features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>

                <!-- Specs Box -->
                <div class="mt-6 rounded-xl border border-line/70 bg-paper-deep/40 p-3 text-[11px] text-ink-dim">
                  <p class="font-semibold text-ink">Architecture Details:</p>
                  <p class="mt-1">· <strong>Scope:</strong> {pkg.specs.pages}</p>
                  <p>· <strong>Hosting:</strong> {pkg.specs.domainHosting}</p>
                  <p>· <strong>Revisions:</strong> {pkg.specs.revisions}</p>
                  <p>· <strong>Support:</strong> {pkg.specs.support}</p>
                </div>
              </div>

              <div class="mt-8 pt-4">
                <a
                  href={`https://wa.me/601127205895?text=${encodeURIComponent(pkg.whatsappMessage)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'inline-flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition-all duration-200',
                    pkg.highlight
                      ? 'bg-accent text-white shadow-md hover:bg-accent-dim'
                      : 'border border-ink bg-ink text-white hover:bg-ink/85'
                  ]}
                >
                  <span>{pkg.ctaText}</span>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Answer Engine Optimization (AI-SEO) Breakdown -->
  <Section class="bg-paper-dim/60">
    <Container>
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <Eyebrow label="AI-First Search Visibility" tone="yellow" />
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">
            Engineered for Answer Engines, Not Just Legacy Search.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-dim">
            Modern customers ask <strong>ChatGPT, Perplexity, and Gemini</strong> for local recommendations instead of scrolling 10 blue Google links.
            Every WSS Express build ships with structured JSON-LD data and semantic metadata so AI assistants cite your business directly.
          </p>

          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3 rounded-xl border border-line bg-paper p-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 font-bold text-accent">✓</span>
              <div>
                <h3 class="text-sm font-semibold text-ink">Structured FAQ & Service Schemas</h3>
                <p class="mt-0.5 text-xs text-ink-dim">Direct question-and-answer pairs encoded directly into page head data for rapid LLM indexing.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 rounded-xl border border-line bg-paper p-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 font-bold text-accent">✓</span>
              <div>
                <h3 class="text-sm font-semibold text-ink">Local Geo-Relevance Anchors</h3>
                <p class="mt-0.5 text-xs text-ink-dim">Precise ICBM coordinates, SSM identifiers, and Malaysian service territory tagging.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-ink p-6 text-white shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-3 font-mono text-xs text-white/50">
            <span>schema-validator.jsonld</span>
            <span class="text-emerald-400">● Validated Schema</span>
          </div>
          <pre class="mt-4 overflow-x-auto font-mono text-xs leading-relaxed text-white/80">
<code>{`{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Your Malaysian Business",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Kuala Lumpur",
    "addressCountry": "MY"
  },
  "makesOffer": {
    "@type": "Offer",
    "priceCurrency": "MYR",
    "price": "180"
  },
  "answerEngineOptimized": true
}`}</code></pre>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Direct Builder Availability -->
  <Section id="builders" rule>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="The Direct Builder Model" tone="red" />
        <h2 class="mt-2 text-3xl font-bold text-ink md:text-4xl">
          You Talk Directly to the Engineer. No Middlemen.
        </h2>
        <p class="mt-3 text-sm text-ink-dim">
          No account managers or support tickets. When you message WSS Dev Labs, you talk directly with the person building your product.
        </p>
      </div>

      <div class="mt-10 mx-auto max-w-md">
        {
          LIVE_SYSTEM_METRICS.directBuilders.map((builder) => (
            <div class="rounded-2xl border border-line bg-paper p-6 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl font-bold text-ink">{builder.name}</h3>
                  <p class="text-xs font-semibold text-accent">{builder.role}</p>
                </div>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  {builder.status}
                </span>
              </div>

              <p class="mt-4 text-xs leading-relaxed text-ink-dim">
                <strong>Core Focus:</strong> {builder.specialty}
              </p>

              <div class="mt-6 flex items-center gap-3 pt-4 border-t border-line/60">
                <a
                  href={`https://wa.me/601127205895?text=${encodeURIComponent(`Hi ${builder.name}! I'd like to discuss an Express build.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 rounded-xl bg-accent px-4 py-2 text-center text-xs font-semibold text-white shadow-sm transition hover:bg-accent-dim"
                >
                  WhatsApp Directly
                </a>
                <a
                  href={`mailto:${builder.email}`}
                  class="rounded-xl border border-line bg-paper-dim px-4 py-2 text-center text-xs font-semibold text-ink hover:bg-paper-deep"
                >
                  Email
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- 4-Stage Standard Build Pipeline -->
  <Section id="pipeline" rule class="bg-paper-dim/30">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="Go-Live Calm" tone="blue" />
        <h2 class="mt-2 text-3xl font-bold text-ink md:text-4xl">
          Our Standard 4-Stage Sprint Pipeline
        </h2>
        <p class="mt-3 text-sm text-ink-dim">
          How every WSS Express build transitions safely from kick-off to production.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          STANDARD_BUILD_PIPELINE.map((stage) => (
            <div class="flex flex-col justify-between rounded-2xl border border-line bg-paper p-6 shadow-sm">
              <div>
                <span class="font-feature text-2xl font-extrabold text-accent">{stage.stage}</span>
                <h3 class="mt-2 text-base font-bold text-ink">{stage.label}</h3>
                <p class="mt-3 text-xs leading-relaxed text-ink-dim">{stage.description}</p>
              </div>
              <div class="mt-6 border-t border-line/60 pt-3">
                <p class="text-[11px] font-mono text-ink-dim">
                  Duration: <strong class="text-ink">{stage.expectedDuration}</strong>
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Recent Shipments & Deployments -->
  <Section id="deployments" rule>
    <Container>
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <Eyebrow label="Live Verified Shipments" tone="yellow" />
          <h2 class="mt-2 text-3xl font-bold text-ink">Recent Production Deployments</h2>
        </div>

        <div class="mt-8 space-y-4">
          {
            LIVE_SYSTEM_METRICS.recentDeployments.map((dep) => (
              <div class="flex flex-col gap-4 rounded-2xl border border-line bg-paper p-5 sm:flex-row sm:items-center sm:justify-between shadow-sm">
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-bold text-ink">{dep.client}</h3>
                    <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
                      {dep.status}
                    </span>
                  </div>
                  <p class="mt-0.5 text-xs text-ink-dim">{dep.category} · {dep.date}</p>
                </div>
                <div class="flex items-center gap-3">
                  <div class="text-right">
                    <span class="font-feature text-lg font-bold text-accent">{dep.lighthouseMobile}/100</span>
                    <span class="block text-[10px] text-ink-dim">Mobile Lighthouse</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <!-- Interactive SME Grant & Project Calculator -->
  <SMEProjectCalculator />

  <!-- Conversion FAQ -->
  <Section rule class="bg-paper-dim/40">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="Direct & Scannable Answers" tone="blue" />
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink">
          Frequently Asked Questions
        </h2>
      </div>

      <div class="mx-auto mt-10 max-w-3xl space-y-4">
        {
          EXPRESS_FAQ.map((faq) => (
            <details class="group rounded-2xl border border-line bg-paper p-5 transition hover:border-line-hover open:border-accent open:bg-paper">
              <summary class="flex cursor-pointer items-center justify-between text-base font-semibold text-ink">
                <span>{faq.q}</span>
                <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-paper-dim text-ink transition-transform duration-200 group-open:rotate-180">
                  ↓
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink-dim">{faq.a}</p>
            </details>
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <p class="text-sm text-ink-dim">
          Have a custom question or ready to begin?
          <a
            href="https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I%20have%20a%20question%20about%20WSS%20Express."
            class="font-semibold text-accent-blue hover:underline"
          >
            Chat with us on WhatsApp
          </a>
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>

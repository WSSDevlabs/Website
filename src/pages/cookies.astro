---
import LegalLayout from '../components/legal/LegalLayout.astro';
import LegalIdentity from '../components/legal/LegalIdentity.astro';

const lastUpdated = new Date('2026-10-11');

const toc = [
  { id: 'short-version', label: 'The short version' },
  { id: 'what-runs', label: 'What runs on this site' },
  { id: 'no-banner', label: 'Why there is no cookie banner' },
  { id: 'control', label: 'Your choices' },
  { id: 'changes', label: 'Changes' }
];
---

<LegalLayout
  title="Cookie Policy"
  description="WSS DevLabs doesn't use tracking or advertising cookies. Our analytics are cookieless. Here is exactly what runs on this website."
  path="/cookies/"
  lastUpdated={lastUpdated}
  intro="We don't use tracking or advertising cookies. This page lists exactly what runs on this website, and it matches what the site actually does."
  toc={toc}
>
  <h2 id="short-version">The short version</h2>
  <ul>
    <li>We don't set any cookies of our own.</li>
    <li>Our visitor statistics are cookieless and anonymous.</li>
    <li>Nothing on this site follows you to other websites.</li>
  </ul>
  <LegalIdentity />

  <h2 id="what-runs">What runs on this site</h2>
  <table>
    <thead>
      <tr><th>Service</th><th>What it does</th><th>Cookies</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>Cloudflare (hosting and security)</td>
        <td>Delivers the site and blocks attacks and bots.</td>
        <td>May set strictly necessary security cookies, such as <code>__cf_bm</code>, to tell people from bots. They don't identify you.</td>
      </tr>
      <tr>
        <td>Cloudflare Web Analytics</td>
        <td>Counts page views, device types and countries, as anonymous totals.</td>
        <td>None. It's cookieless and doesn't track you across sites.</td>
      </tr>
      <tr>
        <td>Button and form statistics</td>
        <td>Counts clicks on our WhatsApp and quote buttons, and form submissions, so we know which pages help people reach us.</td>
        <td>None.</td>
      </tr>
      <tr>
        <td>Web3Forms</td>
        <td>Delivers our contact form to our inbox. Runs only when you press send.</td>
        <td>None.</td>
      </tr>
      <tr>
        <td>WhatsApp</td>
        <td>Opens a chat with us, only when you click a WhatsApp button.</td>
        <td>None on this site. WhatsApp's own policy applies once you're there.</td>
      </tr>
    </tbody>
  </table>
  <p>The site doesn't store anything in your browser's local storage either.</p>

  <h2 id="no-banner">Why there is no cookie banner</h2>
  <p>
    Cookie banners exist to ask permission for non-essential cookies. We don't use any, so there is nothing to ask permission for,
    and you get a calmer page. If we ever add something that needs your consent, we'll ask first and update this page.
  </p>

  <h2 id="control">Your choices</h2>
  <p>
    You can block or delete cookies in your browser settings at any time. The site works normally without them. For how we handle
    personal data, see our <a href="/privacy/">Privacy Notice</a>.
  </p>

  <h2 id="changes">Changes</h2>
  <p>We update this page whenever what runs on the site changes. The date at the top shows the latest version.</p>
</LegalLayout>

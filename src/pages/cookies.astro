---
import LegalLayout from '../components/legal/LegalLayout.astro';
import LegalSection from '../components/legal/LegalSection.astro';
import Email from '../components/ui/Email.astro';

const lastUpdated = new Date('2026-10-14');

const toc = [
  { id: 'what-are-cookies', label: '1. Cookies and similar tools' },
  { id: 'summary', label: '2. What this site uses' },
  { id: 'consent-banner', label: '3. Our consent banner' },
  { id: 'analytics', label: '4. Visit statistics' },
  { id: 'chat', label: '5. The chat assistant' },
  { id: 'essential', label: '6. Essential storage' },
  { id: 'third-party', label: '7. Other third-party content' },
  { id: 'your-choices', label: '8. Your choices' },
  { id: 'changes', label: '9. Changes' },
  { id: 'contact', label: '10. Contact' }
];

const items = [
  ['Your banner choice', 'Local storage, on this site', 'Remembers whether you clicked Allow or Reject, so we don\'t ask on every visit', 'Until you clear it'],
  ['Intro animation', 'Session storage, on this site', 'Shows the logo intro only once per visit', 'Until you close the tab'],
  ['Chat assistant (Botpress)', 'Local storage', 'Keeps your chat session so the conversation continues between pages', 'Until you clear it'],
  ['Visit statistics (Cloudflare Web Analytics)', 'No cookies, nothing stored on your device', 'Counts page views anonymously', 'Only after you click Allow'],
  ['Security (Cloudflare)', 'A cookie may be set if a visit looks automated', 'Protects the site from bots and attacks', 'Short-lived']
];
---

<LegalLayout
  title="Cookie Policy"
  description="Exactly what WSS DevLabs stores in your browser, what loads after you click Allow, and how to change your mind."
  path="/cookies/"
  icon="M21 12a9 9 0 11-9-9 3 3 0 003 3 3 3 0 003 3 3 3 0 003 3z M8.5 10.5h.01 M11 15h.01 M15 14h.01"
  accent="yellow"
  lastUpdated={lastUpdated}
  intro="A short, honest list: no advertising cookies, no cross-site tracking, and visit statistics only run if you click Allow."
  toc={toc}
>
  <LegalSection id="what-are-cookies" number="1" title="Cookies and similar tools">
    <p>
      Cookies are small files a website stores on your device. "Local storage" and "session storage" work in a similar way, but
      can only be read by this website. This policy covers all of them.
    </p>
  </LegalSection>

  <LegalSection id="summary" number="2" title="What this site uses">
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr><th>What</th><th>Where it's kept</th><th>Why</th><th>How long</th></tr>
        </thead>
        <tbody>
          {items.map(([what, where, why, howLong]) => <tr><td>{what}</td><td>{where}</td><td>{why}</td><td>{howLong}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>We don't use advertising cookies, and we don't track you across other websites.</p>
  </LegalSection>

  <LegalSection id="consent-banner" number="3" title="Our consent banner">
    <p>On your first visit, a banner asks you to Allow or Reject visit statistics.</p>
    <ul>
      <li><strong>Allow:</strong> we load Cloudflare Web Analytics and remember your choice.</li>
      <li><strong>Reject:</strong> statistics stay off, and we remember that choice so the banner doesn't keep coming back.</li>
      <li>Rejecting never affects your ability to browse, ask for a quote or use the chat assistant.</li>
    </ul>
  </LegalSection>

  <LegalSection id="analytics" number="4" title="Visit statistics">
    <p>
      Cloudflare Web Analytics counts page views without cookies, without storing anything on your device and without
      identifying you. It tells us which pages are useful, roughly how many people visit, and from which country and type of
      device. It runs only after you click Allow.
    </p>
  </LegalSection>

  <LegalSection id="chat" number="5" title="The chat assistant">
    <p>
      The chat bubble in the corner is an automated assistant run by Botpress. It loads on every page so you can start a chat
      any time, and keeps a session identifier in your browser's local storage so your conversation continues as you move between
      pages. Your messages are processed by Botpress only when you use the chat. It is an automated assistant: it can be wrong,
      and you can always ask for a person. Please don't share passwords or sensitive personal data in the chat.
    </p>
  </LegalSection>

  <LegalSection id="essential" number="6" title="Essential storage">
    <p>
      Remembering your banner choice and whether you've seen the intro animation is needed for the site to work the way you
      expect, so it doesn't need consent. Cloudflare, our host, may also set a short-lived security cookie if a visit looks like
      it comes from a bot.
    </p>
  </LegalSection>

  <LegalSection id="third-party" number="7" title="Other third-party content">
    <ul>
      <li><strong>Images</strong> on some pages load from Unsplash's servers.</li>
      <li><strong>The map</strong> on our contact page loads map tiles from OpenStreetMap.</li>
      <li><strong>Our contact form</strong> sends your enquiry through Web3Forms when you submit it.</li>
    </ul>
    <p>
      These services receive your IP address when they load, as any website you request content from does. None of them set
      cookies through this site.
    </p>
  </LegalSection>

  <LegalSection id="your-choices" number="8" title="Your choices">
    <ul>
      <li>To change your banner choice, clear this site's local storage in your browser settings; the banner returns on your next visit.</li>
      <li>You can block cookies and storage entirely in your browser. The site still works, though the chat may restart each time.</li>
      <li>Rejecting statistics never affects anything else on the site.</li>
    </ul>
  </LegalSection>

  <LegalSection id="changes" number="9" title="Changes">
    <p>We update this policy when the tools on our site change. The date at the top shows the latest version.</p>
  </LegalSection>

  <LegalSection id="contact" number="10" title="Contact">
    <p>Questions about this policy can be sent to <Email />. Our <a href="/privacy/">Privacy Notice</a> has the full details.</p>
  </LegalSection>
</LegalLayout>

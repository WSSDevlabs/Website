---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Disclosure from '../components/ui/Disclosure.astro';
import FaqList from '../components/ui/FaqList.astro';
import Icon from '../components/ui/Icon.astro';
import CaseStudies from '../components/sections/CaseStudies.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { AI_WHATSAPP, CUSTOM, formatRM } from '../data/catalog';
import { CUSTOM_FAQ } from '../data/faqs';
import { CUSTOM_STEPS } from '../data/process';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();

const builds = [
  {
    icon: 'document',
    title: 'Business systems',
    body: 'Approvals, scheduling, field work, multi-branch operations: systems shaped around how your business actually runs, when spreadsheets and WhatsApp groups stop coping.',
    price: `From ${formatRM(CUSTOM.build.from)}`,
    note: `Usually ${formatRM(CUSTOM.build.typicalLow)} to ${formatRM(CUSTOM.build.typicalHigh)}, fixed after discovery`
  },
  {
    icon: 'bolt',
    title: 'Automation and AI assistants',
    body: 'Practical automation: WhatsApp assistants, document and invoice handling, and reports that build themselves. Nothing experimental.',
    price: `WhatsApp assistant from ${formatRM(AI_WHATSAPP.setup)}`,
    note: 'Bigger automations get a fixed quote after discovery'
  },
  {
    icon: 'wrench',
    title: 'Taking over or fixing a system',
    body: "Your developer disappeared, or your system is slow, broken or insecure. A Rescue Audit tells you exactly what you have and whether to fix it or rebuild.",
    price: `Rescue Audit ${formatRM(CUSTOM.rescueAudit.price)}`,
    note: 'Credited toward the fix if you go ahead'
  }
] as const;
---

<BaseLayout
  title="Custom Software Builds for Malaysian SMEs"
  description={`When ready-made doesn't fit. Start with a Discovery Sprint (${formatRM(CUSTOM.discovery.price)}, credited to the build). Custom builds from ${formatRM(CUSTOM.build.from)}, at a fixed price, with full source code.`}
  path="/custom/"
  schema={[
    faqSchema(CUSTOM_FAQ),
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Custom', path: '/custom/' }
    ])
  ]}
>
  <!-- 1. Hero -->
  <section class="border-b border-line">
    <Container class="py-14 md:py-20">
      <h1 class="h-display max-w-3xl">When <span class="whitespace-nowrap">ready-made</span> doesn't fit.</h1>
      <p class="lead mt-5">
        Start with a Discovery Sprint ({formatRM(CUSTOM.discovery.price)}, credited to the build). Custom builds from{' '}
        {formatRM(CUSTOM.build.from)}, at a fixed price.
      </p>
      <a href="/contact/?need=custom" class="btn btn-primary btn-lg mt-8" data-track="quote_click">Get a fixed quote</a>
    </Container>
  </section>

  <!-- 2. What we build: three things only (audit 3.18) -->
  <section class="py-16 md:py-20">
    <Container>
      <h2 class="h-section">What we build</h2>
      <ul class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_1fr_1fr]">
        {
          builds.map((build, index) => (
            <li class:list={['flex flex-col rounded-2xl border p-6 sm:p-7', index === 0 ? 'border-ink bg-ink text-white' : 'border-line bg-white']}>
              <Icon name={build.icon} class:list={['h-8 w-8', index === 0 ? 'text-white' : 'text-accent']} />
              <h3 class:list={['mt-5 font-display text-2xl font-bold', index === 0 ? 'text-white' : 'text-ink']}>{build.title}</h3>
              <p class:list={['mt-3 flex-1', index === 0 ? 'text-white/85' : 'text-ink-dim']}>{build.body}</p>
              <p class:list={['price mt-6 text-xl', index === 0 && 'text-white']}>{build.price}</p>
              <p class:list={['text-sm', index === 0 ? 'text-white/85' : 'text-muted']}>{build.note}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 grid gap-x-10 md:grid-cols-2">
        <div class="border-t border-line py-4">
          <p class="font-semibold text-ink">Need a mobile app?</p>
          <p class="mt-1 text-ink-dim">
            From {formatRM(CUSTOM.mobileApp.from)}, scoped through a Discovery Sprint. App store fees (Google Play US$25 once, Apple
            US$99 a year) are paid by you, in your name, so you own the listing.
          </p>
        </div>
        <Disclosure summary="Do you need an app, or a mobile website?" class="border-t border-line py-2" summaryClass="py-2 font-semibold text-ink">
          <p class="text-ink-dim">
            If customers use it daily, offline, or with phone features like the camera, GPS or notifications, an app makes sense. If
            they visit now and then to read or enquire, a fast mobile website is cheaper and works for everyone, with nothing to
            download.
          </p>
        </Disclosure>
      </div>
    </Container>
  </section>

  <!-- 3. One case study, once it exists -->
  <CaseStudies offer="custom" title="A recent custom build" />

  <!-- 4. How it works: the full 8 steps, details collapsed (audit A6) -->
  <section class="bg-paper-dim py-16 md:py-20" id="process">
    <Container>
      <h2 class="h-section">How a custom build works</h2>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          CUSTOM_STEPS.map((step, index) => (
            <li class="card p-5">
              <span class="price text-sm text-ink-dim" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <Disclosure summary={step.title} summaryClass="py-1 text-left font-display text-lg font-semibold text-ink">
                <p class="text-sm text-ink-dim">{step.body}</p>
              </Disclosure>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <!-- 5. Prices and terms in full (audit 12.4 D) -->
  <section class="py-16 md:py-20" id="pricing">
    <Container>
      <h2 class="h-section">Prices and what they include</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <article class="card p-6">
          <h3 class="h-sub">Discovery Sprint</h3>
          <p class="price mt-2 text-3xl">{formatRM(CUSTOM.discovery.price)}</p>
          <p class="mt-1 text-sm text-ink-dim">
            Credited 100% to the build if you go ahead within {CUSTOM.discovery.creditWindowDays} days. {CUSTOM.discovery.timeline}.
          </p>
          <ul class="mt-5 list-disc space-y-1 pl-5 text-ink-dim">
            {CUSTOM.discovery.included.map((item) => <li>{item}</li>)}
          </ul>
          <p class="mt-4 text-ink">You keep every document, even if you don't build with us.</p>
        </article>
        <article class="card p-6">
          <h3 class="h-sub">Custom build</h3>
          <p class="price mt-2 text-3xl">From {formatRM(CUSTOM.build.from)}</p>
          <p class="mt-1 text-sm text-ink-dim">
            Usually {formatRM(CUSTOM.build.typicalLow)} to {formatRM(CUSTOM.build.typicalHigh)}. Fixed in discovery.
          </p>
          <ul class="mt-5 list-disc space-y-1 pl-5 text-ink-dim">
            <li>Design sign-off before any code</li>
            <li>A staging link and a short weekly update</li>
            <li>Testing on desktop and mobile, then your team's acceptance testing</li>
            <li>Deployment, full source code, documentation and credentials</li>
            <li>A 2-hour training session</li>
            <li>{CUSTOM.build.warrantyDays} days of free bug fixes</li>
          </ul>
          <p class="mt-4 text-sm text-ink-dim">Payment: {CUSTOM.build.payment} Timeline: {CUSTOM.build.timeline}</p>
          <p class="mt-2 text-sm text-ink-dim">
            Not included: hosting, third-party fees (SMS, maps, AI services), hardware, and new features after sign-off, which get a
            fixed-price change request first.
          </p>
        </article>
        <article class="card p-6">
          <h3 class="h-sub">Rescue Audit</h3>
          <p class="price mt-2 text-3xl">{formatRM(CUSTOM.rescueAudit.price)}</p>
          <p class="mt-1 text-sm text-ink-dim">Credited toward the fix if you go ahead. {CUSTOM.rescueAudit.timeline}.</p>
          <ul class="mt-5 list-disc space-y-1 pl-5 text-ink-dim">
            {CUSTOM.rescueAudit.included.map((item) => <li>{item}</li>)}
          </ul>
          <p class="mt-4 text-sm text-ink-dim">We only access your systems with your written authorisation, for the scope and dates you agree.</p>
        </article>
      </div>

      <div class="mt-14 grid gap-10 lg:grid-cols-2">
        <div>
          <h3 class="h-sub">Ready-made or custom?</h3>
          <div class="mt-4 overflow-hidden rounded-2xl border border-line">
            <table class="w-full border-collapse text-left text-sm sm:text-base">
              <caption class="sr-only">When to choose a ready-made system or a custom build</caption>
              <thead class="bg-paper-dim">
                <tr>
                  <th scope="col" class="p-4 font-semibold text-ink">Choose ready-made if...</th>
                  <th scope="col" class="p-4 font-semibold text-ink">Choose custom if...</th>
                </tr>
              </thead>
              <tbody class="text-ink-dim">
                <tr class="border-t border-line"><td class="p-4">Your process is common (POS, attendance, helpdesk)</td><td class="p-4">Your process is your competitive advantage</td></tr>
                <tr class="border-t border-line"><td class="p-4">You need it this week</td><td class="p-4">You can invest 6 to 12 weeks</td></tr>
                <tr class="border-t border-line"><td class="p-4">Your budget is under RM3,000</td><td class="p-4">Your budget is {formatRM(CUSTOM.build.from)} or more</td></tr>
                <tr class="border-t border-line"><td class="p-4">Small changes are enough</td><td class="p-4">It must connect to your existing systems</td></tr>
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-ink-dim">
            Tip: many clients start with a <a href="/systems/" class="link">ready-made system</a> and customise it. It's cheaper than
            starting from zero.
          </p>
        </div>
        <div>
          <h3 class="h-sub">Why pay for discovery?</h3>
          <p class="mt-4 text-ink-dim">
            Because a {formatRM(CUSTOM.discovery.price)} plan prevents a much bigger mistake. Unclear scope is the main reason software
            projects fail or run over budget: the client imagined one thing and the developer built another. Discovery turns your idea
            into a clear document you own and a fixed price you can trust. No surprises later.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- 6. FAQ -->
  <section class="bg-paper-dim py-16 md:py-20" id="faq">
    <Container narrow>
      <h2 class="h-section">Questions</h2>
      <FaqList items={CUSTOM_FAQ} class="mt-8" />
    </Container>
  </section>

  <FinalCTA title="Tell us what you need built." />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Differentiator from '../components/sections/Differentiator.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTABand from '../components/sections/CTABand.astro';
import { AI_WHATSAPP, CUSTOM, formatRM } from '../data/catalog';
import { CUSTOM_FAQ } from '../data/faqs';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();

const toneAccent: Record<string, string> = {
  red: 'bg-accent-red',
  blue: 'bg-accent-blue',
  yellow: 'bg-accent-yellow'
};

const builds = [
  {
    tone: 'blue',
    icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
    title: 'Business systems',
    body: 'Approvals, scheduling, field work and multi-branch operations, shaped around how your business actually runs. For when spreadsheets and WhatsApp groups stop coping: data gets lost, nobody knows the latest version, and reports take days.',
    price: `From ${formatRM(CUSTOM.build.from)}`,
    note: `Usually ${formatRM(CUSTOM.build.typicalLow)} to ${formatRM(CUSTOM.build.typicalHigh)}, fixed after discovery`,
    included: [
      'Design sign-off before any code is written',
      'A staging link so you can follow progress',
      'Testing with your own team before launch',
      'Full source code, documentation and logins'
    ]
  },
  {
    tone: 'red',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
    title: 'Automation and AI assistants',
    body: 'Practical automation that saves hours every week: a WhatsApp assistant that answers common questions, document and invoice handling, and reports that build themselves. Nothing experimental.',
    price: `WhatsApp assistant from ${formatRM(AI_WHATSAPP.setup)}`,
    note: `+ ${formatRM(AI_WHATSAPP.monthly)}/month. Bigger automations get a fixed quote after discovery`,
    included: [
      'Runs on your official WhatsApp Business number',
      'Trained on your own prices, FAQ and services',
      'Always says it is an assistant, and hands over to a person',
      'Never gives medical, legal or financial advice'
    ]
  },
  {
    tone: 'yellow',
    icon: 'M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z',
    title: 'Taking over or fixing a system',
    body: 'Your previous developer disappeared, or your system is slow, broken or insecure. A Rescue Audit tells you exactly what you have, what is risky, and whether to fix it or rebuild.',
    price: `Rescue Audit ${formatRM(CUSTOM.rescueAudit.price)}`,
    note: `Credited toward the fix if you go ahead. ${CUSTOM.rescueAudit.timeline}`,
    included: CUSTOM.rescueAudit.included
  }
];

/* What every custom build includes (shown in the six-card grid). */
const INCLUDED_PHASES = [
  {
    title: 'Discovery Sprint',
    items: [
      `Workshops: two 2-hour sessions to understand how the work flows today.`,
      'Requirements document: features, user roles and rules, written down.',
      'Clickable wireframe: the key screens, before anything is built.',
      'Fixed price: a quote, timeline and milestone plan you can trust.'
    ]
  },
  {
    title: 'Fixed Price, No Hourly Billing',
    items: [
      `Milestone payments: ${CUSTOM.build.payment.replace(' No hourly billing.', '')}`,
      'Change requests: anything new is quoted at a fixed price before work starts.',
      'No surprises: you never get a bill for work you did not approve.'
    ]
  },
  {
    title: 'Design Before Code',
    items: [
      'Design sign-off: you approve the screens before development starts.',
      'Built for phones: tested on desktop and mobile from the first screen.',
      'Plain language: no jargon in the screens your staff will use every day.'
    ]
  },
  {
    title: 'Progress You Can See',
    items: [
      'Staging link: follow the build as it happens, on a private address.',
      'Weekly update: a short video or message on what moved this week.',
      'One contact: you talk to the person building it, every time.'
    ]
  },
  {
    title: 'Tested Properly',
    items: [
      'Our testing: every feature checked on desktop and mobile.',
      'Your testing (UAT): your team tests it against a checklist before launch.',
      'Definition of done: every agreed feature works on staging and production.'
    ]
  },
  {
    title: 'Handover & Warranty',
    items: [
      'Everything handed over: full source code, documentation and logins.',
      'Training: a 2-hour session for your team, recorded.',
      `Warranty: ${CUSTOM.build.warrantyDays} days of free bug fixes, then an optional Care Plan.`
    ]
  }
];

const STEPS = [
  { n: 1, title: 'Discovery call', description: 'A free call about your goals, your current setup and your budget, before anything is scoped or quoted.' },
  { n: 2, title: 'Discovery Sprint', description: `Two workshops that turn the idea into a requirements document, a clickable wireframe and a fixed price (${formatRM(CUSTOM.discovery.price)}, credited to the build).` },
  { n: 3, title: 'Fixed quote', description: 'A written scope, timeline, milestones and fixed price for you to review, with no obligation.' },
  { n: 4, title: 'Contract & deposit', description: 'A signed agreement and the first payment lock in your start date and the agreed scope.' },
  { n: 5, title: 'Design sign-off', description: 'Wireframes first, then the screens, reviewed and approved by you before a single line of code is written.' },
  { n: 6, title: 'Build with a staging link', description: 'You follow real progress on a staging link, with a weekly update, so you can redirect early.' },
  { n: 7, title: 'Testing & your review', description: 'We test across devices, then your team tests it against a checklist before anything is called finished.' },
  { n: 8, title: 'Launch & handover', description: 'Deployment to production, training, and full source code, credentials and documentation handed over.' }
];

const readyMadeIf = [
  'Your process is common: sales, attendance, visitors, a helpdesk',
  'You need it this week',
  'Your budget is under RM3,000',
  'Small changes are enough'
];
const customIf = [
  'Your process is your competitive advantage',
  'You can invest 6 to 12 weeks',
  `Your budget is ${formatRM(CUSTOM.build.from)} or more`,
  'It has to connect to systems you already use'
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom software development',
      provider: { '@id': `${siteUrl}#organization` },
      areaServed: { '@type': 'Country', name: 'Malaysia' },
      offers: [
        { '@type': 'Offer', name: 'Discovery Sprint', price: String(CUSTOM.discovery.price), priceCurrency: 'MYR' },
        { '@type': 'Offer', name: 'Rescue Audit', price: String(CUSTOM.rescueAudit.price), priceCurrency: 'MYR' }
      ]
    },
    faqSchema(CUSTOM_FAQ),
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Custom', path: '/custom/' }
    ])
  ]
};
---

<BaseLayout
  title="Custom Software for Malaysian SMEs, at a Fixed Price"
  description={`When ready-made doesn't fit. Start with a Discovery Sprint (${formatRM(CUSTOM.discovery.price)}, credited to the build). Custom builds from ${formatRM(CUSTOM.build.from)}, at a fixed price, with full source code.`}
  path="/custom/"
  schema={schema}
>
  <!-- ── Hero ───────────────────────────────────────────────── -->
  <section class="relative overflow-hidden">
    <Container class="relative pt-10 pb-10 md:pt-36 md:pb-14">
      <h1 class="h-display mt-4 max-w-3xl" data-split>When ready-made <span class="badge-highlight">doesn't fit.</span></h1>
      <p class="body-lead mt-5 max-w-2xl">
        Start with a Discovery Sprint ({formatRM(CUSTOM.discovery.price)}, credited to the build). Custom builds from{' '}
        {formatRM(CUSTOM.build.from)}, at a fixed price, with the full source code handed over.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/contact/?package=custom"
          data-magnetic
          data-track="quote_click"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white shadow-[0_8px_20px_-8px_rgb(217_45_32/0.5)] transition-all duration-300 [transition-timing-function:var(--ease-out-expo)] hover:-translate-y-0.5 hover:bg-accent-dim"
        >
          Get a fixed quote
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href="/systems/"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-6 py-3.5 text-sm font-semibold text-ink shadow-card transition-all hover:-translate-y-0.5 hover:border-ink/25 hover:shadow-card-hover"
        >
          See ready-made systems first
        </a>
      </div>
    </Container>
    <div class="hairline absolute inset-x-0 bottom-0" aria-hidden="true" />
  </section>

  <!-- ── What we build: three things only ───────────────────── -->
  <Section rule class="bg-paper-dim">
    <Container>
      <div class="mx-auto max-w-2xl text-center mb-12">
        <h2 class="h-section">What we build</h2>
        <p class="mt-4 text-ink-dim">Three kinds of custom work, each with a published starting price.</p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        {
          builds.map((build) => (
            <div class="flex flex-col rounded-3xl border border-line bg-white p-8 shadow-card">
              <span class:list={['flex h-12 w-12 items-center justify-center rounded-2xl text-white', toneAccent[build.tone]]}>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={build.icon} />
                </svg>
              </span>
              <h3 class="mt-5 text-xl font-bold tracking-tight text-ink">{build.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-dim">{build.body}</p>

              <p class="mono-label mt-6 text-ink-dim">What's Included</p>
              <ul class="mt-3 space-y-2.5">
                {build.included.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-dim">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>

              <div class="mt-6 border-t border-line pt-4">
                <p class="text-lg font-black text-ink">{build.price}</p>
                <p class="mt-0.5 text-xs text-ink-dim">{build.note}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-line bg-white p-5 shadow-sm">
          <p class="font-semibold text-ink">Need a mobile app?</p>
          <p class="mt-1 text-sm leading-relaxed text-ink-dim">
            From {formatRM(CUSTOM.mobileApp.from)}, scoped through a Discovery Sprint. App store fees (Google Play US$25 once,
            Apple US$99 a year) are paid by you, in your name, so you own the listing.
          </p>
        </div>
        <details class="card group p-5 open:pb-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
            Do you need an app, or a mobile website?
            <svg class="h-4 w-4 shrink-0 text-ink-dim transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-dim">
            If customers use it daily, offline, or with phone features like the camera, GPS or notifications, an app makes sense.
            If they visit now and then to read or enquire, a fast mobile website is cheaper and works for everyone, with nothing to
            download.
          </p>
        </details>
      </div>
    </Container>
  </Section>

  <!-- ── What every custom build includes ───────────────────── -->
  <section class="py-16 md:py-24 bg-paper">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="h-section" data-split>What every custom build includes</h2>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          INCLUDED_PHASES.map((phase, i) => (
            <div class="rounded-3xl border border-line bg-white p-6 shadow-card">
              <span class="font-feature text-2xl font-black text-accent">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 text-base font-bold text-ink">{phase.title}</h3>
              <ul class="mt-4 space-y-2.5">
                {phase.items.map((item) => {
                  const [head, ...rest] = item.split(': ');
                  const desc = rest.join(': ');
                  return (
                    <li class="text-xs leading-relaxed text-ink-dim">
                      <strong class="text-ink">{head}:</strong> {desc}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- ── Eight-step scroll timeline: matte-dark, alternating, line fills as you scroll ── -->
  <section id="process" class="relative overflow-hidden bg-charcoal py-16 md:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.05] [background-image:radial-gradient(circle,white_1px,transparent_1px)] [background-size:26px_26px]"
      aria-hidden="true"
    />
    <Container class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="h-display-xl !text-[clamp(2.1rem,1.5rem+2vw,3.1rem)] text-white" data-split>
          How a custom build works
        </h2>
        <p class="mt-4 leading-relaxed text-white/60">
          From the first call to handover, here is exactly what happens and when.
        </p>
      </div>

      <div class="relative mt-16" data-timeline-track>
        <!-- Base rule + scroll-scrubbed fill, desktop -->
        <div class="absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 md:block" aria-hidden="true">
          <div class="absolute inset-0 bg-white/10" />
          <div class="absolute inset-0 bg-accent" style="transform-origin: top; transform: scaleY(0);" data-timeline-fill />
        </div>
        <!-- Mobile rule -->
        <div class="absolute left-4 top-0 h-full w-px bg-white/10 md:hidden" aria-hidden="true" />

        <ol class="space-y-10 md:space-y-4">
          {
            STEPS.map((s, i) => (
              <li class="relative grid items-start gap-6 pl-12 md:grid-cols-[1fr_2.5rem_1fr] md:gap-x-8 md:pl-0">
                <span
                  class="stat-num absolute left-4 top-0 z-10 flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full bg-accent text-xs text-white ring-4 ring-charcoal md:relative md:left-auto md:top-auto md:col-start-2 md:mx-auto md:-translate-x-0"
                >
                  {s.n}
                </span>

                {i % 2 === 0 ? (
                  <>
                    <div
                      class="rounded-3xl border border-white/10 bg-charcoal-soft p-6 md:col-start-1 md:row-start-1"
                      data-reveal="tilt3d"
                    >
                      <h3 class="text-lg font-semibold tracking-tight text-white">{s.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-white/60">{s.description}</p>
                    </div>
                    <div class="hidden md:col-start-3 md:row-start-1 md:block" aria-hidden="true" />
                  </>
                ) : (
                  <>
                    <div class="hidden md:col-start-1 md:row-start-1 md:block" aria-hidden="true" />
                    <div
                      class="rounded-3xl border border-white/10 bg-charcoal-soft p-6 md:col-start-3 md:row-start-1"
                      data-reveal="tilt3d"
                    >
                      <h3 class="text-lg font-semibold tracking-tight text-white">{s.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-white/60">{s.description}</p>
                    </div>
                  </>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </section>

  <!-- ── Ready-made or custom? + the Discovery Sprint ───────── -->
  <Section rule class="bg-paper-dim/40">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="h-section">Ready-made or custom?</h2>
        <p class="mt-4 text-sm leading-relaxed text-ink-dim">
          Many clients start with a ready-made system and customise it later. It's cheaper than starting from zero.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-line bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-dim/70">Choose ready-made if</p>
          <ul class="mt-3 space-y-2">
            {readyMadeIf.map((item) => <li class="text-sm text-ink-dim">· {item}</li>)}
          </ul>
          <a href="/systems/" class="link-underline mt-4 text-sm font-semibold text-accent">See ready-made systems</a>
        </div>
        <div class="rounded-2xl border border-line bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wide text-accent">Choose custom if</p>
          <ul class="mt-3 space-y-2">
            {customIf.map((item) => <li class="text-sm font-medium text-ink">· {item}</li>)}
          </ul>
        </div>
      </div>

      <div class="mt-10 flex flex-col items-center gap-6 rounded-3xl bg-charcoal p-8 text-center sm:flex-row sm:justify-between sm:text-left">
        <div>
          <p class="mono-label text-white/60">Start here</p>
          <p class="mt-1 text-2xl font-black text-white">Discovery Sprint, {formatRM(CUSTOM.discovery.price)}</p>
          <p class="mt-1 max-w-xl text-sm text-white/60">
            {CUSTOM.discovery.timeline}. Credited in full to the build if you go ahead within {CUSTOM.discovery.creditWindowDays} days,
            and you keep every document either way. A {formatRM(CUSTOM.discovery.price)} plan prevents a much more expensive mistake.
          </p>
        </div>
        <a
          href="/contact/?package=discovery"
          data-track="quote_click"
          class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-ink shadow-float transition-all duration-300 hover:-translate-y-0.5"
        >
          Book a Discovery Sprint
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </Container>
  </Section>

  <!-- ── Why work with us ───────────────────────────────────── -->
  <Differentiator />

  <!-- ── FAQ ─────────────────────────────────────────────────── -->
  <FAQ title="Questions about custom builds" items={CUSTOM_FAQ} />

  <!-- ── CTA band ────────────────────────────────────────────── -->
  <CTABand
    title="Have something in mind?"
    subtitle="Tell us what you're trying to fix. We reply within one business day, and the Discovery Sprint turns it into a fixed price."
    ctaLabel="Get a fixed quote"
    ctaHref="/contact/?package=custom"
  />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTimelineFill() {
    const track = document.querySelector<HTMLElement>('[data-timeline-track]');
    const fill = document.querySelector<HTMLElement>('[data-timeline-fill]');
    if (!track || !fill) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.to(fill, {
      scaleY: 1,
      ease: 'none',
      scrollTrigger: { trigger: track, start: 'top 65%', end: 'bottom 65%', scrub: true }
    });
  }

  initTimelineFill();
  document.addEventListener('astro:page-load', initTimelineFill);
</script>

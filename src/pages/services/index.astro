---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import LatestProjects from '../../components/sections/LatestProjects.astro';
import Differentiator from '../../components/sections/Differentiator.astro';
import CTABand from '../../components/sections/CTABand.astro';

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteUrl).toString() },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', siteUrl).toString() }
  ]
};
---

<BaseLayout
  title="Services: WSS DevLabs"
  description="Web development, mobile apps, custom systems, AI, branding, marketing, redesigns, grants, and business launches. Whatever the digital need, one team handles it."
  path="/services"
  schema={schema}
>

  <ServicesGrid />

  <LatestProjects />
  <Differentiator />
  <CTABand
    title="Ready to start your project?"
    subtitle="Tell us what you're building, and we'll respond within one business day with a fixed-price proposal."
  />
</BaseLayout>

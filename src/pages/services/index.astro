---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import { SERVICE_CATEGORIES } from '../../data/serviceCategories';

const u = (id: string) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=900&h=700&q=75`;
const IMAGES: Record<string, string> = {
  'artificial-intelligence-automation': u('1555255707-c07966088b7b'),
  'iot-solutions-infrastructure': u('1581091226825-a6a2a5aee158'),
  'web-software-app-development': u('1517180102446-f3ece451e9d8'),
  'digital-design-media-marketing': u('1512941937669-90a1b58e7e9c'),
  'digital-consulting-solutions': u('1551288049-bebda4e38f71')
};

const reasons = [
  {
    title: 'You always know who to talk to',
    body: 'One friendly team, from the first chat to long after launch. You get straight answers from the people actually building your project, not a different voice every week.'
  },
  {
    title: 'We start by listening',
    body: 'You explain the problem your way, in plain words. We ask questions until we really understand your business, then shape the solution around it.'
  },
  {
    title: 'No surprises along the way',
    body: 'You see progress in small steps, and you know the scope, timeline and price before we start. If something changes, you hear it from us first.'
  },
  {
    title: 'Help that stays after launch',
    body: 'When your project goes live, we do not wave goodbye. We are a message away when you have a question, need a change, or want to grow.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', Astro.site).toString() }
  ]
};
---

<BaseLayout
  title="Services: WSS DevLabs"
  description="AI and automation, IoT, systems, web and mobile apps, design and marketing, and consulting. One team handles whatever the digital need."
  path="/services"
  schema={schema}
>
  <!-- Intro: statement + key areas -->
  <section class="pb-16 pt-32 md:pb-24 md:pt-44" data-tight>
    <Container>
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
        <div>
          <h2 class="font-display text-[clamp(1.6rem,1.15rem+1.8vw,2.4rem)] font-medium leading-[1.18] tracking-[-0.025em] text-ink">
            Technology that is built around your site, your data and your team, then supported after launch.
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-dim">
            Every business has its own story, and the right technology starts with understanding it. Here is what we can build alongside you, from the first idea to the day it quietly runs on its own.
          </p>
        </div>

        <!-- one column, on the right; the dark highlight moves down the list on its own -->
        <ul class="flex flex-col gap-3 lg:ml-auto lg:w-full lg:max-w-md" data-pill-cycle>
          {
            SERVICE_CATEGORIES.map((category, i) => (
              <li>
                <a
                  href={`/services/${category.slug}`}
                  data-pill
                  class:list={['flex w-full items-center gap-2.5 rounded-full px-6 py-3.5 text-sm font-semibold transition-all duration-500', i === 0 ? 'bg-ink text-white' : 'bg-paper-dim text-ink']}
                >
                  <span class="h-2 w-2 shrink-0 rounded-full bg-current opacity-60" aria-hidden="true"></span>
                  {category.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  <!-- Service categories -->
  <section class="rounded-t-[2.75rem] bg-paper-dim py-20 md:py-28">
    <Container>
      <SectionHead
        centered
        title="Tailored services to build, connect and grow"
      />
      <div class="acc mt-14" data-acc>
        {
          SERVICE_CATEGORIES.map((category, i) => (
            <a
              href={`/services/${category.slug}`}
              class="acc-card"
              data-acc-card
              data-active={i === 0 ? 'true' : 'false'}
              data-tone={i % 5}
            >
              <h3 class="acc-title">{category.title}</h3>

              <div class="acc-body">
                <p class="acc-text">{category.description}</p>
                <div class="acc-img">
                  <img src={IMAGES[category.slug]} alt="" loading="lazy" width="900" height="700" />
                </div>
              </div>

              <span class="acc-foot">
                <span class="acc-more">Read more</span>
                <span class="acc-arrow">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5 19.5 4.5m0 0H8.25m11.25 0v11.25" /></svg>
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Why choose us (dark, rounded top over the previous band) -->
  <section class="relative -mt-10 rounded-t-[2.75rem] bg-charcoal-soft pb-20 pt-28 text-white md:-mt-14 md:pb-28 md:pt-36">
    <Container>
      <SectionHead dark title="Working with us feels like working with a friend who happens to know technology." />
      <!-- Infographic row: oversized coloured numerals that rise out of a soft shadow line, then title, text and an icon -->
      <ol class="why-row mt-16 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-4" data-why-row>
        {
          reasons.map((reason, i) => (
            <li class="why-item group flex flex-col items-center text-center" style={`--i:${i}; --c:${['#ff6a5a', '#7aa2ff', '#f2c14e', '#4ad8a0'][i]}`}>
              <div class="why-num-wrap relative h-[5.6rem] w-full overflow-hidden">
                <span class="why-num font-feature font-black leading-none">0{i + 1}</span>
                <span class="why-shadow" aria-hidden="true"></span>
              </div>
              <h3 class="mt-6 text-base font-bold tracking-tight text-white">{reason.title}</h3>
              <p class="mt-3 max-w-[16rem] flex-1 text-sm leading-relaxed text-white/60">{reason.body}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <!-- Closing: a gentle signpost instead of the dark call-to-action band -->
  <section class="py-6 md:py-10" data-tight>
    <Container>
      <div class="rounded-[2.25rem] bg-tint p-8 md:p-12">
        <div class="max-w-2xl">
          <h2 class="font-display text-[clamp(1.6rem,1.15rem+1.8vw,2.4rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
            Not sure where to start? That is perfectly fine.
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-dim">
            Most people are not. Tell us a little about your day, and we will point you to the right place.
          </p>
        </div>
        <div class="mt-8 grid gap-3 md:grid-cols-3">
          {
            [
              { text: 'Something keeps going wrong on my site', href: '/solutions' },
              { text: 'I need a website or an app', href: '/services/web-software-app-development' },
              { text: 'I just want to understand my options', href: '/resources#consult' }
            ].map((option) => (
              <a href={option.href} class="group flex items-center justify-between gap-4 rounded-[1.5rem] bg-white p-5 text-sm font-semibold text-ink transition-transform duration-300 hover:-translate-y-0.5">
                {option.text}
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink text-white transition-transform group-hover:translate-x-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  // The highlighted pill moves through the five categories on its own; hovering a pill pauses it
  function initPillCycle() {
    document.querySelectorAll<HTMLElement>('[data-pill-cycle]').forEach((list) => {
      if (list.dataset.bound) return;
      list.dataset.bound = '1';
      const pills = Array.from(list.querySelectorAll<HTMLElement>('[data-pill]'));
      if (pills.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const on = ['bg-ink', 'text-white'];
      const off = ['bg-paper-dim', 'text-ink'];
      let current = 0;
      let paused = false;
      const show = (index: number) => {
        pills.forEach((pill, i) => {
          pill.classList.remove(...(i === index ? off : on));
          pill.classList.add(...(i === index ? on : off));
        });
        current = index;
      };
      list.addEventListener('mouseenter', () => (paused = true));
      list.addEventListener('mouseleave', () => (paused = false));
      pills.forEach((pill, i) => pill.addEventListener('mouseenter', () => show(i)));
      const timer = window.setInterval(() => {
        if (!document.body.contains(list)) return window.clearInterval(timer);
        if (!paused) show((current + 1) % pills.length);
      }, 2200);
    });
  }
  document.addEventListener('astro:page-load', initPillCycle);
</script>

<style is:global>
  /* One row of cards; the active card grows wide and shows its picture, the others stay compact. */
  .acc {
    display: flex;
    gap: 1rem;
    height: 27rem;
  }
  .acc-card {
    position: relative;
    display: flex;
    min-width: 0;
    flex: 1 1 0;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: 1.75rem;
    padding: 1.6rem;
    color: #121214;
    background: linear-gradient(160deg, #f4f4f1 0%, #e4e5e0 100%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.7);
    transition:
      flex-grow 0.75s cubic-bezier(0.65, 0, 0.35, 1),
      background 0.5s;
  }
  .acc-card[data-tone='1'] { background: linear-gradient(160deg, #eef2fc 0%, #dde6f8 100%); }
  .acc-card[data-tone='2'] { background: linear-gradient(160deg, #f6f1ea 0%, #e8e0d4 100%); }
  .acc-card[data-tone='3'] { background: linear-gradient(160deg, #eef1ec 0%, #dde3d8 100%); }
  .acc-card[data-tone='4'] { background: linear-gradient(160deg, #f2eff3 0%, #e3dde6 100%); }
  .acc-card[data-active='true'] {
    flex-grow: 3.6;
    background: #ffffff;
    box-shadow: 0 30px 60px -34px rgb(0 0 0 / 0.35), inset 0 0 0 1px rgb(0 0 0 / 0.05);
  }

  .acc-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 14rem;
  }

  /* picture + text appear only on the active card; fixed inner width so the text never re-wraps while the card grows */
  .acc-body {
    position: absolute;
    left: 1.6rem;
    right: 1.6rem;
    top: 6.2rem;
    bottom: 4.6rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 1.4rem;
    opacity: 0;
    transform: translateX(1.2rem);
    pointer-events: none;
    transition: opacity 0.3s, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .acc-card[data-active='true'] .acc-body {
    opacity: 1;
    transform: translateX(0);
    transition-delay: 0.35s;
  }
  .acc-text {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #4a4b4f;
    overflow: hidden;
  }
  .acc-img {
    overflow: hidden;
    border-radius: 1.25rem;
    background: #19191b;
  }
  .acc-img img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.8s;
  }
  .acc-card:hover .acc-img img { transform: scale(1.05); }

  .acc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    position: relative;
    z-index: 1;
  }
  .acc-more { font-size: 0.8rem; font-weight: 600; }
  .acc-arrow {
    display: flex;
    height: 2.4rem;
    width: 2.4rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgb(18 18 20 / 0.12);
    color: #121214;
    transition: background 0.4s, color 0.4s, transform 0.4s;
  }
  .acc-card[data-active='true'] .acc-arrow {
    background: #121214;
    color: #fff;
  }
  .acc-card:hover .acc-arrow { transform: translate(2px, -2px); }

  @media (max-width: 1023px) {
    .acc { flex-direction: column; height: auto; }
    .acc-card, .acc-card[data-active='true'] { flex: none; padding-bottom: 1.2rem; }
    .acc-body, .acc-card[data-active='true'] .acc-body {
      position: static;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      grid-template-columns: 1fr;
      margin: 1rem 0 1.4rem;
      transition: none;
    }
    .acc-img { aspect-ratio: 16 / 9; }
    .acc-card:not([data-active='true']) { background: linear-gradient(160deg, #f4f4f1 0%, #e4e5e0 100%); }
    .acc-card[data-active='true'] { background: #fff; }
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-card, .acc-body, .acc-img img, .acc-arrow { transition-duration: 0.01ms; transition-delay: 0s; }
  }
</style>

<script>
  function initAccordion() {
    document.querySelectorAll<HTMLElement>('[data-acc]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-acc-card]'));
      const desktop = () => window.matchMedia('(min-width: 1024px)').matches;
      let timer = 0;
      const activate = (card: HTMLElement) => {
        cards.forEach((c) => (c.dataset.active = c === card ? 'true' : 'false'));
      };
      // every 2.5 seconds the next card opens by itself; hovering or tapping a card opens that one and restarts the 2.5 seconds
      const restart = () => {
        window.clearInterval(timer);
        timer = window.setInterval(() => {
          if (!document.body.contains(root)) return window.clearInterval(timer);
          if (document.hidden || !desktop()) return;
          const index = cards.findIndex((c) => c.dataset.active === 'true');
          activate(cards[(index + 1) % cards.length]);
        }, 2500);
      };
      cards.forEach((card) => {
        card.addEventListener('mouseenter', () => {
          if (!desktop()) return;
          activate(card);
          restart();
        });
        card.addEventListener('focus', () => {
          if (!desktop()) return;
          activate(card);
          restart();
        });
        // first tap opens a compact card; a tap on the open one follows the link
        card.addEventListener('click', (event) => {
          if (desktop() && card.dataset.active !== 'true') {
            event.preventDefault();
            activate(card);
            restart();
          }
        });
      });
      restart();
    });
  }
  document.addEventListener('astro:page-load', initAccordion);
</script>

<style is:global>
  /* Big numerals: coloured, half hidden behind a soft shadow line, rising into view when the row scrolls on screen */
  .why-num {
    position: absolute;
    left: 50%;
    top: 0;
    font-size: clamp(5rem, 4rem + 3vw, 7.2rem);
    color: var(--c);
    background: linear-gradient(180deg, var(--c) 0%, color-mix(in srgb, var(--c) 40%, transparent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transform: translate(-50%, 110%);
    opacity: 0;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.7s;
    transition-delay: calc(var(--i) * 0.14s);
  }
  .why-row.is-in .why-num {
    transform: translate(-50%, 0);
    opacity: 1;
  }
  .why-shadow {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 0;
    height: 1.4rem;
    background: radial-gradient(60% 100% at 50% 100%, rgb(0 0 0 / 0.55), transparent 70%);
    filter: blur(3px);
  }
  .why-item {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .why-item:hover {
    transform: translateY(-6px);
  }
  .why-item h3,
  .why-item p {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.7s, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.35s + var(--i) * 0.14s);
  }
  .why-row.is-in .why-item h3,
  .why-row.is-in .why-item p {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .why-num,
    .why-item h3,
    .why-item p {
      transition: none;
      opacity: 1;
      transform: none;
    }
    .why-num { transform: translate(-50%, 0); }
  }
</style>

<script>
  function initWhyRow() {
    document.querySelectorAll<HTMLElement>('[data-why-row]').forEach((row) => {
      if (row.dataset.bound) return;
      row.dataset.bound = '1';
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            row.classList.add('is-in');
            io.disconnect();
          }
        },
        { threshold: 0.3 }
      );
      io.observe(row);
    });
  }
  document.addEventListener('astro:page-load', initWhyRow);
</script>

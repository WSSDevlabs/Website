---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import { BESPOKE_SERVICES, GOVERNMENT_GRANTS, TOOLS_WE_TRUST } from '../../data/bespoke';
import QuoteForm from '../../components/sections/QuoteForm.astro';

const bespokeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Bespoke Enterprise Software Engineering',
  provider: {
    '@type': 'Organization',
    name: 'WSS DevLabs'
  },
  areaServed: {
    '@type': 'Country',
    name: 'Malaysia'
  },
  description:
    'Custom ERP/CRM systems, AI/LLM RAG pipelines, and cross-platform mobile apps aligned with 2026 Malaysian Government Grants (PMKS Madani, MDEC MDSG-MFG).'
};
---

<BaseLayout
  title="Bespoke Enterprise Engineering: Custom ERP, AI & Grant-Matched Builds | WSS DevLabs"
  description="Custom enterprise engineering (RM 4,500 – RM 15,000) tailored to Malaysian SMEs. Private RAG pipelines, internal operations tools, mobile apps, and 50%–70% Government Grant funding matching."
  path="/services/bespoke"
  schema={bespokeSchema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-ink py-20 text-white md:py-28">
    <div class="grain-overlay" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 top-0 h-96 w-96 rounded-full bg-accent/20 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-accent-yellow/15 blur-3xl"
      aria-hidden="true"
    ></div>

    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1 text-xs font-mono uppercase tracking-wider text-accent-yellow-vivid">
          <span class="h-2 w-2 rounded-full bg-accent-yellow-vivid animate-pulse"></span>
          Enterprise Ceiling: RM 4,500 – RM 15,000 · 2026 Grant Aligned
        </div>
        <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl">
          Bespoke Enterprise Engineering <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-accent via-red-400 to-accent-yellow-vivid bg-clip-text text-transparent">
            Built Around Your Real Operations.
          </span>
        </h1>
        <p class="mt-6 text-base leading-relaxed text-white/70 sm:text-lg">
          When off-the-shelf templates and SaaS subscriptions can no longer handle your company's scale, we architect custom ERPs, internal CRMs, AI/LLM pipelines, and native mobile apps with guaranteed delivery and grant subsidies.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <Button
            href="https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I'd%20like%20to%20consult%20on%20a%20Bespoke%20Enterprise%20System."
            variant="primary"
            class="shadow-lg shadow-accent/30"
          >
            Consult with Lead Architect
          </Button>
          <a
            href="#grants"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
          >
            Explore Grant Subsidies (Up to 70%)
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- High-Ticket Offerings Grid -->
  <Section rule>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Eyebrow label="High-Value Solutions" tone="red" />
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">
          Bespoke Systems, Transparent Pricing
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          We establish clear scope boundaries and transparent investment ceilings (RM 4,500 – RM 15,000) so your company avoids open-ended agency billing.
        </p>
      </div>

      <div class="mt-12 space-y-8">
        {
          BESPOKE_SERVICES.map((service, idx) => (
            <div class="rounded-3xl border border-line bg-paper p-8 shadow-sm transition hover:border-line-hover md:p-10">
              <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr]">
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="font-feature text-xs font-bold text-accent">0{idx + 1}</span>
                    <span class="rounded-full border border-line bg-paper-dim px-3 py-0.5 text-xs font-semibold text-ink">
                      {service.title}
                    </span>
                    {service.grantEligible && (
                      <span class="rounded-full bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700">
                        MADANI Grant Eligible (50% Subsidy)
                      </span>
                    )}
                  </div>

                  <h3 class="mt-3 text-2xl font-bold text-ink">{service.tagline}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink-dim">{service.description}</p>

                  <div class="mt-6">
                    <p class="text-xs font-bold uppercase tracking-wider text-ink">Core Deliverables:</p>
                    <ul class="mt-3 grid gap-2 sm:grid-cols-2 text-xs text-ink-dim">
                      {service.deliverables.map((deliv) => (
                        <li class="flex items-start gap-2">
                          <span class="text-accent font-bold">✓</span>
                          <span>{deliv}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="mt-6 flex flex-wrap gap-1.5 pt-4 border-t border-line/60">
                    {service.techStack.map((tech) => (
                      <span class="rounded-md bg-paper-deep/60 px-2.5 py-1 text-[11px] font-mono text-ink-dim">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Price & Booking box -->
                <div class="flex flex-col justify-between rounded-2xl border border-line bg-paper-dim/50 p-6 text-center lg:p-8">
                  <div>
                    <p class="text-xs font-mono uppercase tracking-wider text-ink-dim">Investment Range</p>
                    <p class="mt-2 font-feature text-3xl font-extrabold text-accent md:text-4xl">
                      {service.priceRange}
                    </p>
                    <p class="mt-2 text-xs text-ink-dim leading-relaxed">
                      Fixed milestone quotes provided within 24 hours of technical discovery.
                    </p>
                  </div>

                  <div class="mt-6">
                    <a
                      href={`https://wa.me/601127205895?text=${encodeURIComponent(`Hi WSS DevLabs! I'd like to consult on ${service.title} (${service.priceRange}).`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-ink px-5 py-3 text-xs font-semibold text-white shadow-md transition hover:bg-ink/85"
                    >
                      <span>Scope This Project</span>
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- The Government Grant Moat Section -->
  <Section id="grants" rule class="bg-paper-dim/30">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <Eyebrow label="Government Funding Moat" tone="yellow" />
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">
          Subsidize Up to 70% of Your Custom Build.
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          WSS Dev Labs structures all technical proposals, architecture diagrams, and milestones to align directly with 2026 Malaysian Government digitalization priorities.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          GOVERNMENT_GRANTS.map((grant) => (
            <div class="flex flex-col justify-between rounded-2xl border border-line bg-paper p-6 shadow-sm">
              <div>
                <span class="rounded-full bg-accent/10 px-2.5 py-0.5 font-mono text-[10px] font-bold text-accent uppercase">
                  {grant.code}
                </span>
                <h3 class="mt-3 text-lg font-bold text-ink">{grant.name}</h3>
                <p class="mt-2 text-xs font-bold text-emerald-700 bg-emerald-500/10 rounded-lg p-2">
                  {grant.matching}
                </p>

                <div class="mt-4 space-y-2 text-xs text-ink-dim">
                  <p><strong>Focus:</strong> {grant.focus}</p>
                  <p><strong>Eligibility:</strong> {grant.eligibility}</p>
                  <p class="border-t border-line/60 pt-2 text-[11px]">
                    <strong>How WSS Helps:</strong> {grant.howWssHelps}
                  </p>
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-line/60">
                <a
                  href={`https://wa.me/601127205895?text=${encodeURIComponent(`Hi WSS DevLabs! I'd like to check our SME grant eligibility for ${grant.name}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full items-center justify-center gap-1.5 rounded-xl border border-line bg-paper-dim px-3.5 py-2 text-center text-xs font-semibold text-ink transition hover:bg-paper-deep"
                >
                  Check Grant Eligibility
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Tools We Trust Stack Grid -->
  <Section rule>
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <Eyebrow label="Tools We Trust" tone="blue" />
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink">
          The Engineering Stack Behind Our Systems
        </h2>
        <p class="mt-3 text-sm text-ink-dim">
          No generic drag-and-drop builders. We craft software with battle-tested programming languages and enterprise infrastructure.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-line bg-paper p-5">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-accent">Core Stack</h3>
          <div class="mt-4 space-y-3">
            {TOOLS_WE_TRUST.core.map((item) => (
              <div>
                <p class="text-xs font-bold text-ink">{item.name}</p>
                <p class="text-[11px] text-ink-dim">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-paper p-5">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-accent-blue">Extended Tooling</h3>
          <div class="mt-4 space-y-3">
            {TOOLS_WE_TRUST.extended.map((item) => (
              <div>
                <p class="text-xs font-bold text-ink">{item.name}</p>
                <p class="text-[11px] text-ink-dim">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-paper p-5">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-accent-yellow">Enterprise Languages</h3>
          <div class="mt-4 space-y-3">
            {TOOLS_WE_TRUST.enterprise.map((item) => (
              <div>
                <p class="text-xs font-bold text-ink">{item.name}</p>
                <p class="text-[11px] text-ink-dim">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-paper p-5">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-emerald-700">Infrastructure</h3>
          <div class="mt-4 space-y-3">
            {TOOLS_WE_TRUST.infrastructure.map((item) => (
              <div>
                <p class="text-xs font-bold text-ink">{item.name}</p>
                <p class="text-[11px] text-ink-dim">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Quote and Discovery Form -->
  <QuoteForm />
</BaseLayout>

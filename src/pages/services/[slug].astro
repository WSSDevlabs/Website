---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import GrantSolutions from '../../components/sections/GrantSolutions.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import CTABand from '../../components/sections/CTABand.astro';
import { SERVICE_CATEGORIES, getServicesForCategory } from '../../data/serviceCategories';
import { TESTIMONIALS } from '../../data/testimonials';
import { GROUP_TONE, TONE_TEXT_CLASS, TONE_BORDER_CLASS, TONE_BG_SOFT_CLASS } from '../../lib/tone';

export function getStaticPaths() {
  return SERVICE_CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const services = getServicesForCategory(category);
const otherCategories = SERVICE_CATEGORIES.filter((c) => c.slug !== category.slug);
const isSpotlight = services.length === 1;

const serviceImages: Record<string, [string, string]> = {
  'web-development': [
    'https://images.unsplash.com/photo-1517180102446-f3ece451e9d8?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'mobile-app-development': [
    'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1512428813834-c702c7702b78?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'custom-systems': [
    'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'ai-development': [
    'https://images.unsplash.com/photo-1555255707-c07966088b7b?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'ui-ux-design': [
    'https://images.unsplash.com/photo-1587440871875-191322ee64b0?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1559028006-448665bd7c7f?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'maintenance-support': [
    'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'digital-marketing': [
    'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1533750349088-cd871a92f312?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'business-growth': [
    'https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'branding-services': [
    'https://images.unsplash.com/photo-1626785774573-4b799315345d?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1611162617213-7d7a39e9b1d7?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'product-photoshoot-marketing': [
    'https://images.unsplash.com/photo-1542038784456-1ea8e935640e?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'media-creation': [
    'https://images.unsplash.com/photo-1492619375914-88005aa9e8fb?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1601506521937-0121a7fc2a6b?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'ui-ux-system-redesign': [
    'https://images.unsplash.com/photo-1587440871875-191322ee64b0?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1559028006-448665bd7c7f?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'grant-government-project-support': [
    'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'business-startup-package': [
    'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=700&h=460&q=80',
  ],
  'iot-development': [
    'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1400&h=800&q=80',
    'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=700&h=460&q=80',
  ],
};

const toneAccent: Record<string, string> = {
  red: 'bg-accent-red',
  blue: 'bg-accent-blue',
  yellow: 'bg-accent-yellow',
  green: 'bg-accent-green',
  neutral: 'bg-ink-dim'
};

type PriceCell = boolean | string;
type PricingTable = {
  title: string;
  tiers: { name: string; price: string }[];
  rows: { label: string; values: PriceCell[] }[];
  renewal?: string[];
  hasCta: boolean;
  popularIndex?: number;
};

const websiteDesignPricingTables: PricingTable[] = [
  {
    title: 'SME Website Design Packages',
    tiers: [
      { name: '1 Page', price: 'RM 1,799' },
      { name: '5 Pages', price: 'RM 2,599' },
      { name: '5+ Pages', price: 'RM 2,799' },
      { name: '10 Pages', price: 'RM 3,299' },
      { name: '10+ Pages', price: 'RM 3,499' }
    ],
    rows: [
      { label: 'Domain', values: [true, true, true, true, true] },
      { label: 'Web Pages Design', values: ['1 page', '5 pages', '5 pages', '10 pages', '10 pages'] },
      { label: 'Web Storage', values: ['10 GB', '10 GB', '10 GB', '10 GB', '10 GB'] },
      { label: 'Email Users', values: ['20 users', '20 users', '20 users', '20 users', '20 users'] },
      { label: 'Mobile Responsive', values: [true, true, true, true, true] },
      { label: 'Products Listing', values: [false, false, true, false, true] },
      { label: 'Products Upload', values: [false, false, '20 products', false, '20 products'] },
      { label: 'Animated Banner', values: ['1', '2', '2', '3', '3'] },
      { label: 'Content Management System', values: [true, true, true, true, true] },
      { label: 'Ownership & Access', values: [true, true, true, true, true] },
      { label: 'SSL Certificate', values: [true, true, true, true, true] },
      { label: 'Stock Photos', values: [true, true, true, true, true] },
      { label: 'Technical Support', values: [true, true, true, true, true] },
      { label: 'SEO Friendly', values: [true, true, true, true, true] }
    ],
    renewal: ['RM 549.00', 'RM 549.00', 'RM 549.00', 'RM 549.00', 'RM 549.00'],
    hasCta: false
  },
  {
    title: 'Corporate Website Design Packages',
    tiers: [
      { name: 'Corporate', price: 'RM 4,299' },
      { name: 'Advance', price: 'RM 5,299' },
      { name: 'Premium', price: 'RM 6,399' },
      { name: 'Champion', price: 'RM 7,399' }
    ],
    rows: [
      { label: 'Domain', values: [true, true, true, true] },
      { label: 'Web Pages Design', values: ['15 pages', '20 pages', '25 pages', '30 pages'] },
      { label: 'Web Storage', values: ['20 GB', '20 GB', '30 GB', '30 GB'] },
      { label: 'Email Users', values: ['35 users', '35 users', 'Unlimited', 'Unlimited'] },
      { label: 'Mobile Responsive', values: [true, true, true, true] },
      { label: 'Customisable Design & Layout', values: [true, true, true, true] },
      { label: 'Mega Menu', values: [true, true, true, true] },
      { label: 'Products Upload', values: ['30', '30', '50', '50'] },
      { label: 'Animated Banner', values: ['3', '5', '5', '5'] },
      { label: 'Content Management System', values: [true, true, true, true] },
      { label: 'Ownership & Access', values: [true, true, true, true] },
      { label: 'SSL Certificate', values: [true, true, true, true] },
      { label: 'Stock Photos', values: [true, true, true, true] },
      { label: 'Technical Support', values: [true, true, true, true] },
      { label: 'SEO Friendly', values: [true, true, true, true] }
    ],
    renewal: ['RM 659.00', 'RM 659.00', 'RM 769.00', 'RM 769.00'],
    hasCta: true
  },
  {
    title: 'UI & UX Design',
    tiers: [
      { name: 'Seed', price: 'RM 1,500' },
      { name: 'Grow', price: 'RM 4,500' },
      { name: 'Bloom', price: 'RM 8,500' },
      { name: 'Ultimate', price: 'RM 13,000' }
    ],
    rows: [
      { label: 'Number of Screens', values: ['5', '15', '30', '50'] },
      { label: 'User Journey Mapping', values: [true, true, true, true] },
      { label: 'Revisions', values: ['3', '3', '5', '5'] },
      { label: 'Responsive Design', values: [false, false, false, false] },
      { label: 'Technology', values: ['Figma', 'Figma', 'Figma', 'Figma'] }
    ],
    hasCta: true,
    popularIndex: 1
  }
];
---

<ServiceLayout
  title={`${category.title}: WSS DevLabs`}
  description={category.description}
  path={`/services/${category.slug}`}
  serviceName={category.title}
>
  <!-- ── Hero ───────────────────────────────────────────────── -->
  <section class="relative overflow-hidden">
    <Container class="relative pt-10 pb-10 md:pt-36 md:pb-14">
      <h1 class="h-display mt-4 max-w-3xl" data-split>{category.title}</h1>
      <p class="body-lead mt-5 max-w-2xl">{category.description}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/contact"
          data-magnetic
          class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white shadow-[0_8px_20px_-8px_rgb(217_45_32/0.5)] transition-all duration-300 [transition-timing-function:var(--ease-out-expo)] hover:-translate-y-0.5 hover:bg-accent-dim"
        >
          Start a Project
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href="/services"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-6 py-3.5 text-sm font-semibold text-ink shadow-card transition-all hover:-translate-y-0.5 hover:border-ink/25 hover:shadow-card-hover"
        >
          All Services
        </a>
      </div>

    </Container>
    <div class="hairline absolute inset-x-0 bottom-0" aria-hidden="true" />
  </section>

  {
    isSpotlight ? (
      /* Single-service spotlight layout */
      services.map((service) => {
        const tone = GROUP_TONE[service.group];
        const [heroImg, secondImg] = serviceImages[service.slug] ?? serviceImages['web-development'];
        return (
          <Fragment>
            <Section rule>
              <Container>
                <div id={service.slug} class="scroll-mt-28 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
                  <div>
                    <p class:list={['mono-label', TONE_TEXT_CLASS[tone]]}>{service.group}</p>
                    <h2 class="h-section mt-3" data-split>{service.title}</h2>
                    <p class="mt-4 leading-relaxed text-ink-dim">{service.valueProp}</p>
                    <div class="hairline my-6" aria-hidden="true" />
                    <p class="leading-relaxed text-ink-dim">{service.problem}</p>

                    {service.pricingFrom && (
                      <div class="mt-8 flex items-center gap-4 rounded-2xl border border-line bg-paper p-5 shadow-card w-fit">
                        <span class:list={['flex h-10 w-10 items-center justify-center rounded-xl', toneAccent[tone]]}>
                          <svg class="h-4.5 w-4.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                          </svg>
                        </span>
                        <div>
                          <p class="mono-label text-ink-dim">Pricing From</p>
                          <p class="stat-num text-xl leading-none text-ink">{service.pricingFrom}</p>
                        </div>
                      </div>
                    )}
                  </div>

                  <div class="relative overflow-hidden rounded-3xl border border-line shadow-card">
                    <img
                      src={heroImg}
                      alt={service.title}
                      class="h-72 w-full scale-110 object-cover lg:h-96"
                      loading="lazy"
                      width="1400"
                      height="800"
                      data-parallax="8"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-ink/35 via-transparent to-transparent" aria-hidden="true" />
                  </div>
                </div>
              </Container>
            </Section>

            <Section rule class="bg-paper-dim">
              <Container>
                <div class="grid gap-10 lg:grid-cols-2">
                  <div>
                    <p class="mono-label text-ink-dim">What's Included</p>
                    <ul class="mt-5 space-y-3">
                      {service.deliverables.map((item) => (
                        <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-dim">
                          <span class:list={['mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg', toneAccent[tone]]}>
                            <svg class="h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                          </span>
                          {item}
                        </li>
                      ))}
                    </ul>

                    <div class="mt-8 flex flex-wrap gap-2.5">
                      {service.tools.map((tool) => (
                        <span class="rounded-full border border-line bg-paper px-4 py-2 text-xs font-medium text-ink shadow-card">
                          {tool}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div>
                    <p class="mono-label text-ink-dim">Our Approach</p>
                    <div class="relative mt-5 space-y-6 border-l-2 border-line pl-6">
                      {service.approach.map((step, i) => {
                        const [head, ...rest] = step.split(':');
                        const title = rest.length ? head.trim() : step;
                        const desc = rest.length ? rest.join(':').trim() : '';
                        return (
                          <div class="relative">
                            <span class:list={['absolute -left-[1.95rem] flex h-6 w-6 items-center justify-center rounded-full text-[11px] font-bold text-white', toneAccent[tone]]}>
                              {i + 1}
                            </span>
                            <h4 class="font-semibold tracking-tight text-ink">{title}</h4>
                            {desc && <p class="mt-1 text-sm leading-relaxed text-ink-dim">{desc}</p>}
                          </div>
                        );
                      })}
                    </div>

                    <div class="mt-8 overflow-hidden rounded-3xl border border-line shadow-card">
                      <img src={secondImg} alt="" class="h-40 w-full scale-110 object-cover" loading="lazy" width="700" height="460" data-parallax="7" />
                    </div>
                  </div>
                </div>

                {service.pricingFrom && (
                  <div class:list={['mt-10 flex flex-col items-start justify-between gap-6 rounded-3xl p-8 sm:flex-row sm:items-center', toneAccent[tone]]}>
                    <div>
                      <p class="mono-label text-white/70">Pricing From</p>
                      <p class="stat-num mt-2 text-3xl text-white">{service.pricingFrom}</p>
                    </div>
                    <a
                      href="/contact"
                      class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-ink shadow-float transition-all duration-300 [transition-timing-function:var(--ease-out-expo)] hover:-translate-y-0.5"
                    >
                      Get a Quote
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                  </div>
                )}

                {service.faq.length > 0 && (
                  <div class="mt-10">
                    <p class="mono-label text-ink-dim">FAQ</p>
                    <div class="mt-5 space-y-3">
                      {service.faq.map((f) => (
                        <details class="card group p-5 open:pb-5">
                          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
                            {f.question}
                            <svg class="h-4 w-4 shrink-0 text-ink-dim transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                          </summary>
                          <p class="mt-3 text-sm leading-relaxed text-ink-dim">{f.answer}</p>
                        </details>
                      ))}
                    </div>
                  </div>
                )}
              </Container>
            </Section>

            {service.slug === 'grant-government-project-support' && <GrantSolutions />}
          </Fragment>
        );
      })
    ) : (
      /* Multi-service grid layout */
      <Section rule class="bg-paper-dim">
        <Container>
          <div class:list={['grid gap-6 items-start', services.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-2']} data-stagger>
            {services.map((service) => {
              const tone = GROUP_TONE[service.group];
              const [heroImg] = serviceImages[service.slug] ?? serviceImages['web-development'];
              return (
                <div id={service.slug} data-stagger-child class:list={['scroll-mt-28 flex flex-col overflow-hidden rounded-3xl border bg-paper shadow-card', TONE_BORDER_CLASS[tone]]}>
                  <div class="relative h-40 overflow-hidden">
                    <img src={heroImg} alt={service.title} class="h-full w-full object-cover" loading="lazy" width="1400" height="800" />
                    <div class="absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-transparent" aria-hidden="true" />
                    {service.pricingFrom && (
                      <span class="absolute bottom-3 right-3 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-ink shadow-sm backdrop-blur-sm">
                        From {service.pricingFrom}
                      </span>
                    )}
                  </div>

                  <div class="flex flex-1 flex-col p-7">
                    <p class:list={['mono-label', TONE_TEXT_CLASS[tone]]}>{service.group}</p>
                    <h2 class="mt-2 text-xl font-bold tracking-tight text-ink">{service.title}</h2>
                    <p class="mt-3 text-sm leading-relaxed text-ink-dim">{service.valueProp}</p>

                    <ul class="mt-5 space-y-2">
                      {service.deliverables.slice(0, 4).map((item) => (
                        <li class="flex items-start gap-2.5 text-sm text-ink-dim">
                          <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                          </svg>
                          {item}
                        </li>
                      ))}
                    </ul>

                    {service.tools.length === 1 && service.tools[0].length > 24 ? (
                      <p class:list={['mt-5 rounded-xl px-4 py-3 text-xs leading-relaxed', TONE_BG_SOFT_CLASS[tone], TONE_TEXT_CLASS[tone]]}>
                        {service.tools[0]}
                      </p>
                    ) : (
                      <div class="mt-5 flex flex-wrap gap-1.5">
                        {service.tools.slice(0, 4).map((tool) => (
                          <span class:list={['rounded-full px-3 py-1 text-[11px] font-medium', TONE_BG_SOFT_CLASS[tone], TONE_TEXT_CLASS[tone]]}>
                            {tool}
                          </span>
                        ))}
                      </div>
                    )}

                    {service.faq.length > 0 && (
                      <div class="mt-5 space-y-2">
                        {service.faq.map((f) => (
                          <details class="group rounded-xl border border-line bg-paper-dim/60 p-3.5">
                            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-ink">
                              {f.question}
                              <svg class="h-3.5 w-3.5 shrink-0 text-ink-dim transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                              </svg>
                            </summary>
                            <p class="mt-2 text-xs leading-relaxed text-ink-dim">{f.answer}</p>
                          </details>
                        ))}
                      </div>
                    )}

                    {category.slug !== 'web-software-app-development' && (
                      <a
                        href="/contact"
                        class:list={['mt-6 inline-flex items-center justify-center gap-1.5 rounded-full py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5', toneAccent[tone]]}
                      >
                        Get a Quote
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                      </a>
                    )}

                    {service.slug === 'grant-government-project-support' && (
                      <p class="mt-3 text-center text-[11px] text-ink-dim">
                        See grant-matching detail below ↓
                      </p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </Container>
      </Section>
    )
  }

  {
    category.slug === 'web-software-app-development' && (
      <Fragment>
        {websiteDesignPricingTables.map((table) => (
          <Section rule>
            <Container>
              <div class="mx-auto max-w-2xl text-center mb-10">
                <h2 class="h-section">{table.title}</h2>
              </div>

              <div class="overflow-x-auto rounded-3xl border border-line shadow-card">
                <table class="w-full min-w-[820px] border-collapse bg-white text-sm">
                  <thead>
                    <tr>
                      <th class="w-56 bg-charcoal p-5 text-left align-bottom text-sm font-bold text-white">
                        {table.title}
                      </th>
                      {table.tiers.map((tier, i) => {
                        const isPopular = (table.popularIndex ?? table.tiers.length - 1) === i;
                        return (
                          <th
                            class:list={[
                              'relative border-l border-line p-5 text-center align-bottom font-bold',
                              isPopular ? 'bg-accent/10 text-accent' : 'bg-paper-dim text-ink'
                            ]}
                          >
                            {isPopular && (
                              <span class="absolute right-2 top-2 rounded-full bg-accent px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-white">
                                Popular
                              </span>
                            )}
                            {tier.name}
                          </th>
                        );
                      })}
                    </tr>
                    <tr>
                      <td class="bg-charcoal" />
                      {table.tiers.map((tier, i) => {
                        const isPopular = (table.popularIndex ?? table.tiers.length - 1) === i;
                        return (
                          <td
                            class:list={[
                              'border-l border-line p-4 text-center',
                              isPopular ? 'bg-accent text-white' : 'bg-paper-dim/60 text-ink'
                            ]}
                          >
                            <p class="text-xl font-black">{tier.price}</p>
                            <p class:list={['mt-0.5 text-[11px]', isPopular ? 'text-white/70' : 'text-ink-dim']}>
                              Subject to 8% SST
                            </p>
                          </td>
                        );
                      })}
                    </tr>
                  </thead>
                  <tbody>
                    {table.rows.map((row, ri) => (
                      <tr class:list={[ri % 2 === 1 && 'bg-paper-dim/40']}>
                        <td class="bg-charcoal p-4 text-sm font-semibold text-white">{row.label}</td>
                        {row.values.map((val) => (
                          <td class="border-l border-line p-4 text-center text-sm text-ink-dim">
                            {val === true && (
                              <svg class="mx-auto h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                              </svg>
                            )}
                            {val === false && (
                              <svg class="mx-auto h-4 w-4 text-ink-dim/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                              </svg>
                            )}
                            {typeof val === 'string' && val}
                          </td>
                        ))}
                      </tr>
                    ))}

                    {table.renewal && (
                      <tr class="border-t-2 border-line bg-paper-dim/60">
                        <td class="bg-charcoal p-4 text-sm font-semibold text-white">Subsequent Yearly Renewal</td>
                        {table.renewal.map((price) => (
                          <td class="border-l border-line p-4 text-center">
                            <p class="text-sm font-bold text-ink">{price}</p>
                            <p class="text-[10px] text-ink-dim">Subject to 8% SST</p>
                          </td>
                        ))}
                      </tr>
                    )}

                    {table.hasCta && (
                      <tr class="bg-paper">
                        <td class="bg-charcoal p-4" />
                        {table.tiers.map((tier) => (
                          <td class="border-l border-line p-4 text-center">
                            <a
                              href={`https://wa.me/601127205895?text=${encodeURIComponent(`Hi WSS DevLabs, I'd like to sign up for the ${tier.name} website design package.`)}`}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center justify-center rounded-full bg-accent px-5 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-accent-dim"
                            >
                              Sign Up
                            </a>
                          </td>
                        ))}
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </Container>
          </Section>
        ))}
      </Fragment>
    )
  }

  {services.some((s) => s.slug === 'grant-government-project-support') && !isSpotlight && <GrantSolutions />}

  <!-- ── Testimonials ───────────────────────────────────────── -->
  <Testimonials testimonials={TESTIMONIALS} />

  <!-- ── Explore other categories ────────────────────────────── -->
  <Section rule class:list={[isSpotlight ? undefined : 'bg-paper']}>
    <Container>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="mono-label text-accent">Keep Exploring</p>
          <h2 class="h-section mt-3" data-split>Other services you may need</h2>
        </div>
        <a
          href="/services"
          class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-accent-blue transition-colors hover:opacity-80"
        >
          View all services
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          otherCategories.map((other) => (
            <a href={`/services/${other.slug}`} data-stagger-child class="card card-lift spotlight-card group block p-6">
              <p class="mono-label text-accent">{other.tagline}</p>
              <h3 class="mt-4 font-semibold tracking-tight text-ink transition-colors group-hover:text-accent">
                {other.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-dim">{other.description}</p>
            </a>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ── CTA band ────────────────────────────────────────────── -->
  <CTABand
    title={`Ready to start your ${category.title} project?`}
    subtitle="Tell us what you're building, and we'll respond within one business day with a fixed-price proposal."
  />
</ServiceLayout>

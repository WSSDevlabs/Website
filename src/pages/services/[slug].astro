const toneAccent: Record<string, string> = {
  red: 'bg-accent-red',
  blue: 'bg-accent-blue',
  yellow: 'bg-accent-yellow',
  green: 'bg-accent-green',
  neutral: 'bg-ink-dim'
};

type PriceCell = boolean | string;
type PricingTable = {
  title: string;
  tiers: { name: string; price: string }[];
  rows: { label: string; values: PriceCell[] }[];
  renewal?: string[];
  hasCta: boolean;
  popularIndex?: number;
};

const websiteDesignPricingTables: PricingTable[] = [
  {
    title: 'SME Website Design Packages',
    tiers: [
      { name: '1 Page', price: 'RM 549' },
      { name: '5 Pages', price: 'RM 999' },
      { name: '10 Pages', price: 'RM 1,399' }
    ],
    rows: [
      { label: 'Domain', values: [true, true, true] },
      { label: 'Web Pages Design', values: ['1 page', '5 pages', '10 pages'] },
      { label: 'Web Storage', values: ['10 GB', '10 GB', '10 GB'] },
      { label: 'Email Users', values: ['20 users', '20 users', '20 users'] },
      { label: 'Mobile Responsive', values: [true, true, true] },
      { label: 'Animated Banner', values: ['1', '2', '3'] },
      { label: 'Content Management System', values: [true, true, true] },
      { label: 'Ownership & Access', values: [true, true, true] },
      { label: 'SSL Certificate', values: [true, true, true] },
      { label: 'Stock Photos', values: [true, true, true] },
      { label: 'Technical Support', values: [true, true, true] },
      { label: 'SEO Friendly', values: [true, true, true] }
    ],
    renewal: ['RM 549.00', 'RM 549.00', 'RM 549.00'],
    hasCta: false,
    popularIndex: 1
  },
  {
    title: 'Corporate Website Design Packages',
    tiers: [
      { name: 'Corporate', price: 'RM 2,599' },
      { name: 'Advance', price: 'RM 3,599' },
      { name: 'Premium', price: 'RM 4,599' }
    ],
    rows: [
      { label: 'Domain', values: [true, true, true] },
      { label: 'Web Pages Design', values: ['10 pages', '15 pages', '20 pages and more'] },
      { label: 'Add more pages anytime (within the 1-year contract)', values: [true, true, true] },
      { label: 'Web Storage', values: ['20 GB', '30 GB', '30 GB'] },
      { label: 'Email Users', values: ['35 users', '35 users', 'Unlimited'] },
      { label: 'Mobile Responsive', values: [true, true, true] },
      { label: 'Customisable Design & Layout', values: [true, true, true] },
      { label: 'Mega Menu', values: [true, true, true] },
      { label: 'Products Upload', values: ['30', '50', '50'] },
      { label: 'Animated Banner', values: ['3', '5', '5'] },
      { label: 'Content Management System', values: [true, true, true] },
      { label: 'Ownership & Access', values: [true, true, true] },
      { label: 'SSL Certificate', values: [true, true, true] },
      { label: 'Stock Photos', values: [true, true, true] },
      { label: 'Technical Support', values: [true, true, true] },
      { label: 'SEO Friendly', values: [true, true, true] }
    ],
    renewal: ['RM 659.00', 'RM 659.00', 'RM 769.00'],
    hasCta: true,
    popularIndex: 1
  },
  {
    title: 'UI & UX Design',
    tiers: [

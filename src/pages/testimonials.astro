---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { TESTIMONIALS } from '../data/testimonials';

const allTestimonials = TESTIMONIALS;

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const partnerProjects = allProjects.filter((p) => p.data.featured).slice(0, 4);
---

<BaseLayout
  title="Testimonials: WSS DevLabs"
  description="Real feedback from founders, operators, and marketing leads who have worked with WSS DevLabs."
  path="/testimonials"
>
  <!-- Reviews carousel -->
  <section class="border-b border-line">
    <Container class="pt-28 pb-12 md:pt-36 md:pb-16">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-xl">
          <p class="mono-label text-ink-dim">What people say about us</p>
          <h1 class="h-display mt-3 !text-[clamp(2rem,1.3rem+2.6vw,3.2rem)]" data-split>Reviews from our clients</h1>
          <p class="mt-4 leading-relaxed text-ink-dim">
            Real feedback from founders, operators, and marketing leads who've worked with WSS
            DevLabs on real projects.
          </p>
        </div>
        {
          allTestimonials.length > 0 && (
            <div class="flex shrink-0 gap-2">
              <button
                type="button"
                aria-label="Previous reviews"
                data-t-prev
                class="flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-ink shadow-card transition-colors hover:bg-ink hover:text-white"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                </svg>
              </button>
              <button
                type="button"
                aria-label="Next reviews"
                data-t-next
                class="flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-ink shadow-card transition-colors hover:bg-ink hover:text-white"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          )
        }
      </div>

      {
        allTestimonials.length > 0 ? (
          <div class="mt-12 mask-fade-x -mx-6 px-6 md:-mx-10 md:px-10">
            <div
              class="flex gap-6 overflow-x-auto pb-2 snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
              data-t-track
            >
              {
                allTestimonials.map((t) => (
                  <div class="tilt-card card w-[300px] shrink-0 snap-start overflow-hidden !rounded-3xl p-0 sm:w-[340px]" data-reveal="tilt3d">
                    <div class="relative h-56 overflow-hidden bg-charcoal">
                      <div class="grid-pattern absolute inset-0 opacity-15" aria-hidden="true"></div>
                      <div class="absolute inset-0 flex items-center justify-center">
                        <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/10 text-2xl font-bold text-white ring-1 ring-white/20">
                          {t.author.charAt(0)}
                        </span>
                      </div>
                      <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-transparent" aria-hidden="true"></div>
                      <div class="absolute left-4 top-4 flex gap-0.5">
                        {Array.from({ length: t.rating ?? 5 }).map(() => (
                          <svg class="h-3.5 w-3.5 text-accent-yellow" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" /></svg>
                        ))}
                      </div>
                      <p class="absolute bottom-4 left-4 right-4 font-semibold text-white">{t.author}</p>
                    </div>
                    <div class="flex flex-col p-6">
                      <p class="text-sm leading-relaxed text-ink-dim">&ldquo;{t.quote}&rdquo;</p>
                      <p class="mt-4 text-xs font-semibold text-ink-dim">{t.role}{t.company ? `, ${t.company}` : ''}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        ) : (
          <div class="mt-12 rounded-3xl border border-line bg-paper-dim p-10 text-center">
            <p class="font-semibold text-ink">We're just getting started collecting client reviews.</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-dim">
              Check out <a href="/work" class="font-semibold text-accent hover:underline">completed projects</a> in
              the meantime, or be one of the first to leave one below.
            </p>
          </div>
        )
      }

      <div class="mt-12 flex flex-wrap items-center justify-center gap-4 border-t border-line pt-10 text-center">
        <a
          href="/contact"
          data-magnetic
          class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-white shadow-[0_8px_20px_-8px_rgb(217_45_32/0.5)] transition-all hover:-translate-y-0.5 hover:bg-accent-dim"
        >
          Start a Project
        </a>
        <button
          type="button"
          id="open-review-modal"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-7 py-3.5 text-sm font-semibold text-ink shadow-card transition-all hover:-translate-y-0.5 hover:border-ink/25"
        >
          Leave a review
        </button>
      </div>
    </Container>
  </section>

  <!-- Special Partnership Program -->
  <section class="border-b border-line bg-paper-dim">
    <Container class="py-14 md:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="mono-label text-accent">Special Partnership Program</p>
        <h2 class="mt-2 text-3xl font-bold text-ink">Projects under our partnership program</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          Businesses in this program get a lower rate in exchange for letting us feature their project
          here as live proof of our work. It's a fair trade: they save on cost, we get to show real
          results.
        </p>
      </div>

      {
        partnerProjects.length > 0 ? (
          <Fragment>
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
              {partnerProjects.map((project) => (
                <a href={`/work/${project.id}`} data-stagger-child class="tilt-card card card-lift group overflow-hidden !rounded-3xl p-0">
                  <div class="relative h-40 overflow-hidden">
                    <Image
                      src={project.data.heroImage}
                      alt={project.data.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      width={400}
                      height={260}
                    />
                  </div>
                  <div class="p-5">
                    <p class="text-sm font-bold text-ink transition-colors group-hover:text-accent">{project.data.title}</p>
                    <p class="mt-1 text-xs text-ink-dim">{project.data.client}</p>
                  </div>
                </a>
              ))}
            </div>
            <div class="mt-8 text-center">
              <a href="/work" class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-6 py-3 text-sm font-semibold text-ink shadow-card transition-all hover:-translate-y-0.5 hover:border-accent/40">
                View More
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
          </Fragment>
        ) : (
          <div class="mt-10 rounded-3xl border border-line bg-paper p-10 text-center">
            <p class="font-semibold text-ink">No partnership projects live yet, you could be the first.</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-dim">
              If you're open to us featuring your project here, ask about the partnership rate when you{' '}
              <a href="/contact" class="font-semibold text-accent hover:underline">get in touch</a>.
            </p>
          </div>
        )
      }
    </Container>
  </section>

  <!-- Leave a review modal -->
  <div id="review-modal" class="fixed inset-0 z-[100] hidden items-start justify-center overflow-y-auto bg-ink/60 p-4 py-10 backdrop-blur-sm md:items-center" role="dialog" aria-modal="true" aria-labelledby="review-modal-title">
    <div class="relative w-full max-w-md rounded-3xl bg-paper p-6 shadow-2xl md:p-8">
      <button type="button" id="review-modal-close" aria-label="Close" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-dim transition-colors hover:bg-paper-dim hover:text-ink">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
      <h2 id="review-modal-title" class="text-lg font-bold text-ink">Leave a review</h2>
      <p class="mt-1.5 text-sm text-ink-dim">Tell us about your experience working with WSS DevLabs.</p>

      <form id="review-form" class="mt-6 space-y-4" novalidate>
        <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="New client review submission" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <div>
          <label for="rv-name" class="mb-1.5 block text-xs font-semibold text-ink">Your Name</label>
          <input id="rv-name" name="name" type="text" required placeholder="Full name"
            class="w-full rounded-xl border border-line bg-paper-dim px-4 py-2.5 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/25" />
        </div>
        <div>
          <label for="rv-company" class="mb-1.5 block text-xs font-semibold text-ink">Company (optional)</label>
          <input id="rv-company" name="company" type="text" placeholder="Your company"
            class="w-full rounded-xl border border-line bg-paper-dim px-4 py-2.5 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/25" />
        </div>
        <div>
          <label for="rv-rating" class="mb-1.5 block text-xs font-semibold text-ink">Rating</label>
          <select id="rv-rating" name="rating" class="w-full rounded-xl border border-line bg-paper-dim px-4 py-2.5 text-sm text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/25">
            <option value="5">5 - Excellent</option>
            <option value="4">4 - Good</option>
            <option value="3">3 - Average</option>
            <option value="2">2 - Below average</option>
            <option value="1">1 - Poor</option>
          </select>
        </div>
        <div>
          <label for="rv-review" class="mb-1.5 block text-xs font-semibold text-ink">Your Review</label>
          <textarea id="rv-review" name="review" rows="4" required placeholder="How was your experience?"
            class="w-full resize-none rounded-xl border border-line bg-paper-dim px-4 py-2.5 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/25"></textarea>
        </div>

        <button id="review-submit" type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-[0_8px_20px_-8px_rgb(217_45_32/0.5)] transition-all hover:-translate-y-0.5 hover:bg-accent-dim">
          <span id="review-submit-label">Submit Review</span>
        </button>

        <p id="review-status" role="status" aria-live="polite" class="text-center text-sm"></p>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  function initTestimonialCarousel() {
    const track = document.querySelector<HTMLElement>('[data-t-track]');
    if (!track || track.dataset.bound) return;
    track.dataset.bound = '1';

    const prev = document.querySelector<HTMLButtonElement>('[data-t-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-t-next]');
    const step = () => (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? 320;

    prev?.addEventListener('click', () => track.scrollBy({ left: -(step() + 24), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step() + 24, behavior: 'smooth' }));
  }

  initTestimonialCarousel();
  document.addEventListener('astro:page-load', initTestimonialCarousel);

  function initReviewModal() {
    const openBtn = document.getElementById('open-review-modal');
    const modal = document.getElementById('review-modal');
    const closeBtn = document.getElementById('review-modal-close');
    const form = document.getElementById('review-form') as HTMLFormElement | null;
    const submitButton = document.getElementById('review-submit') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('review-submit-label');
    const status = document.getElementById('review-status');
    if (!openBtn || !modal || !closeBtn || !form || !submitButton || !submitLabel || !status || modal.dataset.bound) return;
    modal.dataset.bound = '1';

    const open = () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const botcheck = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
      if (botcheck?.checked) return;

      submitButton.disabled = true;
      submitLabel.textContent = 'Sending…';
      status.textContent = '';
      status.className = 'text-center text-sm';

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData
        });
        const result = await response.json();

        if (result.success) {
          status.textContent = 'Thank you! Your review will be added to this page soon.';
          status.classList.add('text-accent-green');
          form.reset();
        } else {
          throw new Error(result.message ?? 'Submission failed');
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again or email us directly.';
        status.classList.add('text-accent-red');
      } finally {
        submitButton.disabled = false;
        submitLabel.textContent = 'Submit Review';
      }
    });
  }

  initReviewModal();
  document.addEventListener('astro:page-load', initReviewModal);
</script>

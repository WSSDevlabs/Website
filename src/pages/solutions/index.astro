---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import VideoMedia from '../../components/media/VideoMedia.astro';
import FAQ from '../../components/sections/FAQ.astro';
import CTABand from '../../components/sections/CTABand.astro';
import Pill from '../../components/ui/Pill.astro';
import { SECTORS, TRAINING_CLASSES } from '../../data/sectors';
import { CLIPS } from '../../data/media';

// Section tones cycle so no two neighbours match; the dark one is matte dark grey
const TONES = [
  { bg: 'bg-paper', dark: false, cell: 'bg-white', rule: 'bg-line' },
  { bg: 'bg-paper-dim', dark: false, cell: 'bg-white', rule: 'bg-line' },
  { bg: 'bg-tint', dark: false, cell: 'bg-white', rule: 'bg-white' },
  { bg: 'bg-charcoal', dark: true, cell: 'bg-white/[0.06]', rule: 'bg-white/10' }
];

const faqs = [
  {
    question: 'Do you only work with large companies?',
    answer:
      'No. We work with plantation groups and councils, and with SMEs that have one shop and a few cameras. Every project starts with a pilot sized to your budget.'
  },
  {
    question: 'Do you supply hardware or only software?',
    answer:
      'Both. We specify, source and install sensors, gateways and cameras, then build the software, AI models and dashboards on top. You deal with one team.'
  },
  {
    question: 'Who owns the data and the code?',
    answer:
      'You do. Data stays in your cloud account or on your own server, and custom code is handed over at the end of the project.'
  },
  {
    question: 'Can you train our staff?',
    answer:
      'Yes. Training comes with every rollout, and we also run standalone classes on digital basics, AI tools at work and digital marketing.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI, IoT and system solutions by sector | WSS DevLabs',
  description:
    'AI, IoT and system solutions for agriculture, biomass, smart cities, energy, waste-to-energy, digital foundations and SMEs in Malaysia.',
  hasPart: SECTORS.map((sector) => ({
    '@type': 'Service',
    name: `${sector.name} solutions`,
    description: sector.summary,
    url: new URL(`/solutions#${sector.slug}`, Astro.site).toString(),
    provider: { '@type': 'Organization', name: 'WSS DevLabs' },
    areaServed: 'MY'
  }))
};
---

<BaseLayout
  title="AI, IoT & System Solutions by Sector | WSS DevLabs"
  description="AI, IoT and system solutions for agriculture, biomass, smart cities, energy, waste-to-energy and SMEs in Malaysia. The problems we solve, the system behind each one, and what changes for you."
  path="/solutions"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden pb-14 pt-32 md:pb-20 md:pt-44" data-noreveal>
    <div class="absolute -top-40 right-[-10%] h-[32rem] w-[46rem] rounded-full bg-accent-blue/10 blur-3xl" aria-hidden="true"></div>
    <div class="grid-pattern-blue mask-fade-edges absolute inset-0 opacity-15" aria-hidden="true"></div>
    <Container class="relative">
      <div data-hero-item data-hero-delay="0" class="max-w-4xl">
        <h1 class="font-display text-[clamp(2.4rem,1.3rem+4vw,4.4rem)] font-bold leading-[1.02] tracking-[-0.04em] text-ink">
          AI, IoT and systems for the work <span class="badge-highlight">on the ground</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg">
          Pick your industry. Each section shows the problem we solve, what we build and what changes for you.
        </p>
      </div>
    </Container>
  </section>

  <!-- One band per sector -->
  {
    SECTORS.map((sector, i) => {
      const tone = TONES[i % TONES.length];
      const d = tone.dark;
      return (
      <section id={sector.slug} class:list={['scroll-mt-24 rounded-t-[2.75rem] py-16 md:py-24', i > 0 && '-mt-10 pt-24 md:-mt-12 md:pt-32', tone.bg, d && 'text-white']}>
        <Container>
          <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
            <div class="relative aspect-[4/3] overflow-hidden rounded-[1.75rem] bg-charcoal" data-clip-reveal>
              <VideoMedia clip={CLIPS[sector.clip]} class="h-full w-full" />
              <p class="absolute bottom-3 left-4 z-10 text-[0.68rem] text-white/70">Illustrative footage</p>
            </div>
            <div>
              <h2 class:list={['font-display text-[clamp(1.9rem,1.3rem+2.4vw,3rem)] font-bold leading-[1.08] tracking-[-0.03em]', d ? 'text-white' : 'text-ink']}>
                {sector.titleLead} <span class="badge-highlight">{sector.titleHighlight}</span>
              </h2>
              <p class:list={['mt-5 text-base leading-relaxed', d ? 'text-white/65' : 'text-ink-dim']}>{sector.intro}</p>
              <p class:list={['mt-4 text-sm font-semibold leading-relaxed', d ? 'text-white' : 'text-ink']}>
                <span class="text-accent">The problem:</span> {sector.problem}
              </p>
              {sector.whyNow && (
                <p class:list={['mt-4 text-sm leading-relaxed', d ? 'text-white/60' : 'text-ink-dim']}>
                  {sector.whyNow.text}{' '}
                  <a href={sector.whyNow.href} class:list={['font-bold underline underline-offset-4', d ? 'text-white' : 'text-ink']}>{sector.whyNow.linkLabel}</a>
                </p>
              )}
              <Pill href={`/contact?topic=${encodeURIComponent(sector.name)}`} label="Consult with us" variant={d ? 'light' : 'dark'} class="mt-7" />
            </div>
          </div>

          <div class="mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {sector.useCases.map((useCase, n) => (
              <div class:list={['flex flex-col rounded-[1.75rem] p-6 sm:p-7', tone.cell]}>
                <span class="font-feature text-sm font-semibold text-accent">0{n + 1}</span>
                <h3 class:list={['mt-2 text-lg font-bold tracking-tight', d ? 'text-white' : 'text-ink']}>{useCase.title}</h3>
                <p class:list={['mt-2 text-sm leading-relaxed', d ? 'text-white/60' : 'text-ink-dim']}>{useCase.body}</p>
              </div>
            ))}
          </div>

          {sector.slug === 'sme-digital-shift' && (
            <div id="training" class="mt-14 scroll-mt-24 rounded-[1.75rem] bg-white p-6 sm:p-8">
              <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
                <div>
                  <h3 class="h-sub font-black tracking-tight text-ink">Training and <span class="badge-highlight">classes</span></h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink-dim">
                    Small-group, hands-on sessions in Bahasa Malaysia or English, at your office or online. Your team works on its own tasks, not on slides.
                  </p>
                  <a href="/contact?topic=Training" class="mt-5 inline-flex rounded-full bg-ink px-6 py-3 text-sm font-bold text-white transition-all hover:scale-105 hover:bg-black">
                    Ask about a class
                  </a>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  {TRAINING_CLASSES.map((course) => (
                    <div class="rounded-2xl bg-paper-dim p-5">
                      <p class="text-xs font-bold uppercase tracking-wide text-accent">{course.length}</p>
                      <h4 class="mt-1.5 text-base font-bold tracking-tight text-ink">{course.title}</h4>
                      <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">{course.body}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </Container>
      </section>
      );
    })
  }

  <FAQ title="Questions about our solutions" items={faqs} />
  <CTABand
    title="Tell us what goes wrong on site."
    subtitle="We reply within one business day, and the first site visit is how every project starts."
    ctaLabel="Consult with us"
  />
</BaseLayout>

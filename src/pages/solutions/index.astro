---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import VideoMedia from '../../components/media/VideoMedia.astro';
import FAQ from '../../components/sections/FAQ.astro';
import CTABand from '../../components/sections/CTABand.astro';
import { SECTORS, TRAINING_CLASSES } from '../../data/sectors';
import { CLIPS } from '../../data/media';

const faqs = [
  {
    question: 'Do you only work with large companies?',
    answer:
      'No. We work with plantation groups and councils, and with SMEs that have one shop and a few cameras. Every project starts with a pilot sized to your budget.'
  },
  {
    question: 'Do you supply hardware or only software?',
    answer:
      'Both. We specify, source and install sensors, gateways and cameras, then build the software, AI models and dashboards on top. You deal with one team.'
  },
  {
    question: 'Who owns the data and the code?',
    answer:
      'You do. Data stays in your cloud account or on your own server, and custom code is handed over at the end of the project.'
  },
  {
    question: 'Can you train our staff?',
    answer:
      'Yes. Training comes with every rollout, and we also run standalone classes on digital basics, AI tools at work and digital marketing.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI, IoT and system solutions by sector | WSS DevLabs',
  description:
    'AI, IoT and system solutions for agriculture, biomass, smart cities, energy, waste-to-energy, digital foundations and SMEs in Malaysia.',
  hasPart: SECTORS.map((sector) => ({
    '@type': 'Service',
    name: `${sector.name} solutions`,
    description: sector.summary,
    url: new URL(`/solutions#${sector.slug}`, Astro.site).toString(),
    provider: { '@type': 'Organization', name: 'WSS DevLabs' },
    areaServed: 'MY'
  }))
};
---

<BaseLayout
  title="AI, IoT & System Solutions by Sector | WSS DevLabs"
  description="AI, IoT and system solutions for agriculture, biomass, smart cities, energy, waste-to-energy and SMEs in Malaysia. The problems we solve, the system behind each one, and what changes for you."
  path="/solutions"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden pb-14 pt-8 md:pb-20 md:pt-36" data-noreveal>
    <div class="absolute -top-40 right-[-10%] h-[32rem] w-[46rem] rounded-full bg-accent-blue/10 blur-3xl" aria-hidden="true"></div>
    <div class="grid-pattern-blue mask-fade-edges absolute inset-0 opacity-15" aria-hidden="true"></div>
    <Container class="relative">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div data-hero-item data-hero-delay="0">
          <p class="mono-label text-accent" data-scramble>Solutions by sector</p>
          <h1 class="h-display mt-5 !text-[clamp(2.4rem,1.3rem+4vw,4.4rem)]">
            AI, IoT and systems for the work <span class="badge-highlight">on the ground</span>
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg">
            Pick your industry. Each section shows the problem we solve, what we build and what changes for you.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#sectors" class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white shadow-md transition-all hover:scale-105 hover:bg-black">
              Browse sectors
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
              </svg>
            </a>
            <a href="/systems" class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-white px-6 py-3.5 text-sm font-semibold text-ink transition-all hover:scale-105 hover:bg-paper-dim">
              See systems and demos
            </a>
          </div>
        </div>

        <div data-hero-item data-hero-delay="0.15" class="relative">
          <div class="relative aspect-[4/3] overflow-hidden rounded-[2rem] border border-line bg-charcoal shadow-[0_30px_70px_-25px_rgba(25,25,27,0.45)]">
            <VideoMedia clip={CLIPS.dotsSphere} eager class="h-full w-full opacity-70" />
            <div data-scene="network" data-scene-props='{"radius":2.1,"linkOpacity":0.35}' class="absolute inset-0" aria-hidden="true"></div>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent" aria-hidden="true"></div>
            <div class="absolute inset-x-0 bottom-0 grid grid-cols-3 gap-px border-t border-white/10 bg-white/10 text-white backdrop-blur-md">
              <div class="bg-charcoal/50 px-4 py-4">
                <p class="font-feature text-2xl font-semibold">7</p>
                <p class="mt-0.5 text-[0.7rem] text-white/60">Focus sectors</p>
              </div>
              <div class="bg-charcoal/50 px-4 py-4">
                <p class="font-feature text-2xl font-semibold">4</p>
                <p class="mt-0.5 text-[0.7rem] text-white/60">Layers per system</p>
              </div>
              <div class="bg-charcoal/50 px-4 py-4">
                <p class="font-feature text-2xl font-semibold">1</p>
                <p class="mt-0.5 text-[0.7rem] text-white/60">Team end to end</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Sector index -->
  <section id="sectors" class="band-light border-y border-line/60 py-10 md:py-12">
    <Container>
      <ul class="flex flex-wrap gap-2.5">
        {
          SECTORS.map((sector) => (
            <li>
              <a
                href={`#${sector.slug}`}
                class="inline-flex items-center rounded-full border border-line bg-white px-5 py-2.5 text-sm font-semibold text-ink transition hover:border-ink hover:bg-ink hover:text-white"
              >
                {sector.name}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- One band per sector -->
  {
    SECTORS.map((sector, i) => (
      <section id={sector.slug} class:list={['scroll-mt-24 py-16 md:py-24', i % 2 === 0 ? 'bg-white' : 'band-light']}>
        <Container>
          <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
            <div class="relative aspect-[4/3] overflow-hidden rounded-[2rem] border border-line bg-charcoal" data-clip-reveal>
              <VideoMedia clip={CLIPS[sector.clip]} class="h-full w-full" />
              <p class="absolute bottom-3 left-4 z-10 text-[0.68rem] text-white/70">Illustrative footage</p>
            </div>
            <div>
              <p class="mono-label text-accent">0{i + 1} / {sector.name}</p>
              <h2 class="h-section mt-4 font-black tracking-tight text-ink">
                {sector.titleLead} <span class="badge-highlight">{sector.titleHighlight}</span>
              </h2>
              <p class="mt-5 text-base leading-relaxed text-ink-dim">{sector.intro}</p>
              <p class="mt-4 text-sm font-semibold leading-relaxed text-ink">
                <span class="text-accent">The problem:</span> {sector.problem}
              </p>
              {sector.whyNow && (
                <p class="mt-4 text-sm leading-relaxed text-ink-dim">
                  {sector.whyNow.text}{' '}
                  <a href={sector.whyNow.href} class="font-bold text-ink underline underline-offset-4">{sector.whyNow.linkLabel}</a>
                </p>
              )}
              <a
                href={`/contact?topic=${encodeURIComponent(sector.name)}`}
                class="mt-7 inline-flex items-center justify-center rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white shadow-md transition-all hover:scale-105 hover:bg-black"
              >
                Consult with us
              </a>
            </div>
          </div>

          <div class="mt-14 grid gap-px overflow-hidden rounded-[2rem] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
            {sector.useCases.map((useCase, n) => (
              <div class="flex flex-col bg-white p-6 sm:p-7">
                <span class="font-feature text-sm font-semibold text-accent">0{n + 1}</span>
                <h3 class="mt-2 text-lg font-bold tracking-tight text-ink">{useCase.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-dim">{useCase.body}</p>
              </div>
            ))}
          </div>

          <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {sector.outcomes.map((outcome) => (
              <li class="flex gap-3 text-sm font-semibold leading-snug text-ink">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                {outcome}
              </li>
            ))}
          </ul>

          {sector.slug === 'sme-digital-shift' && (
            <div id="training" class="mt-14 scroll-mt-24 rounded-[2rem] border border-line bg-paper-dim p-6 sm:p-8">
              <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
                <div>
                  <h3 class="h-sub font-black tracking-tight text-ink">Training and <span class="badge-highlight">classes</span></h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink-dim">
                    Small-group, hands-on sessions in Bahasa Malaysia or English, at your office or online. Your team works on its own tasks, not on slides.
                  </p>
                  <a href="/contact?topic=Training" class="mt-5 inline-flex rounded-full bg-ink px-6 py-3 text-sm font-bold text-white transition-all hover:scale-105 hover:bg-black">
                    Ask about a class
                  </a>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  {TRAINING_CLASSES.map((course) => (
                    <div class="rounded-2xl border border-line bg-white p-5">
                      <p class="text-xs font-bold uppercase tracking-wide text-accent">{course.length}</p>
                      <h4 class="mt-1.5 text-base font-bold tracking-tight text-ink">{course.title}</h4>
                      <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">{course.body}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </Container>
      </section>
    ))
  }

  <FAQ title="Questions about our solutions" items={faqs} />
  <CTABand
    title="Tell us what goes wrong on site."
    subtitle="We reply within one business day, and the first site visit is how every project starts."
    ctaLabel="Consult with us"
  />
</BaseLayout>

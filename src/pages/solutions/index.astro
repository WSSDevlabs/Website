---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import VideoMedia from '../../components/media/VideoMedia.astro';
import SolutionStack from '../../components/sections/SolutionStack.astro';
import PilotProcess from '../../components/sections/PilotProcess.astro';
import FAQ from '../../components/sections/FAQ.astro';
import CTABand from '../../components/sections/CTABand.astro';
import { SECTORS } from '../../data/sectors';
import { CLIPS } from '../../data/media';

// Bento: two wide, three regular, two wide (6-column grid on desktop)
const SPANS = ['lg:col-span-3', 'lg:col-span-3', 'lg:col-span-2', 'lg:col-span-2', 'lg:col-span-2', 'lg:col-span-3', 'lg:col-span-3'];

const faqs = [
  {
    question: 'Do you only work with large companies?',
    answer:
      'No. We work with plantation groups and councils, and with SMEs that have one shop and a few cameras. Every project starts with a pilot sized to your budget.'
  },
  {
    question: 'Do you supply hardware or only software?',
    answer:
      'Both. We specify, source and install sensors, gateways and cameras, then build the software, AI models and dashboards on top. You deal with one team.'
  },
  {
    question: 'Who owns the data and the code?',
    answer:
      'You do. Data stays in your cloud account or on your own server, and custom code is handed over at the end of the project.'
  },
  {
    question: 'Can you train our staff?',
    answer:
      'Yes. Training comes with every rollout, and we also run standalone classes on digital basics, AI tools at work and digital marketing.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Solutions by sector | WSS DevLabs',
  description:
    'AI, IoT, software and analytics solutions for agriculture, biomass, smart cities, energy, waste-to-energy and SMEs in Malaysia.',
  hasPart: SECTORS.map((sector) => ({
    '@type': 'Service',
    name: `${sector.name} solutions`,
    description: sector.summary,
    url: new URL(`/solutions/${sector.slug}`, Astro.site).toString(),
    provider: { '@type': 'Organization', name: 'WSS DevLabs' },
    areaServed: 'MY'
  }))
};
---

<BaseLayout
  title="Solutions by Sector: AI, IoT and Software | WSS DevLabs"
  description="AI, IoT, software and analytics for agriculture, biomass, smart cities, energy, waste-to-energy and SMEs in Malaysia. See the problems we solve and how each system works."
  path="/solutions"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden pb-14 pt-8 md:pb-20 md:pt-36" data-noreveal>
    <div class="absolute -top-40 right-[-10%] h-[32rem] w-[46rem] rounded-full bg-accent-blue/10 blur-3xl" aria-hidden="true"></div>
    <div class="grid-pattern-blue mask-fade-edges absolute inset-0 opacity-15" aria-hidden="true"></div>
    <Container class="relative">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div data-hero-item data-hero-delay="0">
          <p class="mono-label text-accent" data-scramble>Solutions by sector</p>
          <h1 class="h-display mt-5 !text-[clamp(2.4rem,1.3rem+4vw,4.4rem)]">
            Technology for the work <span class="badge-highlight">on the ground</span>
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg">
            Pick your industry to see the problems we solve, the system behind each one and what it looks like running.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#sectors" class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white shadow-md transition-all hover:scale-105 hover:bg-black">
              Browse sectors
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
              </svg>
            </a>
            <a href="/labs" class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-white px-6 py-3.5 text-sm font-semibold text-ink transition-all hover:scale-105 hover:bg-paper-dim">
              Watch the demos
            </a>
          </div>
        </div>

        <div data-hero-item data-hero-delay="0.15" class="relative">
          <div class="relative aspect-[4/3] overflow-hidden rounded-[2rem] border border-line bg-charcoal shadow-[0_30px_70px_-25px_rgba(25,25,27,0.45)]">
            <VideoMedia clip={CLIPS.network} eager class="h-full w-full opacity-70" />
            <div data-scene="network" data-scene-props='{"radius":2.1,"linkOpacity":0.35}' class="absolute inset-0" aria-hidden="true"></div>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent" aria-hidden="true"></div>
            <div class="absolute inset-x-0 bottom-0 grid grid-cols-3 gap-px border-t border-white/10 bg-white/10 text-white backdrop-blur-md">
              <div class="bg-charcoal/50 px-4 py-4">
                <p class="font-feature text-2xl font-semibold">7</p>
                <p class="mt-0.5 text-[0.7rem] text-white/60">Focus sectors</p>
              </div>
              <div class="bg-charcoal/50 px-4 py-4">
                <p class="font-feature text-2xl font-semibold">4</p>
                <p class="mt-0.5 text-[0.7rem] text-white/60">Layers per system</p>
              </div>
              <div class="bg-charcoal/50 px-4 py-4">
                <p class="font-feature text-2xl font-semibold">1</p>
                <p class="mt-0.5 text-[0.7rem] text-white/60">Team end to end</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Sector bento -->
  <section id="sectors" class="border-t border-line/60 bg-paper py-16 md:py-24">
    <Container>
      <div class="max-w-2xl">
        <h2 class="h-section font-black tracking-tight text-ink">Choose your <span class="badge-highlight">sector</span></h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">Hover a card to see the setting. Each page explains the problem, the system and the use cases.</p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
        {
          SECTORS.map((sector, i) => (
            <a
              href={`/solutions/${sector.slug}`}
              data-hover-host
              class:list={[
                'tilt-card group relative flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-[2rem] border border-black/10 bg-charcoal shadow-[0_25px_60px_-20px_rgba(0,0,0,0.25)] transition-shadow duration-500 hover:shadow-2xl',
                SPANS[i],
                i < 2 && 'lg:min-h-[26rem]'
              ]}
            >
              <img
                src={sector.image}
                alt=""
                loading="lazy"
                width="1200"
                height="800"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <VideoMedia clip={CLIPS[sector.clip]} hover class="!absolute inset-0 !bg-transparent [&>img]:opacity-0" />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#111215]/95 via-[#111215]/55 to-transparent" aria-hidden="true" />
              <div class="relative z-10 p-6 sm:p-7">
                <h3 class="font-display text-2xl font-bold tracking-tight text-white">{sector.name}</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-white/75">{sector.summary}</p>
                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {sector.useCases.slice(0, 3).map((useCase) => (
                    <li class="rounded-full border border-white/20 bg-white/10 px-2.5 py-1 text-[0.7rem] font-semibold text-white backdrop-blur-md">{useCase.title}</li>
                  ))}
                </ul>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-white">
                  Explore
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  <SolutionStack />
  <PilotProcess />
  <FAQ title="Questions about our solutions" items={faqs} />
  <CTABand
    title="Tell us what goes wrong on site."
    subtitle="We reply within one business day, and the first site visit is how every project starts."
    ctaLabel="Consult with us"
  />
</BaseLayout>

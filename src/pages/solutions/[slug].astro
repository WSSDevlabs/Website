---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import VideoMedia from '../../components/media/VideoMedia.astro';
import SolutionStack from '../../components/sections/SolutionStack.astro';
import PilotProcess from '../../components/sections/PilotProcess.astro';
import FAQ from '../../components/sections/FAQ.astro';
import CTABand from '../../components/sections/CTABand.astro';
import { SECTORS, TRAINING_CLASSES, type Sector } from '../../data/sectors';
import { getDemo, type Demo } from '../../data/demos';
import { CLIPS } from '../../data/media';

export function getStaticPaths() {
  return SECTORS.map((sector) => ({ params: { slug: sector.slug }, props: { sector } }));
}

type Props = { sector: Sector };
const { sector } = Astro.props;

const demos = sector.demos.map(getDemo).filter((d): d is Demo => Boolean(d));
const others = SECTORS.filter((s) => s.slug !== sector.slug);
const pageUrl = new URL(`/solutions/${sector.slug}`, Astro.site).toString();

// Use-case bento: one feature cell (2×2) + five regular cells on a 3-column grid
const CELL = ['lg:col-span-2 lg:row-span-2', '', '', '', '', ''];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `${sector.name} solutions`,
      serviceType: `${sector.titleLead} ${sector.titleHighlight}`,
      description: sector.intro,
      url: pageUrl,
      areaServed: 'MY',
      provider: { '@type': 'Organization', name: 'WSS DevLabs', url: Astro.site?.toString() }
    },
    {
      '@type': 'FAQPage',
      mainEntity: sector.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
        { '@type': 'ListItem', position: 2, name: 'Solutions', item: new URL('/solutions', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: sector.name, item: pageUrl }
      ]
    }
  ]
};
---

<BaseLayout
  title={`${sector.name} Solutions: AI, IoT & Software | WSS DevLabs`}
  description={`${sector.summary} Designed, built and supported in Malaysia by WSS DevLabs.`}
  path={`/solutions/${sector.slug}`}
  schema={schema}
>
  <!-- Full-bleed video hero -->
  <section class="relative isolate flex min-h-[78dvh] items-end overflow-hidden bg-charcoal pb-14 pt-28 md:min-h-[88dvh] md:pb-20 md:pt-40" data-noreveal>
    <div class="absolute inset-0 -z-10" data-parallax="6">
      <VideoMedia clip={CLIPS[sector.clip]} eager class="h-full w-full scale-110" />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#111215] via-[#111215]/60 to-[#111215]/25" aria-hidden="true"></div>
    <div class="grid-pattern absolute inset-0 -z-10 opacity-[0.06] invert" aria-hidden="true"></div>

    <Container class="relative">
      <nav data-hero-item data-hero-delay="0" aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-white/60">
        <a href="/solutions" class="transition hover:text-white">Solutions</a>
        <span aria-hidden="true">/</span>
        <span class="text-white">{sector.name}</span>
      </nav>
      <h1 data-hero-item data-hero-delay="0.08" class="h-display mt-5 max-w-4xl !text-[clamp(2.4rem,1.3rem+4.2vw,4.8rem)] !text-white">
        {sector.titleLead} <span class="badge-highlight">{sector.titleHighlight}</span>
      </h1>
      <p data-hero-item data-hero-delay="0.16" class="mt-6 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg">
        {sector.intro}
      </p>
      <div data-hero-item data-hero-delay="0.24" class="mt-8 flex flex-wrap gap-4">
        <a
          href={`/contact?topic=${encodeURIComponent(sector.name)}`}
          data-magnetic
          class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-bold text-ink shadow-md transition-all hover:scale-105 hover:bg-paper"
        >
          Consult with us
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href="#use-cases"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur-md transition-all hover:scale-105 hover:bg-white/20"
        >
          See use cases
        </a>
      </div>
      <p class="mt-10 text-[0.68rem] text-white/45">Illustrative footage</p>
    </Container>
  </section>

  <!-- The problem + why now -->
  <section class="bg-paper py-16 md:py-24">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:items-end lg:gap-16">
        <div>
          <p class="mono-label text-accent" data-scramble>The problem</p>
          <p data-color-reveal class="mt-5 font-display text-[clamp(1.6rem,1.1rem+1.9vw,2.7rem)] font-bold leading-[1.16] tracking-[-0.025em]">
            {sector.problem}
          </p>
        </div>
        {
          sector.whyNow && (
            <aside class="relative overflow-hidden rounded-3xl bg-charcoal p-7 text-white shadow-xl">
              <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-accent/30 blur-3xl" aria-hidden="true" />
              <p class="relative text-xs font-bold uppercase tracking-wide text-white/55">Why now</p>
              <p class="relative mt-3 text-sm leading-relaxed text-white/85">{sector.whyNow.text}</p>
              <a href={sector.whyNow.href} class="relative mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-white underline-offset-4 hover:underline">
                {sector.whyNow.linkLabel}
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </aside>
          )
        }
      </div>
    </Container>
  </section>

  <SolutionStack only={sector.slug} />

  <!-- Use cases bento -->
  <section id="use-cases" class="border-t border-line/60 bg-paper py-16 md:py-24">
    <Container>
      <div class="max-w-2xl">
        <h2 class="h-section font-black tracking-tight text-ink">What we <span class="badge-highlight">build</span></h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">Use cases for {sector.name.toLowerCase()}. Each one can run alone or plug into the others.</p>
      </div>
      <div class="mt-12 grid auto-rows-[minmax(15rem,auto)] gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          sector.useCases.map((useCase, i) => {
            const Tag = useCase.href ? 'a' : 'div';
            return (
              <Tag
                href={useCase.href}
                class:list={[
                  'group relative flex flex-col justify-end overflow-hidden rounded-[2rem] border border-black/10 bg-charcoal shadow-[0_20px_50px_-24px_rgba(0,0,0,0.35)]',
                  CELL[i],
                  i === 0 ? 'min-h-[22rem] lg:min-h-0' : 'min-h-[16rem]'
                ]}
                data-clip-reveal
              >
                {useCase.clip ? (
                  <VideoMedia clip={CLIPS[useCase.clip]} class="!absolute inset-0 h-full w-full" />
                ) : (
                  <img
                    src={useCase.image}
                    alt=""
                    loading="lazy"
                    width="1200"
                    height="800"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                )}
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#111215]/95 via-[#111215]/45 to-transparent" aria-hidden="true" />
                <div class:list={['relative z-10', i === 0 ? 'p-7 sm:p-9' : 'p-6']}>
                  <h3 class:list={['font-display font-bold tracking-tight text-white', i === 0 ? 'text-2xl sm:text-3xl' : 'text-lg']}>
                    {useCase.title}
                  </h3>
                  <p class:list={['mt-2 leading-relaxed text-white/75', i === 0 ? 'max-w-lg text-sm sm:text-base' : 'text-sm']}>{useCase.body}</p>
                  {useCase.href && (
                    <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-white">
                      Open
                      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                      </svg>
                    </span>
                  )}
                </div>
              </Tag>
            );
          })
        }
      </div>
    </Container>
  </section>

  {
    demos.length > 0 && (
      <section class="border-t border-line/60 bg-paper py-16 md:py-24">
        <Container>
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 class="h-section font-black tracking-tight text-ink">
              See it <span class="badge-highlight">working</span>
            </h2>
            <a href="/labs" class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-6 py-3 text-sm font-semibold text-ink transition-all hover:scale-105 hover:bg-paper-dim">
              All demos in Labs
            </a>
          </div>
          <div class:list={['mt-10 grid gap-8', demos.length > 1 && 'md:grid-cols-2', demos.length > 2 && 'lg:grid-cols-3']}>
            {demos.map((demo) => (
              <article>
                <div class="relative aspect-video overflow-hidden rounded-[1.75rem] border border-line bg-charcoal" data-clip-reveal>
                  <VideoMedia clip={CLIPS[demo.clip]} class="h-full w-full" />
                  {demo.youtubeId && (
                    <VideoMedia clip={CLIPS[demo.clip]} mode="player" youtubeId={demo.youtubeId} title={demo.title} class="!absolute inset-0 !bg-transparent" />
                  )}
                </div>
                <h3 class="mt-5 text-lg font-bold tracking-tight text-ink">{demo.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-dim">{demo.summary}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {demo.points.map((point) => (
                    <li class="rounded-full border border-line bg-white px-3 py-1 text-xs font-semibold text-ink">{point}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
          <p class="mt-6 text-xs text-ink-dim">Illustrative footage. Recordings of our own systems replace these clips as each pilot goes live.</p>
        </Container>
      </section>
    )
  }

  <!-- Outcomes -->
  <section class="border-t border-line/60 bg-paper py-16 md:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <div>
          <h2 class="h-section font-black tracking-tight text-ink">What <span class="badge-highlight">changes</span> for you</h2>
          <p class="mt-4 max-w-md text-base leading-relaxed text-ink-dim">The point of the technology is the result on your site, in your reports and in your team’s day.</p>
          <div class="mt-8 flex flex-wrap gap-2">
            {
              sector.related.map((link) => (
                <a href={link.href} class="rounded-full border border-line bg-white px-4 py-2 text-xs font-semibold text-ink transition hover:border-ink hover:bg-paper-dim">
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
        <div class="space-y-3.5">
          {
            sector.outcomes.map((outcome, i) => (
              <div class="group flex items-center gap-4 rounded-full border border-line bg-white px-5 py-4 shadow-sm transition-all duration-300 hover:scale-[1.02] hover:border-ink hover:bg-paper-dim hover:shadow-md sm:px-6">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-dim font-mono text-xs font-bold text-ink transition-colors group-hover:bg-ink group-hover:text-white">
                  0{i + 1}
                </span>
                <p class="text-sm font-semibold text-ink sm:text-base">{outcome}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  {
    sector.slug === 'sme-digital-shift' && (
      <section id="training" class="border-t border-line/60 bg-paper py-16 md:py-24">
        <Container>
          <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-14">
            <div>
              <div class="relative aspect-[4/3] overflow-hidden rounded-[2rem] border border-line bg-charcoal" data-clip-reveal>
                <VideoMedia clip={CLIPS.trainingRoom} class="h-full w-full" />
              </div>
              <h2 class="h-section mt-8 font-black tracking-tight text-ink">
                Training and <span class="badge-highlight">classes</span>
              </h2>
              <p class="mt-4 text-base leading-relaxed text-ink-dim">
                Small-group, hands-on sessions in Bahasa Malaysia or English, at your office or online. Your team works on its own tasks, not on slides.
              </p>
              <a href="/contact?topic=Training" class="mt-7 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white shadow-md transition-all hover:scale-105 hover:bg-black">
                Ask about a class
              </a>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {TRAINING_CLASSES.map((course, i) => (
                <div class:list={['card card-lift spotlight-card !rounded-3xl p-6', i === 0 && 'sm:col-span-2 bg-paper-dim']}>
                  <p class="text-xs font-bold uppercase tracking-wide text-accent">{course.length}</p>
                  <h3 class="mt-2 text-lg font-bold tracking-tight text-ink">{course.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink-dim">{course.body}</p>
                </div>
              ))}
            </div>
          </div>
        </Container>
      </section>
    )
  }

  <PilotProcess />

  <FAQ title={`${sector.name} questions`} items={sector.faqs} />

  <!-- Other sectors -->
  <section class="border-t border-line/60 bg-paper py-16 md:py-20">
    <Container>
      <h2 class="h-sub text-ink">Other sectors</h2>
      <div class="mt-6 flex snap-x gap-4 overflow-x-auto pb-2 [scrollbar-width:none]">
        {
          others.map((other) => (
            <a href={`/solutions/${other.slug}`} class="group relative h-44 w-64 shrink-0 snap-start overflow-hidden rounded-3xl bg-charcoal" data-hover-host>
              <img src={other.image} alt="" loading="lazy" width="1200" height="800" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" aria-hidden="true" />
              <span class="absolute bottom-4 left-5 right-5 font-display text-lg font-bold text-white">{other.name}</span>
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  <CTABand
    title={`Start a ${sector.name.toLowerCase()} pilot.`}
    subtitle="Tell us what goes wrong today. We reply within one business day."
    ctaLabel="Consult with us"
    ctaHref={`/contact?topic=${encodeURIComponent(sector.name)}`}
  />
</BaseLayout>

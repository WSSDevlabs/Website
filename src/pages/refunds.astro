---
import LegalLayout from '../components/legal/LegalLayout.astro';
import LegalSection from '../components/legal/LegalSection.astro';
import LegalIdentity from '../components/legal/LegalIdentity.astro';
import Email from '../components/ui/Email.astro';
import { LICENCE_TERMS } from '../data/catalog';
import { SITE } from '../data/site';

const lastUpdated = new Date('2026-10-14');

const toc = [
  { id: 'summary', label: '1. Summary' },
  { id: 'websites-custom', label: '2. Websites and custom builds' },
  { id: 'discovery', label: '3. Discovery Sprint and Rescue Audit' },
  { id: 'systems', label: '4. Ready-made systems' },
  { id: 'care', label: '5. Care Plans' },
  { id: 'third-party', label: '6. Third-party costs and hardware' },
  { id: 'how', label: '7. How to ask for a refund' }
];
---

<LegalLayout
  title="Refund Policy"
  description="When WSS DevLabs refunds deposits, licence fees and Care Plans, and how to ask for a refund."
  path="/refunds/"
  icon="M8.25 9.75h4.875a2.625 2.625 0 0 1 0 5.25H12M8.25 9.75 10.5 7.5M8.25 9.75 10.5 12m9-7.243V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0c1.1.128 1.907 1.077 1.907 2.185Z"
  accent="blue"
  lastUpdated={lastUpdated}
  intro="Clear rules on cancellations and refunds, so nobody is surprised. Your rights under Malaysian consumer law are not affected."
  toc={toc}
>
  <LegalSection id="summary" number="1" title="Summary">
    <ul>
      <li>Cancel a website or custom build before you approve the design: we refund your deposit, minus the work already done.</li>
      <li>A ready-made system that can't be installed by following the guide, and that we can't fix: full refund within {LICENCE_TERMS.refundDays} days.</li>
      <li>Monthly Care Plans: cancel any time, effective at the end of the paid month.</li>
    </ul>
    <LegalIdentity />
  </LegalSection>

  <LegalSection id="websites-custom" number="2" title="Websites and custom builds">
    <ul>
      <li><strong>Before design approval:</strong> if you cancel, we refund your deposit minus the work already done, which we show you in writing.</li>
      <li><strong>After design approval:</strong> payments for milestones already reached aren't refundable. We invoice work done up to the cancellation, and hand over that work once it's paid for.</li>
      <li>If we can't deliver what we agreed and don't fix it within a reasonable time, you may cancel and receive a refund for the undelivered work.</li>
    </ul>
  </LegalSection>

  <LegalSection id="discovery" number="3" title="Discovery Sprint and Rescue Audit">
    <p>
      Refunded in full if you cancel before the first workshop or before we start the audit. After that they aren't refundable,
      but you keep everything delivered, including the documents and report.
    </p>
  </LegalSection>

  <LegalSection id="systems" number="4" title="Ready-made systems">
    <p>
      If the system can't be installed by following the install guide and we can't fix the problem, we refund the licence fee in
      full, as long as you tell us within {LICENCE_TERMS.refundDays} days of delivery. Because software can be copied once it's
      downloaded, there is no refund if you simply change your mind after download. If you're unsure, book a screen-share and
      watch it working before you buy.
    </p>
  </LegalSection>

  <LegalSection id="care" number="5" title="Care Plans">
    <ul>
      <li><strong>Monthly plans:</strong> cancel any time. The plan ends at the end of the month you've paid for.</li>
      <li><strong>Yearly plans:</strong> if you cancel within 30 days of paying, we refund the unused months. After that, the plan runs until the end of the paid year.</li>
    </ul>
  </LegalSection>

  <LegalSection id="third-party" number="6" title="Third-party costs and hardware">
    <p>
      Domain registrations, payment gateway fees, WhatsApp (Meta) fees and other third-party costs paid on your behalf can't be
      refunded by us once paid. Hardware follows the supplier's returns and warranty terms.
    </p>
  </LegalSection>

  <LegalSection id="how" number="7" title="How to ask for a refund">
    <p>
      Email <Email /> or WhatsApp {SITE.phone} with your invoice number and the reason. We reply within one business day.
      Approved refunds are paid to the account you paid from within 14 days.
    </p>
  </LegalSection>
</LegalLayout>

---
import LegalLayout from '../components/legal/LegalLayout.astro';
import LegalSection from '../components/legal/LegalSection.astro';
import LegalIdentity from '../components/legal/LegalIdentity.astro';
import { LICENCE_TERMS, SYSTEM_EXTRAS, formatRM } from '../data/catalog';
import { businessName } from '../data/site';

const lastUpdated = new Date('2026-10-14');

const toc = [
  { id: 'parties', label: '1. Who this is between' },
  { id: 'meanings', label: '2. Meanings' },
  { id: 'grant', label: '3. What you can do' },
  { id: 'restrictions', label: "4. What you can't do" },
  { id: 'transfer', label: '5. Transferring the licence' },
  { id: 'ownership', label: '6. Ownership' },
  { id: 'delivery', label: '7. Delivery' },
  { id: 'support', label: '8. Support and updates' },
  { id: 'warranty', label: '9. Warranty' },
  { id: 'responsibilities', label: '10. Your responsibilities' },
  { id: 'third-party', label: '11. Open-source parts' },
  { id: 'licence-check', label: '12. The licence check' },
  { id: 'refund', label: '13. Refund' },
  { id: 'liability', label: '14. Liability' },
  { id: 'termination', label: '15. Ending the licence' },
  { id: 'law', label: '16. Law' }
];
---

<LegalLayout
  title="Licence Agreement"
  description="The perpetual licence for WSS DevLabs ready-made systems: what you can do with the source code, support and updates, warranty, refund and liability."
  path="/licence/"
  icon="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z"
  accent="green"
  lastUpdated={lastUpdated}
  intro="When you buy a ready-made system, you get a perpetual licence with the full source code: use it, change it and host it forever. You can't resell it. This page sets out exactly what that means."
  toc={toc}
>
  <LegalSection id="parties" number="1" title="Who this is between">
    <p>
      This licence is between {businessName} ("we") and the business that buys the system ("you"). By completing an order, you
      agree to it. Our <a href="/terms/">Terms of Service</a> also apply.
    </p>
    <LegalIdentity />
  </LegalSection>

  <LegalSection id="meanings" number="2" title="Meanings">
    <ul>
      <li><strong>System:</strong> the ready-made software you bought, including its source code, database files and documentation.</li>
      <li><strong>Live installation:</strong> one copy of the system running for real use, on one server.</li>
      <li><strong>Test copy:</strong> one extra copy used only for testing, training or staging.</li>
      <li><strong>Update:</strong> a new release of the standard system, with release notes.</li>
    </ul>
  </LegalSection>

  <LegalSection id="grant" number="3" title="What you can do">
    <p>
      We give you a perpetual, non-exclusive licence to install, use and change the system for your own business, for{' '}
      {LICENCE_TERMS.installations}. More live installations (for example, separate companies in a group) need their own
      licence. There are no per-user fees.
    </p>
  </LegalSection>

  <LegalSection id="restrictions" number="4" title="What you can't do">
    <ul>
      <li>Resell, sublicense, rent out or give away the system or its source code.</li>
      <li>Offer the system, or a version of it, as a hosted service to other businesses.</li>
      <li>Remove copyright or licence notices from the code.</li>
    </ul>
  </LegalSection>

  <LegalSection id="transfer" number="5" title="Transferring the licence">
    <p>
      You can transfer the licence only together with the sale of your business, by telling us in writing. The new owner takes
      on this agreement.
    </p>
  </LegalSection>

  <LegalSection id="ownership" number="6" title="Ownership">
    <p>
      We keep the copyright in the system. You own your data, and you may use the changes you make to the code under this
      licence. That's why we call it a licence, not ownership of the product.
    </p>
  </LegalSection>

  <LegalSection id="delivery" number="7" title="Delivery">
    <p>
      After payment clears, we email a download link, your licence and the install guide. If you add installation
      ({formatRM(SYSTEM_EXTRAS.installation.price)}), we install it within 3 working days of receiving access to your hosting.
    </p>
  </LegalSection>

  <LegalSection id="support" number="8" title="Support and updates">
    <ul>
      <li>{LICENCE_TERMS.supportDays} days of WhatsApp support from the builder, and bug fixes for {LICENCE_TERMS.supportDays} days, from delivery.</li>
      <li>
        {LICENCE_TERMS.updateMonths} months of updates: security patches and improvements to the standard system, delivered as
        downloadable releases with release notes.
      </li>
      <li>
        Installing an update for you is free on a Care Plan, otherwise {formatRM(SYSTEM_EXTRAS.updateInstall.price)} per
        installation. If you've changed the code, adapting an update to your changes is quoted separately.
      </li>
      <li>After {LICENCE_TERMS.supportDays} days, support is available through a Care Plan or paid per fix.</li>
    </ul>
  </LegalSection>

  <LegalSection id="warranty" number="9" title="Warranty">
    <p>
      For {LICENCE_TERMS.supportDays} days from delivery, the system will substantially work as described in its documentation,
      and we will fix defects you report. We don't promise the system is free of errors or suits every purpose. The warranty
      doesn't cover changes made by anyone other than us, your hosting, third-party services, or misuse.
    </p>
  </LegalSection>

  <LegalSection id="responsibilities" number="10" title="Your responsibilities">
    <ul>
      <li>Your hosting, its security and your backups, unless you have a Care Plan with us.</li>
      <li>Using the system lawfully, including the PDPA for any personal data it holds. You are the data controller for that data.</li>
      <li>Any changes you or others make to the code.</li>
    </ul>
  </LegalSection>

  <LegalSection id="third-party" number="11" title="Open-source parts">
    <p>
      The system may include open-source components. They stay under their own licences, which are listed in the notice file
      included with the download.
    </p>
  </LegalSection>

  <LegalSection id="licence-check" number="12" title="The licence check">
    <p>
      The system contains a licence check that works offline. It never contacts us, and there is no remote kill switch: we can't
      switch your system off. Your protection, and ours, is this agreement.
    </p>
  </LegalSection>

  <LegalSection id="refund" number="13" title="Refund">
    <p>
      If the system can't be installed by following the install guide and we can't fix the problem, we refund the licence fee in
      full, as long as you tell us within {LICENCE_TERMS.refundDays} days of delivery. See the <a href="/refunds/">Refund Policy</a>.
    </p>
  </LegalSection>

  <LegalSection id="liability" number="14" title="Liability">
    <p>
      Our total liability under this licence is limited to the licence fee you paid. Neither of us is liable for indirect or
      consequential losses. Nothing here limits liability for fraud, or anything else that cannot be limited by law.
    </p>
  </LegalSection>

  <LegalSection id="termination" number="15" title="Ending the licence">
    <p>
      The licence lasts forever unless you seriously breach it (for example, by reselling the system) and don't fix the breach
      within 14 days of our written notice. If it ends, you must stop using the system and delete your copies.
    </p>
  </LegalSection>

  <LegalSection id="law" number="16" title="Law">
    <p>This licence is governed by the laws of Malaysia. Disputes are handled as set out in our <a href="/terms/#complaints">Terms of Service</a>.</p>
  </LegalSection>
</LegalLayout>

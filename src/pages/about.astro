---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import FounderCard from '../components/sections/FounderCard.astro';
import Reviews from '../components/sections/Reviews.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { SITE, phoneHref } from '../data/site';
import { FOUNDER, founderDisplayName } from '../data/team';
import { organizationSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();

const principles = [
  {
    title: 'You own everything.',
    body: 'Code, domain, data and credentials, all handed over to you. Your domain is registered in your name from day one.'
  },
  {
    title: 'The price is the price.',
    body: 'Fixed quotes and published packages. No hourly billing, and any change gets a fixed price before work starts.'
  },
  {
    title: 'You talk to the builder.',
    body: 'No account managers and no hand-offs. The person you message is the person doing the work.'
  }
];

const facts: [string, string | undefined][] = [
  ['Registered name', SITE.legalName || undefined],
  ['Registration no.', SITE.ssmNumber || undefined],
  ['Founded', SITE.foundedYear || undefined],
  ['Address', SITE.registeredAddress || undefined],
  ['Based in', SITE.baseLocation],
  ['Meetings', SITE.meetings],
  ['Hours', SITE.hours]
];
---

<BaseLayout
  title="About WSS DevLabs"
  description="Founder-led and based in the Klang Valley. WSS DevLabs helps Malaysian SMEs own their software instead of renting it: fixed prices, full source code, no lock-in."
  path="/about/"
  schema={organizationSchema(siteUrl)}
>
  <!-- 1. Founder: photo, name, three sentences (audit A3, A4) -->
  <section class="border-b border-line">
    <Container class="grid items-center gap-10 py-14 md:grid-cols-[auto_1fr] md:py-20">
      <FounderCard size="lg" />
      <div class="max-w-2xl">
        <h1 class="h-display">Hi, I'm {founderDisplayName}.</h1>
        <p class="lead mt-5">
          I run WSS DevLabs. It's founder-led: I scope, build and support every project myself. When a job needs a specialist,
          such as a licensed electrician for hardware, I tell you upfront who they are and what they do.
        </p>
        {
          FOUNDER.yearsExperience && (
            <p class="mt-4 text-ink-dim">{FOUNDER.yearsExperience} years of building software.</p>
          )
        }
        {
          FOUNDER.notable && FOUNDER.notable.length > 0 && (
            <ul class="mt-4 list-disc space-y-1 pl-5 text-ink-dim">
              {FOUNDER.notable.map((item) => <li>{item}</li>)}
            </ul>
          )
        }
        {
          FOUNDER.social?.linkedin && (
            <a href={FOUNDER.social.linkedin} class="link mt-5 inline-flex min-h-11 items-center" target="_blank" rel="noopener noreferrer">
              Connect on LinkedIn
            </a>
          )
        }
      </div>
    </Container>
  </section>

  <!-- 2. Mission, vision and three principles (audit 1.4) -->
  <section class="py-16 md:py-20">
    <Container>
      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="h-sub text-ink-dim">Mission</h2>
          <p class="mt-3 font-display text-2xl font-semibold leading-snug text-ink sm:text-3xl">
            Help Malaysian SMEs own their software instead of renting it: fixed price, full source code, no lock-in.
          </p>
        </div>
        <div>
          <h2 class="h-sub text-ink-dim">Vision</h2>
          <p class="mt-3 font-display text-2xl font-semibold leading-snug text-ink sm:text-3xl">
            A Malaysia where a 10-person business runs on software it owns and controls, not a stack of subscriptions it can't escape.
          </p>
        </div>
      </div>
      <h2 class="h-section mt-16">Three principles</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {
          principles.map((principle) => (
            <li class="border-t-2 border-ink pt-5">
              <h3 class="h-sub">{principle.title}</h3>
              <p class="mt-2 text-ink-dim">{principle.body}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <!-- 3. The story (audit A5: the "own, don't rent" origin) -->
  <section class="bg-paper-dim py-16 md:py-20">
    <Container narrow>
      <h2 class="h-section">Why WSS DevLabs exists</h2>
      <div class="mt-6 space-y-4 text-lg text-ink-dim">
        <p>
          Small businesses in Malaysia pay monthly for almost everything: the POS, the attendance app, the booking tool, the website
          builder. Each bill looks small. Together they never stop, and the business never owns any of it. Stop paying, and the
          software and often the data go with it.
        </p>
        <p>
          WSS DevLabs exists to offer the other way: pay a fixed price once, get the full source code, and keep the system running
          on hosting you control. When you want help, a Care Plan covers real ongoing work. You're never charged rent just to keep
          using what you bought.
        </p>
        <p>
          We focus on Malaysian SMEs with 5 to 100 staff, and we keep our offer small on purpose: websites, ready-made systems and
          custom builds. If we can't show it, we don't sell it.
        </p>
      </div>
    </Container>
  </section>

  <!-- 4. Reviews: real ones only, shown once published with permission -->
  <Reviews id="reviews" title="What clients say" />

  <!-- 5. Company facts (audit A9, L1) -->
  <section class="py-16 md:py-20" id="company">
    <Container>
      <h2 class="h-section">Company details</h2>
      <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          facts
            .filter(([, value]) => Boolean(value))
            .map(([label, value]) => (
              <div class="border-t border-line pt-4">
                <dt class="text-sm font-semibold text-ink-dim">{label}</dt>
                <dd class="mt-1 text-lg text-ink">{value}</dd>
              </div>
            ))
        }
        <div class="border-t border-line pt-4">
          <dt class="text-sm font-semibold text-ink-dim">Email</dt>
          <dd class="mt-1 text-lg"><a href={`mailto:${SITE.email}`} class="link">{SITE.email}</a></dd>
        </div>
        <div class="border-t border-line pt-4">
          <dt class="text-sm font-semibold text-ink-dim">Phone and WhatsApp</dt>
          <dd class="mt-1 text-lg"><a href={phoneHref} class="link">{SITE.phone}</a></dd>
        </div>
      </dl>
    </Container>
  </section>

  <FinalCTA title="Tell us what you need." />
</BaseLayout>

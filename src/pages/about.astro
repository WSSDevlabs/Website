---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Email from '../components/ui/Email.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import CTABand from '../components/sections/CTABand.astro';
import { SITE, businessName, phoneHref } from '../data/site';
import { TEAM } from '../data/team';
import { REPLY_PROMISE } from '../data/catalog';
import { breadcrumbSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();
const founder = TEAM[0];

const principles = [
  { label: 'You own everything', detail: 'Code, domain, data and logins, all handed over to you.' },
  { label: 'The price is the price', detail: 'Fixed quotes and published packages. No hourly billing.' },
  { label: 'You talk to the builder', detail: 'No account managers between you and the person doing the work.' }
];

const whyFeatures = [
  {
    icon: 'M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
    label: 'One Team, Every Need',
    desc: 'No juggling multiple vendors. One team covers your website, systems, and ongoing support, so nothing falls through the cracks.'
  },
  {
    icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
    label: 'Built Around Your Brief',
    desc: 'We scope every project around what actually works for you: your budget, your timeline and your existing setup, never a rigid, one-size-fits-all package.'
  },
  {
    icon: 'M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z',
    label: 'Direct with the Builder',
    desc: 'You get straight answers from the person actually doing the work, with no account-manager layers and no waiting days for a reply.'
  },
  {
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
    label: 'Delivered Properly',
    desc: 'We stay flexible on how we get there, but never on quality, so what you receive works reliably from day one.'
  }
];

/* Company facts (audit A9). Registration details appear as soon as they're filled in site.json. */
const facts = [
  { title: 'Business name', body: businessName + (SITE.legalName && SITE.legalName !== SITE.name ? `, trading as ${SITE.name}` : '') },
  ...(SITE.ssmNumber ? [{ title: 'SSM registration', body: SITE.ssmNumber }] : []),
  ...(SITE.foundedYear ? [{ title: 'Founded', body: SITE.foundedYear }] : []),
  { title: SITE.registeredAddress ? 'Registered address' : 'Based in', body: SITE.registeredAddress || `${SITE.baseLocation}. ${SITE.meetings}.` },
  { title: 'Hours', body: SITE.hours }
];

const schema = breadcrumbSchema(siteUrl, [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' }
]);
---

<BaseLayout
  title="About: A Founder-Led Software Studio"
  description="WSS DevLabs is a founder-led Malaysian software studio. Razali builds fixed-price websites, ready-made business systems and custom software for SMEs, and hands over the code."
  path="/about/"
  schema={schema}
>

  <!-- "About Us" intro block: vision/mission + founder portrait -->
  <section class="relative overflow-hidden pt-10 md:pt-32">
    <!-- Vision / Mission with center founder frame -->
    <Container class="relative pb-16 pt-16 md:pb-20 md:pt-20">
      <div class="grid gap-6 lg:grid-cols-3 lg:items-center">
        <div class="card p-8">
          <h3 class="h-sub text-ink">Our Vision</h3>
          <p class="mt-2.5 leading-relaxed text-ink-dim">A Malaysia where a 10-person business runs on software it owns and controls, not a stack of subscriptions it can't escape.</p>
        </div>

        <!-- Center founder frame: circular; shows the real photo once it's added in the CMS -->
        <div class="mx-auto flex flex-col items-center">
          <div class="relative aspect-square w-full max-w-[220px] overflow-hidden rounded-full border-4 border-paper bg-paper-dim shadow-float">
            {
              founder?.photo ? (
                <img src={founder.photo} alt={`${founder.name}, founder of WSS DevLabs`} class="h-full w-full object-cover" width="220" height="220" />
              ) : (
                <div class="flex h-full w-full items-center justify-center">
                  <svg class="h-20 w-20 text-ink-dim/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.964 0a9 9 0 1 0-11.964 0m11.964 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                </div>
              )
            }
          </div>
          <p class="mt-4 font-semibold text-ink">{founder?.name ?? 'Razali'}</p>
          <p class="text-sm text-ink-dim">Founder of WSS DevLabs</p>
        </div>

        <div class="card p-8">
          <h3 class="h-sub text-ink">Our Mission</h3>
          <p class="mt-2.5 leading-relaxed text-ink-dim">Help Malaysian SMEs own their software instead of renting it: fixed price, full source code, no lock-in.</p>
        </div>
      </div>
    </Container>

    <!-- About Us content block -->
    <Container class="relative py-16 md:py-20">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20">
        <!-- Left: abstract identity panel (no stock photos) -->
        <div class="relative overflow-hidden rounded-3xl border border-line bg-paper-dim shadow-card sm:h-[26rem]">
          <div class="grid-pattern mask-fade-edges absolute inset-0 opacity-50" aria-hidden="true"></div>
          <div class="absolute -top-12 -right-12 h-56 w-56 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
          <div class="absolute -bottom-12 -left-12 h-56 w-56 rounded-full bg-accent-blue/10 blur-3xl" aria-hidden="true"></div>
          <div class="relative flex h-full flex-col items-center justify-center gap-4 p-10 text-center">
            <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-ink shadow-sm ring-1 ring-line/80">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.964 0a9 9 0 1 0-11.964 0m11.964 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
            </span>
            <p class="font-semibold text-ink">One founder, every build</p>
            <p class="max-w-xs text-sm text-ink-dim">No account managers. Razali scopes, builds and supports every project, and stays your single point of contact.</p>
          </div>
        </div>

        <!-- Right: story + principles -->
        <div>
          <h1 class="h-display !text-[clamp(2rem,1.4rem+2.4vw,3.2rem)]" data-split>Why WSS DevLabs <span class="badge-highlight">exists</span></h1>
          <p class="mt-5 leading-relaxed text-ink-dim">
            Too many Malaysian SMEs pay every month for software they will never own. When the subscription stops, the system
            stops, and their data goes with it. WSS DevLabs builds the other way: fixed-price websites, ready-made systems you pay
            for once, and custom builds where the code is handed over. Founder-led from {SITE.baseLocation.split(',')[0]}, with no
            account managers and no lock-in.
          </p>

          <div class="mt-8">
            {principles.map((item, i) => (
              <div class:list={['flex items-start gap-4 py-4', i > 0 && 'border-t border-line']}>
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent/8">
                  <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                </span>
                <div>
                  <p class="font-semibold text-ink">{item.label}</p>
                  <p class="mt-0.5 text-sm text-ink-dim">{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Why choose us -->
  <section class="relative bg-paper-dim py-12 md:py-16">
    <div class="hairline absolute inset-x-0 top-0" aria-hidden="true"></div>
    <Container>
      <div class="grid gap-12 md:grid-cols-2 md:items-center md:gap-16">
        <!-- Left: abstract panel + ownership chip (no stock photos) -->
        <div class="relative overflow-hidden rounded-3xl border border-line bg-paper shadow-card h-72 sm:h-80">
          <div class="dot-pattern mask-fade-edges absolute inset-0 opacity-60" aria-hidden="true"></div>
          <div class="absolute top-1/2 left-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/8 blur-3xl" aria-hidden="true"></div>
          <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 rounded-2xl border border-line bg-paper px-5 py-3.5 text-center shadow-float">
            <p class="stat-num text-xl leading-none text-ink">100%</p>
            <p class="mono-label mt-1.5 !text-[0.6rem] text-ink-dim">Code ownership</p>
          </div>
        </div>

        <!-- Right: heading + 2x2 features -->
        <div>
          <h2 class="h-section" data-split>What working with us is like</h2>
          <p class="mt-5 max-w-lg leading-relaxed text-ink-dim">
            We understand every business has different budgets, timelines and constraints, so we shape the project around your
            reality, not a rigid template.
          </p>
          <div class="mt-9 grid gap-x-8 gap-y-7 sm:grid-cols-2" data-stagger>
            {whyFeatures.map((f) => (
              <div data-stagger-child>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent/8">
                  <svg class="h-[18px] w-[18px] text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={f.icon} /></svg>
                </span>
                <p class="mt-3.5 font-semibold tracking-tight text-ink">{f.label}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Reviews: only real ones, shown once they exist -->
  <Testimonials />

  <!-- Company facts -->
  <section id="company" class="py-16 md:py-24 bg-paper-dim border-t border-line/60">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="h-section" data-split>Company facts</h2>
        <p class="mt-4 text-sm text-ink-dim">{REPLY_PROMISE}</p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          facts.map((fact) => (
            <div class="rounded-2xl border border-line bg-white p-5 shadow-sm">
              <h3 class="text-sm font-bold text-ink">{fact.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-ink-dim">{fact.body}</p>
            </div>
          ))
        }
        <div class="rounded-2xl border border-line bg-white p-5 shadow-sm">
          <h3 class="text-sm font-bold text-ink">Email</h3>
          <p class="mt-2 text-xs leading-relaxed text-ink-dim"><Email class="underline hover:text-accent" /></p>
        </div>
        <div class="rounded-2xl border border-line bg-white p-5 shadow-sm">
          <h3 class="text-sm font-bold text-ink">Phone and WhatsApp</h3>
          <p class="mt-2 text-xs leading-relaxed text-ink-dim"><a href={phoneHref} class="underline hover:text-accent">{SITE.phone}</a></p>
        </div>
      </div>
    </Container>
  </section>

  <CTABand
    title="Talk to the person who builds it"
    subtitle="Tell us what you need. We reply within one business day, with a fixed quote within three."
    ctaLabel="Get a fixed quote"
    ctaHref="/contact/"
  />
</BaseLayout>

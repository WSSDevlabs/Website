---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import Container from '../components/ui/Container.astro';
import VisionBand from '../components/sections/VisionBand.astro';



const STEPS = [
  {
    n: 1,
    title: 'Discovery call',
    description:
      'A call to walk through your goals, current setup, and budget, before anything is scoped or quoted.'
  },
  {
    n: 2,
    title: 'Proposal & quote',
    description:
      'A written proposal with scope, deliverables, timeline, and a fixed price, sent for you to review with no obligation.'
  },
  {
    n: 3,
    title: 'Contract & deposit',
    description:
      'A signed agreement and deposit lock in your start date and the scope agreed in the proposal.'
  },
  {
    n: 4,
    title: 'Kickoff & requirements',
    description:
      'A detailed requirements session, plus your brand assets, content, and account access handed over so we can start.'
  },
  {
    n: 5,
    title: 'Design sign-off',
    description:
      'Wireframes first, then high-fidelity UI, reviewed and approved by you before a single line of code is written.'
  },
  {
    n: 6,
    title: 'Development sprints',
    description:
      'Staged sprints with a staging link you can follow, so you see real progress and can redirect early.'
  },
  {
    n: 7,
    title: 'QA & client review',
    description:
      'Internal testing across devices, then your own review round with revisions before anything is called finished.'
  },
  {
    n: 8,
    title: 'Sign-off, launch & handover',
    description:
      'Formal approval, deployment to production, and full source code, credentials, and documentation handed over.'
  }
];

const SOLUTION_PHASES = [
  {
    title: 'Requirement Analysis',
    items: [
      'Client Consultation: We begin by engaging with clients to understand their specific needs, challenges, and goals.',
      'Feasibility Study: Our team conducts a feasibility study to assess the technical and economic viability of the proposed solution.',
      'Requirements Gathering: We gather detailed requirements, including functional and non-functional specifications, to ensure a clear understanding of the project scope.'
    ]
  },
  {
    title: 'Solution Design',
    items: [
      'Architecture Design: We design a scalable and robust architecture that integrates IoT devices, data processing systems, and AI algorithms.',
      'Component Selection: Our team selects the appropriate hardware (sensors, devices) and software (platforms, frameworks) components to meet the project requirements.',
      'Data Flow Design: We define the data flow, from data collection at the edge to processing, storage, and analysis, ensuring data integrity and security.'
    ]
  },
  {
    title: 'Prototyping and Proof of Concept (PoC)',
    items: [
      'Rapid Prototyping: We develop a prototype to demonstrate the core functionalities of the solution.',
      'PoC Development: A proof of concept is created to validate the technical approach, test the feasibility, and gather feedback for improvements.',
      'Client Review: We present the prototype and PoC to the client for review and approval, making necessary adjustments based on their feedback.'
    ]
  },
  {
    title: 'Development and Integration',
    items: [
      'IoT Device Integration: We integrate IoT sensors and devices into the existing infrastructure, ensuring seamless communication and data exchange.',
      'Software Development: Our software development team creates custom applications and interfaces for data collection, processing, and analysis.',
      'AI Model Development: We develop and train AI models to analyze the collected data, generate insights, and automate decision-making processes.'
    ]
  },
  {
    title: 'Testing and Validation',
    items: [
      'Unit and Integration Testing: Each component is thoroughly tested to ensure it functions correctly and integrates smoothly with other components.',
      'Performance Testing: We test the solution for performance, scalability, and reliability under various conditions and loads.',
      'Security Testing: Our team conducts rigorous security testing to identify and mitigate potential vulnerabilities.'
    ]
  },
  {
    title: 'Deployment & Ongoing Support',
    items: [
      'Deployment Planning: We create a detailed deployment plan, outlining the steps and timeline for rolling out the solution.',
      "Implementation & Training: We deploy with minimal disruption to existing operations and train your staff to manage the new system confidently.",
      'Ongoing Maintenance: We keep the solution up-to-date, secure, and performing optimally after launch.',
      "Technical Support: Our team resolves issues quickly and rolls out continuous improvements based on your feedback."
    ]
  }
];

---

<BaseLayout
  title="About Us: WSS DevLabs"
  description="WSS DevLabs is a Malaysian AI, IoT and systems company building intelligent solutions for agriculture, biomass, energy, smart cities and SMEs. Websites, apps and marketing also available."
  path="/about"
>

  <!-- "About Us" intro block: banner, story, vision/mission + portrait -->
  <section class="relative overflow-hidden pt-24 md:pt-40">
    <!-- Hero panel (reference layout): headline + vision/mission on the left, founder portrait on the right -->
    <Container class="relative pb-10 pt-6 md:pb-14 md:pt-0">
      <div class="relative grid overflow-hidden rounded-[2.25rem] bg-paper-dim md:min-h-[34rem] md:grid-cols-[1.05fr_0.95fr] md:rounded-[2.75rem]">
        <div class="relative z-10 flex flex-col justify-center gap-6 p-8 md:p-12 lg:p-16">
          <h2 class="font-display text-[clamp(2.2rem,1.3rem+3.4vw,4.2rem)] font-bold leading-[1.02] tracking-[-0.04em] text-ink">
            Our vision.<br />
            <span class="text-ink-dim">Our mission.</span>
          </h2>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <p class="text-xs font-bold uppercase tracking-wide text-accent">Our Vision</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-dim">To be the team Malaysian operators call when a problem lives outside the office: in the field, on the plant floor or across a city.</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wide text-accent">Our Mission</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-dim">To apply software, apps, AI, IoT, analytics and marketing to real problems in agriculture, biomass, energy, cities and SMEs, and to train the people who run them, as one team from site visit to support.</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href="/contact" class="inline-flex items-center rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition-transform hover:scale-105">Get in touch</a>
            <a href="/solutions" class="inline-flex items-center rounded-full border border-black/10 bg-white px-6 py-3 text-sm font-semibold text-ink transition-transform hover:scale-105">View solutions</a>
          </div>
        </div>

        <!-- Founder portrait: the photo has a white background, so it is blended (multiply) into the grey panel -->
        <div class="relative min-h-[26rem] overflow-hidden md:min-h-full" data-founder-photo>
          <div class="absolute inset-0 bg-gradient-to-b from-paper-dim to-paper-deep/70" aria-hidden="true"></div>
          <img
            src="/images/home/founder.webp"
            alt="Razali, founder of WSS DevLabs"
            width="1100"
            height="1445"
            loading="eager"
            class="absolute bottom-0 right-0 h-full w-auto max-w-none object-contain object-bottom mix-blend-multiply md:right-4"
          />

          <!-- Name card -->
          <div class="absolute bottom-4 left-4 right-4 rounded-[1.5rem] bg-white/85 p-5 backdrop-blur-md md:right-auto md:w-[17rem]">
            <p class="text-[0.7rem] font-semibold text-ink-dim">Founder</p>
            <p class="mt-0.5 font-display text-lg font-bold tracking-tight text-ink">Razali</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-dim">Builds it, ships it and supports it, so you always know who to call.</p>
          </div>
        </div>
      </div>
    </Container>

    <!-- Story: editorial layout. Huge heading overlaps a text card and two pictures. No photo background. -->
    <div class="mx-auto w-full max-w-[100rem] px-3 pb-10 pt-6 md:px-6 md:pb-16 md:pt-10">
      <div class="relative">
        <h1 class="relative z-20 max-w-[90%] font-display text-[clamp(2.4rem,1.2rem+6.4vw,7.2rem)] font-black uppercase leading-[0.88] tracking-[-0.045em] text-ink md:-mb-[0.32em]">
          Real problems, <span class="text-accent">real solutions</span>
        </h1>

        <div class="relative z-10 mt-4 grid gap-3 md:mt-0 md:grid-cols-[0.9fr_1.1fr] md:gap-4">
          <!-- text card -->
          <div class="rounded-[1.75rem] bg-paper-dim p-6 md:pb-8 md:pl-8 md:pr-8 md:pt-[4.2em] lg:text-[1rem]">
            <div class="space-y-3.5 text-[0.95rem] leading-relaxed text-ink-dim">
              <p>WSS DevLabs started small, as a software team building websites and business systems for local businesses. We enjoyed the work, but we kept noticing the same thing: the problems that really cost people sleep were not on a screen.</p>
              <p>A farm was losing crops to animals at night. A mill was guessing the moisture of its biomass. An office was paying for CCTV that nobody watched. These were not website problems, but they were real, and the people living with them deserved help just as much.</p>
              <p>So we learned. One problem at a time, we added sensors, cameras, AI models and training to what we already did, until we could walk beside a client from the first site visit to the dashboard their managers open every morning.</p>
              <p>Today we are a Malaysian team that wants to help everyone, from the single shop with a few cameras to the large plantation. We start small with a pilot, we explain things in plain words, and we hand over code you own, so you are never locked in.</p>
              <p>If something on your site keeps going wrong, we would love to hear about it. Often, one conversation is all it takes to see a way forward.</p>
            </div>
          </div>

          <!-- pictures -->
          <div class="grid gap-3 md:gap-4 md:grid-rows-[auto_1fr]">
            <!-- Original illustration, drawn in code: sensors and cameras on the left send readings through a gateway to a dashboard on the right -->
            <div class="about-strip relative hidden h-44 overflow-hidden rounded-[1.5rem] bg-charcoal md:block" aria-hidden="true">
              <svg class="absolute inset-0 h-full w-full" viewBox="0 0 800 176" preserveAspectRatio="xMidYMid slice" fill="none">
                <defs>
                  <pattern id="aboutGrid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" stroke="rgb(255 255 255 / 0.05)" /></pattern>
                  <linearGradient id="aboutLine" x1="0" x2="1"><stop offset="0" stop-color="#ff6a5a" /><stop offset="1" stop-color="#7aa2ff" /></linearGradient>
                  <linearGradient id="aboutArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7aa2ff" stop-opacity="0.35" /><stop offset="1" stop-color="#7aa2ff" stop-opacity="0" /></linearGradient>
                </defs>
                <rect width="800" height="176" fill="url(#aboutGrid)" />

                <!-- sensor and camera nodes -->
                <g class="about-node" fill="#ff6a5a">
                  <circle cx="70" cy="40" r="7" /><circle cx="70" cy="88" r="7" /><circle cx="70" cy="136" r="7" />
                </g>
                <g stroke="rgb(255 255 255 / 0.25)" stroke-width="1.5">
                  <path class="about-flow" d="M77 40 C 180 40, 190 88, 290 88" />
                  <path class="about-flow" d="M77 88 H290" />
                  <path class="about-flow" d="M77 136 C 180 136, 190 88, 290 88" />
                </g>

                <!-- gateway -->
                <rect x="290" y="64" width="64" height="48" rx="12" fill="rgb(255 255 255 / 0.08)" stroke="rgb(255 255 255 / 0.3)" />
                <circle cx="322" cy="88" r="6" fill="#fff" />
                <path d="M322 88 m-14 0 a14 14 0 0 1 28 0" stroke="rgb(255 255 255 / 0.35)" />
                <path class="about-flow" d="M354 88 H470" stroke="url(#aboutLine)" stroke-width="2" />

                <!-- moving readings -->
                <circle r="3.5" fill="#fff"><animateMotion dur="3s" repeatCount="indefinite" path="M77 40 C 180 40, 190 88, 290 88" /></circle>
                <circle r="3.5" fill="#fff"><animateMotion dur="3s" begin="1s" repeatCount="indefinite" path="M77 136 C 180 136, 190 88, 290 88" /></circle>
                <circle r="3.5" fill="#fff"><animateMotion dur="2.4s" repeatCount="indefinite" path="M354 88 H470" /></circle>

                <!-- dashboard -->
                <rect x="470" y="22" width="270" height="132" rx="16" fill="rgb(255 255 255 / 0.06)" stroke="rgb(255 255 255 / 0.2)" />
                <rect x="488" y="38" width="64" height="8" rx="4" fill="rgb(255 255 255 / 0.5)" />
                <rect x="660" y="38" width="64" height="8" rx="4" fill="rgb(255 255 255 / 0.15)" />
                <path d="M488 134 L520 112 L552 120 L584 90 L616 98 L648 70 L680 78 L724 52 V140 H488 Z" fill="url(#aboutArea)" />
                <path class="about-draw" d="M488 134 L520 112 L552 120 L584 90 L616 98 L648 70 L680 78 L724 52" stroke="url(#aboutLine)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
                <circle cx="724" cy="52" r="5" fill="#fff" />
              </svg>
            </div>
            <div class="relative min-h-[18rem] overflow-hidden rounded-[1.75rem] bg-charcoal md:min-h-[26rem]">
              <img src="/images/home/secbg2.webp" alt="The WSS DevLabs website shown on a laptop" width="1366" height="768" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-left-top" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <VisionBand />

  <!-- Eight-step scroll timeline: matte-dark, alternating, line fills as you scroll -->
  <section id="process" class="relative -mt-10 overflow-hidden rounded-t-[2.75rem] bg-charcoal py-16 md:-mt-14 md:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.05] [background-image:radial-gradient(circle,white_1px,transparent_1px)] [background-size:26px_26px]"
      aria-hidden="true"
    />
    <Container class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="h-display-xl !text-[clamp(2.1rem,1.5rem+2vw,3.1rem)] text-white" data-split>
          How we get you to launch
        </h2>
        <p class="mt-4 leading-relaxed text-white/60">
          From the first call to sign-off, here is exactly what happens and when.
        </p>
      </div>

      <div class="relative mt-16" data-timeline-track>
        <!-- Base rule + scroll-scrubbed fill, desktop -->
        <div class="absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 md:block" aria-hidden="true">
          <div class="absolute inset-0 bg-white/10" />
          <div class="absolute inset-0 bg-accent" style="transform-origin: top; transform: scaleY(0);" data-timeline-fill />
        </div>
        <!-- Mobile rule -->
        <div class="absolute left-4 top-0 h-full w-px bg-white/10 md:hidden" aria-hidden="true" />

        <div class="space-y-10 md:space-y-4">
          {
            STEPS.map((s, i) => (
              <div class="relative grid items-start gap-6 pl-12 md:grid-cols-[1fr_2.5rem_1fr] md:gap-x-8 md:pl-0">
                <span
                  class="stat-num absolute left-4 top-0 z-10 flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full bg-accent text-xs text-white ring-4 ring-charcoal md:relative md:left-auto md:top-auto md:col-start-2 md:mx-auto md:-translate-x-0"
                >
                  {s.n}
                </span>

                {i % 2 === 0 ? (
                  <>
                    <div
                      class="rounded-3xl border border-white/10 bg-charcoal-soft p-6 md:col-start-1 md:row-start-1"
                      data-reveal="tilt3d"
                    >
                      <h3 class="text-lg font-semibold tracking-tight text-white">{s.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-white/60">{s.description}</p>
                    </div>
                    <div class="hidden md:col-start-3 md:row-start-1 md:block" aria-hidden="true" />
                  </>
                ) : (
                  <>
                    <div class="hidden md:col-start-1 md:row-start-1 md:block" aria-hidden="true" />
                    <div
                      class="rounded-3xl border border-white/10 bg-charcoal-soft p-6 md:col-start-3 md:row-start-1"
                      data-reveal="tilt3d"
                    >
                      <h3 class="text-lg font-semibold tracking-tight text-white">{s.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-white/60">{s.description}</p>
                    </div>
                  </>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Solution Development Process: horizontal timeline. The line fills as the active phase moves on, finished phases get a tick. -->
  <section class="bg-paper py-16 md:py-24" data-phase-timeline>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="h-section" data-split>The Solution Development Process</h2>
        <p class="mt-4 text-sm leading-relaxed text-ink-dim">Six phases, from the first conversation to support that keeps going after launch. Tap a phase to see what happens in it.</p>
      </div>

      <!-- Timeline -->
      <div class="relative mt-14 rounded-[1.75rem] bg-paper-dim px-4 pb-6 pt-8 sm:px-8">
        <div class="relative">
          <!-- base line and animated fill (they run between the first and last circle centres) -->
          <div class="absolute left-[calc(100%/12)] right-[calc(100%/12)] top-5 h-1 -translate-y-1/2 rounded-full bg-ink/10" aria-hidden="true">
            <div class="h-full w-0 rounded-full bg-accent transition-[width] duration-[900ms] ease-out" data-phase-fill></div>
          </div>

          <ol class="relative grid grid-cols-6">
            {
              SOLUTION_PHASES.map((phase, i) => (
                <li class="flex flex-col items-center text-center">
                  <button
                    type="button"
                    data-phase-node={i}
                    aria-label={`Phase ${i + 1}: ${phase.title}`}
                    class="phase-node group flex flex-col items-center gap-3 outline-none"
                  >
                    <span class="phase-dot relative flex h-10 w-10 items-center justify-center rounded-full border-2 border-ink/15 bg-white text-sm font-bold text-ink-dim transition-all duration-500">
                      <span class="phase-num">{i + 1}</span>
                      <svg class="phase-check absolute h-5 w-5 scale-0 text-white transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                    </span>
                    <span class="hidden px-1 text-[0.7rem] font-semibold leading-snug text-ink-dim transition-colors group-aria-selected:text-ink md:block">{phase.title}</span>
                  </button>
                </li>
              ))
            }
          </ol>
        </div>

        <!-- Detail of the selected phase -->
        <div class="mt-8 border-t border-black/10 pt-6">
          {
            SOLUTION_PHASES.map((phase, i) => (
              <div class="phase-panel" data-phase-panel={i} hidden={i !== 0}>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-display text-xl font-bold tracking-tight text-ink">
                    <span class="mr-2 font-feature text-accent">{String(i + 1).padStart(2, '0')}</span>{phase.title}
                  </h3>
                  <p class="text-xs font-semibold text-ink-dim">Phase {i + 1} of {SOLUTION_PHASES.length}</p>
                </div>
                <ul class="mt-5 grid gap-4 md:grid-cols-3">
                  {phase.items.map((item) => {
                    const [head, ...rest] = item.split(': ');
                    const desc = rest.join(': ');
                    return (
                      <li class="phase-item rounded-[1.25rem] bg-white p-5 text-sm leading-relaxed text-ink-dim">
                        <strong class="block text-ink">{head}</strong>
                        {desc}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <FaqSection />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTimelineFill() {
    const track = document.querySelector<HTMLElement>('[data-timeline-track]');
    const fill = document.querySelector<HTMLElement>('[data-timeline-fill]');
    if (!track || !fill) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.to(fill, {
      scaleY: 1,
      ease: 'none',
      scrollTrigger: { trigger: track, start: 'top 65%', end: 'bottom 65%', scrub: true }
    });
  }

  initTimelineFill();
  document.addEventListener('astro:page-load', initTimelineFill);
</script>

<style is:global>
  /* states: done (tick), current (filled red, ringed), later (muted) */
  .phase-node[data-state='done'] .phase-dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  .phase-node[data-state='done'] .phase-num { opacity: 0; }
  .phase-node[data-state='done'] .phase-check { transform: scale(1); }
  .phase-node[data-state='current'] .phase-dot {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
    transform: scale(1.12);
    box-shadow: 0 0 0 6px rgb(18 18 20 / 0.1);
  }
  .phase-node[data-state='current'] span.hidden { color: var(--color-ink); }
  .phase-node:hover .phase-dot { transform: scale(1.1); }
  .phase-node:focus-visible .phase-dot { outline: 2px solid var(--color-ink); outline-offset: 3px; }

  .phase-panel:not([hidden]) .phase-item {
    animation: phase-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .phase-panel:not([hidden]) .phase-item:nth-child(2) { animation-delay: 0.08s; }
  .phase-panel:not([hidden]) .phase-item:nth-child(3) { animation-delay: 0.16s; }
  .phase-panel:not([hidden]) .phase-item:nth-child(4) { animation-delay: 0.24s; }
  @keyframes phase-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .phase-panel .phase-item { animation: none !important; }
    [data-phase-fill] { transition-duration: 0.01ms; }
  }
</style>

<script>
  // The active phase advances every 3.5 seconds once the timeline is on screen. Hovering or tapping a phase jumps to it.
  function initPhaseTimeline() {
    document.querySelectorAll<HTMLElement>('[data-phase-timeline]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const nodes = Array.from(root.querySelectorAll<HTMLElement>('[data-phase-node]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-phase-panel]'));
      const fill = root.querySelector<HTMLElement>('[data-phase-fill]');
      if (!nodes.length || !fill) return;
      let current = 0;
      let timer = 0;
      let started = false;

      const show = (index: number) => {
        current = index;
        nodes.forEach((node, i) => {
          node.dataset.state = i < index ? 'done' : i === index ? 'current' : 'later';
          node.setAttribute('aria-selected', i === index ? 'true' : 'false');
        });
        panels.forEach((panel, i) => (panel.hidden = i !== index));
        fill.style.width = `${(index / (nodes.length - 1)) * 100}%`;
      };

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const play = () => {
        window.clearInterval(timer);
        if (reduce) return;
        timer = window.setInterval(() => {
          if (!document.body.contains(root)) return window.clearInterval(timer);
          if (document.hidden) return;
          show((current + 1) % nodes.length);
        }, 3500);
      };

      nodes.forEach((node, i) => {
        const pick = () => {
          show(i);
          play();
        };
        node.addEventListener('click', pick);
        node.addEventListener('mouseenter', pick);
      });

      show(0);
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting && !started) {
            started = true;
            play();
          }
        },
        { threshold: 0.35 }
      );
      io.observe(root);
    });
  }
  document.addEventListener('astro:page-load', initPhaseTimeline);
</script>

<style is:global>
  .about-flow { stroke-dasharray: 5 6; animation: about-dash 1.6s linear infinite; }
  @keyframes about-dash { to { stroke-dashoffset: -22; } }
  .about-node circle { animation: about-pulse 2.4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .about-node circle:nth-child(2) { animation-delay: 0.4s; }

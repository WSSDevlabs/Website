---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import { MARKETPLACE_SYSTEMS, type MarketplaceSystem } from '../../data/marketplace';

const totalSystems = MARKETPLACE_SYSTEMS.length;

const CATEGORY_META: Record<string, { icon: string; description: string }> = {
  'Facility & Operations Management': {
    icon: 'M2.25 21h19.5M4.5 3h6v18h-6zM10.5 8.25h6V21h-6zM16.5 12h4.5v9h-4.5z',
    description: 'Booking, meal redemption, hostel, parcel, and facility-management systems for busy sites.'
  },
  'Corporate Operations': {
    icon: 'M2.25 21h19.5M4.5 21V9.75l7.5-6 7.5 6V21M9.75 21v-6h4.5v6',
    description: 'Attendance, HR, asset, and internal-operations tools for growing teams.'
  },
  'Security & Access Control': {
    icon: 'M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
    description: 'ID issuance, visitor management, patrol, and incident-response systems.'
  },
  'Venues & Hospitality': {
    icon: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5',
    description: 'Booking engines, ticketing, and event tools for venues and organizers.'
  },
  'IoT & Monitoring': {
    icon: 'M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z',
    description: 'Real-time machine, energy, and equipment monitoring systems.'
  },
  'Developer Tools': {
    icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
    description: 'Portals, infrastructure, and immersive experience platforms.'
  },
  'Commerce & Rental': {
    icon: 'M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 1.9-4.652 2.257-7.126a1.125 1.125 0 0 0-1.13-1.243H4.117L3.85 4.402A1.125 1.125 0 0 0 2.762 3.6H2.25m6 15.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm11.25 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z',
    description: 'Point-of-sale and business directory systems for retail and services.'
  },
  'Real Estate & CRM': {
    icon: 'M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205 3 1m1.5.5-1.5-.5M6.75 7.364V3h-3v18m3-13.636 10.5-3.819',
    description: 'Lead and pipeline tracking built for contractors and service providers.'
  },
  'Health & Services': {
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z',
    description: 'Appointment booking and patient queue management for clinics.'
  }
};

type GroupedCategory = { name: string; icon: string; description: string; systems: MarketplaceSystem[] };

const categories: GroupedCategory[] = Object.entries(
  MARKETPLACE_SYSTEMS.reduce<Record<string, MarketplaceSystem[]>>((acc, system) => {
    (acc[system.category] ??= []).push(system);
    return acc;
  }, {})
)
  .map(([name, systems]) => ({
    name,
    icon: CATEGORY_META[name]?.icon ?? 'M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
    description: CATEGORY_META[name]?.description ?? 'Production-ready systems in this category.',
    systems
  }))
  .sort((a, b) => b.systems.length - a.systems.length);
---

<BaseLayout
  title="The WSS Marketplace: Buy-Once, Own-Forever Business Systems"
  description="Production-ready, high-performance business systems with full source code ownership. Zero monthly subscriptions, Ed25519 offline licensing, and integrated Malaysian payment gateways."
  path="/marketplace"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-10 pb-20 md:pt-40 md:pb-28">
    <div class="grid-pattern mask-fade-edges absolute inset-0 opacity-25" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 top-1/4 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-40 top-0 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>

    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl md:text-6xl">
          The WSS <span class="badge-highlight">Marketplace</span>
        </h1>
      </div>
    </Container>
  </section>

  <!-- Interactive Catalog Section -->
  <Section rule class="bg-paper-dim/30">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold text-ink md:text-3xl">
          Browse {totalSystems} Systems Across {categories.length} Categories
        </h2>
        <p class="mt-2 text-sm text-ink-dim">Hover a category to see what's inside, or tap on mobile.</p>
      </div>

      <!-- Category Browser: hover/tap a category to reveal its systems -->
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((cat) => (
            <div
              tabindex="0"
              class="category-card group relative flex flex-col rounded-2xl border border-line bg-paper p-6 shadow-sm transition-all duration-300 hover:border-accent hover:shadow-lg focus:border-accent focus:shadow-lg focus:outline-none"
            >
              <div class="flex items-start justify-between gap-3">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/8 text-accent">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d={cat.icon} />
                  </svg>
                </span>
                <span class="rounded-full bg-paper-dim px-2.5 py-1 text-[11px] font-bold text-ink-dim">
                  {cat.systems.length} System{cat.systems.length === 1 ? '' : 's'}
                </span>
              </div>

              <h3 class="mt-4 text-base font-bold text-ink">{cat.name}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-ink-dim">{cat.description}</p>

              <p class="category-hint mt-4 flex items-center gap-1.5 text-[11px] font-semibold text-accent transition-opacity duration-200 group-hover:opacity-0 group-focus:opacity-0">
                Hover to see systems
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </p>

              {/* Reveal panel: collapsed by default, expands on hover/focus */}
              <div class="category-reveal grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 [transition-timing-function:var(--ease-out-expo)] group-hover:grid-rows-[1fr] group-focus:grid-rows-[1fr]">
                <div class="overflow-hidden">
                  <div class="mt-4 max-h-56 space-y-1 overflow-y-auto border-t border-line pt-3">
                    {cat.systems.map((system) => (
                      <a
                        href={`/marketplace/${system.slug}`}
                        class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-xs font-medium text-ink-dim transition-colors hover:bg-paper-dim hover:text-ink"
                      >
                        <span class="truncate">{system.name}</span>
                        <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- The "Buy-Once" Philosophy & Why It Matters -->
  <Section rule>
    <Container>
      <div class="rounded-3xl border border-line bg-ink p-8 text-white md:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <h2 class="font-display text-2xl font-bold tracking-tight text-white md:text-3xl">
              Why Malaysian SMEs Are Escaping Subscription Lock-In.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-white/70">
              When you build on SaaS platforms, you never own your software. If you stop paying your monthly bill, your store or booking system turns off instantly.
              WSS Marketplace systems give you <strong>100% full source code ownership</strong> with no monthly taxes, no transaction commissions, and total data privacy under Malaysian PDPA.
            </p>

            <div class="mt-6 grid grid-cols-2 gap-4">
              <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
                <p class="font-bold text-accent-yellow-vivid">Ed25519 License</p>
                <p class="mt-1 text-xs text-white/60">Offline signature verification that never depends on third-party DRM servers.</p>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
                <p class="font-bold text-emerald-400">Zero Commission</p>
                <p class="mt-1 text-xs text-white/60">100% of payments go straight through your ToyyibPay / SenangPay / Stripe merchant account.</p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/15 bg-white/5 p-6 backdrop-blur-md">
            <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider">What You Receive In Every Order:</h3>
            <ul class="mt-4 space-y-3 text-xs text-white/80">
              <li class="flex items-start gap-2.5">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Full Unencrypted Source Code</strong>: Clean, typed, and easily extendable.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Relational MySQL / SQLite Schemas</strong>: Pre-indexed for sub-50ms database performance.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-accent font-bold">✓</span>
                <span><strong>One-Command Deployment Guide</strong>: Host easily on cPanel, CyberPanel, VPS, or Docker.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Direct Builder Technical Support</strong>: 30 days direct WhatsApp support with Razali.</span>
              </li>
            </ul>

            <div class="mt-6 pt-4 border-t border-white/10">
              <a
                href="https://wa.me/601127205895?text=Hi%20WSS%20DevLabs%2C%20I'd%20like%20to%20ask%20about%20a%20Marketplace%20system%20license."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-accent-dim"
              >
                Questions? WhatsApp an Engineer Now
              </a>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import VideoMedia from '../components/media/VideoMedia.astro';
import DemoStage from '../components/sections/DemoStage.astro';
import PilotProcess from '../components/sections/PilotProcess.astro';
import CTABand from '../components/sections/CTABand.astro';
import { DEMOS } from '../data/demos';
import { CLIPS } from '../data/media';
import { MARKETPLACE_SYSTEMS } from '../data/marketplace';

// Sample systems shown in full. The rest are listed by name only; the full
// catalogue moves to the WSS store later. The data stays in marketplace.ts.
const FEATURED = [
  'wss-machinemonitoring',
  'wss-energysaving',
  'wss-iotboard',
  'wss-assetmanagement',
  'wss-aivoice',
  'wss-aimeetingnotes',
  'wss-smartid',
  'wss-buildright'
];

const featured = FEATURED.map((slug) => MARKETPLACE_SYSTEMS.find((s) => s.slug === slug)).filter(
  (s): s is NonNullable<typeof s> => Boolean(s)
);
const others = MARKETPLACE_SYSTEMS.filter((s) => !FEATURED.includes(s.slug));
const shortName = (name: string) => name.replace(/^WSS\s+/, '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'WSS Systems & Labs',
  description: 'Sample AI, IoT and business systems from WSS DevLabs, plus demos of AI detection, IoT monitoring and digital twins.',
  hasPart: [
    ...DEMOS.map((demo) => ({ '@type': 'CreativeWork', name: demo.title, description: demo.summary })),
    ...featured.map((s) => ({ '@type': 'SoftwareApplication', name: s.name, description: s.summary, applicationCategory: 'BusinessApplication' }))
  ]
};
---

<BaseLayout
  title="Systems & Labs: AI, IoT and Business Systems | WSS DevLabs"
  description="Sample systems and live demos from WSS DevLabs: machine monitoring, energy saving, asset management, AI voice and meeting notes, smart ID, wild animal detection and digital twins."
  path="/systems"
  schema={schema}
>
  <!-- Hero -->
  <section class="pb-6 pt-6 md:pb-10 md:pt-32" data-noreveal>
    <Container>
      <div class="relative isolate overflow-hidden rounded-[2.5rem] bg-charcoal px-6 py-16 text-white shadow-2xl sm:px-12 md:py-24 lg:px-16">
        <div class="absolute inset-0 -z-10 opacity-45">
          <VideoMedia clip={CLIPS.network} eager class="h-full w-full !bg-transparent" />
        </div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-charcoal via-charcoal/85 to-charcoal/30" aria-hidden="true"></div>
        <div class="grid-pattern absolute inset-0 -z-10 opacity-[0.07] invert" aria-hidden="true"></div>
        <div data-scene="network" data-scene-props='{"radius":2.4,"count":190}' class="pointer-events-none absolute -right-[10%] top-0 -z-10 hidden h-full w-[65%] md:block" aria-hidden="true"></div>

        <div class="max-w-2xl">
          <p data-hero-item data-hero-delay="0" class="mono-label text-white/60" data-scramble>Systems &amp; Labs</p>
          <h1 data-hero-item data-hero-delay="0.08" class="h-display mt-5 !text-[clamp(2.4rem,1.3rem+4vw,4.6rem)] !text-white">
            Systems we have built, <span class="badge-highlight">demos</span> you can watch
          </h1>
          <p data-hero-item data-hero-delay="0.16" class="mt-6 text-base leading-relaxed text-white/70 sm:text-lg">
            A few of our AI, IoT and business systems, and the prototypes where your pilot starts.
          </p>
          <div data-hero-item data-hero-delay="0.24" class="mt-8 flex flex-wrap gap-4">
            <a href="#demos" class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-bold text-ink shadow-md transition-all hover:scale-105">
              Watch the demos
            </a>
            <a href="#systems" class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur-md transition-all hover:scale-105 hover:bg-white/20">
              See the systems
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <div id="demos"></div>
  <DemoStage />

  <!-- Sample systems -->
  <section id="systems" class="band-light scroll-mt-24 py-16 md:py-24">
    <Container>
      <div class="max-w-2xl">
        <h2 class="h-section font-black tracking-tight text-ink">Sample <span class="badge-highlight">systems</span></h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Eight of the systems we build. Each is tailored to your site and data, and you own the code.
        </p>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-[2rem] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          featured.map((system) => (
            <button
              type="button"
              data-open-system={system.slug}
              class="group flex flex-col items-start bg-white p-6 text-left transition-colors hover:bg-paper sm:p-7"
            >
              <span class="rounded-full bg-paper-dim px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide text-ink-dim">{system.category}</span>
              <h3 class="mt-4 text-lg font-bold tracking-tight text-ink">{shortName(system.name)}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-dim">{system.summary}</p>
              <div class="mt-5 flex w-full items-center justify-between">
                <span class="text-sm font-bold text-ink">{system.price}</span>
                <span class="inline-flex items-center gap-1 text-sm font-bold text-accent">
                  Details
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </div>
            </button>
          ))
        }
      </div>

      <div class="mt-10 rounded-[2rem] border border-line bg-white p-6 sm:p-8">
        <p class="text-sm font-bold text-ink">Also built</p>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">
          {others.map((s) => shortName(s.name)).join(' · ')}
        </p>
        <div class="mt-6 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-xl text-sm leading-relaxed text-ink-dim">The full catalogue is moving to the WSS Store. Until then, ask us for any system and we will send a quote.</p>
          <a href="/contact?topic=Systems" class="inline-flex shrink-0 items-center justify-center rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white transition-all hover:scale-105 hover:bg-black">
            Ask for a quote
          </a>
        </div>
      </div>
    </Container>
  </section>

  {
    featured.map((system) => (
      <dialog id={`system-${system.slug}`} class="system-dialog m-auto w-[min(42rem,92vw)] rounded-[2rem] border border-line bg-white p-0 text-ink shadow-2xl backdrop:bg-black/50">
        <div class="max-h-[85vh] overflow-y-auto p-7 sm:p-9">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-wide text-accent">{system.category}</p>
              <h3 class="mt-2 font-display text-2xl font-bold tracking-tight">{system.name}</h3>
              <p class="mt-1 text-sm text-ink-dim">{system.tagline}</p>
            </div>
            <form method="dialog">
              <button aria-label="Close" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line text-ink transition hover:bg-paper-dim">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              </button>
            </form>
          </div>
          <p class="mt-5 text-sm leading-relaxed text-ink-dim">{system.summary}</p>
          <p class="mt-4 text-sm"><span class="font-bold text-ink">Built for:</span> <span class="text-ink-dim">{system.target}</span></p>
          <ul class="mt-5 grid gap-2.5 sm:grid-cols-2">
            {system.features.slice(0, 6).map((feature) => (
              <li class="flex gap-2.5 text-sm leading-snug text-ink">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                {feature}
              </li>
            ))}
          </ul>
          <div class="mt-7 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-lg font-bold">{system.price}</p>
              <p class="text-xs text-ink-dim">{system.pricingModel}</p>
            </div>
            <a href={`/contact?topic=${encodeURIComponent(system.name)}`} class="inline-flex items-center justify-center rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white transition-all hover:scale-105 hover:bg-black">
              Ask about this system
            </a>
          </div>
        </div>
      </dialog>
    ))
  }

  <PilotProcess />

  <CTABand
    title="Bring us a problem to prototype."
    subtitle="Describe what goes wrong on site. We reply within one business day."
    ctaLabel="Start a pilot"
    ctaHref="/contact?topic=Pilot"
  />
</BaseLayout>

<script>
  function initSystemDialogs() {
    document.querySelectorAll<HTMLElement>('[data-open-system]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const dialog = document.getElementById(`system-${btn.dataset.openSystem}`) as HTMLDialogElement | null;
        dialog?.showModal();
      });
    });
    document.querySelectorAll<HTMLDialogElement>('.system-dialog').forEach((dialog) => {
      if (dialog.dataset.bound) return;
      dialog.dataset.bound = '1';
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }
  document.addEventListener('astro:page-load', initSystemDialogs);
</script>

---
import LegalLayout from '../components/legal/LegalLayout.astro';
import LegalIdentity from '../components/legal/LegalIdentity.astro';
import { CARE_PLANS, CARE_PLAN_ROWS, CARE_PRO_EXTRA_SITE_MONTHLY, formatRM } from '../data/catalog';

const lastUpdated = new Date('2026-10-11');

const toc = [
  { id: 'plans', label: '1. Plans and prices' },
  { id: 'included', label: '2. What each plan includes' },
  { id: 'meanings', label: '3. What the terms mean' },
  { id: 'not-included', label: '4. Not included' },
  { id: 'your-part', label: '5. Your part' },
  { id: 'data', label: '6. Your data' },
  { id: 'billing', label: '7. Billing, changes and cancelling' },
  { id: 'handover', label: '8. When a plan ends' }
];
---

<LegalLayout
  title="Care Plan Terms"
  description="What WSS DevLabs Care Plans include: hosting, monitoring, backups, updates, small edits and response times, plus billing and cancellation."
  path="/care-plan-terms/"
  lastUpdated={lastUpdated}
  intro="A summary of our Care Plan service levels. Your Care Plan agreement may add details for your site or system, and our Terms apply to every plan."
  toc={toc}
>
  <LegalIdentity />

  <h2 id="plans">1. Plans and prices</h2>
  <ul>
    {CARE_PLANS.map((plan) => <li><strong>{plan.name}:</strong> {plan.price}{plan.annual ? `, or ${plan.annual}` : ''}. {plan.forWho}</li>)}
    <li>Ecosystem packages with more than one site: {formatRM(CARE_PRO_EXTRA_SITE_MONTHLY)}/month per extra site on Care Pro.</li>
  </ul>

  <h2 id="included">2. What each plan includes</h2>
  <table>
    <thead>
      <tr>
        <th></th>
        {CARE_PLANS.map((plan) => <th>{plan.name}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        CARE_PLAN_ROWS.map(([label, ...values]) => (
          <tr>
            <th>{label}</th>
            {values.map((value) => (
              <td>{value}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2 id="meanings">3. What the terms mean</h2>
  <ul>
    <li><strong>Working day:</strong> Monday to Friday, excluding Malaysian public holidays.</li>
    <li><strong>Response time:</strong> how soon we start working on your request and tell you what happens next. It isn't a promise that every fix is finished in that time.</li>
    <li><strong>Critical issue:</strong> your site or system is down, or there is a security incident.</li>
    <li><strong>Small edits:</strong> content changes such as text, images, prices or a new blog post. New pages, features or redesigns are quoted separately.</li>
    <li><strong>Unused edit time</strong> doesn't carry over to the next month.</li>
    <li><strong>Backups:</strong> daily backups (weekly on Hosting Only) are kept for at least 14 days and can be restored on request.</li>
  </ul>

  <h2 id="not-included">4. Not included</h2>
  <ul>
    <li>New features, redesigns and new pages (we quote these at a fixed price first).</li>
    <li>Problems caused by changes made by you or others, or by third-party services and plugins.</li>
    <li>Outages of third-party providers outside our control.</li>
    <li>Hardware faults, which are covered by the supplier's warranty.</li>
  </ul>

  <h2 id="your-part">5. Your part</h2>
  <p>
    Give us the access we need, tell us before making your own changes to the site or system, and keep your contact details up to
    date so we can reach you in an emergency.
  </p>

  <h2 id="data">6. Your data</h2>
  <p>
    While we look after your site or system we may be able to see personal data in it. You are the data controller; we act as your
    data processor, only on your instructions, under a Data Processing Agreement that we sign with you before the plan starts.
  </p>

  <h2 id="billing">7. Billing, changes and cancelling</h2>
  <ul>
    <li>Plans are billed monthly or yearly in advance.</li>
    <li>We give at least 30 days' notice of any price change.</li>
    <li>Monthly plans can be cancelled any time, effective at the end of the paid month. Yearly plans follow our <a href="/refunds/">Refund Policy</a>.</li>
    <li>Ecosystem packages require Care Pro while the system is in use, because security and health systems can't be left unmaintained.</li>
  </ul>

  <h2 id="handover">8. When a plan ends</h2>
  <p>
    You keep everything. We hand over your latest backup, all credentials and anything we were holding for you, and help move your
    hosting if you ask.
  </p>
</LegalLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import WebsiteQuoteCalculator from '../components/sections/WebsiteQuoteCalculator.astro';
import CarePlans from '../components/sections/CarePlans.astro';
import GoDigitalBundle from '../components/sections/GoDigitalBundle.astro';
import CTABand from '../components/sections/CTABand.astro';
import { HOSTING_SITE_YEARLY, HOSTING_STORE_YEARLY, WEBSITE_PACKAGES, formatRM } from '../data/catalog';
import { WEBSITES_FAQ, type QA } from '../data/faqs';
import { SITE } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();
const fromPrice = Math.min(...WEBSITE_PACKAGES.map((p) => p.price));

const overview: Record<string, string> = {
  'one-page': 'A professional page that appears on Google and turns visitors into WhatsApp chats.',
  business: 'A credible, fast website you can edit yourself, built to bring in enquiries.',
  store: 'Your own online store, so you keep your margin and your customer list.'
};

const paymentSummary: Record<string, string> = {
  'one-page': '50% to start, 50% before going live.',
  business: '50% to start, 50% when you approve the staging site.',
  store: '40% to start, 30% at design approval, 30% before going live.'
};

const education = [
  {
    title: "What's a CMS, and why does it matter?",
    body: "A CMS is the editor behind your website. With one, you update prices, photos and news yourself in minutes. Without one, every small change costs a developer's time, so most businesses stop updating, and an outdated site quietly loses customers.",
    link: { label: 'Read the full guide', href: '/insights/what-is-a-cms-and-why-it-matters/' }
  },
  {
    title: 'Why not just a Facebook page?',
    body: "Facebook pages rarely rank in Google, can be restricted without warning, and you don't own them. A website on your own domain is an asset you control. Most customers check Google before they WhatsApp you."
  },
  {
    title: 'Own store or marketplace?',
    body: 'Marketplaces bring traffic but take a commission on every sale and own the customer relationship. Your own store keeps your margin and your customer list, so you can sell to them again. Many brands use both: the marketplace for discovery, their own store for repeat buyers.'
  },
  {
    title: 'Why does SEO take months?',
    body: 'Google needs time to crawl, trust and rank a site. Reviews, consistent business details and helpful pages build that trust. Expect early movement in 4 to 8 weeks and meaningful results in 3 to 6 months. Anyone who guarantees rankings is guessing.'
  }
];

const pick = (q: string) => WEBSITES_FAQ.find((item) => item.q === q) as QA;

const faqCategories: { id: string; label: string; items: QA[] }[] = [
  {
    id: 'pricing',
    label: 'Packages & payment',
    items: [
      pick('How do payments work?'),
      {
        q: 'Are there any monthly fees?',
        a: `No software rent. From year 2 you pay for hosting and your domain (${formatRM(HOSTING_SITE_YEARLY)} a year for websites, ${formatRM(HOSTING_STORE_YEARLY)} for stores), or choose a Care Plan that includes them.`
      },
      { q: 'Do you add SST?', a: 'No. Our prices are final, with no SST added.' }
    ]
  },
  {
    id: 'process',
    label: 'Getting started',
    items: [
      pick('What do I need to prepare?'),
      {
        q: 'How long does it take?',
        a: 'One-Page: 5 working days after you send your content. Business: 2 to 3 weeks. Store: 3 to 5 weeks. Missing content is the most common cause of delay, so the sooner it arrives, the sooner you are live.'
      },
      {
        q: 'Who builds my website?',
        a: 'Razali, the founder. You talk to the person building your site, with no account managers in between.'
      }
    ]
  },
  {
    id: 'after',
    label: 'After launch',
    items: [
      pick('Can I update the website myself?'),
      pick('What happens after the first year?'),
      pick('Will moving to a new website hurt my Google rankings?'),
      pick('Is the speed promise real?')
    ]
  }
];

const allFaqs = faqCategories.flatMap((cat) => cat.items);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Fixed-price websites',
  provider: { '@id': `${siteUrl}#organization` },
  areaServed: { '@type': 'Country', name: 'Malaysia' },
  offers: WEBSITE_PACKAGES.map((pkg) => ({
    '@type': 'Offer',
    name: pkg.name,
    price: String(pkg.price),
    priceCurrency: 'MYR',
    description: pkg.whoFor
  }))
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    serviceSchema,
    faqSchema(allFaqs),
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Websites', path: '/websites/' }
    ])
  ]
};
---

<BaseLayout
  title="Fixed-Price Websites for Malaysian SMEs, from RM569"
  description="One-Page website RM569, Business website RM2,990, Store website RM5,590. Fixed prices, your domain in your name, and you own the code. Live in 5 days to 5 weeks."
  path="/websites/"
  schema={schema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-10 pb-20 md:pt-40 md:pb-28">
    <div class="grid-pattern mask-fade-edges absolute inset-0 opacity-25" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 -top-40 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>

    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl md:text-6xl">
          Fixed-price websites <br class="hidden sm:inline" />
          <span class="badge-highlight">for Malaysian SMEs.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg">
          Live in 5 days to 5 weeks, depending on the package. Your domain is registered in your name, and you own the design,
          code and content once you've paid.
        </p>
        <!-- Trust Signals Bar -->
        <div class="mt-12 rounded-3xl sm:rounded-full border border-line bg-white p-6 sm:px-10 sm:py-7 shadow-card">
          <div class="grid grid-cols-2 gap-6 sm:grid-cols-4 sm:divide-x sm:divide-line text-center">
            <div class="flex flex-col items-center justify-center">
              <p class="font-feature text-2xl font-black text-ink">{formatRM(fromPrice)}</p>
              <p class="mt-1 text-xs text-ink-dim">Websites from</p>
            </div>
            <div class="flex flex-col items-center justify-center sm:pl-6">
              <p class="font-feature text-2xl font-black text-ink">5 Days</p>
              <p class="mt-1 text-xs text-ink-dim">Fastest go-live</p>
            </div>
            <div class="flex flex-col items-center justify-center sm:pl-6">
              <p class="font-feature text-2xl font-black text-accent">100%</p>
              <p class="mt-1 text-xs text-ink-dim">Your code and domain</p>
            </div>
            <div class="flex flex-col items-center justify-center sm:pl-6">
              <p class="font-feature text-2xl font-black text-emerald-600">Direct</p>
              <p class="mt-1 text-xs text-ink-dim">Talk to the builder</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Packages Grid -->
  <Section id="packages" rule>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">
          Three packages. One price each.
        </h2>
        <p class="mt-3 text-sm text-ink-dim">Prices are final, with no SST added. Every package lists exactly what's included, and what isn't.</p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-3 lg:items-stretch">
        {
          WEBSITE_PACKAGES.map((pkg) => {
            const highlight = Boolean(pkg.badge);
            return (
              <div
                id={pkg.id}
                class:list={[
                  'relative flex flex-col justify-between rounded-2xl border p-7 transition-all duration-300',
                  highlight
                    ? 'border-accent bg-paper shadow-2xl ring-2 ring-accent/20 lg:-translate-y-2'
                    : 'border-line bg-paper-dim/40 hover:border-line-hover hover:bg-paper'
                ]}
              >
                {pkg.badge && (
                  <div class="absolute -top-3.5 right-6 rounded-full bg-accent px-3 py-0.5 text-xs font-semibold text-white shadow-sm">
                    {pkg.badge}
                  </div>
                )}

                <div>
                  <h3 class="text-xl font-bold text-ink">{pkg.name}</h3>
                  <p class="mt-2 flex items-baseline gap-2">
                    <span class="font-feature text-3xl font-black tracking-tight text-ink">{formatRM(pkg.price)}</span>
                    <span class="text-xs text-ink-dim">one-time</span>
                  </p>
                  <p class="mt-1 text-xs font-medium text-accent">{pkg.whoFor}</p>
                  <p class="mt-3 text-xs leading-relaxed text-ink-dim">{overview[pkg.id]}</p>

                  <div class="my-6 border-y border-line/60 py-4">
                    <div class="mt-2 flex items-center gap-2 text-xs text-ink-dim">
                      <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                      <span><strong>{pkg.timeline}</strong></span>
                    </div>
                  </div>

                  <!-- Features list -->
                  <p class="text-xs font-bold uppercase tracking-wider text-ink">What's Included:</p>
                  <ul class="mt-3 space-y-2.5 text-xs text-ink-dim">
                    {pkg.highlights.map((feature) => (
                      <li class="flex items-start gap-2.5">
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>

                  <!-- Specs Box -->
                  <div class="mt-6 rounded-xl border border-line/70 bg-paper-deep/40 p-3 text-[11px] text-ink-dim">
                    <p class="font-semibold text-ink">The fine print:</p>
                    <p class="mt-1">· <strong>Payment:</strong> {paymentSummary[pkg.id]}</p>
                    <p>· <strong>Year 2:</strong> {pkg.renewal.replace('From year 2: ', '')}</p>
                    <p>· <strong>Revisions:</strong> {pkg.spec.revisions}</p>
                    <p>· <strong>Warranty:</strong> {pkg.spec.warranty}</p>
                  </div>

                  <details class="group mt-4 text-[11px] text-ink-dim">
                    <summary class="flex cursor-pointer list-none items-center gap-1.5 font-semibold text-ink transition-colors hover:text-accent">
                      See everything included
                      <svg class="h-3 w-3 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                      </svg>
                    </summary>
                    <div class="mt-3 space-y-3 leading-relaxed">
                      <div>
                        <p class="font-semibold text-ink">Included</p>
                        <ul class="mt-1 list-disc space-y-1 pl-4">
                          {pkg.spec.included.map((item) => <li>{item}</li>)}
                        </ul>
                      </div>
                      <div>
                        <p class="font-semibold text-ink">Not included</p>
                        <ul class="mt-1 list-disc space-y-1 pl-4">
                          {pkg.spec.notIncluded.map((item) => <li>{item}</li>)}
                        </ul>
                      </div>
                      <p><strong class="text-ink">You provide:</strong> {pkg.spec.youProvide}</p>
                      <p><strong class="text-ink">Handover:</strong> {pkg.spec.handover}</p>
                    </div>
                  </details>
                </div>

                <div class="mt-8 pt-4">
                  <a
                    href={`/contact/?package=${pkg.id}`}
                    data-track="quote_click"
                    class:list={[
                      'inline-flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition-all duration-200',
                      highlight
                        ? 'bg-accent text-white shadow-md hover:bg-accent-dim'
                        : 'border border-ink bg-ink text-white hover:bg-ink/85'
                    ]}
                  >
                    <span>Get a quote</span>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Short answers to the doubts people have at the price -->
      <div class="mt-14 grid gap-4 md:grid-cols-2">
        {
          education.map((item) => (
            <details class="card group p-5 open:pb-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
                {item.title}
                <svg class="h-4 w-4 shrink-0 text-ink-dim transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink-dim">{item.body}</p>
              {item.link && (
                <a href={item.link.href} class="link-underline mt-3 text-sm font-semibold text-accent">
                  {item.link.label}
                </a>
              )}
            </details>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Quote builder with the add-ons -->
  <WebsiteQuoteCalculator />

  <!-- Care Plans -->
  <CarePlans context="websites" />

  <!-- Go Digital Bundle -->
  <GoDigitalBundle />

  <!-- Search visibility, in plain words -->
  <Section class="bg-paper-dim/60">
    <Container>
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">
            Built to be found on Google, and on AI search.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-dim">
            Every website includes the basics that search engines read: clear page titles, a sitemap and your Google Business
            Profile. Business and Store websites also describe your business in structured data (name, location, hours and
            services), the format Google and AI assistants like ChatGPT and Gemini use. We never promise rankings: nobody
            controls Google.
          </p>
          {
            SITE.pageSpeedMobile && (
              <p class="mt-3 text-sm font-semibold text-ink">
                This website scores {SITE.pageSpeedMobile}/100 on Google PageSpeed (mobile).
              </p>
            )
          }

          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3 rounded-xl border border-line bg-paper p-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 font-bold text-accent">✓</span>
              <div>
                <h3 class="text-sm font-semibold text-ink">Google Business Profile, set up for you</h3>
                <p class="mt-0.5 text-xs text-ink-dim">Included in every package. It's free, and it's often the first thing customers see in Google Maps.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 rounded-xl border border-line bg-paper p-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/10 font-bold text-accent">✓</span>
              <div>
                <h3 class="text-sm font-semibold text-ink">Your business, described for search engines</h3>
                <p class="mt-0.5 text-xs text-ink-dim">Business and Store websites include structured data and a sitemap, submitted to Google Search Console.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-ink p-6 text-white shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-3 font-mono text-xs text-white/50">
            <span>your-business.jsonld</span>
            <span class="text-emerald-400">● Example</span>
          </div>
          <pre class="mt-4 overflow-x-auto font-mono text-xs leading-relaxed text-white/80"><code>{`{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Your Business",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Kuala Lumpur",
    "addressCountry": "MY"
  },
  "openingHours": "Mo-Fr 09:00-18:00",
  "telephone": "+60 3-0000 0000"
}`}</code></pre>
        </div>
      </div>
    </Container>
  </Section>

  <!-- FAQ -->
  <section id="faq" class="relative overflow-hidden pt-16 pb-16 md:pt-24 md:pb-20 border-t border-line">
    <div class="grid-pattern mask-fade-edges absolute inset-0 opacity-25" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -left-40 top-0 h-96 w-96 rounded-full bg-paper-dim blur-3xl"
      aria-hidden="true"
    ></div>
    <Container class="relative">
      <div class="mx-auto max-w-xl text-center">
        <h2 class="h-display-xl mt-3 !text-[clamp(2rem,1.4rem+2.4vw,3.2rem)] text-ink" data-split>
          Frequently Asked <span class="badge-highlight">Questions</span>
        </h2>
        <p class="mt-4 leading-relaxed text-ink-dim">
          The questions website buyers ask us most.
        </p>

        <div class="mt-6 flex items-center gap-2 rounded-full border border-line bg-white p-1.5 shadow-sm">
          <svg class="ml-2.5 h-4 w-4 shrink-0 text-ink-dim/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          <label for="faq-search" class="sr-only">Search questions</label>
          <input
            id="faq-search"
            type="text"
            placeholder="Search questions..."
            class="min-w-0 flex-1 bg-transparent px-1 py-2 text-sm text-ink placeholder:text-ink-dim/50 focus:outline-none"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Combined FAQ card: tabs + single panel with transition -->
  <Section rule>
    <Container>
      <div class="flex flex-col gap-12 lg:flex-row lg:gap-16">
        <!-- Left: category tabs + contact CTA (shown once) -->
        <div class="lg:w-72 lg:shrink-0">
          <nav aria-label="FAQ categories" class="space-y-1">
            {faqCategories.map((cat, i) => (
              <button
                type="button"
                data-faq-tab={cat.id}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class:list={[
                  'faq-tab block w-full rounded-xl px-4 py-3 text-left text-sm font-semibold transition-colors',
                  i === 0 ? 'bg-accent/10 text-accent' : 'text-ink-dim hover:bg-paper-dim hover:text-ink'
                ]}
              >
                {cat.label}
              </button>
            ))}
          </nav>

          <p class="mt-8 text-sm text-ink-dim">Can't find what you're looking for?</p>
          <a
            href="/contact/"
            class="mt-5 inline-flex items-center gap-2 rounded-full border border-line bg-paper px-5 py-2.5 text-sm font-semibold text-ink shadow-card transition-all hover:-translate-y-0.5 hover:border-ink/25 hover:shadow-card-hover"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
            </svg>
            Ask us directly
          </a>

          <div class="card mt-6 flex items-center gap-4 !rounded-2xl border-accent/20 bg-accent/4 p-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/10">
              <svg class="h-4.5 w-4.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-ink">We reply within</p>
              <p class="text-sm text-ink-dim">1 business day</p>
            </div>
          </div>
        </div>

        <!-- Right: single combined card, one panel visible at a time -->
        <div class="card flex-1 p-2 sm:p-4">
          <div id="faq-panels">
            {faqCategories.map((cat, ci) => (
              <div data-faq-panel={cat.id} class:list={['faq-panel px-4 py-2 transition-opacity duration-300', ci !== 0 && 'hidden']}>
                <h3 class="px-0 py-3 text-sm font-bold uppercase tracking-wide text-ink-dim">{cat.label}</h3>
                {cat.items.map((item, i) => (
                  <details data-faq-item name={`faq-${cat.id}`} class:list={['group py-5', i > 0 && 'border-t border-line']}>
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-base font-semibold tracking-tight text-ink transition-colors hover:text-accent">
                      <span data-faq-question>{item.q}</span>
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line text-ink-dim transition-all duration-300 [transition-timing-function:var(--ease-out-expo)] group-open:rotate-45 group-open:border-accent group-open:bg-accent group-open:text-white">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                      </span>
                    </summary>
                    <p class="mt-4 max-w-2xl pr-10 text-sm leading-relaxed text-ink-dim">{item.a}</p>
                  </details>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <CTABand
    title="Not sure which package fits?"
    subtitle="Tell us about your business. We reply within one business day, with a fixed quote within three."
    ctaLabel="Get a fixed quote"
    ctaHref="/contact/?package=website"
  />
</BaseLayout>

<script>
  function initFaqTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-panel]'));
    if (tabs.length === 0 || tabs[0].dataset.bound) return;
    tabs.forEach((t) => (t.dataset.bound = '1'));

    const showPanel = (id: string) => {
      panels.forEach((panel) => {
        const match = panel.dataset.faqPanel === id;
        panel.classList.toggle('hidden', !match);
        if (match) {
          panel.classList.remove('opacity-0');
          panel.animate([{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'translateY(0)' }], {
            duration: 220,
            easing: 'ease-out'
          });
        }
      });
      tabs.forEach((t) => {
        const active = t.dataset.faqTab === id;
        t.setAttribute('aria-pressed', String(active));
        t.classList.toggle('bg-accent/10', active);
        t.classList.toggle('text-accent', active);
        t.classList.toggle('text-ink-dim', !active);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.faqTab;
        if (id) showPanel(id);
      });
    });
  }

  initFaqTabs();
  document.addEventListener('astro:page-load', initFaqTabs);

  function initFaqSearch() {
    const input = document.getElementById('faq-search') as HTMLInputElement | null;
    if (!input || input.dataset.bound) return;
    input.dataset.bound = '1';

    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-panel]'));

    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      const searching = query.length > 0;

      panels.forEach((panel) => {
        const items = Array.from(panel.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'));
        let visibleCount = 0;

        items.forEach((item) => {
          const question = item.querySelector('[data-faq-question]')?.textContent?.toLowerCase() ?? '';
          const match = !searching || question.includes(query);
          item.classList.toggle('hidden', !match);
          if (match) visibleCount += 1;
        });

        if (searching) {
          panel.classList.toggle('hidden', visibleCount === 0);
        }
      });

      if (!searching) {
        const activeTab = document.querySelector<HTMLButtonElement>('.faq-tab[aria-pressed="true"]');
        panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.faqPanel !== activeTab?.dataset.faqTab));
      }
    });
  }

  initFaqSearch();
  document.addEventListener('astro:page-load', initFaqSearch);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Disclosure from '../components/ui/Disclosure.astro';
import FaqList from '../components/ui/FaqList.astro';
import Icon from '../components/ui/Icon.astro';
import PriceCard from '../components/sections/PriceCard.astro';
import CaseStudies from '../components/sections/CaseStudies.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import {
  AI_WHATSAPP,
  CARE_PLANS,
  CARE_PLAN_ROWS,
  FOUNDING_CLIENT,
  GO_DIGITAL_BUNDLE,
  LOCAL_SEO_SETUP,
  WEBSITE_ADD_ONS,
  WEBSITE_PACKAGES,
  bundleSeparateTotal,
  formatRM
} from '../data/catalog';
import { WEBSITES_FAQ } from '../data/faqs';
import { SITE } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();
const from = Math.min(...WEBSITE_PACKAGES.map((p) => p.price));
const slotsLeft = Math.max(0, Math.min(FOUNDING_CLIENT.totalSlots, SITE.foundingSlotsLeft));
const pageSpeedUrl = 'https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fwssdevlabs.com%2F&form_factor=mobile';

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Fixed-price websites',
  itemListElement: WEBSITE_PACKAGES.map((pkg) => ({
    '@type': 'Offer',
    name: pkg.name,
    price: pkg.price,
    priceCurrency: 'MYR',
    description: pkg.whoFor,
    url: new URL(`/websites/#${pkg.id}`, siteUrl).toString()
  }))
};

const strip = [
  `From ${formatRM(from)}`,
  'Live in 5 working days',
  'You own the code',
  'Talk to the builder'
];
---

<BaseLayout
  title="Fixed-Price Websites for Malaysian SMEs"
  description={`Three fixed-price website packages: One-Page ${formatRM(WEBSITE_PACKAGES[0].price)}, Business ${formatRM(WEBSITE_PACKAGES[1].price)} and Store ${formatRM(WEBSITE_PACKAGES[2].price)}. Everything included is listed. You own the code and the domain.`}
  path="/websites/"
  schema={[
    offerSchema,
    faqSchema(WEBSITES_FAQ),
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Websites', path: '/websites/' }
    ])
  ]}
>
  <!-- 1. Hero -->
  <section class="border-b border-line">
    <Container class="py-14 md:py-20">
      <h1 class="h-display max-w-3xl">Fixed-price websites for Malaysian SMEs.</h1>
      <p class="lead mt-5">Live in 5 days to 5 weeks, depending on the package. You own the code, the design and the domain.</p>
      <ul class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4">
        {strip.map((item) => <li class="bg-paper px-5 py-4 font-semibold text-ink">{item}</li>)}
      </ul>
    </Container>
  </section>

  <!-- 2. Three packages (audit 12.4 A) -->
  <section class="py-16 md:py-20" id="packages">
    <Container>
      <h2 class="h-section">Pick a package</h2>
      <p class="lead mt-3">Every price is fixed and final, with no SST added. Each card lists what's included and what isn't.</p>
      <div class="mt-12 grid items-start gap-8 lg:grid-cols-3">
        {WEBSITE_PACKAGES.map((pkg) => <PriceCard pkg={pkg} />)}
      </div>
      {
        slotsLeft > 0 && (
          <p class="mt-8 text-ink-dim">
            <span class="font-semibold text-ink">Founding Client Programme:</span> {FOUNDING_CLIENT.discountPercent}% off the Business
            and Store websites for our first {FOUNDING_CLIENT.totalSlots} clients, in exchange for a case study.{' '}
            {slotsLeft} of {FOUNDING_CLIENT.totalSlots} places left.{' '}
            <a href="/#founding-clients" class="link">How it works</a>
          </p>
        )
      }

      <div class="mt-12 grid gap-x-10 md:grid-cols-3">
        <Disclosure summary="Why not just a Facebook page?" class="border-t border-line py-2" summaryClass="py-2 font-semibold text-ink">
          <p class="text-ink-dim">
            Facebook pages rarely rank in Google, can be restricted without warning, and you don't own them. A website on your own
            domain is an asset you control. Most customers check Google before they WhatsApp you.
          </p>
        </Disclosure>
        <Disclosure summary="What's a CMS, and does it matter?" class="border-t border-line py-2" summaryClass="py-2 font-semibold text-ink">
          <p class="text-ink-dim">
            A CMS is the editor behind your website. With one, you update prices, photos and news yourself in minutes. Without one,
            every small change costs a developer's time, so most businesses stop updating, and an outdated site quietly loses
            customers.
          </p>
          <a href="/insights/what-is-a-cms-and-why-it-matters/" class="link mt-3 inline-flex min-h-11 items-center">Read more about CMSs</a>
        </Disclosure>
        <Disclosure summary="Own store or marketplace?" class="border-t border-line py-2" summaryClass="py-2 font-semibold text-ink">
          <p class="text-ink-dim">
            Marketplaces bring traffic but take a commission on every sale and own the customer relationship. Your own store keeps
            your margin and your customer list, so you can sell to them again. Most successful brands use both: marketplaces for
            discovery, their own store for repeat buyers.
          </p>
        </Disclosure>
      </div>
    </Container>
  </section>

  <!-- 3. Add-ons: one compact list, max 6 rows (audit 12.4 A add-ons) -->
  <section class="bg-paper-dim py-16 md:py-20" id="add-ons">
    <Container>
      <h2 class="h-section">Add-ons</h2>
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {
          WEBSITE_ADD_ONS.map((addOn) => (
            <li class="card p-5" id={addOn.id}>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-display text-lg font-semibold text-ink">{addOn.name}</h3>
                <p class="price text-lg">{addOn.price}</p>
              </div>
              <p class="mt-1 text-ink-dim">{addOn.solves}</p>
              <p class="mt-2 text-sm text-muted">For: {addOn.forWhich}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 grid gap-x-10 md:grid-cols-2">
        <Disclosure summary={`Local SEO Setup (${formatRM(LOCAL_SEO_SETUP.price)}): what's included`} class="border-t border-line-strong py-2" summaryClass="py-2 font-semibold text-ink">
          <p class="text-ink-dim">{LOCAL_SEO_SETUP.problem}</p>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-ink-dim">
            {LOCAL_SEO_SETUP.included.map((item) => <li>{item}</li>)}
          </ul>
          <p class="mt-3 text-ink-dim">{LOCAL_SEO_SETUP.notIncluded}</p>
          <p class="mt-3 text-ink-dim">{LOCAL_SEO_SETUP.timeline}</p>
          <p class="mt-3 text-ink-dim">
            <span class="font-semibold text-ink">Why SEO takes months:</span> Google needs time to crawl, trust and rank a site.
            Reviews, consistent business details and helpful pages build that trust. Expect early movement in 4 to 8 weeks and
            meaningful results in 3 to 6 months.
          </p>
        </Disclosure>
        <Disclosure summary={`AI WhatsApp Assistant (${formatRM(AI_WHATSAPP.setup)} + ${formatRM(AI_WHATSAPP.monthly)}/month): what's included`} class="border-t border-line-strong py-2" summaryClass="py-2 font-semibold text-ink">
          <p class="text-ink-dim">{AI_WHATSAPP.problem}</p>
          <p class="mt-3 font-semibold text-ink">Setup includes</p>
          <ul class="mt-1 list-disc space-y-1 pl-5 text-ink-dim">
            {AI_WHATSAPP.setupIncludes.map((item) => <li>{item}</li>)}
          </ul>
          <p class="mt-3 text-ink-dim"><span class="font-semibold text-ink">Every month:</span> {AI_WHATSAPP.monthlyIncludes}</p>
          <p class="mt-3 text-ink-dim"><span class="font-semibold text-ink">Not included:</span> {AI_WHATSAPP.notIncluded}</p>
          <p class="mt-3 text-ink-dim">
            <span class="font-semibold text-ink">How WhatsApp fees work:</span> Meta, which owns WhatsApp, charges businesses a small fee
            per conversation on the official API. We pass it on at cost, with no markup, so you always see the real number.
          </p>
          <p class="mt-3 text-ink-dim">{AI_WHATSAPP.disclosure}</p>
        </Disclosure>
      </div>
    </Container>
  </section>

  <!-- 4. Examples: real case studies once they exist; until then, check our own speed -->
  <CaseStudies offer="websites" title="Websites we've built" limit={3} />
  <section class="py-16 md:py-20">
    <Container class="grid items-center gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <h2 class="h-section">Built the way we build yours.</h2>
        <p class="lead mt-4">
          This website uses the same approach as our packages: fast pages, no bloated plugins, and nothing you need a developer to
          keep alive. Don't take our word for it. Test it on Google PageSpeed Insights.
        </p>
        {SITE.pageSpeedMobile && <p class="mt-4 font-semibold text-ink">Our latest mobile score: {SITE.pageSpeedMobile}/100.</p>}
      </div>
      <a href={pageSpeedUrl} class="btn btn-secondary btn-lg" target="_blank" rel="noopener noreferrer">
        Test this site's speed <Icon name="external-link" class="h-4 w-4" />
      </a>
    </Container>
  </section>

  <!-- 5. Go Digital Bundle (audit 12.4 F) -->
  <section class="bg-paper-dim py-16 md:py-20" id="bundle">
    <Container class="grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="h-section">Website and a system, together.</h2>
        <p class="lead mt-4">
          The Go Digital Bundle is for established SMEs that want to digitalise sales and operations in one go, from one builder,
          with a year of care included.
        </p>
        <p class="mt-4 text-ink-dim">
          When your website, POS and WhatsApp assistant come from one team, they're set up to work together, and there is one
          person to call when something needs changing. No finger-pointing between vendors.
        </p>
        <p class="mt-4 text-ink-dim">
          Payment: {GO_DIGITAL_BUNDLE.payment} Timeline: {GO_DIGITAL_BUNDLE.timeline}.
        </p>
      </div>
      <div class="card p-6 sm:p-8">
        <p class="font-display text-xl font-bold text-ink">Go Digital Bundle</p>
        <ul class="mt-5 space-y-3">
          {
            GO_DIGITAL_BUNDLE.items.map((item) => (
              <li class="flex items-baseline justify-between gap-4">
                <span class="text-ink">{item.name}</span>
                <span class="shrink-0 text-ink-dim">{formatRM(item.price)}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-5 flex items-baseline justify-between gap-4 border-t border-line pt-4 text-ink-dim">
          <span>Bought separately</span>
          <span>{formatRM(bundleSeparateTotal)}</span>
        </div>
        <div class="mt-2 flex items-baseline justify-between gap-4">
          <span class="font-semibold text-ink">Bundle price</span>
          <span class="price text-3xl">{formatRM(GO_DIGITAL_BUNDLE.price)}</span>
        </div>
        <p class="mt-1 text-right text-sm font-semibold text-accent-dim">
          You save {formatRM(bundleSeparateTotal - GO_DIGITAL_BUNDLE.price)}
        </p>
        <a href="/contact/?need=website&package=go-digital-bundle" class="btn btn-secondary mt-6 w-full" data-track="quote_click">
          Get a fixed quote
        </a>
      </div>
    </Container>
  </section>

  <!-- 6. Care Plans: the recurring layer (audit 12.4 E) -->
  <section class="py-16 md:py-20" id="care-plans">
    <Container>
      <h2 class="h-section">Care Plans</h2>
      <p class="lead mt-3">
        Websites aren't done at launch. Choose how much looking-after you want. No software rent: you only pay for real ongoing
        service.
      </p>

      <div class="mt-10 overflow-hidden rounded-2xl border border-line">
        <table class="hidden w-full border-collapse text-left text-base md:table">
          <caption class="sr-only">Care Plan comparison</caption>
          <thead class="bg-paper-dim">
            <tr>
              <th scope="col" class="p-4 font-semibold text-ink"><span class="sr-only">Feature</span></th>
              {
                CARE_PLANS.map((plan) => (
                  <th scope="col" class="p-4 align-top">
                    <span class="block font-display text-lg font-bold text-ink">{plan.name}</span>
                    <span class="mt-1 block font-semibold text-ink">{plan.price}</span>
                    {plan.annual && <span class="mt-1 block text-sm font-normal text-ink-dim">or {plan.annual}</span>}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              CARE_PLAN_ROWS.map(([label, ...values]) => (
                <tr class="border-t border-line">
                  <th scope="row" class="p-4 font-medium text-ink">{label}</th>
                  {values.map((value) => (
                    <td class="p-4 text-ink-dim">{value}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
        <!-- Phones: one stacked block per plan instead of a sideways-scrolling table (audit 10.3) -->
        <div class="divide-y divide-line md:hidden">
          {
            CARE_PLANS.map((plan, planIndex) => (
              <div class="p-5">
                <p class="font-display text-lg font-bold text-ink">{plan.name}</p>
                <p class="font-semibold text-ink">{plan.price}</p>
                {plan.annual && <p class="text-sm text-ink-dim">or {plan.annual}</p>}
                <dl class="mt-3 space-y-2 text-sm">
                  {CARE_PLAN_ROWS.map(([label, ...values]) => (
                    <div class="flex justify-between gap-4">
                      <dt class="text-ink-dim">{label}</dt>
                      <dd class="text-right font-medium text-ink">{values[planIndex]}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-8 grid gap-x-10 md:grid-cols-2">
        <Disclosure summary="Why do websites need maintenance?" class="border-t border-line py-2" summaryClass="py-2 font-semibold text-ink">
          <p class="text-ink-dim">
            Like a car, software needs regular servicing: security patches, backups and checks. A hacked or broken site usually costs
            far more to fix than a year of care, and owners often only notice when a customer complains.
          </p>
        </Disclosure>
        <p class="border-t border-line py-4 text-ink-dim">
          Care Plans also cover ready-made systems and custom builds. The full service terms are on the{' '}
          <a href="/care-plan-terms/" class="link">Care Plan terms</a> page.
        </p>
      </div>
    </Container>
  </section>

  <!-- 7. FAQ -->
  <section class="bg-paper-dim py-16 md:py-20" id="faq">
    <Container narrow>
      <h2 class="h-section">Questions</h2>
      <FaqList items={WEBSITES_FAQ} class="mt-8" />
    </Container>
  </section>

  <!-- 8. CTA -->
  <FinalCTA title="Tell us about your business." />
</BaseLayout>

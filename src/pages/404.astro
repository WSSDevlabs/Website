---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { MAIN_NAV } from '../data/nav';
---

<BaseLayout title="Page not found" description="This page doesn't exist. Here's where to go instead." path="/404/" noindex>
  <section>
    <Container class="py-20 md:py-28">
      <h1 class="h-display max-w-2xl">That page doesn't exist.</h1>
      <p class="lead mt-5">It may have moved when we simplified the site. These pages cover everything we do:</p>
      <ul class="mt-8 flex flex-wrap gap-3">
        {
          MAIN_NAV.map((link) => (
            <li>
              <a href={link.href} class="btn btn-secondary">
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href="/contact/" class="btn btn-primary" data-track="quote_click">Get a fixed quote</a></li>
      </ul>
    </Container>
  </section>
</BaseLayout>

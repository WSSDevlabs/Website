---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import HomepageServices from '../components/sections/HomepageServices.astro';
import TeamGrid from '../components/sections/TeamGrid.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ElevateCTA from '../components/sections/ElevateCTA.astro';
import MarketplaceAndExpressBanner from '../components/sections/MarketplaceAndExpressBanner.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import GrantSolutions from '../components/sections/GrantSolutions.astro';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 4);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'WSS DevLabs',
  url: Astro.site?.toString(),
  description:
    'SME productized tech & custom engineering partner: WSS Express websites, Buy-Once Marketplace systems, AI development, and Bespoke Enterprise solutions.'
};
---

<BaseLayout
  title="WSS DevLabs: Productized Services, Marketplace & Bespoke Engineering"
  description="High-performance websites, 15 Buy-Once PHP systems, AI automation, and custom enterprise engineering with 2026 Government Grant funding matching."
  path="/"
  schema={schema}
>
  <Hero />
  <HomepageServices />
  <TeamGrid />
  <Testimonials />
  <ElevateCTA />
  <MarketplaceAndExpressBanner />
  <FeaturedWork projects={featuredProjects} />
  <GrantSolutions />
</BaseLayout>


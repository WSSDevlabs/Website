---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import OfferChooser from '../components/sections/OfferChooser.astro';
import HomeOwnership from '../components/sections/HomeOwnership.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FAQ from '../components/sections/FAQ.astro';
import ElevateCTA from '../components/sections/ElevateCTA.astro';
import { HOME_FAQ } from '../data/faqs';
import { organizationSchema, faqSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString();

const schema = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema(siteUrl), faqSchema(HOME_FAQ)]
};
---

<BaseLayout
  title="Websites & Business Systems for Malaysian SMEs, Fixed Price"
  description="Fixed-price websites from RM569 and buy-once business systems with full source code. No monthly SaaS fees. Founder-led, based in Kuala Lumpur."
  path="/"
  schema={schema}
>
  <Hero />
  <OfferChooser />
  <HomeOwnership />
  <Testimonials />
  <FAQ title="Questions people ask first" items={HOME_FAQ} />
  <ElevateCTA />
</BaseLayout>

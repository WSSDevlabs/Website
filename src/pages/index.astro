---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Marquee from '../components/ui/Marquee.astro';
import BrandTrustGrid from '../components/sections/BrandTrustGrid.astro';
import MarketplaceAndExpressBanner from '../components/sections/MarketplaceAndExpressBanner.astro';
import WhateverYouNeed from '../components/sections/WhateverYouNeed.astro';
import GrantSolutions from '../components/sections/GrantSolutions.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import HomepageServices from '../components/sections/HomepageServices.astro';
import Differentiator from '../components/sections/Differentiator.astro';
import ProcessOverview from '../components/sections/ProcessOverview.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import SMEProjectCalculator from '../components/sections/SMEProjectCalculator.astro';
import FAQ from '../components/sections/FAQ.astro';
import { HOME_FAQ } from '../data/faq';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 4);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'WSS DevLabs',
  url: Astro.site?.toString(),
  description:
    'SME productized tech & custom engineering partner: WSS Express websites, Buy-Once Marketplace systems, AI development, and Bespoke Enterprise solutions.'
};
---

<BaseLayout
  title="WSS DevLabs: Productized Services, Marketplace & Bespoke Engineering"
  description="High-performance websites, 15 Buy-Once PHP systems, AI automation, and custom enterprise engineering with 2026 Government Grant funding matching."
  path="/"
  schema={schema}
>
  <Hero
    eyebrow="Direct with Builders · Zero SaaS Dependency"
    title="Whatever you need, we can build it."
    accentWord="build"
    accentTone="blue"
    subtitle="From RM 180 fixed-price websites and Buy-Once production systems to RM 15,000 bespoke enterprise platforms. Direct with senior engineers."
    primaryCta={{ label: 'Explore Express & Marketplace', href: '/express' }}
    secondaryCta={{ label: 'Bespoke Enterprise', href: '/services/bespoke' }}
  />
  <BrandTrustGrid />
  <Marquee />
  <MarketplaceAndExpressBanner />
  <WhateverYouNeed />
  <AboutSection />
  <HomepageServices />
  <Differentiator />
  <ProcessOverview />
  <FeaturedWork projects={featuredProjects} />
  <Testimonials />
  <GrantSolutions />
  <SMEProjectCalculator />
  <FAQ items={HOME_FAQ} />
</BaseLayout>

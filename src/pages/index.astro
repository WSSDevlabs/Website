---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import Container from '../components/ui/Container.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Pill from '../components/ui/Pill.astro';
import VideoMedia from '../components/media/VideoMedia.astro';
import CTABand from '../components/sections/CTABand.astro';
import HomeSectors from '../components/sections/HomeSectors.astro';
import TrustedPartners from '../components/sections/TrustedPartners.astro';
import MarketplaceAndExpressBanner from '../components/sections/MarketplaceAndExpressBanner.astro';
import { CLIPS } from '../data/media';
import { SECTORS } from '../data/sectors';
import { SERVICE_CATEGORIES } from '../data/serviceCategories';
import { PILOT_STEPS } from '../data/pilot';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'WSS DevLabs',
  url: Astro.site?.toString(),
  description:
    'Malaysian AI, IoT and systems company building intelligent solutions for agriculture, biomass, smart cities, energy, waste-to-energy and SMEs. Websites, apps and digital marketing also available.',
  areaServed: 'MY',
  knowsAbout: [
    'Artificial intelligence',
    'Computer vision',
    'Internet of Things',
    'Digital twins',
    'Smart agriculture',
    'Biomass',
    'Waste-to-energy',
    'Smart city',
    'Energy monitoring',
    'Web and mobile app development',
    'Digital marketing',
    'Digital skills training'
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Solutions by sector',
    itemListElement: SECTORS.map((sector) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: `${sector.name} solutions`, description: sector.summary }
    }))
  }
};

const pillars = SERVICE_CATEGORIES.slice(0, 3);
// Story-style blurbs for the home page (the category pages keep their own copy)
const STORY: Record<string, string> = {
  'artificial-intelligence-automation':
    "You tell us about the repetitive work that eats your team's day. We learn how your business runs, build the AI and automation around it, test it on your own data, and hand it over so it keeps working while you get on with the business.",
  'iot-solutions-infrastructure':
    'We start on site, walking the floor with you. Then we place the sensors, bring everything onto one dashboard and set up alerts, so you hear about a problem the moment it starts, not days later.',
  'web-software-app-development':
    'Your idea becomes a working system in steps you can see. We design it with you, build it around how you really work, launch it, and stay beside you afterwards, so nothing is left for you to figure out alone.'
};
---

<BaseLayout
  title="WSS DevLabs: AI, IoT and System Solutions for Malaysian Industry"
  description="AI, IoT and intelligent systems for agriculture, biomass, smart cities, energy, waste-to-energy and SMEs in Malaysia. Designed, built, supported and taught by one team."
  path="/"
  schema={schema}
>
  <HomeHero />

  <!-- Why WSS: label left, statement right, two stat cards -->
  <section class="py-20 md:py-28">
    <Container>
      <SectionHead
        title="Got a problem in your business? You're in the right place. Whether it's slow sales, no website yet, or too much manual work, we'll sort it out together, one step at a time."
        body="Most business problems feel bigger than they are when you carry them alone. Maybe sales have gone quiet, maybe customers cannot find you online, or maybe your team is buried in work a computer could do. Tell us what is holding you back, big or small. We listen first, explain your options in plain words, then suggest one small step you can try, so you see real results before you decide anything."
        ctaLabel="Consult with us"
        ctaHref="/contact"
      />
    </Container>
  </section>

  <TrustedPartners />

  <!-- Story band: three tall photos (reference layout), dark -->
  <section class="bg-charcoal py-20 text-white md:py-28" data-tight>
    <div class="mx-auto w-full max-w-[100rem] px-4 md:px-6">
      <div class="grid items-end gap-8 md:grid-cols-[1.2fr_0.8fr] md:gap-12">
        <div>
          <h2 class="max-w-2xl font-display text-[clamp(2rem,1.2rem+3vw,3.8rem)] font-medium leading-[1.05] tracking-[-0.035em]">
            Technology that makes hard days a little easier
          </h2>
        </div>
        <div class="md:ml-auto md:max-w-xs">
          <p class="text-sm leading-relaxed text-white/65">
            We start where the work happens, in the field, the plant or the shop. We listen, we connect what we find, and we turn it into simple tools your team can trust.
          </p>
          <Pill href="/resources#consult" label="See how we work" variant="light" class="mt-5" />
        </div>
      </div>

      <div class="mt-12 grid gap-4 md:mt-16 md:grid-cols-3">
        {
          [
            { img: '/images/home/how-1.webp', pos: 'left top', alt: 'A live dashboard reading sensor values', title: 'We listen on site', body: 'We walk the farm, the plant or the shop with you, and hear what really goes wrong. Sensors then read the numbers for you, all day, without anyone checking.' },
            { img: '/images/home/how-2.webp', pos: 'left top', alt: 'A workflow that connects apps and steps automatically', title: 'We connect the dots', body: 'Orders, alerts and messages flow through automations we set up, so the boring steps happen on their own and nothing gets missed.' },
            { img: '/images/home/how-3.webp', pos: 'left top', alt: 'A business workspace with calendar, tasks and shortcuts in one place', title: 'We help you act', body: 'Your records come together in one system with AI watching it, so you see what needs attention before it becomes a problem.' }
          ].map((card) => (
            <article>
              <div class="relative aspect-[16/9] overflow-hidden bg-white">
                <img src={card.img} alt={card.alt} loading="lazy" width="1500" height="900" class="h-full w-full object-cover" style={`object-position:${card.pos}`} />
              </div>
              <h3 class="mt-5 text-lg font-bold tracking-tight">{card.title}</h3>
              <p class="mt-1.5 max-w-md text-sm leading-relaxed text-white/60">{card.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What we build: two small cards left, one large right -->
  <section class="relative isolate overflow-hidden bg-paper-dim py-20 md:py-28">
    <!-- background photo (white backdrop blends into the grey section); mirrored so the figure sits on the right, away from the heading -->
    <img
      src="/images/home/secbg1.webp"
      alt=""
      width="1000"
      height="925"
      loading="lazy"
      class="pointer-events-none absolute right-0 top-0 -z-10 h-[42rem] w-auto max-w-none -scale-x-100 object-cover object-top opacity-40 mix-blend-multiply md:h-full md:min-h-[56rem] md:opacity-100"
    />
    <!-- keeps the heading readable where the photo reaches under it -->
    <div class="pointer-events-none absolute inset-y-0 left-0 -z-10 w-full bg-gradient-to-r from-paper-dim from-35% via-paper-dim/85 via-50% to-transparent to-72%" aria-hidden="true"></div>
    <Container>
      <SectionHead
        title="AI, IoT and systems, engineered as one stack. Field-tested ideas, built to last on your site."
        ctaLabel="See services"
        ctaHref="/services"
      />
      <div class="mt-14 grid gap-4 lg:grid-cols-[0.8fr_1.4fr]">
        <div class="grid gap-4">
          {
            pillars.slice(0, 2).map((pillar, i) => (
              <a
                href={`/services/${pillar.slug}`}
                class="group flex flex-col justify-between rounded-[1.75rem] bg-white p-7 transition-transform duration-300 hover:-translate-y-1 md:min-h-[17rem]"
              >
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-paper-dim text-ink">
                  {i === 0 ? (
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />
                    </svg>
                  ) : (
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
                    </svg>
                  )}
                </span>
                <div class="mt-10">
                  <h3 class="text-lg font-bold tracking-tight text-ink">{pillar.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink-dim">{STORY[pillar.slug] ?? pillar.description}</p>
                </div>
              </a>
            ))
          }
        </div>
        <a
          href={`/services/${pillars[2].slug}`}
          class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-[1.75rem] bg-charcoal p-8 text-white md:p-10"
        >
          <VideoMedia clip={CLIPS.opsCentre} class="!absolute inset-0 -z-10 h-full w-full" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/25 to-transparent" aria-hidden="true"></div>
          <h3 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{pillars[2].title}</h3>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/75">{STORY[pillars[2].slug] ?? pillars[2].description}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold">
            Learn more
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </span>
        </a>
      </div>
    </Container>
  </section>

  <HomeSectors />

  <!-- How a pilot works -->
  <section class="relative -mt-10 rounded-t-[2.75rem] bg-charcoal pb-20 pt-28 text-white md:-mt-14 md:pb-28 md:pt-36">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-40 rounded-t-[2.75rem] bg-gradient-to-b from-white/[0.07] to-transparent" aria-hidden="true"></div>
    <Container class="relative">
      <SectionHead
        dark
        title="Every big change starts with one small step. We try it on your site first, so you see it work before you decide."
      />
      <div class="mt-14 grid gap-4 lg:grid-cols-[1fr_1.2fr]">
        <div class="relative min-h-[22rem] overflow-hidden rounded-[1.75rem] bg-charcoal">
          <VideoMedia clip={CLIPS.cameraInstall} class="h-full w-full" />
        </div>
        <ol class="rounded-[1.75rem] bg-white/[0.07] p-7 md:p-9">
          {
            PILOT_STEPS.map((step, i) => (
              <li class:list={['grid grid-cols-[3rem_1fr] gap-4 py-6', i > 0 && 'border-t border-white/10', i === 0 && 'pt-0', i === PILOT_STEPS.length - 1 && 'pb-0']}>
                <span class="font-feature text-2xl font-semibold text-white">0{i + 1}</span>
                <div>
                  <h3 class="text-base font-bold uppercase tracking-wide text-white">{step.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-white/60">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="mt-8 flex justify-center">
        <Pill href="/resources#consult" label="See how consulting works" variant="light" />
      </div>
    </Container>
  </section>

  <MarketplaceAndExpressBanner />
  <CTABand
    image="/images/home/secbg3.webp"
    title="Let's turn your problem into a plan."
    subtitle="Tell us what is slowing you down, even if you are not sure what the answer is yet. We reply within one business day, and we take it from there."
    ctaLabel="Consult with us"
  />
</BaseLayout>

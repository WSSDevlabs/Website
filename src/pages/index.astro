---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ZoomReveal from '../components/sections/ZoomReveal.astro';
import SectorScroller from '../components/sections/SectorScroller.astro';
import SolutionStack from '../components/sections/SolutionStack.astro';
import KineticBand from '../components/sections/KineticBand.astro';
import ProblemPan from '../components/sections/ProblemPan.astro';
import HomepageServices from '../components/sections/HomepageServices.astro';
import PartnersMarquee from '../components/sections/PartnersMarquee.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ElevateCTA from '../components/sections/ElevateCTA.astro';
import MarketplaceAndExpressBanner from '../components/sections/MarketplaceAndExpressBanner.astro';
import { SECTORS } from '../data/sectors';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'WSS DevLabs',
  url: Astro.site?.toString(),
  description:
    'Malaysian technology solutions company applying software, apps, AI, IoT, analytics and digital marketing to agriculture, biomass, smart cities, energy, waste-to-energy and SME digitalisation.',
  areaServed: 'MY',
  knowsAbout: [
    'Artificial intelligence',
    'Computer vision',
    'Internet of Things',
    'Digital twins',
    'Smart agriculture',
    'Biomass',
    'Waste-to-energy',
    'Smart city',
    'Energy monitoring',
    'Web and mobile app development',
    'Digital marketing',
    'Digital skills training'
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Solutions by sector',
    itemListElement: SECTORS.map((sector) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: `${sector.name} solutions`, description: sector.summary }
    }))
  }
};
---

<BaseLayout
  title="WSS DevLabs: AI, IoT and Software Solutions for Malaysian Industry"
  description="AI, IoT, software and analytics for agriculture, biomass, smart cities, energy, waste-to-energy and SMEs in Malaysia. Designed, built, supported and taught by one team."
  path="/"
  schema={schema}
>
  <Hero />
  <ZoomReveal />
  <SectorScroller />
  <SolutionStack />
  <KineticBand />
  <ProblemPan />
  <HomepageServices />
  <PartnersMarquee />
  <Testimonials />
  <ElevateCTA />
  <MarketplaceAndExpressBanner />
</BaseLayout>

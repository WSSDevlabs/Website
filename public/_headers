# Security headers for every page (audit T2, T3, 14.8).
#
# The Content-Security-Policy is REPORT-ONLY for now: it never blocks anything, it only
# logs violations in the browser console. Once a week of normal use (chat assistant, contact
# form, map, analytics) shows no violations in DevTools, rename the header to
# Content-Security-Policy to enforce it. Any new third-party script must be added here first.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.botpress.cloud https://files.bpcontent.cloud https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdn.botpress.cloud https://fonts.googleapis.com; img-src 'self' data: blob: https://images.unsplash.com https://tile.openstreetmap.org https://*.botpress.cloud https://files.bpcontent.cloud; font-src 'self' data: https://fonts.gstatic.com https://cdn.botpress.cloud; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com https://*.botpress.cloud wss://*.botpress.cloud https://files.bpcontent.cloud; frame-src https://*.botpress.cloud; worker-src 'self' blob:; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  ! Access-Control-Allow-Origin

# Fingerprinted build assets never change: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The Decap CMS console loads its editor from a CDN and talks to GitHub.
/wss-console/*
  ! Content-Security-Policy-Report-Only
  X-Robots-Tag: noindex, nofollow
